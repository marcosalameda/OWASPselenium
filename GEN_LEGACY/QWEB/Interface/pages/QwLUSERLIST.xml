<?xml version="1.0" encoding="utf-8"?>
<PAGE ID="QwLUSERLIST" TIT="Utilizadores" STYLE="QwLUSERLIST" SCROLL="S">

  <MULTIFORM ID="APPLUSERLIST" PROVIDER="psw" MSGCTL="Msgstd"  DEFCOLORD="psw.nome ASC" XOPT="TRECS[=[S">
	<COL ID="psw.codpsw" TYPE="A" TIT="" LARG="0" VIS="N" KEY="S" HISTID="psw"/>
	<COL ID="psw.nome" TYPE="A30" TIT="Identificação" LARG="202" VIS="S" HISTID="psw.nome"/>
	<EVENT ID="SEL" SELOBRIG="U" ACT="OpenPage(QwFPSW,VIS"/>
	<EVENT ID="DBL" SELOBRIG="U" ACT="OpenPage(QwFPSW,VIS"/>
	<EVENT ID="ALT" SELOBRIG="U" ACT="OpenPage(QwFPSW,ALT"/>
	<EVENT ID="INS" SELOBRIG="N" ACT="OpenPage(QwFPSW,INS"/>
	<EVENT ID="DUP" SELOBRIG="U" ACT="OpenPage(QwFPSW,DUP"/>
	<EVENT ID="ELI" SELOBRIG="U" ACT="OpenPage(QwFPSW,ELI"/>
  </MULTIFORM>

<!-- Espaço para rotinas manuais -->

  <PANEL LOCATION="0,0" SIZE="*,65" STYLE="BARRA">
    <PATH LOCATION="1,0" SIZE="*-2,17"/>
    <TITLE LOCATION="1,17" SIZE="*-2,30" ALIGN="LEFT"/>
    <MSG ID="Msgstd" LOCATION="1,45" SIZE="*-2,17" ALIGN="LEFT"/>
  </PANEL>
 
  <PANEL LOCATION="0,65" SIZE="*,*" STYLE="DEFAULT" SCROLL="S">
    <PANEL LOCATION="0,5" SIZE="*,*" STYLE="CONTEUDO" SCROLL="N">    
	  <MULTIGRID ID="dbgrid1" DATACTL="APPLUSERLIST" LOCATION="5,0" SIZE="*-100,*-5" ALLOWORDER="S" AUTOCOLRESIZE="10">
		<HEADERPANEL SIZE="0,20" AUTOLAYOUT="QRY" AUTOSCROLL="S"/>
    	<HEADERPANEL SIZE="0,20" AUTOLAYOUT="CAB" AUTOSCROLL="S"/>
    	<DATAPANEL AUTOLAYOUT="DET" SIZE="0,22"/>
		<FOOTERPANEL SIZE="*,20" AUTOLAYOUT="N" AUTOSCROLL="N">
        <BOTAO LOCATION="0,2" SIZE="16,16" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,GET-" STYLE="DPPAG-" TIP="Página anterior"/>
        <TEXT LOCATION="16,2" SIZE="25,20" DATACTL="APPLUSERLIST" DATAFLD="$page" PROT="S" READONLY="S" ALIGN="CENTER" STYLE="TRANSP"/>
        <LABEL LOCATION="40,2" TXT="/"/>
        <TEXT LOCATION="45,2" SIZE="25,20" DATACTL="APPLUSERLIST" DATAFLD="$pages" PROT="S" READONLY="S" ALIGN="CENTER" STYLE="TRANSP"/>
        <BOTAO LOCATION="65,2" SIZE="16,16" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,GET+" STYLE="DPPAG+" TIP="Página seguinte"/>
        <IMG LOCATION="100,2" SIZE="16,16" SRC="totalIcon.png" TIP="Total de registos: "/>
        <TEXT LOCATION="116,2" SIZE="50,20" DATACTL="APPLUSERLIST" DATAFLD="$records" PROT="S" READONLY="S" STYLE="TRANSP"/>
      </FOOTERPANEL>
	  </MULTIGRID>
		</PANEL>
	</PANEL>
	<PANEL LOCATION="*-100,70" SIZE="*,*" STYLE="DEFAULT" SCROLL="S">
	<BOTAO ICONID="bproc.png" ID="Bprocurar" LOCATION="*-90,0" SIZE="80,21" TXT="Procurar" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,GET" STYLE="BDBEDIT"/>
	<BOTAO ICONID="bselecc.png" LOCATION="*-90,40" SIZE="80,21" TXT="Consultar" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,SEL" STYLE="BDBEDIT"/>
	<BOTAO ICONID="balterar.png" LOCATION="*-90,65" SIZE="80,21" TXT="Alterar" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,ALT" STYLE="BDBEDIT"/>
	<BOTAO ICONID="bins.png" LOCATION="*-90,90" SIZE="80,21" TXT="Inserir" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,INS" STYLE="BDBEDIT"/>
	<BOTAO ICONID="bdupli.png" LOCATION="*-90,115" SIZE="80,21" TXT="Duplicar" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,DUP" STYLE="BDBEDIT"/>
	<BOTAO ICONID="belim.png" LOCATION="*-90,140" SIZE="80,21" TXT="Eliminar" DATACTL="APPLUSERLIST" ACT="Execute(APPLUSERLIST,ELI" STYLE="BDBEDIT"/>
	<BOTAO ICONID="bcancel.png" ID="Bcancel" LOCATION="*-90,165" SIZE="80,21" TXT="Cancelar" DATACTL="APPLUSERLIST" ACT="ClosePage(" STYLE="BDBEDIT"/>

    </PANEL>

</PAGE>

