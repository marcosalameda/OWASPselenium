@model GenioMVC.ViewModels.Anexd.Anexd_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Anexd";
	ViewBag.Title = @Resources.ANEXO_DIGITAL09547;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Anexd", FormMethod.Post, new { enctype="multipart/form-data", @class = "form-horizontal", area="Anexd", data_form="Anexd" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Anexd" area="Anexd" data-form="Anexd">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Anexd_well" area="Anexd" data-form="Anexd">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

