@model GenioMVC.ViewModels.Cfaqs.Cfaqs_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Cfaqs";
	ViewBag.Title = @Resources.CATEGORY_FAQS42471;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Cfaqs", FormMethod.Post, new { @class = "form-horizontal", area="Cfaqs", data_form="Cfaqs" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Cfaqs" area="Cfaqs" data-form="Cfaqs">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Cfaqs_well" area="Cfaqs" data-form="Cfaqs">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-image draggable " id="CONTAINER_LED_CFAQS___CFAQSICON____">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValIcon, new { label_id="LED_CFAQS___CFAQSICON____", @class = " i-text__label", id="LABEL_LED_CFAQS___CFAQSICON____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_CFAQS___CFAQSICON____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								<div data-identifier="LED_CFAQS___CFAQSICON____" pers-cs-area="Cfaqs" pers-cs-field="ValIcon" class="image-control-wrapper" >
								@if(Model.IsEditableMode) {
									@Html.EditorFor(m => m.ValIcon, new {help_id = "LED_CFAQS___CFAQSICON____", @class = "col-auto ", data_identifier = "LED_CFAQS___CFAQSICON____", title = @Resources.ICON41974, guid = @Model.ValCodcfaqs, controller = "Cfaqs", fldname = "ValIcon", identifier = "FCFAQS", style = "height: 7pt; display: inline-block;" })
								} else {
									@Html.DisplayFor(m => m.ValIcon, new {help_id = "LED_CFAQS___CFAQSICON____", @class = "col-auto ", data_identifier = "LED_CFAQS___CFAQSICON____", title = @Resources.ICON41974, guid = @Model.ValCodcfaqs, controller = "Cfaqs", fldname = "ValIcon", identifier = "FCFAQS", style = "height: 7pt; display: inline-block;" })
								}
								</div>
								@Html.ValidationMessageFor(model => model.ValIcon)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-textarea draggable " id="CONTAINER_LED_CFAQS___CFAQSCATEGORY">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValCategory, new { label_id="LED_CFAQS___CFAQSCATEGORY", @class = " i-text__label", id="LABEL_LED_CFAQS___CFAQSCATEGORY"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_CFAQS___CFAQSCATEGORY','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextAreaFor(model => model.ValCategory, 3, 99, new {help_id = "LED_CFAQS___CFAQSCATEGORY", @class = "i-textarea__field i-textarea input-xxlarge", data_identifier = "LED_CFAQS___CFAQSCATEGORY", @pers_cs_area = "Cfaqs", @pers_cs_field = "ValCategory", @db_field = "ValCategory", title = @Resources.CATEGORY18978 })
								@Html.ValidationMessageFor(model => model.ValCategory)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-textarea draggable " id="CONTAINER_LED_CFAQS___CFAQSDESCRIPT">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValDescript, new { label_id="LED_CFAQS___CFAQSDESCRIPT", @class = " i-text__label", id="LABEL_LED_CFAQS___CFAQSDESCRIPT"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_CFAQS___CFAQSDESCRIPT','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextAreaFor(model => model.ValDescript, 3, 99, new {help_id = "LED_CFAQS___CFAQSDESCRIPT", @class = "i-textarea__field i-textarea input-xxlarge", data_identifier = "LED_CFAQS___CFAQSDESCRIPT", @pers_cs_area = "Cfaqs", @pers_cs_field = "ValDescript", @db_field = "ValDescript", title = @Resources.DESCRIPTION07383 })
								@Html.ValidationMessageFor(model => model.ValDescript)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_CFAQS___PSEUDEXPFAQS_">
								<div id="Cfaqs_ValExpfaqs" data-identifier="IFF_CFAQS___PSEUDEXPFAQS_"  data-extra-options="" > 
									@{ Html.RenderAction("Cfaqs_ValExpfaqs", "Cfaqs", new { id = Model.ValCodcfaqs, partialView = "Cfaqs_ValExpfaqs"}); }
								</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodcfaqs, new { @pers_cs_field="ValCodcfaqs", @pers_cs_area="Cfaqs", data_refresh = "true", @form_area="true", @data_value = Model.ValCodcfaqs, @data_identifier = "LED_CFAQS___CFAQSCODCFAQS" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Cfaqs" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Cfaqs" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Cfaqs" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Cfaqs", Model.FormMode).ToString(), "Cfaqs"))", "Cfaqs_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Cfaqs_Delete", "Cfaqs", new {id = @Model.ValCodcfaqs} )", "Cfaqs_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Cfaqs_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Cfaqs_Delete", "Cfaqs", new {id = @Model.ValCodcfaqs} )", "Cfaqs_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Cfaqs_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitCfaqs(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Cfaqs", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteCfaqs(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Cfaqs", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitCfaqs(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Cfaqs_Cancel", "Cfaqs", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Cfaqs.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Cfaqs_Cancel","Cfaqs","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Cfaqs">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Cfaqs" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Cfaqs">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT CFAQS]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_CFAQS" data-form-javascript="true">
@Html.Partial("Cfaqs_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
