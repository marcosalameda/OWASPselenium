@model GenioMVC.ViewModels.Cfaqs.STY_Menu_3591_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Cfaqs.STY_Menu_3591_ViewModel modelSTY_Menu_3591 = new GenioMVC.ViewModels.Cfaqs.STY_Menu_3591_ViewModel(Navigation);
	var columns = modelSTY_Menu_3591.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "cfaqs" && areaField.Field == "category")
		{
			fields.Add("CFAQS.CATEGORY", new TableFilterField("CFAQS", "CATEGORY", Resources.CATEGORY18978, "text"));
		}
		if (areaField.Area == "cfaqs" && areaField.Field == "descript")
		{
			fields.Add("CFAQS.DESCRIPT", new TableFilterField("CFAQS", "DESCRIPT", Resources.DESCRIPTION07383, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("STY_Menu_3591", "Cfaqs", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Cfaqs", data_form="STY_Menu_3591" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="STY_Menu_3591_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qSTY_Menu_3591", Navigation.GetStrValue("qSTY_Menu_3591"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('STY_Menu_3591');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('STY_Menu_3591');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.CATEGORY18978})
					<button id="qSTY_Menu_3591-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("STY_Menu_3591", fields, "CFAQS")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('STY_Menu_3591', 'CFAQS', 'CFAQS.CATEGORY');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@if (!Model.IsViewModeHidden("LIST"))
						{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="STY_Menu_3591_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#STY_Menu_3591_complex_filter', 'STY_Menu_3591_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("STY_Menu_3591")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="STY_Menu_3591" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "STY_Menu_3591", idlistController = "Cfaqs", idlistArea = "Cfaqs", codlista ="c620143f-29ba-4b06-855d-55c48acfe0c6" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("STY_Menu_3591_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "STY_Menu_3591" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_STY_Menu_3591 = new QMenuForm($('[data-form="STY_Menu_3591"]'), "Form_STY_Menu_3591");
		window.Form_STY_Menu_3591.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_STY_Menu_3591.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qSTY_Menu_3591");
		RegisterClearEvents("STY_Menu_3591")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("STY_Menu_3591", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="STY_Menu_3591"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="STY_Menu_3591"]'));
	}

	function ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer) {
		if (bottomInsertBtn) {
			if ($(window).scrollTop() + $(window).height() > $(document).height() - 50)
				insertBtnContainer.addClass("menu-insert-btn-top-hidden");
			else
				insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
		}
	}

	var nav = $('#header-container > nav')[0];
	var header = $(".page-header");
	var threshold_el = $('.c-header').length ? $('.c-header') : $('nav').first();
	var breadcrumbs = $('#breadcrumbs').height() ? $('#breadcrumbs') : $('[aria-label=breadcrumb]');
	header.css('min-height', 50);

	// get the insert button
	var bottomInsertBtn = $('[qbutton=insert]')[0];

	if (bottomInsertBtn) {
		var insertBtn = $.clone($('[qbutton=insert]')[0]);
		insertBtn.innerHTML = insertBtn.innerHTML.replace(insertBtn.innerText, '');
		insertBtn = $(insertBtn);
		insertBtn.removeClass();
		insertBtn.addClass('b-btn b-icon b-icon--secondary');

		// find the page header
		var pageHeader = $('.page-header')[0];
		var newCol = $("<div class='col'></div>");

		// insert
		var insertBtnContainer = $("<div class='menu-insert-btn-top c-action-bar b-btn-group'></div>");
		insertBtn.appendTo(insertBtnContainer);
		insertBtnContainer.appendTo(newCol);
		$(".page-header > div:nth-child(1)").after($(newCol));

		// adjust table title max width
		$('.table-title').parent().addClass("table-title-min");
		insertBtnContainer.parent().css("margin-left", "-.7rem");

		insertBtnContainer.addClass("menu-insert-btn-top-hidden");
		if ($(window).scrollTop() + $(window).height() <= $(document).height() - 50)
			insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
	}

	$(window).scroll(function () {
		ToggleMenuStickyHeader(nav, header, breadcrumbs, threshold_el);
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	});

	$(window).resize(function () {
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	})
</script>
}

@section code_javascript {
	@codeJavascript()
}
