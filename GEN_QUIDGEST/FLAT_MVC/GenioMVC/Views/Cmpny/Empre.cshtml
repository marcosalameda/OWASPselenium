@helper form_content_alert(){
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_footer() {



			if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
			{

				if(Model.FormMode == FormMode.New && Convert.ToBoolean(Request.QueryString.Get("repeatInsertion")))
				{
				<button type="button" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" data-modal-form="true" data-modal-repeat-insertion="true" name="@(Helpers.FormModeActionName("Empre", Model.FormMode))" data-modal-url='@Url.Action(Helpers.FormModeActionName("Empre", Model.FormMode).ToString())' qbutton="ok_new"><i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
				}
				<button type="button" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" data-modal-form="true" name="@(Helpers.FormModeActionName("Empre", Model.FormMode))" data-modal-url='@Url.Action(Helpers.FormModeActionName("Empre", Model.FormMode).ToString(), "Cmpny")' qbutton="ok">
				@if(Model.FormMode == FormMode.Delete)
				{
					<i class="glyphicons glyphicons-glyphicons-check e-icon" aria-hidden="true"></i>
					@Resources.CONFIRMAR09808
				}
				else
				{
					<i class="SaveIcon e-icon" aria-hidden="true"></i>
					@Resources.SAVE04165
				}
				</button>
			}
		   <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-modal-close="true" data-modal-form="true" data-modal-cancel="true" data-modal-url='@Url.Action("Empre_Cancel")' qbutton="cancel"><i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428</button>
}

