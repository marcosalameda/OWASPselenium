		<div elem-identifier="AccordionHeading" class="c-accordion__panel-header" >
			<a elem-identifier="AccordionToggle" href="#" class="b-btn b-btn--link c-accordion__panel-title" role="button" data-toggle="collapse"  
				data-target="#ABATEREQ_COLLAPSEI" data-zone-type="ZC"
				label-id="IFF_ABATEREQPSEUDCOLLAPSE"
				>
				<span  help-id="IFF_ABATEREQPSEUDCOLLAPSE"/>	
