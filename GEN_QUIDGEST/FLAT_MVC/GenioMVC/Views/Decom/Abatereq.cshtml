						<div class="row-line-group" id="CONTAINER_IFF_ABATEREQPSEUDABATETAB">
								<div id="Abatereq_Tabs">
									@{ Html.RenderPartial("~/Views/Decom/Abatereq_Tabs.cshtml"); }
								</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCoddeco, new { @pers_cs_field="ValCoddeco", @pers_cs_area="Decom", data_refresh = "true", @form_area="true", @data_value = Model.ValCoddeco, @data_identifier = "LED_ABATEREQDECOMCODDECO_" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Abatereq" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Abatereq" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Abatereq" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
