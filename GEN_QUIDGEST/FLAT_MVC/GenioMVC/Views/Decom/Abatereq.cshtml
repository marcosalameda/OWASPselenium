								@Html.LabelFor(model => model.ValDecomnr, new { label_id="LED_ABATEREQDECOMDECOMNR_", @class = " i-text__label", id="LABEL_LED_ABATEREQDECOMDECOMNR_"}, true, true)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ABATEREQDECOMDECOMNR_','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.NumberFor(model => model.ValDecomnr, new {help_id = "LED_ABATEREQDECOMDECOMNR_", @class = "Number text-right i-text__field i-text input-small", data_identifier = "LED_ABATEREQDECOMDECOMNR_", @pers_cs_area = "Decom", @pers_cs_field = "ValDecomnr", @db_field = "ValDecomnr", title = @Resources.NUMBER35625, data_number_integer = "10", data_number_decimals = "0", data_number_format = "9999999999" })
								@Html.ValidationMessageFor(model => model.ValDecomnr)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_ABATEREQPSEUDCOLLAPSE">
<div id="ABATEREQ_COLLAPSE" elem-identifier="AccordionGroup" class="c-accordion accordion-group " data-identifier="IFF_ABATEREQPSEUDCOLLAPSE">
	
