													@Html.TextAreaFor(model => model.ValNote, 3, 30, new {help_id = "LED_ABATEREQDECOMNOTE____", @class = "i-textarea__field i-textarea input-large", data_identifier = "LED_ABATEREQDECOMNOTE____", @pers_cs_area = "Decom", @pers_cs_field = "ValNote", @db_field = "ValNote", title = @Resources.NOTES05274 })
