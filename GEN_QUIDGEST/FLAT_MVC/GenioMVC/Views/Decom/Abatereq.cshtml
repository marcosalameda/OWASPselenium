@model GenioMVC.ViewModels.Decom.Abatereq_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Abatereq";
	ViewBag.Title = @Resources.OBRIGATORIO46267;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Decom", FormMethod.Post, new { @class = "form-horizontal", area="Decom", data_form="Abatereq" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Abatereq" area="Decom" data-form="Abatereq">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Abatereq_well" area="Decom" data-form="Abatereq">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

