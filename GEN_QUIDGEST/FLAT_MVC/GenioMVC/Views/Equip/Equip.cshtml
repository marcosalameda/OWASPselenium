@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Equip";
	ViewBag.Title = string.Format(@Resources._EQUIP__REGISTNR____25672, this.Model.ValRegistnr,this.Model.ValDesignat,this.Model.TableTpequTipoequi);
	Model.Navigation.CurrentLevel.redefineLocName(ViewBag.Title);
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Equip", FormMethod.Post, new { @class = "form-horizontal", area="Equip", data_form="Equip" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Equip" area="Equip" data-form="Equip">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Equip_well" area="Equip" data-form="Equip">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

