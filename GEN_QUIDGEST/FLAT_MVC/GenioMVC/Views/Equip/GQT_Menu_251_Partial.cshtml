@model GenioMVC.ViewModels.Equip.GQT_Menu_251_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Equip;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Equip>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodequip, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_EQUIP_REGISTNR]/
		column.Expression(p => p.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("ValRegistnr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_EQUIP_DESIGNAT]/
		column.Expression(p => p.ValDesignat).Title(@Resources.EQUIPMENT03632).Field("ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_EQUIP_PHOTOGRA]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValPhotogra, new {alt=@Resources.PHOTO51874,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodequip, modelname = "Equip", fldname = "ValPhotogra" }))).Title(@Resources.PHOTO51874).Field("ValPhotogra").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_ROOM1_ROOMNR]/
		column.Expression(p => p.Room1.ValRoomnr).Title(@Resources.N_R__ROOM43805).Field("Room1.ValRoomnr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_TPEQU_TIPOEQUI]/
		column.Expression(p => p.Tpequ.ValTipoequi).Title(@Resources.TYPE_OF_EQUIPMENT18080).Hidden().Field("Tpequ.ValTipoequi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_WAREH_WAREHDES]/
		column.Expression(p => p.Wareh.ValWarehdes).Title(@Resources.WAREHOUSE51864).Hidden().Field("Wareh.ValWarehdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_251_ITEM_ITEMDES]/
		column.Expression(p => p.Item.ValItemdes).Title(@Resources.ARTICLE60065).Hidden().Field("Item.ValItemdes").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Equip")
        .Id("GQT_Menu_251")
        .AjaxRequest("GQT_Menu_251_Container")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Equip", false, false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_251, #GQT_Menu_251_complex_filter th input, #GQT_Menu_251_filters input").change(function() {
                    $("#pGQT_Menu_251").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_251_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_251_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_251_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_251']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_251');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_251_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_251').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_251', 'EQUIP', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                    $(document).trigger('GQT_Menu_251_FirstTabInit');


                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_251]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_251]/
</script>