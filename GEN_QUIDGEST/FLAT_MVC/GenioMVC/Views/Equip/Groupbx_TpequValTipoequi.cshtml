@model GenioMVC.ViewModels.Equip.Groupbx_TpequValTipoequi_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.TYPES_OF_EQUIPMENT61264</h2>
        </div>
        <div class="col-auto normal-view" id="Groupbx_TpequValTipoequi_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qGroupbx_TpequValTipoequi", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Groupbx_TpequValTipoequi.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Groupbx_TpequValTipoequi_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Groupbx_TpequValTipoequi_complex_filter', 'Groupbx_TpequValTipoequi_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
        <div class="col-auto">
            <div class="b-btn-group" id="viewMode">
                <button type="button" class="active b-btn b-icon b-icon--secondary" id="normal_view"><i class="glyphicons glyphicons-list e-icon"></i></button>
                <button type="button" class="b-btn b-icon b-icon--secondary" id="tree_view"><i class="glyphicons glyphicons-tree-structure e-icon"></i></button>
            </div>
        </div>
    </div>
</div>

<div class="normal-view">
@using GenioMVC.ViewModels.Tpequ;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Tpequ>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodtpequ, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GROUPBX_TIPOEQUI_TPEQU_TPEQUCOD]/
		column.Expression(p => p.ValTpequcod).Title(@Resources.CODE49225).Field("ValTpequcod").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN GROUPBX_TIPOEQUI_TPEQU_TIPOEQUI]/
		column.Expression(p => p.ValTipoequi).Title(@Resources.TYPE_OF_EQUIPMENT18080).Field("ValTipoequi").Size(50);
// USE /[MANUAL GQT CUSTOM_COLUMN GROUPBX_TIPOEQUI_TPEQU_TPEQUPAI]/
		column.Expression(p => p.ValTpequpai).Title(@Resources.DEPENDENT_ON28321).Hidden().Field("ValTpequpai").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN GROUPBX_TIPOEQUI_TPEQU_NIVEL]/
		column.Expression(p => p.ValNivel).Title(@Resources.LEVEL06184).Hidden().Field("ValNivel").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GROUPBX_TIPOEQUI_TPEQU_BACKCOLO]/
		column.Expression(p => p.ValBackcolo).Title(@Resources.BACKGROUND_COLOR47883).Hidden().Field("ValBackcolo").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GROUPBX_TIPOEQUI_TPEQU_CORLETRA]/
		column.Expression(p => p.ValCorletra).Title(@Resources.LETTER_COLOR15736).Hidden().Field("ValCorletra").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValTipoequi).Field("ValTipoequi").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Tpequ")
        .Id("Groupbx_TpequValTipoequi")
        .AjaxRequest("Groupbx_TpequValTipoequi")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Groupbx_TpequValTipoequi", new { id = Model.ValCodequip, partialView = "Groupbx_TpequValTipoequi"}))
        .Filters(this.Model.Menu.Filters)
        .BackgroundColourOnCondition(p => p.ValZzstate != 0 ? "" : ((CSGenio.business.GlobalFunctions.emptyC((p.ValBackcolo))==1)?("RGB(255,255,255)"):((p.ValBackcolo))))
        .ForegroundColourOnCondition(p => p.ValZzstate != 0 ? "" : ((CSGenio.business.GlobalFunctions.emptyC((p.ValCorletra))==1)?("RGB(0,0,0)"):((p.ValCorletra))))
        .Form("Tpequ", false, false, new { data_skip_prevalida = "true" })
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()
</div>
<div class="c-modal__body n-treeview" id="qSeeMoreTree_body" style="display:none;"></div>
<script>
    try {
        if (jQuery) {
            try {
                $("#viewMode.btn-group > .btn").click(function(){
                    $(".btn-group > .btn").removeClass("active");
                    $(this).addClass("active");
                });
                $("#tree_view", $("#viewMode.b-btn-group")).click(function(){
                    var modal = $(this).closest('#modal-dbedit');
                    var treeBody = $("#qSeeMoreTree_body", modal);
                    $(".normal-view", modal).hide(); treeBody.show();
                    if(!treeBody.data('tree')) {
                        $("#qSeeMoreTree_body", modal).treeSeeMoreFor($('[data-identifier="IFF_GROUPBX_TPEQUTIPOEQUI"]'));
                    }
                });
                $("#normal_view", $("#viewMode.b-btn-group")).click(function(){
                    var modal = $(this).closest('#modal-dbedit');
                    var treeBody = $("#qSeeMoreTree_body", modal);
                    treeBody.hide(); $(".normal-view", modal).show();
                    if(treeBody.data('tree')) {
                        // Force a reload - some filters might be active on tree-view but not in normal-view
                        window.Groupbx_TpequValTipoequi.Search();
                    }

                });
                $("#qGroupbx_TpequValTipoequi, #TableTpequTipoequi_complex_filter th input").change(function() {
                    var context = $("#TableTpequTipoequi").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Groupbx_TpequValTipoequi table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_GROUPBX_TPEQUTIPOEQUI"]');

                    selectList.trigger("DBEditSetValue", key);

                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Groupbx_TpequValTipoequi_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Groupbx_TpequValTipoequi_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Groupbx_TpequValTipoequi_extra').prop("disabled", true);
</text>
}


// USE /[MANUAL GQT LISTING_JS GROUPBX_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>