@model GenioMVC.ViewModels.Equip.STY_Menu_TABLE_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Equip;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Equip>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: true)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodequip, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_CMPNY_DESIGNAT]/
		column.Expression(p => p.Cmpny.ValDesignat).Title(@Resources.DESIGNATION35876).Field("Cmpny.ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_SEQUENNR]/
		column.Expression(p => p.ValSequennr).Title(@Resources.SEQUENTIAL_NO_38590).Field("ValSequennr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_REGISTNR]/
		column.Expression(p => p.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("ValRegistnr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_WAREH_WAREHDES]/
		column.Expression(p => p.Wareh.ValWarehdes).Title(@Resources.WAREHOUSE51864).Field("Wareh.ValWarehdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_ITEM_ITEMDES]/
		column.Expression(p => p.Item.ValItemdes).Title(@Resources.ITEM40802).Field("Item.ValItemdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_DTAQUISI]/
		column.Expression(p => p.ValDtaquisi).Title(@Resources.ACQUISITION44180).Field("ValDtaquisi").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_IFABATIF]/
		column.Expression(p => p.ValIfabatif).Title(@Resources.DOWNED_EQUIPMENT43331).Field("ValIfabatif").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_PHOTOGRA]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValPhotogra, new {alt=@Resources.PHOTO51874,}, Url.Action("ImageHandlerGet", "Home", new { ticket = Helpers.GetFileTicket(UserContext.Current.User, "Equip", "ValPhotogra", "", p.ValCodequip, null) }))).Title(@Resources.PHOTO51874).Field("ValPhotogra").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_VALORTOT]/
		column.Expression(p => p.ValValortot).Title(@Resources.TOTAL_VALUE30570).Field("ValValortot").Size(12);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_FREQUENC]/
		column.Expression(p => p.ArrayValfrequenc).Title(@Resources.LOAN_FREQUENCY00701).Field("ValFrequenc", "ArrayFreqempr").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_BOUGHT]/
		column.Expression(p => p.ValBought).Title(@Resources.BOUGHT32044).Field("ValBought").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_ROOM1_ROOMNR]/
		column.Expression(p => p.Room1.ValRoomnr).Title(@Resources.N_R__ROOM43805).Field("Room1.ValRoomnr").Size(10).BackgroundColourOnCondition(p => p.ValZzstate != 0 ? "" : "RGB(220,220,220)");
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TABLE_EQUIP_SITEFABR]/
		column.Expression(p => p.ValSitefabr).Title(@Resources.MANUFACTURER_S_WEBSI11084).Field("ValSitefabr").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Equip")
        .Id("STY_Menu_TABLE")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Equip", false, false)
        .SetFollowUp("Equip_Show", "Equip" , (Func<GenioMVC.Models.Equip, object>)(item => new { id = item.ValCodequip }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_TABLE, #STY_Menu_TABLE_complex_filter th input, #STY_Menu_TABLE_filters input").change(function() {
                    $("#pSTY_Menu_TABLE").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_TABLE_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_TABLE_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_TABLE_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_TABLE']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_TABLE');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_TABLE_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_TABLE').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_TABLE', 'EQUIP', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_TABLE]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS STY_MENU_TABLE]/
</script>