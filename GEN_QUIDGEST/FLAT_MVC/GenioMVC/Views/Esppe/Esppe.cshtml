@model GenioMVC.ViewModels.Esppe.Esppe_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Esppe";
	ViewBag.Title = @Resources.PERSON_SPECIALTY62734;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Esppe", FormMethod.Post, new { @class = "form-horizontal", area="Esppe", data_form="Esppe" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Esppe" area="Esppe" data-form="Esppe">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Esppe_well" area="Esppe" data-form="Esppe">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_ESPPE___PESSONAME____">
								<div class="d-flex">
								@Html.LabelFor(model => model.TablePessoName, new { label_id="IFF_ESPPE___PESSONAME____", @class = " i-text__label", id="LABEL_IFF_ESPPE___PESSONAME____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_ESPPE___PESSONAME____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodpesso, Model.TablePessoName.List , "", new {help_id = "IFF_ESPPE___PESSONAME____", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_ESPPE___PESSONAME____", @pers_cs_area = "Pesso", @pers_cs_field = "ValCodpesso", @db_field = "ValCodpesso", @db_full_field_name = "esppe.codpesso", data_has_more = Model.TablePessoName.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TablePessoName.Selected, data_dbedit_value = Model.TablePessoName.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodesppe, @data_see_more = "Esppe_PessoValName", title = @Resources.NAME31974, data_see_more_url = @Url.Action("Esppe_PessoValName","Esppe"), data_is_dbedit = "true", data_fields = "pesso.codpesso,pesso.name", data_main_field = "Pesso.ValName", data_elements = 0, data_filled_by_history = Model.TablePessoName.FilledByHistory, @dependant_fields = "pesso.codpesso,pesso.name" })
								@Html.ValidationMessageFor(model => model.TablePessoName)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_ESPPE___SPECIESPECIAL">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableSpeciEspecial, new { label_id="IFF_ESPPE___SPECIESPECIAL", @class = " i-text__label", id="LABEL_IFF_ESPPE___SPECIESPECIAL"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_ESPPE___SPECIESPECIAL','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodespec, Model.TableSpeciEspecial.List , "", new {help_id = "IFF_ESPPE___SPECIESPECIAL", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_ESPPE___SPECIESPECIAL", @pers_cs_area = "Speci", @pers_cs_field = "ValCodespec", @db_field = "ValCodespec", @db_full_field_name = "esppe.codespec", data_has_more = Model.TableSpeciEspecial.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableSpeciEspecial.Selected, data_dbedit_value = Model.TableSpeciEspecial.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodesppe, @data_see_more = "Esppe_SpeciValEspecial", title = @Resources.SPECIALTY09304, data_see_more_url = @Url.Action("Esppe_SpeciValEspecial","Esppe"), data_is_dbedit = "true", data_fields = "speci.codespec,speci.especial", data_main_field = "Speci.ValEspecial", data_elements = 0, data_filled_by_history = Model.TableSpeciEspecial.FilledByHistory, @dependant_fields = "speci.codespec,speci.especial" })
								@Html.ValidationMessageFor(model => model.TableSpeciEspecial)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodesppe, new { @pers_cs_field="ValCodesppe", @pers_cs_area="Esppe", data_refresh = "true", @form_area="true", @data_value = Model.ValCodesppe, @data_identifier = "LED_ESPPE___ESPPECODESPPE" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Esppe" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Esppe" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Esppe" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Esppe", Model.FormMode).ToString(), "Esppe"))", "Esppe_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.INSERT30329
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Esppe_Delete", "Esppe", new {id = @Model.ValCodesppe} )", "Esppe_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Esppe_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Esppe_Delete", "Esppe", new {id = @Model.ValCodesppe} )", "Esppe_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Esppe_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitEsppe(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Esppe", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteEsppe(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Esppe", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitEsppe(event)" title="@Resources.INSERT30329" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.INSERT30329
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Esppe_Cancel", "Esppe", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Esppe.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Esppe_Cancel","Esppe","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Esppe">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Esppe" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Esppe">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT ESPPE]/ *@

