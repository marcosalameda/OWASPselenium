		@* Formula of the 'ValFimperio' field *@
		$(qForm).bind('VALUNTILMAN_CHANGE VALUNTIL_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValUntilman', $('[data-form="Evcat"]'))))==0, getFieldValue($(':not([elem-identifier="Multiform"]) > #ValUntilman', $('[data-form="Evcat"]'))), getFieldValue($(':not([elem-identifier="Multiform"]) > #ValUntil', $('[data-form="Evcat"]')))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValFimperio', $('[data-form="Evcat"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValFimperio', $('[data-form="Evcat"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValFimperio', $('[data-form="Evcat"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValFimperio: ' + err.message, err.stack, window.location.href); }
		});
		





	</text>
}

