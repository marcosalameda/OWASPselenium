	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Expen", FormMethod.Post, new { @class = "form-horizontal", area="Expen", data_form="Despe" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Despe" area="Expen" data-form="Despe">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Despe_well" area="Expen" data-form="Despe">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

