@model GenioMVC.ViewModels.Fami1.Fami1_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Fami1";
	ViewBag.Title = @Resources.FAMILIA_DE_EQUIPAMEN28756;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Fami1", FormMethod.Post, new { @class = "form-horizontal", area="Fami1", data_form="Fami1" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Fami1" area="Fami1" data-form="Fami1">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Fami1_well" area="Fami1" data-form="Fami1">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_FAMI1___FAMI1FAMILY__">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValFamily, new { label_id="LED_FAMI1___FAMI1FAMILY__", @class = " i-text__label", id="LABEL_LED_FAMI1___FAMI1FAMILY__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_FAMI1___FAMI1FAMILY__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValFamily, new {help_id = "LED_FAMI1___FAMI1FAMILY__", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_FAMI1___FAMI1FAMILY__", @pers_cs_area = "Fami1", @pers_cs_field = "ValFamily", @db_field = "ValFamily", title = @Resources.EQUIPMENT_FAMILY41883, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValFamily)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_FAMI1___PSEUDTIPOSEQU">
								<div id="Fami1_ValTiposequ" data-identifier="IFF_FAMI1___PSEUDTIPOSEQU"  data-extra-options="" > 
									@{ Html.RenderAction("Fami1_ValTiposequ", "Fami1", new { id = Model.ValCodfamil, partialView = "Fami1_ValTiposequ"}); }
								</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_FAMI1___PSEUDTIPOSEQ1">
								<div class="d-inline-flex">
								@Html.LabelFor(model => model.ValTiposeq1, new { label_id="IFF_FAMI1___PSEUDTIPOSEQ1", @class = " i-text__label table-title f-header__title", id="LABEL_IFF_FAMI1___PSEUDTIPOSEQ1"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_FAMI1___PSEUDTIPOSEQ1','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								<div id="Fami1_ValTiposeq1" data-identifier="IFF_FAMI1___PSEUDTIPOSEQ1"  data-extra-options="" > 
									@{ Html.RenderAction("Fami1_ValTiposeq1", "Fami1", new { id = Model.ValCodfamil, partialView = "Fami1_ValTiposeq1"}); }
								</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodfamil, new { @pers_cs_field="ValCodfamil", @pers_cs_area="Fami1", data_refresh = "true", @form_area="true", @data_value = Model.ValCodfamil, @data_identifier = "LED_FAMI1___FAMI1CODFAMIL" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Fami1" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Fami1" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Fami1" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Fami1", Model.FormMode).ToString(), "Fami1")", "Fami1_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Fami1_Delete", "Fami1", new {id = @Model.ValCodfamil} )", "Fami1_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Fami1_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Fami1_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFami1(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Fami1", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteFami1(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Fami1", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFami1(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Fami1_Cancel", "Fami1", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Fami1.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Fami1_Cancel","Fami1","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Fami1">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Fami1" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Fami1">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT FAMI1]/ *@

