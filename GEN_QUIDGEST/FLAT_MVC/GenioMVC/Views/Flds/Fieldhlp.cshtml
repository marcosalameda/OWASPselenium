    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Flds", FormMethod.Post, new { enctype="multipart/form-data", @class = "form-horizontal", area="Flds", data_form="Fieldhlp" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Fieldhlp" area="Flds" data-form="Fieldhlp">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Fieldhlp_well" area="Flds" data-form="Fieldhlp">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

