@model GenioMVC.ViewModels.Flds.Infields_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Infields";
	ViewBag.Title = @Resources.INPUT_FIELDS51344;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Flds", FormMethod.Post, new { @class = "form-horizontal", area="Flds", data_form="Infields" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Infields" area="Flds" data-form="Infields">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Infields_well" area="Flds" data-form="Infields">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

