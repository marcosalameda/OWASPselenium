@model GenioMVC.ViewModels.People_ValPeoplels_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR PEOPLE_PEOPLELS]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Pesso>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodpesso, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PEOPLE_PEOPLELS_PESSO_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PEOPLE_PEOPLELS_PESSO_PHOTOGRA]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValPhotogra, new {alt=@Resources.PHOTO51874,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodpesso, modelname = "Pesso", fldname = "ValPhotogra" }))).Title(@Resources.PHOTO51874).Field("ValPhotogra").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN PEOPLE_PEOPLELS_PESSO_GENDER]/
		column.Expression(p => p.ArrayValgender).Title(@Resources.GENUS37471).Field("ValGender", "ArrayGenero").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN PEOPLE_PEOPLELS_PESSO_EMAIL]/
		column.Expression(p => p.ValEmail).Title(@Resources.EMAIL25170).Field("ValEmail").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Pesso")
        .Id("ValPeoplels")
        .AjaxRequest("People_ValPeoplels")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("People_ValPeoplels", new { partialView = "People_ValPeoplels"}))
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValPeoplels, #ValPeoplels_complex_filter th input, #ValPeoplels_filters input").change(function() {
                    $("#pValPeoplels").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValPeoplels_tableFilters').val(false);")
                    @Html.Raw("$('#ValPeoplels_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValPeoplels_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValPeoplels_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValPeoplels_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValPeoplels').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValPeoplels']"));
                    InitSpecialControls($('#ValPeoplels'));
                    $('#ValPeoplels').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PEOPLE_VALPEOPLELS]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>