@model GenioMVC.ViewModels.Wid_grap_ValField001_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_WID_GRAPPSEUDFIELD001" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.COMPANY_S_PEOPLE_COU57461</h2 list-header> </label></div>
	</div>
	<div class="col-auto search">
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR WID_GRAP_FIELD001]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Cmpny>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodempre, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN WID_GRAP_FIELD001_CMPNY_DESIGNAT]/
		column.Expression(p => p.ValDesignat).Title(@Resources.COMPANY52963).Field("ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WID_GRAP_FIELD001_CMPNY_QTDPESSO]/
		column.Expression(p => p.ValQtdpesso).Title(@Resources.NUMBER_OF_PEOPLE08859).Field("ValQtdpesso").Size(10);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Cmpny")
        .Id("ValField001")
        .AjaxRequest("Wid_grap_ValField001")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Wid_grap_ValField001", new { partialView = "Wid_grap_ValField001"}))
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
    var chart = data
        .ToSpecialRendering()
		.SetSpecialRendering(this.Model.ViewModesCfg.SpecialRenderings.FirstOrDefault(sr => sr.Id == "CHART"))
        .RequestLink(@Url.Action("Wid_grap_ValField001", new { partialView = "Wid_grap_ValField001"}))
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@{ renderings.Clear(); }
@{ renderings.Add(Model.GetViewModePosition("CHART"), chart.ToSpecialRenderingHtml(hidden: Model.IsViewModeHidden("CHART"))); }

@{ renderings.Add(2, @tbl.ToHtml(hidden: true)); }

@foreach (var render in renderings.ToList().OrderBy(r => r.Key))
{
    @Html.Raw(render.Value.ToHtmlString());
}

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValField001, #ValField001_complex_filter th input, #ValField001_filters input").change(function() {
                    $("#pValField001").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValField001_tableFilters').val(false);")
                    @Html.Raw("$('#ValField001_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValField001_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValField001_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValField001_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValField001').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValField001']"));
                    InitSpecialControls($('#ValField001'));
                    $('#ValField001').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS WID_GRAP_VALFIELD001]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>