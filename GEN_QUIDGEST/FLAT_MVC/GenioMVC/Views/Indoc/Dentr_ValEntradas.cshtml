@model GenioMVC.ViewModels.Indoc.Dentr_ValEntradas_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_DENTR___PSEUDENTRADAS" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.ENTRIES32319</h2 list-header> </label></div>
	</div>
	<div class="col-auto search">
	<div id="ValEntradas_simple_filter">
		<div class="i-input-group input-xxlarge">
			@Html.TextBox("qValEntradas", Model.Menu.Query, new { @class="i-input-group__field ", @onkeydown = "ListSearchEnter(event)", @style="height: inherit" } )
			<div class="i-input-group--right">
				<button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" elem-identifier="ListSearchButton" onclick="window.ValEntradas.Search();"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
				<button id="ValEntradas_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#ValEntradas_complex_filter', 'ValEntradas_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
			</div>
		</div>
	</div>
	</div>
	<div class="col-auto"  style="padding: 0; padding-right: 15px">
		<div class="b-btn-group">
			@Html.ExportListMenu("ValEntradas")
			<button id="order_ValEntradas" class="b-btn b-icon b-icon--secondary" type="button" title="@Resources.REORDENAR52758" @if(!Model.IsEditableMode){ <text>disabled</text> }><i class="glyphicons glyphicons-move e-icon @if(!Model.IsEditableMode){ <text>disabled</text> }"></i></button>
		</div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR DENTR_ENTRADAS]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Ldent;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Ldent>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodldent, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN DENTR_ENTRADAS_LDENT_LINE]/
		column.Expression(p => p.ValLine).Title(@Resources.LINE27983).Field("ValLine").Size(5);
// USE /[MANUAL GQT CUSTOM_COLUMN DENTR_ENTRADAS_WAREH_WAREHDES]/
		column.Expression(p => p.Wareh.ValWarehdes).Title(@Resources.WAREHOUSE51864).Field("Wareh.ValWarehdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN DENTR_ENTRADAS_ITEM_ITEMDES]/
		column.Expression(p => p.Item.ValItemdes).Title(@Resources.ARTICLE60065).Field("Item.ValItemdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN DENTR_ENTRADAS_LDENT_QTDENTRA]/
		column.Expression(p => p.ValQtdentra).Title(@Resources.QTD_ENTRY35144).Field("ValQtdentra").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN DENTR_ENTRADAS_LDENT_DHENTRA]/
		column.Expression(p => p.ValDhentra).Title(@Resources.INSTANT_ENTRANCE27379).Field("ValDhentra").Size(16);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Ldent")
        .Id("ValEntradas")
        .AjaxRequest("Dentr_ValEntradas")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Dentr_ValEntradas", new { id = Model.ValCoddentr, partialView = "Dentr_ValEntradas"}))
        .Filters(this.Model.Menu.Filters)
        .Form("Ldent", true, true)
        .AddTableAction(Model.IsEditableMode ? "Ldentnor_Edit" : "Ldentnor_Show", "Ldent" , (Func<GenioMVC.Models.Ldent, object>)(item => new { id = item.ValCodldent }), "", @Resources.NORMAL_FORM03650, isRoutine: false, isAjaxAction: false, openInPopup: false, isBootStrapIcon: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
        .MultipleSelection()
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {
	var link = '@Url.Action("ReorderDentr_ValEntradas", "Indoc")';
	OrderTable("ValEntradas", link, "#CONTAINER_IFF_DENTR___PSEUDENTRADAS", "#order_ValEntradas");

    try {
        if (jQuery) {
            try {
                $("#qValEntradas, #ValEntradas_complex_filter th input, #ValEntradas_filters input").change(function() {
                    $("#pValEntradas").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValEntradas_tableFilters').val(false);")
                    @Html.Raw("$('#ValEntradas_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValEntradas_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValEntradas_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValEntradas_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValEntradas').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValEntradas']"));
                    InitSpecialControls($('#ValEntradas'));
                    $('#ValEntradas').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS DENTR_VALENTRADAS]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>