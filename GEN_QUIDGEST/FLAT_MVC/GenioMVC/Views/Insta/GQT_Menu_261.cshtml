@model GenioMVC.ViewModels.Insta.GQT_Menu_261_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Insta.GQT_Menu_261_ViewModel modelGQT_Menu_261 = new GenioMVC.ViewModels.Insta.GQT_Menu_261_ViewModel(Navigation);
	var columns = modelGQT_Menu_261.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "insta" && areaField.Field == "since")
		{
			fields.Add("INSTA.SINCE", new TableFilterField("INSTA", "SINCE", Resources.SINCE47259, "date", defaultSearch : true));
		}
		if (areaField.Area == "insta" && areaField.Field == "until")
		{
			fields.Add("INSTA.UNTIL", new TableFilterField("INSTA", "UNTIL", Resources.UNTIL39173, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "designat")
		{
			fields.Add("EQUIP.DESIGNAT", new TableFilterField("EQUIP", "DESIGNAT", Resources.EQUIPMENT03632, "text"));
		}
		if (areaField.Area == "tpequ" && areaField.Field == "tipoequi")
		{
			fields.Add("TPEQU.TIPOEQUI", new TableFilterField("TPEQU", "TIPOEQUI", Resources.TYPE00312, "text"));
		}
		if (areaField.Area == "insta" && areaField.Field == "hours")
		{
			fields.Add("INSTA.HOURS", new TableFilterField("INSTA", "HOURS", Resources.QTD_HOURS28684, "num"));
		}
		if (areaField.Area == "insta" && areaField.Field == "precohor")
		{
			fields.Add("INSTA.PRECOHOR", new TableFilterField("INSTA", "PRECOHOR", Resources.HOURLY_PRICE48005, "num"));
		}
		if (areaField.Area == "insta" && areaField.Field == "value")
		{
			fields.Add("INSTA.VALUE", new TableFilterField("INSTA", "VALUE", Resources.VALUE10285, "num"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_261", "Insta", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Insta", data_form="GQT_Menu_261" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_261_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_261", Navigation.GetStrValue("qGQT_Menu_261"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_261');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_261');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.SINCE47259})
					<button id="qGQT_Menu_261-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_261", fields, "INSTA")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_261', 'INSTA', 'INSTA.SINCE');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_261_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_261_complex_filter', 'GQT_Menu_261_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_261")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_261" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_261", idlistController = "Insta", idlistArea = "Insta", codlista ="0655f0e5-8a64-4786-911e-9b4ece9f7ac0" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_261_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_261" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_261 = new QMenuForm($('[data-form="GQT_Menu_261"]'), "Form_GQT_Menu_261");
		window.Form_GQT_Menu_261.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_261.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_261");
		RegisterClearEvents("GQT_Menu_261")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("GQT_Menu_261", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_261"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_261"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
