@model GenioMVC.ViewModels.Insta.Insta_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Insta";
	ViewBag.Title = @Resources.INSTALLATION12952;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Insta", FormMethod.Post, new { @class = "form-horizontal", area="Insta", data_form="Insta" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Insta" area="Insta" data-form="Insta">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Insta_well" area="Insta" data-form="Insta">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

