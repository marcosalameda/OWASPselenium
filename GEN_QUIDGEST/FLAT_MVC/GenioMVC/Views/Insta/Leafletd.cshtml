                        </span>
                        <div data-parent-form="Leafletd" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Leafletd">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
