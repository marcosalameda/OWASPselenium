@model GenioMVC.ViewModels.Item.Artig_ValContacor_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List" data-toggle="tooltip" help-id="IFF_ARTIG___PSEUDCONTACOR" data-placement="top" title="@Resources._112319369" description="@Resources._1123_VERBOSE50467"  style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.MOVEMENTS47007</h2 list-header> </label></div>
	</div>
	<div class="col-auto search">
	<div id="ValContacor_simple_filter">
		<div class="i-input-group input-xxlarge">
			@Html.TextBox("qValContacor", Model.Menu.Query, new { @class="i-input-group__field ", @onkeydown = "ListSearchEnter(event)", @style="height: inherit" } )
			<div class="i-input-group--right">
				<button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" elem-identifier="ListSearchButton" onclick="window.ValContacor.Search();"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
				<button id="ValContacor_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#ValContacor_complex_filter', 'ValContacor_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
			</div>
		</div>
	</div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR ARTIG_CONTACOR]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Ccorr>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodccorr, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_CONTACOR_CCORR_NORDER]/
		column.Expression(p => p.ValNorder).Title(@Resources.ORDER39632).Field("ValNorder").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_CONTACOR_CCORR_DATE]/
		column.Expression(p => p.ValDate).Title(@Resources.INSTANT35907).Field("ValDate").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_CONTACOR_CCORR_TYPE]/
		column.Expression(p => p.ValType).Title(@Resources.TYPE00312).Field("ValType").Size(8);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_CONTACOR_CCORR_REFERENC]/
		column.Expression(p => p.ValReferenc).Title(@Resources.REF_A30225).Field("ValReferenc").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_CONTACOR_CCORR_QNTY]/
		column.Expression(p => p.ValQnty).Title(@Resources.AMOUNT46885).Field("ValQnty").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_CONTACOR_CCORR_BALANCE]/
		column.Expression(p => p.ValBalance).Title(@Resources.BALANCE13297).Field("ValBalance").Size(10);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Ccorr")
        .Id("ValContacor")
        .AjaxRequest("Artig_ValContacor")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Artig_ValContacor", new { id = Model.ValCoditem, partialView = "Artig_ValContacor"}))
        .Filters(this.Model.Menu.Filters)
        .BackgroundColourOnCondition(p => p.ValZzstate != 0 ? "" : (((p.ValType)=="Entrada")?("RGB(207,255,158)"):((((p.ValType)=="Saída")?("RGB(255,190,158)"):("RGB(255,255,255)")))))
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValContacor, #ValContacor_complex_filter th input, #ValContacor_filters input").change(function() {
                    $("#pValContacor").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValContacor_tableFilters').val(false);")
                    @Html.Raw("$('#ValContacor_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValContacor_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValContacor_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValContacor_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValContacor').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValContacor']"));
                    InitSpecialControls($('#ValContacor'));
                    $('#ValContacor').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS ARTIG_VALCONTACOR]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>