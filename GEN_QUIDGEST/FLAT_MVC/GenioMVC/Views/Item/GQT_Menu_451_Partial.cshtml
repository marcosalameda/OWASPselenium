@model GenioMVC.ViewModels.Item.GQT_Menu_451_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Item;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Item>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoditem, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_ITEMDES]/
		column.Expression(p => p.ValItemdes).Title(@Resources.ARTICLE60065).Field("ValItemdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_ITEMCOD]/
		column.Expression(p => p.ValItemcod).Title(@Resources.CODE49225).Field("ValItemcod").Size(15);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_ENTRIES]/
		column.Expression(p => p.ValEntries).Title(@Resources.ENTRIES32319).Field("ValEntries").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_EXITS]/
		column.Expression(p => p.ValExits).Title(@Resources.OUTPUTS47833).Field("ValExits").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_EXISTENC]/
		column.Expression(p => p.ValExistenc).Title(@Resources.STOCKS47349).Field("ValExistenc").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_GITEM_ITEMDES]/
		column.Expression(p => p.Gitem.ValItemdes).Title(@Resources.GLOBAL_ARTICLE63861).Field("Gitem.ValItemdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_WAREH_WAREHDES]/
		column.Expression(p => p.Wareh.ValWarehdes).Title(@Resources.WAREHOUSE51864).Field("Wareh.ValWarehdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_IMAGE]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValImage, new {alt=@Resources.IMAGE65174,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCoditem, modelname = "Item", fldname = "ValImage" }))).Title(@Resources.IMAGE65174).Field("ValImage").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_451_ITEM_CATEGORY]/
		column.Expression(p => p.ValCategory).Title(@Resources.CATEGORIZATION17554).Field("ValCategory").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Item")
        .Id("GQT_Menu_451")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Artig", false, true)
        .SetFollowUp("Artig_Show", "Item" , (Func<GenioMVC.Models.Item, object>)(item => new { id = item.ValCoditem }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_451, #GQT_Menu_451_complex_filter th input, #GQT_Menu_451_filters input").change(function() {
                    $("#pGQT_Menu_451").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_451_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_451_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_451_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_451']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_451');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_451_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_451').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_451', 'ARTIG', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_451]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_451]/
</script>