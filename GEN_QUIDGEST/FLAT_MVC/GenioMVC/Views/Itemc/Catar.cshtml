@model GenioMVC.ViewModels.Itemc.Catar_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Catar";
	ViewBag.Title = @Resources.ARTICLE_CATEGORIZATI07119;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Itemc", FormMethod.Post, new { @class = "form-horizontal", area="Itemc", data_form="Catar" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Catar" area="Itemc" data-form="Catar">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Catar_well" area="Itemc" data-form="Catar">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_CATAR___ITEM_ITEMDES_">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableItemItemdes, new { label_id="IFF_CATAR___ITEM_ITEMDES_", @class = " i-text__label", id="LABEL_IFF_CATAR___ITEM_ITEMDES_"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_CATAR___ITEM_ITEMDES_','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCoditem, Model.TableItemItemdes.List , "", new {help_id = "IFF_CATAR___ITEM_ITEMDES_", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_CATAR___ITEM_ITEMDES_", @pers_cs_area = "Item", @pers_cs_field = "ValCoditem", @db_field = "ValCoditem", @db_full_field_name = "itemc.coditem", data_has_more = Model.TableItemItemdes.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableItemItemdes.Selected, data_dbedit_value = Model.TableItemItemdes.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodcatar, @data_see_more = "Catar_ItemValItemdes", title = @Resources.ITEM_31041, data_see_more_url = @Url.Action("Catar_ItemValItemdes","Itemc"), data_is_dbedit = "true", data_support_form = @Url.Action("ARTIG_New", "ITEM"), data_fields = "item.coditem,item.itemdes", data_main_field = "Item.ValItemdes", data_elements = 0, data_filled_by_history = Model.TableItemItemdes.FilledByHistory, @dependant_fields = "item.coditem,item.itemdes" })
								@Html.ValidationMessageFor(model => model.TableItemItemdes)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_CATAR___CATTPTPCATEGO">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableCattpTpcatego, new { label_id="IFF_CATAR___CATTPTPCATEGO", @class = " i-text__label", id="LABEL_IFF_CATAR___CATTPTPCATEGO"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_CATAR___CATTPTPCATEGO','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodtpcat, Model.TableCattpTpcatego.List , "", new {help_id = "IFF_CATAR___CATTPTPCATEGO", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_CATAR___CATTPTPCATEGO", @pers_cs_area = "Cattp", @pers_cs_field = "ValCodtpcat", @db_field = "ValCodtpcat", @db_full_field_name = "itemc.codtpcat", data_has_more = Model.TableCattpTpcatego.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableCattpTpcatego.Selected, data_dbedit_value = Model.TableCattpTpcatego.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodcatar, @data_see_more = "Catar_CattpValTpcatego", title = @Resources.CATEGORY_TYPE23058, data_see_more_url = @Url.Action("Catar_CattpValTpcatego","Itemc"), data_is_dbedit = "true", data_support_form = @Url.Action("TPCAT_New", "CATTP"), data_fields = "cattp.codtpcat,cattp.tpcatego", data_main_field = "Cattp.ValTpcatego", data_elements = 0, data_filled_by_history = Model.TableCattpTpcatego.FilledByHistory, @dependant_fields = "cattp.codtpcat,cattp.tpcatego" })
								@Html.ValidationMessageFor(model => model.TableCattpTpcatego)
							</div>
						</div>
					</div>
				</div>
			</div>


		@Html.HiddenFor(model=> model.ValTpcateg, new { @pers_cs_area = "Itemc", @pers_cs_field = "ValTpcateg", @data_identifier = "LED_CATAR___ITEMCTPCATEG_" })


			@Html.HiddenFor(model => model.ValCodcatar, new { @pers_cs_field="ValCodcatar", @pers_cs_area="Itemc", data_refresh = "true", @form_area="true", @data_value = Model.ValCodcatar, @data_identifier = "LED_CATAR___ITEMCCODCATAR" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Catar" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Catar" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Catar" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Catar", Model.FormMode).ToString(), "Itemc")", "Catar_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Catar_Delete", "Itemc", new {id = @Model.ValCodcatar} )", "Catar_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Catar_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Catar_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitCatar(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Catar", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteCatar(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Catar", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitCatar(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Catar_Cancel", "Itemc", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Catar.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Catar_Cancel","Itemc","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Catar">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Catar" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Catar">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT CATAR]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_CATAR" data-form-javascript="true">
@Html.Partial("Catar_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
