@model GenioMVC.ViewModels.Notif.GQT_Menu_81_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Notif.GQT_Menu_81_ViewModel modelGQT_Menu_81 = new GenioMVC.ViewModels.Notif.GQT_Menu_81_ViewModel(Navigation);
	var columns = modelGQT_Menu_81.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "notif" && areaField.Field == "nrcomoda")
		{
			fields.Add("NOTIF.NRCOMODA", new TableFilterField("NOTIF", "NRCOMODA", Resources.NO__OF_THE_DADATO35934, "num", defaultSearch : true));
		}
		if (areaField.Area == "notif" && areaField.Field == "begin")
		{
			fields.Add("NOTIF.BEGIN", new TableFilterField("NOTIF", "BEGIN", Resources.BEGINNING18124, "date"));
		}
		if (areaField.Area == "notif" && areaField.Field == "end")
		{
			fields.Add("NOTIF.END", new TableFilterField("NOTIF", "END", Resources.END47577, "date"));
		}
		if (areaField.Area == "notif" && areaField.Field == "email")
		{
			fields.Add("NOTIF.EMAIL", new TableFilterField("NOTIF", "EMAIL", Resources.RECIPIENT_S_EMAIL43894, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "idnotif")
		{
			fields.Add("NOTIF.IDNOTIF", new TableFilterField("NOTIF", "IDNOTIF", Resources.NOTIFICATION_ID_THAT61751, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "idmsg")
		{
			fields.Add("NOTIF.IDMSG", new TableFilterField("NOTIF", "IDMSG", Resources.MESSAGE_ID37133, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "message")
		{
			fields.Add("NOTIF.MESSAGE", new TableFilterField("NOTIF", "MESSAGE", Resources.TEXT_OF_THE_SENT_MES52307, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "mailerr")
		{
			fields.Add("NOTIF.MAILERR", new TableFilterField("NOTIF", "MAILERR", Resources.ERROR_SENDING_EMAIL53846, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "designat")
		{
			fields.Add("NOTIF.DESIGNAT", new TableFilterField("NOTIF", "DESIGNAT", Resources.RECIPIENT65165, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "creatdat")
		{
			fields.Add("NOTIF.CREATDAT", new TableFilterField("NOTIF", "CREATDAT", Resources.CREATION__DATE13180, "date"));
		}
		if (areaField.Area == "notif" && areaField.Field == "creatope")
		{
			fields.Add("NOTIF.CREATOPE", new TableFilterField("NOTIF", "CREATOPE", Resources.CREATION__OPERATOR50535, "text"));
		}
		if (areaField.Area == "notif" && areaField.Field == "returned")
		{
			fields.Add("NOTIF.RETURNED", new TableFilterField("NOTIF", "RETURNED", Resources.RETURNED01606, "bool"));
		}
		if (areaField.Area == "notif" && areaField.Field == "dtdevolu")
		{
			fields.Add("NOTIF.DTDEVOLU", new TableFilterField("NOTIF", "DTDEVOLU", Resources.RETURN32222, "date"));
		}
		if (areaField.Area == "pess2" && areaField.Field == "name")
		{
			fields.Add("PESS2.NAME", new TableFilterField("PESS2", "NAME", Resources.NAME31974, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_81", "Notif", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Notif", data_form="GQT_Menu_81" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_81_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_81", Navigation.GetStrValue("qGQT_Menu_81"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_81');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_81');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__OF_THE_DADATO35934})
					<button id="qGQT_Menu_81-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_81", fields, "NOTIF")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_81', 'NOTIF', 'NOTIF.NRCOMODA');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_81_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_81_complex_filter', 'GQT_Menu_81_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_81")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_81" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_81", idlistController = "Notif", idlistArea = "Notif", codlista ="8a24817a-f3db-4158-821e-86bf9df25ea0" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_81_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_81" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_81 = new QMenuForm($('[data-form="GQT_Menu_81"]'), "Form_GQT_Menu_81");
		window.Form_GQT_Menu_81.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_81.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_81");
		RegisterClearEvents("GQT_Menu_81")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("GQT_Menu_81", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_81"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_81"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
