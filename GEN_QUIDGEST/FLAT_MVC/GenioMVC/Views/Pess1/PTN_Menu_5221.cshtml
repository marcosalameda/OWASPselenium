@model GenioMVC.ViewModels.Pess1.PTN_Menu_5221_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Pess1.PTN_Menu_5221_ViewModel modelPTN_Menu_5221 = new GenioMVC.ViewModels.Pess1.PTN_Menu_5221_ViewModel(Navigation);
	var columns = modelPTN_Menu_5221.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrGenero = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayGenero.GetDictionary())
	{
		arrGenero.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "pess1" && areaField.Field == "name")
		{
			fields.Add("PESS1.NAME", new TableFilterField("PESS1", "NAME", Resources.NAME31974, "text", defaultSearch : true));
		}
		if (areaField.Area == "pess1" && areaField.Field == "gender")
		{
			fields.Add("PESS1.GENDER", new TableFilterField("PESS1", "GENDER", Resources.GENUS37471, "enum", array : arrGenero));
		}
		if (areaField.Area == "pess1" && areaField.Field == "dtnascim")
		{
			fields.Add("PESS1.DTNASCIM", new TableFilterField("PESS1", "DTNASCIM", Resources.BIRTH21799, "date"));
		}
		if (areaField.Area == "pess1" && areaField.Field == "idade")
		{
			fields.Add("PESS1.IDADE", new TableFilterField("PESS1", "IDADE", Resources.AGE28663, "num"));
		}
		if (areaField.Area == "pess1" && areaField.Field == "idfuncio")
		{
			fields.Add("PESS1.IDFUNCIO", new TableFilterField("PESS1", "IDFUNCIO", Resources.OFFICIAL_NO_34819, "num"));
		}
		if (areaField.Area == "pess1" && areaField.Field == "telephon")
		{
			fields.Add("PESS1.TELEPHON", new TableFilterField("PESS1", "TELEPHON", Resources.PHONE56703, "text"));
		}
		if (areaField.Area == "pess1" && areaField.Field == "email")
		{
			fields.Add("PESS1.EMAIL", new TableFilterField("PESS1", "EMAIL", Resources.EMAIL25170, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("PTN_Menu_5221", "Pess1", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Pess1", data_form="PTN_Menu_5221" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="PTN_Menu_5221_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qPTN_Menu_5221", Navigation.GetStrValue("qPTN_Menu_5221"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('PTN_Menu_5221');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('PTN_Menu_5221');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NAME31974})
					<button id="qPTN_Menu_5221-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("PTN_Menu_5221", fields, "PESS1")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('PTN_Menu_5221', 'PESS1', 'PESS1.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="PTN_Menu_5221_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#PTN_Menu_5221_complex_filter', 'PTN_Menu_5221_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("PTN_Menu_5221")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="PTN_Menu_5221" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "PTN_Menu_5221", idlistController = "Pess1", idlistArea = "Pess1", codlista ="40157e0a-8b62-4cb7-ab60-aac650c37731" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("PTN_Menu_5221_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "PTN_Menu_5221" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_PTN_Menu_5221 = new QMenuForm($('[data-form="PTN_Menu_5221"]'), "Form_PTN_Menu_5221");
		window.Form_PTN_Menu_5221.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_PTN_Menu_5221.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qPTN_Menu_5221");
		RegisterClearEvents("PTN_Menu_5221")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("PTN_Menu_5221", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="PTN_Menu_5221"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="PTN_Menu_5221"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
