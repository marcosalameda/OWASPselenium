@model GenioMVC.ViewModels.Pesso.GQT_Menu_271_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Pesso.GQT_Menu_271_ViewModel modelGQT_Menu_271 = new GenioMVC.ViewModels.Pesso.GQT_Menu_271_ViewModel(Navigation);
	var columns = modelGQT_Menu_271.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrGenero = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayGenero.GetDictionary())
	{
		arrGenero.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "pesso" && areaField.Field == "name")
		{
			fields.Add("PESSO.NAME", new TableFilterField("PESSO", "NAME", Resources.NAME31974, "text", defaultSearch : true));
		}
		if (areaField.Area == "pesso" && areaField.Field == "gender")
		{
			fields.Add("PESSO.GENDER", new TableFilterField("PESSO", "GENDER", Resources.GENUS37471, "enum", array : arrGenero));
		}
		if (areaField.Area == "pesso" && areaField.Field == "dtnascim")
		{
			fields.Add("PESSO.DTNASCIM", new TableFilterField("PESSO", "DTNASCIM", Resources.BIRTH21799, "date"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "telephon")
		{
			fields.Add("PESSO.TELEPHON", new TableFilterField("PESSO", "TELEPHON", Resources.PHONE56703, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "email")
		{
			fields.Add("PESSO.EMAIL", new TableFilterField("PESSO", "EMAIL", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "idfuncio")
		{
			fields.Add("PESSO.IDFUNCIO", new TableFilterField("PESSO", "IDFUNCIO", Resources.OFFICIAL_NO_34819, "num"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "dtultcat")
		{
			fields.Add("PESSO.DTULTCAT", new TableFilterField("PESSO", "DTULTCAT", Resources.SINCE47259, "date"));
		}
		if (areaField.Area == "categ" && areaField.Field == "category")
		{
			fields.Add("CATEG.CATEGORY", new TableFilterField("CATEG", "CATEGORY", Resources.CATEGORY18978, "text"));
		}
		if (areaField.Area == "cmpny" && areaField.Field == "designat")
		{
			fields.Add("CMPNY.DESIGNAT", new TableFilterField("CMPNY", "DESIGNAT", Resources.COMPANY52963, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_271", "Pesso", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Pesso", data_form="GQT_Menu_271" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_271_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_271", Navigation.GetStrValue("qGQT_Menu_271"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_271');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_271');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NAME31974})
					<button id="qGQT_Menu_271-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_271", fields, "PESSO")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_271', 'PESSO', 'PESSO.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@if (!Model.IsViewModeHidden("LIST"))
						{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_271_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_271_complex_filter', 'GQT_Menu_271_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_271")
					</div>
				</div>
			</div>
			@{
				var listBtnCssClass = Model.IsViewModeHidden("LIST") ? "b-icon--secondary" : "b-icon--primary";
				var alternativeViewBtnCssClass = Model.IsViewModeHidden("LIST") ? "b-icon--primary" : "b-icon--secondary";

				<div class="col-auto" style="padding: 0; padding-right: 15px">
					<div class="b-btn-group">
						<button class="b-btn b-icon @listBtnCssClass" type="button" onclick="window.GQT_Menu_271.ToggleViewMode('GQT_Menu_271', 'Pesso', 'Pesso', 'e6dc0e9f-d5c7-4b9c-87f7-f7ac16dffec8', 1)" title="@Resources.MUDAR_PARA_VISTA_EM_03626"><i class="glyphicons glyphicons-show-lines e-icon"></i></button>
						<button class="b-btn b-icon @alternativeViewBtnCssClass" type="button" onclick="window.GQT_Menu_271.ToggleViewMode('GQT_Menu_271', 'Pesso', 'Pesso', 'e6dc0e9f-d5c7-4b9c-87f7-f7ac16dffec8', 2)" title="@Resources.MUDAR_PARA_VISTA_ALT46064"><i class="glyphicons glyphicons-show-big-thumbnails e-icon"></i></button>
					</div>
				</div>
			}
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_271" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_271", idlistController = "Pesso", idlistArea = "Pesso", codlista ="e6dc0e9f-d5c7-4b9c-87f7-f7ac16dffec8" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_271_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_271" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_271 = new QMenuForm($('[data-form="GQT_Menu_271"]'), "Form_GQT_Menu_271");
		window.Form_GQT_Menu_271.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_271.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_271");
		RegisterClearEvents("GQT_Menu_271")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("GQT_Menu_271", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_271"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_271"]'));
	}

	function ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer) {
		if (bottomInsertBtn) {
			if ($(window).scrollTop() + $(window).height() > $(document).height() - 50)
				insertBtnContainer.addClass("menu-insert-btn-top-hidden");
			else
				insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
		}
	}

	var nav = $('#header-container > nav')[0];
	var header = $(".page-header");
	var threshold_el = $('.c-header').length ? $('.c-header') : $('nav').first();
	var breadcrumbs = $('#breadcrumbs').height() ? $('#breadcrumbs') : $('[aria-label=breadcrumb]');
	header.css('min-height', 50);

	// get the insert button
	var bottomInsertBtn = $('[qbutton=insert]')[0];

	if (bottomInsertBtn) {
		var insertBtn = $.clone($('[qbutton=insert]')[0]);
		insertBtn.innerHTML = insertBtn.innerHTML.replace(insertBtn.innerText, '');
		insertBtn = $(insertBtn);
		insertBtn.removeClass();
		insertBtn.addClass('b-btn b-icon b-icon--secondary');

		// find the page header
		var pageHeader = $('.page-header')[0];
		var newCol = $("<div class='col'></div>");

		// insert
		var insertBtnContainer = $("<div class='menu-insert-btn-top c-action-bar b-btn-group'></div>");
		insertBtn.appendTo(insertBtnContainer);
		insertBtnContainer.appendTo(newCol);
		$(".page-header > div:nth-child(1)").after($(newCol));

		// adjust table title max width
		$('.table-title').parent().addClass("table-title-min");
		insertBtnContainer.parent().css("margin-left", "-.7rem");

		insertBtnContainer.addClass("menu-insert-btn-top-hidden");
		if ($(window).scrollTop() + $(window).height() <= $(document).height() - 50)
			insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
	}

	$(window).scroll(function () {
		ToggleMenuStickyHeader(nav, header, breadcrumbs, threshold_el);
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	});

	$(window).resize(function () {
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	})
</script>
}

@section code_javascript {
	@codeJavascript()
}
