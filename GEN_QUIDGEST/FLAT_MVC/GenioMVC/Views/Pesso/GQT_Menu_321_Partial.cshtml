@model GenioMVC.ViewModels.Pesso.GQT_Menu_321_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Pesso;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Pesso>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodpesso, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(50);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_GENDER]/
		column.Expression(p => p.ArrayValgender).Title(@Resources.GENUS37471).Field("ValGender", "ArrayGenero").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_DTNASCIM]/
		column.Expression(p => p.ValDtnascim).Title(@Resources.BIRTH21799).Field("ValDtnascim").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_TELEPHON]/
		column.Expression(p => p.ValTelephon).Title(@Resources.PHONE56703).Field("ValTelephon").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_EMAIL]/
		column.Expression(p => p.ValEmail).Title(@Resources.EMAIL25170).Field("ValEmail").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_PHOTOGRA]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValPhotogra, new {alt=@Resources.PHOTO51874,}, Url.Action("ImageHandlerGet", "Home", new { ticket = Helpers.GetFileTicket(UserContext.Current.User, "Pesso", "ValPhotogra", "", p.ValCodpesso, null) }))).Title(@Resources.PHOTO51874).Field("ValPhotogra").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_PESSO_IDFUNCIO]/
		column.Expression(p => p.ValIdfuncio).Title(@Resources.OFFICIAL_NO_34819).Field("ValIdfuncio").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_321_CMPNY_DESIGNAT]/
		column.Expression(p => p.Cmpny.ValDesignat).Title(@Resources.COMPANY52963).Form("Empre_Show","Cmpny",p => p.Cmpny.ValCodempre, false, true).Field("Cmpny.ValDesignat").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Pesso")
        .Id("GQT_Menu_321")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Pesso", false, false)
        .UpdateConditions((item)=>Pesso_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Pesso_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Pesso_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Pesso_ViewModel.InsertConditions(this.Model.Navigation))
        .SetFollowUp("Pesso_Edit", "Pesso" , (Func<GenioMVC.Models.Pesso, object>)(item => new { id = item.ValCodpesso }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_321, #GQT_Menu_321_complex_filter th input, #GQT_Menu_321_filters input").change(function() {
                    $("#pGQT_Menu_321").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_321_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_321_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_321_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_321']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_321');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_321_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_321').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_321', 'PESSO', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_321]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_321]/
</script>