@model GenioMVC.ViewModels.Pesso.Pesso_Pais1ValCountry_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.COUNTRIES64527</h2>
        </div>
        <div class="col-auto normal-view" id="Pesso_Pais1ValCountry_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qPesso_Pais1ValCountry", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Pesso_Pais1ValCountry.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Pesso_Pais1ValCountry_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Pesso_Pais1ValCountry_complex_filter', 'Pesso_Pais1ValCountry_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="normal-view">
@{
    var data = Html.newTableFor<GenioMVC.Models.Pais1>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodcntry, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PESSO_COUNTRY_PAIS1_COUNTRY]/
		column.Expression(p => p.ValCountry).Title(@Resources.COUNTRY64133).Field("ValCountry").Size(90);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValCountry).Field("ValCountry").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Pais1")
        .Id("Pesso_Pais1ValCountry")
        .AjaxRequest("Pesso_Pais1ValCountry")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Pesso_Pais1ValCountry", new { id = Model.ValCodpesso, partialView = "Pesso_Pais1ValCountry"}))
        .Filters(this.Model.Menu.Filters)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()
</div>
<script>
    try {
        if (jQuery) {
            try {
                $("#qPesso_Pais1ValCountry, #TablePais1Country_complex_filter th input").change(function() {
                    var context = $("#TablePais1Country").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Pesso_Pais1ValCountry table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_PESSO___PAIS1COUNTRY_"]');

                    selectList.trigger("DBEditSetValue", key);

                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Pesso_Pais1ValCountry_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Pesso_Pais1ValCountry_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Pesso_Pais1ValCountry_extra').prop("disabled", true);
</text>
}


// USE /[MANUAL GQT LISTING_JS PESSO_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>