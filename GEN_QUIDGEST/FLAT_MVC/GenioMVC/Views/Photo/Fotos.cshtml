@model GenioMVC.ViewModels.Photo.Fotos_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Fotos";
	ViewBag.Title = @Resources.PHOTO51874;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Photo", FormMethod.Post, new { @class = "form-horizontal", area="Photo", data_form="Fotos" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Fotos" area="Photo" data-form="Fotos">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Fotos_well" area="Photo" data-form="Fotos">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_FOTOS___EQUIPREGISTNR">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableEquipRegistnr, new { label_id="IFF_FOTOS___EQUIPREGISTNR", @class = " i-text__label", id="LABEL_IFF_FOTOS___EQUIPREGISTNR"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_FOTOS___EQUIPREGISTNR','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodequip, Model.TableEquipRegistnr.List , "", new {help_id = "IFF_FOTOS___EQUIPREGISTNR", @class = "i-select chosen-dropdown input-medium", data_identifier = "IFF_FOTOS___EQUIPREGISTNR", @pers_cs_area = "Equip", @pers_cs_field = "ValCodequip", @db_field = "ValCodequip", @db_full_field_name = "photo.codequip", data_has_more = Model.TableEquipRegistnr.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableEquipRegistnr.Selected, data_dbedit_value = Model.TableEquipRegistnr.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodphoto, @data_see_more = "Fotos_EquipValRegistnr", title = @Resources.REGISTRATION_NO_06209, data_see_more_url = @Url.Action("Fotos_EquipValRegistnr","Photo"), data_is_dbedit = "true", data_fields = "equip.codequip,equip.registnr", data_main_field = "Equip.ValRegistnr", data_elements = 0, data_filled_by_history = Model.TableEquipRegistnr.FilledByHistory, @dependant_fields = "equip.codequip,equip.registnr" })
								@Html.ValidationMessageFor(model => model.TableEquipRegistnr)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-image draggable " id="CONTAINER_LED_FOTOS___PHOTOPHOTOGRA">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValPhotogra, new { label_id="LED_FOTOS___PHOTOPHOTOGRA", @class = " i-text__label", id="LABEL_LED_FOTOS___PHOTOPHOTOGRA"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_FOTOS___PHOTOPHOTOGRA','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								<div data-identifier="LED_FOTOS___PHOTOPHOTOGRA" pers-cs-area="Photo" pers-cs-field="ValPhotogra" class="image-control-wrapper" >
								@if(Model.IsEditableMode) {
									@Html.EditorFor(m => m.ValPhotogra, new {help_id = "LED_FOTOS___PHOTOPHOTOGRA", @class = "col-auto ", data_identifier = "LED_FOTOS___PHOTOPHOTOGRA", title = @Resources.PHOTO51874, guid = @Model.ValCodphoto, controller = "Photo", fldname = "ValPhotogra", identifier = "FFOTOS", style = "height: 47pt; display: inline-block;" })
								} else {
									@Html.DisplayFor(m => m.ValPhotogra, new {help_id = "LED_FOTOS___PHOTOPHOTOGRA", @class = "col-auto ", data_identifier = "LED_FOTOS___PHOTOPHOTOGRA", title = @Resources.PHOTO51874, guid = @Model.ValCodphoto, controller = "Photo", fldname = "ValPhotogra", identifier = "FFOTOS", style = "height: 47pt; display: inline-block;" })
								}
								</div>
								@Html.ValidationMessageFor(model => model.ValPhotogra)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_FOTOS___PHOTOTITLE___">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValTitle, new { label_id="LED_FOTOS___PHOTOTITLE___", @class = " i-text__label", id="LABEL_LED_FOTOS___PHOTOTITLE___"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_FOTOS___PHOTOTITLE___','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValTitle, new {help_id = "LED_FOTOS___PHOTOTITLE___", @class = "i-text__field i-text input-xxlarge", data_identifier = "LED_FOTOS___PHOTOTITLE___", @pers_cs_area = "Photo", @pers_cs_field = "ValTitle", @db_field = "ValTitle", title = @Resources.TITLE21885, maxlength = "85", rows = "85" })
								@Html.ValidationMessageFor(model => model.ValTitle)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-date-picker draggable " id="CONTAINER_LED_FOTOS___PHOTOANEXED__">
								<div class="d-inline-flex">
								@Html.LabelFor(model => model.ValAnexed, new { label_id="LED_FOTOS___PHOTOANEXED__", @class = " i-text__label", id="LABEL_LED_FOTOS___PHOTOANEXED__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_FOTOS___PHOTOANEXED__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DateFor(model => model.ValAnexed, new {help_id = "LED_FOTOS___PHOTOANEXED__", @class = "i-input-group__field b-icon-text input-medium", data_identifier = "LED_FOTOS___PHOTOANEXED__", @pers_cs_area = "Photo", @pers_cs_field = "ValAnexed", @db_field = "ValAnexed", title = @Resources.ATTACHED_64932 })
								@Html.ValidationMessageFor(model => model.ValAnexed)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodphoto, new { @pers_cs_field="ValCodphoto", @pers_cs_area="Photo", data_refresh = "true", @form_area="true", @data_value = Model.ValCodphoto, @data_identifier = "LED_FOTOS___PHOTOCODPHOTO" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Fotos" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Fotos" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Fotos" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Fotos", Model.FormMode).ToString(), "Photo")", "Fotos_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Fotos_Delete", "Photo", new {id = @Model.ValCodphoto} )", "Fotos_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Fotos_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Fotos_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFotos(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Fotos", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteFotos(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Fotos", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFotos(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Fotos_Cancel", "Photo", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Fotos.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Fotos_Cancel","Photo","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Fotos">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Fotos" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Fotos">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

