@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Proprall";
	ViewBag.Title = @Resources.PROPERTY43977;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Propr", FormMethod.Post, new { @class = "form-horizontal", area="Propr", data_form="Proprall" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Proprall" area="Propr" data-form="Proprall">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Proprall_well" area="Propr" data-form="Proprall">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

