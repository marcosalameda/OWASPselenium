@model GenioMVC.ViewModels.Pwcom.GQT_Menu_711_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Pwcom.GQT_Menu_711_ViewModel modelGQT_Menu_711 = new GenioMVC.ViewModels.Pwcom.GQT_Menu_711_ViewModel(Navigation);
	var columns = modelGQT_Menu_711.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "psw" && areaField.Field == "nome")
		{
			fields.Add("PSW.NOME", new TableFilterField("PSW", "NOME", Resources.LOGIN48703, "text"));
		}
		if (areaField.Area == "pess1" && areaField.Field == "name")
		{
			fields.Add("PESS1.NAME", new TableFilterField("PESS1", "NAME", Resources.NAME31974, "text"));
		}
		if (areaField.Area == "pwcom" && areaField.Field == "nridenti")
		{
			fields.Add("PWCOM.NRIDENTI", new TableFilterField("PWCOM", "NRIDENTI", Resources.IDENTIFICATION37731, "num"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_711", "Pwcom", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Pwcom", data_form="GQT_Menu_711" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_711_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_711", Navigation.GetStrValue("qGQT_Menu_711"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_711');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_711');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.LOGIN48703})
					<button id="qGQT_Menu_711-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_711", fields, "PWCOM")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_711', 'PWCOM', 'PSW.NOME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_711_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_711_complex_filter', 'GQT_Menu_711_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_711")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_711" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_711", idlistController = "Pwcom", idlistArea = "Pwcom", codlista ="b84668d1-565f-459d-a7c5-24dcba182b3d" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_711_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_711" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_711 = new QMenuForm($('[data-form="GQT_Menu_711"]'), "Form_GQT_Menu_711");
		window.Form_GQT_Menu_711.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_711.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_711");
		RegisterClearEvents("GQT_Menu_711")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("GQT_Menu_711", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_711"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_711"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
