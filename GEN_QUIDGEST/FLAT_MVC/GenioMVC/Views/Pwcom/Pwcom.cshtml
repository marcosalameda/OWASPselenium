@model GenioMVC.ViewModels.Pwcom.Pwcom_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Pwcom";
	ViewBag.Title = @Resources.MOVING_ACCESS62712;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Pwcom", FormMethod.Post, new { @class = "form-horizontal", area="Pwcom", data_form="Pwcom" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Pwcom" area="Pwcom" data-form="Pwcom">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Pwcom_well" area="Pwcom" data-form="Pwcom">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

