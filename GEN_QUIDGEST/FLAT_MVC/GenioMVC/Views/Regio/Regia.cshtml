@model GenioMVC.ViewModels.Regio.Regia_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Regia";
	ViewBag.Title = @Resources.REGION12723;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Regio", FormMethod.Post, new { @class = "form-horizontal", area="Regio", data_form="Regia" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Regia" area="Regio" data-form="Regia">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Regia_well" area="Regio" data-form="Regia">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_REGIA___CNTRYCOUNTRY_">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableCntryCountry, new { label_id="IFF_REGIA___CNTRYCOUNTRY_", @class = " i-text__label", id="LABEL_IFF_REGIA___CNTRYCOUNTRY_"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_REGIA___CNTRYCOUNTRY_','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodcntry, Model.TableCntryCountry.List , "", new {help_id = "IFF_REGIA___CNTRYCOUNTRY_", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_REGIA___CNTRYCOUNTRY_", @pers_cs_area = "Cntry", @pers_cs_field = "ValCodcntry", @db_field = "ValCodcntry", @db_full_field_name = "regio.codcntry", data_has_more = Model.TableCntryCountry.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableCntryCountry.Selected, data_dbedit_value = Model.TableCntryCountry.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodregia, @data_see_more = "Regia_CntryValCountry", title = @Resources.COUNTRY64133, data_see_more_url = @Url.Action("Regia_CntryValCountry","Regio"), data_is_dbedit = "true", data_support_form = @Url.Action("PAIS_New", "CNTRY"), data_fields = "cntry.codcntry,cntry.country", data_main_field = "Cntry.ValCountry", data_elements = 0, data_filled_by_history = Model.TableCntryCountry.FilledByHistory, @dependant_fields = "cntry.codcntry,cntry.country" })
								@Html.ValidationMessageFor(model => model.TableCntryCountry)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_REGIA___REGIOREGIAO__">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValRegiao, new { label_id="LED_REGIA___REGIOREGIAO__", @class = " i-text__label", id="LABEL_LED_REGIA___REGIOREGIAO__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_REGIA___REGIOREGIAO__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValRegiao, new {help_id = "LED_REGIA___REGIOREGIAO__", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_REGIA___REGIOREGIAO__", @pers_cs_area = "Regio", @pers_cs_field = "ValRegiao", @db_field = "ValRegiao", title = @Resources.REGION12723, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValRegiao)
							</div>
						</div>
					</div>
				</div>
			</div>



			@Html.HiddenFor(model => model.ValCodpais1, new { @pers_cs_field="ValCodpais1", @pers_cs_area="Regio", @data_value = Model.ValCodpais1, @db_field="ValCodpais1", @trelate="Pais1", @tfrelate="Codcntry", @data_identifier="LED_REGIA___PAIS1CODCNTRY" })

			@Html.HiddenFor(model => model.ValCodregia, new { @pers_cs_field="ValCodregia", @pers_cs_area="Regio", data_refresh = "true", @form_area="true", @data_value = Model.ValCodregia, @data_identifier = "LED_REGIA___REGIOCODREGIA" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Regia" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Regia" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Regia" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Regia", Model.FormMode).ToString(), "Regio")", "Regia_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.GRAVAR45301
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Regia_Delete", "Regio", new {id = @Model.ValCodregia} )", "Regia_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Regia_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Regia_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitRegia(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Regia", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteRegia(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Regia", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitRegia(event)" title="@Resources.GRAVAR45301" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR45301
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Regia_Cancel", "Regio", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Regia.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Regia_Cancel","Regio","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Regia">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Regia" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Regia">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT REGIA]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_REGIA" data-form-javascript="true">
@Html.Partial("Regia_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
