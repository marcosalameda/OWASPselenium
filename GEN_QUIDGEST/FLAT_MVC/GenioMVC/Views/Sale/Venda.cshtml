@{
	ViewBag.Form = "Venda";
	ViewBag.Title = @Resources.SALE02786;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Sale", FormMethod.Post, new { @class = "form-horizontal", area="Sale", data_form="Venda" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Venda" area="Sale" data-form="Venda">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Venda_well" area="Sale" data-form="Venda">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

