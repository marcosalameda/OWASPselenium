@using System.Collections.Generic;
@using System.Globalization;
@{
    #region Properties

    // Common
    var containerId = (string)ViewData["container-id"];
    var subtype = (string)ViewData["subtype"];
    var rows = (List<Dictionary<string, object>>)ViewData["rows"];
    var style = (Dictionary<string, string>)ViewData["style-vars"];

    // Data (default values)
    var firstColor = "undefined";
    var chartColorArray = "Highcharts Default";
    var invertColorArray = "false";
    var xaxisType = "linear";
    var yaxisType = "linear";
    var graphTitle = "";
    var groupType = "join";
    var widthPercentage = "100";
    var showBreaks = "false";

    // Init configuration
    if (style.ContainsKey("first-color")) { firstColor = style["first-color"]; }
    if (style.ContainsKey("chart-color-array")) { chartColorArray = style["chart-color-array"]; }
    if (style.ContainsKey("invert-color-array")) { invertColorArray = style["invert-color-array"]; }
    if (style.ContainsKey("xaxis-type")) { xaxisType = style["xaxis-type"]; }
    if (style.ContainsKey("yaxis-type")) { yaxisType = style["yaxis-type"]; }
    if (style.ContainsKey("graph-title")) { graphTitle = style["graph-title"]; }
    if (style.ContainsKey("group-type")) { groupType = style["group-type"]; }
    if (style.ContainsKey("width-percentage")) { widthPercentage = style["width-percentage"]; }
    if (style.ContainsKey("show-breaks")) { showBreaks = style["show-breaks"]; }

    string color = "#058DC7";
    string[] colorArray = GetColorArray(chartColorArray);
    if (firstColor != null && firstColor != "undefined") { color = firstColor.Substring(firstColor.IndexOf("(") + 1, firstColor.IndexOf(")") - 1 - firstColor.IndexOf("(")); }
    if (!firstColor.Equals("undefined")) { colorArray[0] = firstColor; }
    if (invertColorArray != null) { if (invertColorArray.Equals("true")) { Array.Reverse(colorArray); } }

    // Series construction function (xAxis and yAxis as a Number, Date or Category):
    // secondary columns (columns that map auxiliary data to the x and y-axis)
    // at the moment only 3 columns exist but more can be added (for example, in column charts,
    // data can be grouped into stacks (for example, male and female if series correspond to people))
    // this new columns are treated the same way as these 3

    List<string> series = null;
    bool dynamicSeries = false;

    if (rows.Any())
    {
        var seriesSelector = rows
            .Where(row => row.ContainsKey("serie-selector"))
            .Select(r => (string)r["serie-selector"])
            .Distinct()
            .ToList();
            
        dynamicSeries = seriesSelector.Any();
            
        if (dynamicSeries)
        {
            // serie-selector has been defined
            // this means that only one mapping of the yAxis is expected
            // and the values will determine the series
            // => each distinct value is a series

            series = seriesSelector;
        }
        else
        {
            // The # of series is given by the number of mapped "yaxis" variables
            var yAxisList = rows
            .Where(row => row.ContainsKey("yaxis"))
            .Select(r => r["yaxis"]);

            var columnData = (List<string[]>)yAxisList.First();
            int depth = columnData.Count;

            series = new string[depth].ToList();
            for (int i = 0; i < columnData.Count; i++)
            {
                var column = columnData[i];
                series[i] = column[1];
            }
        }
    }
    else
    {
        series = new string[1].ToList();
    }

    // Find the distict values mapped to each series
    var distinctXAxis = rows.Select(r => r["xaxis"]).Distinct().ToList();
    var distinctYAxisAux = rows.Select(r => r["yaxis"]).Distinct().ToList();
    var distinctYAxis = new List<string>();
    foreach (List<string[]> row in distinctYAxisAux)
    {
        foreach (string[] yAxisData in row)
        {
            string yAxis = yAxisData[0];
            if (!distinctYAxis.Contains(yAxis))
            {
                distinctYAxis.Add(yAxis);
            }
        }
    }

    ViewData["allSeries"] = BuildData(series, rows, distinctXAxis, distinctYAxis, xaxisType, yaxisType, showBreaks, dynamicSeries);
    ViewData["colorArray"] = colorArray;
    ViewData["distinctXAxis"] = distinctXAxis;
    ViewData["distinctYAxis"] = distinctYAxis;

    #endregion
}

@functions {
    #region Functions

    // Process data and return the point to be mapped in the graph.
    // Given a data point, checks and saves it in the corresponding type (DateTime, Float, String).
    // Using Regex, if a special character is found then returns null and the point is not shown in the graph.
    Object axisData(string axisString)
    {
        Object point;
        DateTime date_out = new DateTime();
        float axisNumber = 0.0f;

        if (axisString == null) return null;

        //Regural expression to check for for special characters \!_@â?¬~#$%&*{}/:?><+<>?|
        System.Text.RegularExpressions.Regex rgx = new System.Text.RegularExpressions.Regex("[\\!_^@â?¬~#$%&*{}/:?><+<>?|\"]");

        //allows all styles
        if (float.TryParse(axisString, NumberStyles.Any, CultureInfo.CreateSpecificCulture("pt-PT"), out axisNumber) ||
        float.TryParse(axisString, out axisNumber))
        {
            point = axisNumber;
        }
        else if (DateTime.TryParseExact(axisString, "dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out date_out) ||
        DateTime.TryParseExact(axisString, "dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out date_out) ||
        DateTime.TryParseExact(axisString, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out date_out) ||
        DateTime.TryParse(axisString, out date_out))
        {
            DateTime oDate = DateTime.SpecifyKind(date_out, DateTimeKind.Utc);
            point = new DateTimeOffset(oDate).ToUnixTimeMilliseconds();
        }
        else if (rgx.IsMatch(axisString) || axisString.Equals(""))
        {
            point = null;
        }
        else
        {
            point = axisString;
        }

        return point;
    }

    string[] GetColorArray(string chartColorArray)
    {
        string[] colorArray;
        if (chartColorArray.Equals("Highcharts Default"))
        {
            colorArray = new[] { "#7cb5ec", "#434348", "#90ed7d", "#f7a35c", "#8085e9", "#f15c80", "#e4d354", "#2b908f", "#f45b5b", "#91e8e1" };
        }
        else if (chartColorArray.Equals("Highcharts Default 2"))
        {
            colorArray = new[] { "#4572A7", "#AA4643", "#89A54E", "#80699B", "#3D96AE", "#DB843D", "#92A8CD", "#A47D7C", "#B5CA92" };
        }
        else if (chartColorArray.Equals("Highcharts Default 3"))
        {
            colorArray = new[] { "#2f7ed8", "#0d233a", "#8bbc21", "#910000", "#1aadce", "#492970", "#f28f43", "#77a1e5", "#c42525", "#a6c96a" };
        }
        else if (chartColorArray.Equals("Monochrome Red"))
        {
            colorArray = new[] { "#ff9e79", "#fb6d4c", "#d6212e", "#c62121", "#8d0101", "#6b0101", "#580000" };
        }
        else if (chartColorArray.Equals("Monochrome Green"))
        {
            colorArray = new[] { "#12e772", "#358535", "#008001", "#006400", "#006b3c", "#00563f", "#013220" };
        }
        else if (chartColorArray.Equals("Monochrome Blue"))
        {
            colorArray = new[] { "#BBDFFA", "#97BAEC", "#6987D5", "#445BC1", "#2C43B8", "#1727AE", "#000667" };
        }
        else if (chartColorArray.Equals("Monochrome Grey"))
        {
            colorArray = new[] { "#DDDDDD", "#D1D1D1", "#BBBBBB", "#A6A6A6", "#868686", "#676767", "#251D1C" };
        }
        else if (chartColorArray.Equals("Opposites"))
        {
            colorArray = new[] { "#058DC7", "#50B432", "#ED561B", "#DDDF00", "#24CBE5", "#64E572", "#FF9655", "#FFF263", "#6AF9C4" };
        }
        else if (chartColorArray.Equals("Rainbow"))
        {
            colorArray = new[] { "#ff0000", "#ffa500", "#ffff00", "#008000", "#0000ff", "#4b0082", "#ee82ee" };
        }
        else { colorArray = new[] { "#058DC7" }; }

        return colorArray;
    }

    object BuildData(List<string> series, List<Dictionary<string, object>> rows,
        List<object> distinctXAxis, List<string> distinctYAxis, string xAxisType, 
        string yAxisType, string showBreaks, bool dynamicSeries)
    {
        if (!rows.Any()) return null;

        var result = new List<object>();
        for (int i = 0; i < series.Count; i++)
        {
            string serieColor = null;
            var data = new List<object>();

            for (int id = 0; id < rows.Count; id++)
            {
                var row = rows[id];

                var x = row.ContainsKey("xaxis") ? (string)row["xaxis"] : null;

                // If yAxisMapping is set to "dynamic",
                // only one mapping of the yAxis variable is expected
                // Otherwhise, if set to "static", use as many mappings as provided
                int pos = 0;
                if (!dynamicSeries) { pos = i; }

                var yData = row.ContainsKey("yaxis")
                    ? (string[])((List<string[]>)row["yaxis"]).ElementAt(pos)
                    : null;

                var y = (yData != null && yData.Length == 2) ? yData[0] : null;
                if (dynamicSeries && series[i] != (string)row["serie-selector"]) { continue; }

                var z = row.ContainsKey("zaxis") ? (string)row["zaxis"] : null;
                var color = row.ContainsKey("serie-color") ? (string)row["serie-color"] : null;

                if (serieColor == null)
                {
                    serieColor = color;
                }

                if (x != null && y != null)
                {
                    if (xAxisType == "category" && yAxisType == "category")
                    {
                        data.Add(new
                        {
                            x = distinctXAxis.IndexOf(x),
                            y = distinctYAxis.IndexOf(y),
                            z = axisData(z),
                            value = axisData(z),
                            color = color,
                            id = id
                        });
                    }
                    else if (xAxisType == "category")
                    {
                        data.Add(new
                        {
                            name = x,
                            x = distinctXAxis.IndexOf(x),
                            y = axisData(y),
                            z = axisData(z),
                            value = axisData(z),
                            color = color,
                            id = id
                        });
                    }
                    else if (yAxisType == "category")
                    {
                        data.Add(new
                        {
                            x = axisData(x),
                            y = distinctYAxis.IndexOf(y),
                            z = axisData(z),
                            value = axisData(z),
                            color = color,
                            id = id
                        });
                    }
                    else
                    {
                        data.Add(new
                        {
                            x = axisData(x),
                            y = axisData(y),
                            z = axisData(z),
                            value = axisData(z),
                            color = color,
                            id = id
                        });
                    }
                }
                else if (x != null && showBreaks == "true")
                {
                    data.Add(new
                    {
                        x = axisData(x),
                        y = (string)null,
                        z = axisData(z),
                        value = axisData(z),
                        color = color,
                        id = id
                    });
                }
            }

            // Sort by 'x' to ensure the graph is drawn correctly
            if (xAxisType != "category")
            {
                data = data
                .OrderBy(c => c.GetType().GetProperty("x").GetValue(c, null))
                .ToList();
            }

            result.Add(new
            {
                name = series[i],
                borderWidth = 1,
                color = serieColor,
                data = data
            }); ;
        }

        return result;
    }

    #endregion
}

