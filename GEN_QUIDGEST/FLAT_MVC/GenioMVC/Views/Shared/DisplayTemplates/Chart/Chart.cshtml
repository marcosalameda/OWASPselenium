<div id="@containerId" class="highcharts-container container-fluid">

    @{
        <script>
            //sets the width of the container
            $('#@containerId').parents('.row').first().css({ "width": @widthPercentage+"%" });
            //if title doesnt exists, centers table description to be used as a title
            if ('@graphTitle' === '')
                $('label[class="i-text__label table-title c-table__title"]').css({ "text-align": "center" });
            //maps the graphs in a Genio Zone
            //they can be put side by side or each in a row
            //lastly its applied a justify-content to occupy the rest of the space available
            if ($('#@containerId').parents('.c-groupbox').first().length > 0 && '@groupType' === "join") {
                $('#@containerId').parents('.form-flow').first().addClass('row');
                $('#@containerId').parents('.row').first().css({ "margin-right": "0px" });
                $('#@containerId').parents('.row').first().css({ "margin-left": "0px" });
                $('#@containerId').parents('.form-flow').first().css({ "justify-content": "space-between" });
            }
            //maps the graphs in a Genio Collapsible Zone
            //they can be put side by side or each in a row
            //lastly its applied a justify-content to occupy the rest of the space available
            if ($('#@containerId').parents('.c-accordion__panel').length > 0 && '@groupType' === "join") {
                $('#@containerId').parents('.c-accordion__panel-body').first().addClass('row');
                $('#@containerId').parents('.row').first().css({ "margin-right": "0px" });
                $('#@containerId').parents('.row').first().css({ "margin-left": "0px" });
                $('#@containerId').parents('.c-accordion__panel-body').first().css({ "justify-content": "space-between" });
            }

            //maps the graphs in a page
            //if groupType is join, puts graph inline with the only before it
            //if groupType is break, puts graph in its own line
            if ('@groupType' === "join") {
                $('#@containerId').parents('.row').first().css({ "display": "inline-flex" });
            }
        </script>

        //Check if table list has data to map and displays it.
        if (rows.Any())
        {
            Html.RenderPartial("~/Views/Shared/DisplayTemplates/Chart/" + subtype + ".cshtml", ViewData);
        }
        else
        {
            <script>
            
                // Shows a empty graph with "No data to display" in the center.
                const chart_@containerId = Highcharts.chart('@containerId', {
                    title: {
                        text: ''
                    },
                    series: [{
                        type: 'line',
                        name: 'Data',
                        data: []
                    }],
                    lang: {
                        noData: "No data to display"
                    },
                    noData: {
                        style: {
                            fontWeight: 'bold',
                            fontSize: '20px',
                            color: '#303030'
                        }
                    },
                    credits: {
                        enabled: false
                    }
                });

                if (!window["hc_instances"]) window["hc_instances"] = {}
                window["hc_instances"]['@containerId'] = chart_@containerId;
            </script>
        }
    }

</div>

<script type="text/javascript">
    //necessary to delete the highcharts.js script because in a webpage
    //there can only be one and for each graph, it makes a duplicate
    //solution found for the problem
    if (window.Highcharts) {
        window.Highcharts_4_1_9 = window.Highcharts; delete window.Highcharts;
    }
</script>
