@model GenioMVC.ViewModels.DocumsVersionsDBEdit_ViewModel
@using GenioMVC.Resources

@{
    ViewBag.Title = @Resources.VERSOES_DO_DOCUMENTO34166;
    bool isRequired = ViewData["isRequired"] == null ? false : Convert.ToBoolean(ViewData["isRequired"]);
}

<form>
    <fieldset>
        <legend class="form-header">@ViewBag.Title</legend>
        <div class="form-flow">
            <div class="row">
                @{ var style = !@Model.Menu.Filters.ShowTableFilters ? "" : "display: none"; }
                <div class="col-9 search" style="@style">
                    <div class="i-input-group" id="_DocumsVersionsDBEdit_simple_filter">
                        @Html.TextBox("q_DocumsVersionsDBEdit", Model.Menu.Query, new { @class = "i-input-group__field input-xxlarge" })
                        <div class="i-input-group--right">
                            <button type="button" class="b-icon--primary i-input-group__button--primary  listSearchButton" onclick="makeAjaxRequest('@Url.Action("GetDocumsVersionsDBEdit", new { ticket = Model.Ticket, isRequired })', '_DocumsVersionsDBEdit', 'DocumsVersionsDBEDit')">
                                <i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i>
                            </button>
                            <button id="DocumsVersionsDBEdit_extra" class="b-icon--primary i-input-group__button--primary" type="button" onclick="changeFilters('#_DocumsVersionsDBEdit_complex_filter', '_DocumsVersionsDBEdit_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198">
                                <span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="tbl_DocumsVersionsDBEdit">
                @{ var t = Html.newTableFor<GenioMVC.Models.Docums>(edit: true, canPage: true, canSort: true)
                     .Columns(column =>
                     {
                        column.Expression(p => p.ValCoddocums, true).Hidden();
                        column.Expression(p => p.ValVersao).Field("ValVersao").Title(@Resources.VERSAO61228).Size(10);
                        column.Expression(p => p.ValNome).Field("ValNome").Title(@Resources.DOCUMENTO60418).Size(40);
                        column.Expression(p => p.ValTamanho).Field("ValTamanho").Title(@Resources.BYTES25864).Size(10);
                        column.Expression(p => p.ValOpercria).Field("ValOpercria").Title(@Resources.AUTOR45670).Size(15);
                        column.Expression(p => p.ValDatacria).Field("ValDatacria").Title(@Resources.DATA_DE_CRIACAO16914).Size(15);
                     })
                     .Id("_DocumsVersionsDBEdit")
                     .AjaxRequest("_DocumsVersionsDBEdit")
                     .Sort(this.Model.Menu.Sort)
                     .Pager(this.Model.Menu.Pagination)
                     .DataSource(this.Model.Menu.Elements)
                     .TableList(hasFilters: true)
                     .RequestLink(Url.Action("GetDocumsVersionsDBEdit", new { ticket = Model.Ticket }))
                     .Filters(this.Model.Menu.Filters)
                     .AddTableAction("GetSpecificFile", Model.TableName, (Func<GenioMVC.Models.Docums, object>)(item => new { ticket = item.Ticket }), "", Resources.DESCARREGAR58418)
                     ;}
                @t.ToHtml()
            </div>
        </div>
        @Html.Hidden("ticket", this.Model.Ticket)
        @Html.Hidden("documid", this.Model.DocumId)
    </fieldset>
</form>

@{
    if (!this.Model.Onlyshow)
    {
        <div class="actions float-right">
            <button type="button" data-action="LastVersion" elem-identifier="DeleteVersion" class="b-icon-text b-icon-text--danger">@Resources.APAGAR_ULTIMA25492</button>
            <button type="button" data-action="Historic" elem-identifier="DeleteVersion" class="b-icon-text b-icon-text--danger">@Resources.APAGAR_HISTORICO26221</button>
        </div>
    }
}

<script>
    $('[elem-identifier="DeleteVersion"]').unbind('click').click(function (e) {
        var dbdocumentContainer = $("#@Model.FieldName" + "_file").closest('[elem-identifier="DocumContainer"]');
        dbdocumentContainer.data('dbdocument').deleteVersion($(this));
    })

	if (localStorage.getItem("blockcontrol") != null) {
		if (localStorage.getItem("blockcontrol") == "1") {
			$("#_DocumsVersionsDBEdit > div[class='form-actions']").hide();
		}
	}
</script>

@section code_javascript
{
}