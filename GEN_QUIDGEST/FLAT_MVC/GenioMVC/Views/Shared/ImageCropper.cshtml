@model GenioMVC.ViewModels.ImageCropper_ViewModel

<div class="form-horizontal" id="ImageCropper">
    <div class="c-modal__dialog c-modal--lg">
        <div class="c-modal__content">
            <div elem-identifier="ModalBody" class="c-modal__body">
                <div class="form-flow">
                    @form_content()
                </div>
            </div>
            <div class="c-modal__footer">
                <div class="actions">
                    <button type="button" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" onclick="SubmitImageCropper()">@Resources.GRAVAR45301</button>
                    <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-modal-close="true" onclick="CloseImageCropper()">@Resources.CANCELAR49513</button>
                </div>
            </div>
        </div>
    </div>
</div>

@helper form_content()
{
    @Html.ValidationSummary(false)
	
    <div class="alert c-alert c-alert-W" role="alert">
        <i class="glyphicons glyphicons-light-beacon c-alert__icon"></i>
        <a href="#" class="c-alert__dismissible" data-dismiss="alert" aria-label="close">
            <i class="glyphicons glyphicons-remove c-alert__icon"></i>
        </a>                
        <div class="c-alert__text">
            @Html.Raw(@Resources.ATENCAO__AO_GRAVAR_E10841)
        </div> 
    </div>
    <fieldset>
        <div class="container">
            <div class="row">
                <div class="docs-demo">
                    <div class="img-container">
                        <img id="inputImage" class="container" src="@Url.Action("ImageHandlerGet", new { ticket = Helpers.GetFileTicket(GenioMVC.Models.Navigation.UserContext.Current.User, Model.modelname, Model.fldname, "", Model.Key, null) })" alt="Picture">
                    </div>
                </div>
            </div>
            <div style="margin-top:8px">
                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.ZOOM_IN39873" title="@Resources.ZOOM_IN39873" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.zoom(0.1)">
                    <i class="glyphicons glyphicons-zoom-in" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.ZOOM_OUT31562" title="@Resources.ZOOM_OUT31562" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.zoom(-0.1)">
                    <i class="glyphicons glyphicons-zoom-out" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.MOVER_IMAGEM_PARA_A_24246" title="@Resources.MOVER_IMAGEM_PARA_A_24246" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.move(-10, 0)">
                    <i class="glyphicons glyphicons-arrow-left" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.MOVER_IMAGEM_PARA_A_35927" title="@Resources.MOVER_IMAGEM_PARA_A_35927" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.move(10, 0)">
                    <i class="glyphicons glyphicons-arrow-right" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.MOVER_IMAGEM_PARA_CI59923" title="@Resources.MOVER_IMAGEM_PARA_CI59923" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.move(0, -10)">
                    <i class="glyphicons glyphicons-arrow-up" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.MOVER_IMAGEM_PARA_BA49541" title="@Resources.MOVER_IMAGEM_PARA_BA49541" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.move(0, 10)">
                    <i class="glyphicons glyphicons-arrow-down" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.VIRAR_A_ESQUERDA33355" title="@Resources.VIRAR_A_ESQUERDA33355" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.rotate(-45)">
                    <i class="glyphicons glyphicons-rotate-left" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.VIRAR_A_DIREITA03453" title="@Resources.VIRAR_A_DIREITA03453" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.rotate(45)">
                    <i class="glyphicons glyphicons-rotate-right" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.VIRAR_NA_HORIZONTAL60231" title="@Resources.VIRAR_NA_HORIZONTAL60231" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.scaleX(-1)">
                    <i class="glyphicons glyphicons-resize-horizontal" aria-hidden="true" style="font-size:25px"></i>
                </button>

                <button style="cursor:pointer" type="button" data-end-pers="true" name="@Resources.VIRAR_NA_VERTICAL20218" title="@Resources.VIRAR_NA_VERTICAL20218" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="cropper.scaleY(-1)">
                    <i class="glyphicons glyphicons-resize-vertical" aria-hidden="true" style="font-size:25px"></i>
                </button>

            </div>
        </div>

    </fieldset>
}

<link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/stylesheets/ImageCropper/cropper.css")" />

@codeJavascript()

@helper codeJavascript()
{
    <script src="@Url.Content("~/Scripts/ImageCropper/cropper.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            const image = document.getElementById('inputImage');

            window.cropper = new Cropper(image, {
            });

            @*
				//to override this control just rebuild the cropper instance for example
				window.cropper = new Cropper(image, {
					cropBoxResizable: false,
					aspectRatio: 15 / 9,
				});
                https://github.com/fengyuanchen/cropperjs/blob/master/README.md#options
                https://github.com/fengyuanchen/cropperjs/blob/master/README.md
                https://www.cssscript.com/feature-rich-image-cropper-pure-javascript-cropper-js/
            *@
        })

        function CloseImageCropper() {
            var formModal = $('#ImageCropper-form-modal');
            $(formModal).html('');
            $(formModal).modal('hide');
        };

        function SubmitImageCropper() {

            $.ajax('@Url.Action("UploadImageCropper", "Home")', {
                method: 'POST',
                data: { FileData: cropper.getCroppedCanvas().toDataURL(), id: '@Model.Key', modelname: '@Model.modelname', fldname: '@Model.fldname', formIdentifier: '@Model.Identifier' },
                //processData: false,
                //contentType: false,
                success() {
                    CloseImageCropper();
                    window.Form_@{@Model.FormName}.Controls.@{@Model.FieldIdentifier}.UpdateSrc();
                },
                error() {
                    console.log('Upload error');
                },
            });
        }
    </script>
}

@section code_javascript {
    @codeJavascript()
}
@section include_stylesheets {
}