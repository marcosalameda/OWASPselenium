@model GenioMVC.ViewModels.Bookmarks.Bookmarks_ViewModel

<div data-identifier="bookmarks_container" class="n-sidebar__section bookmarks__container">
    <ul class="nav nav-pills nav-sidebar flex-column n-sidebar__nav bookmarks__container-ddlist" data-widget="treeview" role="menu" data-accordion="true">
        <li class="nav-item n-sidebar__nav-item has-treeview">
            <a class="nav-link n-sidebar__nav-link d-flex flex-row bookmarks__header" href="javascript:void(0)">
                <i class="glyphicons glyphicons-star nav-icon n-sidebar__icon e-icon"></i>
                <p>
                    @Resources.FAVORITOS12992
                    <i class="right glyphicons glyphicons-chevron-down"></i>
                </p>
            </a>
            <ul data-identifier="bookmarks__content" class="nav nav-treeview bookmarks__content">
                @foreach (var fav in @Model.Bookmarks)
                {
                    <li bookmark-id="@(fav.Codusrcfg)" class="nav-item n-sidebar__nav-item has-treeview bookmarks__item">
                        @if (fav.MenuEntryObj != null)
                        {
                            @Html.MenuAction(fav.MenuEntryObj, Url, fav.Module, formatLinkButton(fav).ToHtmlString(), new { @class = "bookmarks__btn--link", data_toggle = "tooltip", data_placement = "right", title = fav.Description, module = fav.Module })
                            <br />
                            <button class="b-btn b-btn--link bookmarks__btn--remove" onclick="QBookmarks.onClickRemoveBookmark(this)">
                                <i class="glyphicons glyphicons-remove e-icon"></i>
                                @Resources.REMOVER14367
                            </button>
                        }
                        else
                        {
                            <span class="bookmarks__text">@fav.Description</span>
                            <br />
                            <button class="b-btn b-btn--link bookmarks__btn--remove" onclick="QBookmarks.onClickRemoveBookmark(this)">
                                <i class="glyphicons glyphicons-remove e-icon"></i>
                                @Resources.REMOVER14367
                            </button>
                        }
                    </li>
                }
                <li class="nav-item n-sidebar__nav-item has-treeview bookmarks__item">
                    <button class="b-btn b-btn--link bookmarks__btn--add" onclick="QBookmarks.ActivateSelectionMode(this)">
                        <i class="glyphicons glyphicons-plus-sign e-icon"></i>
                        @Resources.ADICIONAR14072
                    </button>
                </li>
            </ul>
        </li>
    </ul>
    <script>
        if ($.SpecialMenus) {
            $.SpecialMenus();
        } else {
            $(document).ready(function () {
                $.SpecialMenus();
            });
        }
    </script>
</div>

@helper formatLinkButton(GenioMVC.ViewModels.Bookmarks.Bookmark_Menu_ViewModel fav)
{
    <span class="bookmarks__text">@Helpers.GetTextFromResources(fav.MenuEntryObj.Title)</span>
    <br />
    <span class="bookmarks__full-path">@fav.Description</span>
}
