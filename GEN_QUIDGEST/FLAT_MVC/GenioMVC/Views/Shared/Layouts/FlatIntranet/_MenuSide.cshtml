            <li class="nav-item c-header__item--sidebar">
                <span class="nav-link c-header__link--sidebar" data-widget="pushmenu" data-identifier="sidemenu_push_button"><i class="glyphicons glyphicons-menu-hamburger n-sidebar__toggler-icon"></i></span>
            </li>
            @if (CSGenio.framework.Configuration.QAEnvironment == 1)
            {
                <li class="nav-item c-header__item--sidebar">
                    <span class="nav-link c-header__link--sidebar betatesting">
                        <i class="glyphicons glyphicons-alert e-icon"></i> TESTING
                    </span>
                </li>
            }
        </ul>
        <ul class="navbar-nav ml-auto n-menu__aside">
    @if (!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
    {
		if (GenioMVC.Models.Navigation.UserContext.Current.User.Years.Count > 1)
        {
            <li class="nav-item dropdown n-DByear__item n-menu__aside-item">
                <a class="nav-link dropdown-toggle n-DByear__link n-menu__aside-link" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="glyphicons glyphicons-calendar n-menu__icon nav-icon n-sidebar__icon"></span>@GenioMVC.Models.Navigation.UserContext.Current.User.Year
                </a>
                <div class="dropdown-menu n-DByear__dropdown dropdown-menu-right n-module__dropdown" aria-labelledby="navbarDropdown" style="min-width: 7rem;">
                    <div class="c-card n-module__container">
                        @foreach (var year in GenioMVC.Models.Navigation.UserContext.Current.User.Years)
                        {
                        <a class="dropdown-item" style="text-align: center;" href="@Url.Action("Index", "Home", new { system = year })">@year</a>
                        }
                    </div>
                </div>
            </li>
        }
            @Html.Partial("_UserAvatar")
	}
	else
	{
		<li class="dropdown_login">
            <a class="dropdown-toggle b-icon-text b-icon-text--primary" data-toggle="dropdown" href="#">
				<i class="glyphicons glyphicons-log-in e-icon"></i>
				@Resources.ENTRAR16118
			</a>
            <div class="dropdown-menu dropdown-menu-right c-user__dropdown" aria-labelledby="dropdownMenuButton" style="padding: 15px; padding: 0px;">
                <div class="c-card c-card--text-center">
                    <div class="c-card__body">
                        @{ Html.RenderAction("LogOnPartial", "Account", new { }); }
                    </div>
                </div>
            </div>
        </li>
	}

        </ul>
    </nav>

    <aside class="main-sidebar @menuBackgroundColor n-menu--sidebar">
        <div class="n-sidebar__brand">
            @if (GenioMVC.LayoutConfig.config.menuBrand.Equals(GenioMVC.MenuBrand.Image))
            {
                <a href="@Url.Action("Index", "Home")">
                    <img src="@Url.Content("~/Content/img/Q_icon.png")" alt="Quidgest" class="n-sidebar__img">
                </a>
                <img src="@Url.Content("~/Content/img/logotipo_header.png")" alt="Quidgest" class="brand-image">
            }
            else
            {
                <a href="@Url.Action("Index", "Home")">
                    <img src="@Url.Content("~/Content/img/Q_icon.png")" alt="Quidgest" class="n-sidebar__img">
				    <span class="brand-text n-sidebar__brand-text">@Resources.STYLES28487</span>
			    </a>
            }
        </div>
        @*<div class="n-sidebar__panel">
            <div class="c-header__user-id text-right">
                @Html.Partial("_LogOnPartial")
            </div>
        </div>*@

        <div class="sidebar n-sidebar" data-identifier="sidemenu_container">
            <!-- Sidebar modules -->
            @*<div class="mt-3 pb-3 d-flex n-sidebar__module">
                <div class="n-sidebar__module-img">
                    @Html.Partial("_Modules")
                </div>
            </div>*@

            <!-- Sidebar Menu -->
            <nav class="mt-2">
@if (GenioMVC.LayoutConfig.config.MenuSearchEnable)
{
                @SearchBox()
}
@if (GenioMVC.LayoutConfig.config.BookmarkEnable)
{
                @Bookmarks()
}
@if (moduleCount > 1)
{
                <div class="n-sidebar__section">
@if (GenioMVC.LayoutConfig.config.modulesStyle.Equals(GenioMVC.ModulesStyle.list))
{
                    <span id="modulesTitle" class="n-sidebar__title d-flex">
                        <i class="glyphicons glyphicons-show-thumbnails nav-icon n-sidebar__icon e-icon"></i>
                        <span>@Resources.MODULOS17298</span>
                    </span>
}
                    @Html.Partial("_Modules")
                </div>
}
                <div class="n-sidebar__section">
@if (GenioMVC.LayoutConfig.config.modulesStyle.Equals(GenioMVC.ModulesStyle.list) && moduleCount > 1)
{
                    <span id="moduleItemsTitle" class="n-sidebar__title d-flex" data-identifier="sidemenu_push_button">
                        <i class="glyphicons glyphicons-menu-hamburger nav-icon n-sidebar__icon e-icon"></i>
                        <span>@Resources.ITENS_DO_MODULO58305</span>
                    </span>
}
else if(GenioMVC.LayoutConfig.config.modulesStyle.Equals(GenioMVC.ModulesStyle.collapsible) && moduleCount > 1)
{
                    <span class="n-sidebar__active-module n-sidebar__title d-flex" style="text-transform:unset" data-identifier="sidemenu_push_button">
                        <i class="@classIcon nav-icon n-sidebar__icon e-icon"></i>
                        <span>@Helpers.GetTextFromResources(moduleTitle)</span>
                    </span>
}
                    <ul class="nav nav-pills nav-sidebar flex-column n-sidebar__nav" data-widget="treeview" role="menu" data-accordion="true">
                        @{
                            int x = 0;
                            foreach (GenioMVC.Helpers.Menus.MenuEntry menu in Model.MenuList)
                            {
                                @ShowSubItems(@menu, @Model.CurrentModule, x, true)
                            }
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </aside>
}

@{
    if (GenioMVC.LayoutConfig.config.headerPlacement.Equals(GenioMVC.HeaderPlacement.in_menuPanel))
    {
        @DrawMenuFlat()
    }
    else
    {
        @DrawMenu()
    }
}

<script type="text/javascript">
    var currentSearchRequest = null;

    function SearchMenu() {
        var searchText = $("#MenuSearchInput").val();
        if (!searchText) {
            var area = $("#SearchMenuArea");
            area.empty();
            area.parent().next().show();
            return;
        }
        currentSearchRequest = $.ajax({
            url: '@Url.Action("Search", "MenuSearch")',
            data: { searchString: searchText },
            //Abort previous request
            beforeSend: function () {
                if(currentSearchRequest != null) {
                    currentSearchRequest.abort();
                    currentSearchRequest = null;
                }
            },
            success: function (data) {
                var area = $("#SearchMenuArea");
                area.html(data);
                if (area.height() > area.parent().parent().height() / 2) {
                    area.parent().next().hide();
                }
                else {
                    area.parent().next().show();
                }
            }
        });
    }
</script>