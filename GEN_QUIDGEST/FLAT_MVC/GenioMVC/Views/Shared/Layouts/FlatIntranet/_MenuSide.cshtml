@model GenioMVC.ViewModels.Menu_ViewModel
@using GenioMVC.Models.Navigation;

@helper MakeLink(GenioMVC.Helpers.Menus.MenuEntry menu, string module, bool firstLevel = false)
{
object htmlAttributes = null;
if (firstLevel)
{
    htmlAttributes = new { @class = "nav-link n-sidebar__nav-link" };
}

if (menu.Action != null && menu.Action.Contains("Menu") && menu.TreeLevel == 1)
{
     htmlAttributes = new { @class = "nav-link n-sidebar__nav-link" };
}
else if (menu.Action != null && !menu.Action.Contains("Menu") && menu.TreeLevel > 1)
{
     htmlAttributes = new { @class = "dropdown-submenu" };
}
else if (menu.TreeLevel > 1)
{
     htmlAttributes = new { @class = "nav-link n-sidebar__nav-link" };
}

var innerHtml = "";
if (!String.IsNullOrEmpty(menu.Image))
{
    TagBuilder i = new TagBuilder("i");
    i.AddCssClass("icon-custom");

    TagBuilder img = new TagBuilder("img");
    img.MergeAttribute("src", Url.Content(menu.Image));
    img.MergeAttribute("style", "vertical-align:text-top;");
    img.MergeAttribute("height", "14");

    try { img.MergeAttribute("alt", "icon-" + Helpers.GetTextFromResources(menu.Title)); }
    catch (Exception) { img.MergeAttribute("alt", "icon-" + menu.Title); }

    i.InnerHtml += img;

    innerHtml += i + " ";
}
else if(!String.IsNullOrEmpty(menu.Font))
{
    TagBuilder i = new TagBuilder("i");
    i.AddCssClass(menu.Font + " e-icon nav-icon n-sidebar__icon");
    i.Attributes["style"] = "margin-right: 0.45rem;";
    innerHtml += i + " ";
}

try
{
    //Only use acronym if an image has not been defined and acronym is filled
    if (String.IsNullOrEmpty(menu.Image) && String.IsNullOrEmpty(menu.Font) && !String.IsNullOrEmpty(menu.Sigla))
    {
        innerHtml += "<span class=\"e-badge--mini-menu\">" + menu.Sigla + "</span>";
    }

    TagBuilder pg = new TagBuilder("p");

    pg.InnerHtml = Helpers.GetTextFromResources(menu.Title);

    if (menu.Count > 0)
    {
        pg.InnerHtml += " <span class=\"e-badge e-badge--dark\" title=\"(" + menu.Count + " " + @Resources.REGISTOS53981 + ")\"><span aria-hidden=\"true\">" + menu.Count + "</span></span>";
    }

    if (menu.Children.Count > 0)
    {
        pg.InnerHtml += "<i class=\"right glyphicons glyphicons-chevron-down\"></i>";
    }

    innerHtml += pg;
}
catch (Exception) { innerHtml += menu.Title; }
    @Html.MenuAction(menu, Url, module, innerHtml,htmlAttributes);
}

@helper ShowSubItems(GenioMVC.Helpers.Menus.MenuEntry menu, string module, int level, bool root)
{
    //string extra = root ? "nav-item n-sidebar__nav-item" : "nav-item n-sidebar__nav-item n-sidebar__nav-sub-item1";
    string extra = "nav-item n-sidebar__nav-item";
    extra = menu.Children.Count > 0 ? extra + " has-treeview" : extra;

    if (menu.Separates)
    {
        <li class='dropdown-divider'></li>
    }
    <li class='@extra' id="@module@menu.ID">
        @if (menu.Children.Count > 0)
        {
            @MakeLink(menu, module, level == 0)

            string sMenu = (menu.TreeLevel == 2 ? "nav nav-treeview n-sidebar__nav--level3":"nav nav-treeview");

            <ul class="@sMenu" id="@module@menu.ID">
                @foreach (GenioMVC.Helpers.Menus.MenuEntry subMenu in menu.Children)
                {
                    if (subMenu.Type == "ITEM")
                    {
                        @ShowSubItems(subMenu, module, level + 1, false)
                    }
                    else if (subMenu.Type == "LIST")
                    {
                        Html.RenderAction(subMenu.Action_MVC, subMenu.Controller);
                    }
                    else if (subMenu.Type == "REPORT")
                    {
                        <li>
                            @MakeLink(subMenu, module)
                        </li>
                    }
                }
            </ul>

        }
        else
        {
            @MakeLink(menu, module)
            // @Html.ActionLink(menu.Title, menu.Action_MVC, menu.Controller, new { module = module }, null);
        }
    </li>
}

@helper SearchBox()
{
<div class="n-sidebar__section menu-search">
    <div class="i-input-group" id="MenuSearchGroup">
        <input class="i-input-group__field" id="MenuSearchInput" name="menuSearchInput" onkeyup="SearchMenu()" placeholder="@Resources.PESQUISA_DE_MENUS30314" type="text" value="">
        <div class="i-input-group--right">
            <button type="button" elem-identifier="MenuSearchButton" class="b-icon--primary i-input-group__button--primary " title="@Resources.PESQUISAR34506" onclick="SearchMenu()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
        </div>
    </div>

    <div id="SearchMenuArea"></div>
</div>
}

