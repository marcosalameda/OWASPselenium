@model GenioMVC.ViewModels.Menu_ViewModel

@{
	if (GenioMVC.LayoutConfig.config.modulesStyle.Equals(GenioMVC.ModulesStyle.collapsible))
	{
		<ul class="nav nav-pills nav-sidebar flex-column n-sidebar__nav" data-widget="treeview" role="menu" data-accordion="true">
            <li class="nav-item n-sidebar__nav-item has-treeview">
                <a class="nav-link n-sidebar__nav-link d-flex flex-row" href="javascript:void(0)">
                    <i class="glyphicons glyphicons-show-thumbnails nav-icon n-sidebar__icon e-icon"></i>
                    <p>
                        @Resources.MODULOS17298
                        <i class="right glyphicons glyphicons-chevron-down"></i>
                    </p>
                </a>
                <ul class="nav nav-treeview" id="CollapsibleModules">
                    @AllModules()
                </ul>                
            </li>            
        </ul>
	}
    else if (GenioMVC.LayoutConfig.config.modulesStyle.Equals(GenioMVC.ModulesStyle.list))
    {
        <ul class="nav nav-pills nav-sidebar flex-column n-sidebar__nav" data-widget="treeview" role="menu" data-accordion="true">
            @AllModules()
        </ul>
    }
    else
    {
        if (@Model.AvailableModules.Count > 0)
        {
            if (@Model.AvailableModules.Count > 1)
            {
                <div class="n-sidebar__nav-item--dropdown">
                    <ul class="nav">
                        <li class="dropdown">
                            <a href="#" class="brand" data-toggle="dropdown">
                                @DesignModuleBrand()
                            </a>
                            @AllModulesdrop()
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="@Url.Action("Index", "Home")" class="brand">
                    @DesignModuleBrand()
                </a>
            }
        }
        else
        {
            <a class="brand" href="@Url.Action("Index", "Home")"></a>
        }
    }
}

@helper AllModules()
{
    if (Model.AvailableModules.Count > 0)
    {
        foreach (GenioMVC.Helpers.Menus.MenuEntry item in Model.AvailableModules)
        {
            var activeClass = "";
            if (@Model.CurrentModule == item.ID)
            {
                activeClass = "n-sidebar__nav-link--active";
            }
            <li class="nav-item n-sidebar__nav-item has-treeview @activeClass">
                <a href="@Url.Action("Index", "Home", new { module = item.ID, newMenu = true })" class="nav-link n-sidebar__nav-link n-sidebar__module-link">
                    @if (!String.IsNullOrEmpty(item.Font))
                    {
                        <i class="@item.Font nav-icon n-sidebar__icon"></i>
                        <p> @Helpers.GetTextFromResources(item.Title)</p>
                    }
                    else if (!String.IsNullOrEmpty(Model.Icon) && !String.IsNullOrEmpty(item.Image))
                    {
                        var imgIcon = item.Image;

                        if (item.ID.Equals(Model.CurrentModule) && imgIcon.Contains("."))
                        {
                            imgIcon = imgIcon.Insert(imgIcon.LastIndexOf("."), "_over");
                        }

                        <img src="@Url.Content(imgIcon)" title="@Helpers.GetTextFromResources(item.Title)" />

                    }
                    else
                    {
                        @Helpers.GetTextFromResources(item.Title)
                    }
                </a>
            </li>
            //}
        }
    }
}

@helper DesignModuleBrand()
{    
    if (GenioMVC.LayoutConfig.config.modulesStyle.Equals(GenioMVC.ModulesStyle.dropdown) && GenioMVC.LayoutConfig.config.headerPlacement.Equals(GenioMVC.HeaderPlacement.in_menuPanel))
    { 
        if(@Model.AvailableModules.Count > 1)
        {    
            <p class="n-sidebar__item "><i class="glyphicons glyphicons-show-thumbnails nav-icon n-sidebar__icon mr-2"></i><span>@Resources.MODULOS17298</span></p>
        }
    }
    else
    {
    <i class="glyphicons glyphicons-show-thumbnails"></i>    
    }
}

@helper AllModulesdrop()
{
    var moduleClass = "";
    <ul class="dropdown-menu">
        @if (@Model.AvailableModules.Count > 0)
        {
            foreach (GenioMVC.Helpers.Menus.MenuEntry item in @Model.AvailableModules)
            {
                if (item.ID.Equals(@Model.CurrentModule))
                {
                    moduleClass = "current";
                }else{
                    moduleClass = "";
                }

                <li class="@moduleClass">
                    <a class="dropdown-item" href="@Url.Action("Index", "Home", new { module = item.ID })">
                        @if (!String.IsNullOrEmpty(item.Font))
                        {
                            <i class="@item.Font dropdown__icon"></i>@Helpers.GetTextFromResources(item.Title)
                        }
                        else
                        {
                            @Helpers.GetTextFromResources(item.Title)
                        }
                    </a>
                </li>
            }
            moduleClass = "";
        }
    </ul>
}
