@model GenioMVC.ViewModels.Menu_ViewModel

@if (GenioMVC.LayoutConfig.config.headerPlacement.Equals(GenioMVC.HeaderPlacement.in_menuPanel))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_MenuSide");
}
else
{
    <!-- BEGIN Navigational bar -->
    <div id="header">
        <div class="navbar p-3 px-md-4 c-header mb-3">
            <div class="c-header__brand float-left">
                <a href="@Url.Action("Index", "Home")"><img src="@Url.Content("~/Content/img/logotipo_header.png")" alt="@Resources.PAGINA_INICIAL55004"></a>
            </div>
            @if (CSGenio.framework.Configuration.QAEnvironment == 1)
            {
                <div class="float-left">
                    <span class="nav-link c-header__link--sidebar betatesting">
                        <i class="glyphicons glyphicons-alert e-icon"></i> TESTING
                    </span>
                </div>
            }
            @Html.Partial("_LogOnPartial")
        </div>
    </div>

    <div class="navigationside">
        <div class="menuContainer">
            <div class="modules">
                @Html.Partial("_Modules");
            </div>
            <div class="button">
                <a href="javascript:;" data-identifier="sidemenu_push_button">
                    <i class="glyphicons glyphicons-menu-hamburger n-sidebar__toggler-icon"></i>
                </a>
            </div>
        </div>
        <div class="nav_menuContainer" data-identifier="sidemenu_container">
            <nav class="mt-2 ml-2">
                @Html.AntiForgeryToken()
                @Html.Partial("_MenuSide")
            </nav>
        </div>
    </div>
    <!-- END of Navigational bar -->
}
