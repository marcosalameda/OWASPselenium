	<script>
        function openSidebar() {
            document.getElementById("mySidenav").style.width = "300px";
            document.getElementById("main").style.marginRight = "300px";
            $('#opensidebarbtn').hide();
            QLocalStorage.setLocalStorage('rigthsidebaropen', "true"); 
        }

        function closeSidebar() {
            document.getElementById("mySidenav").style.width = "50px";
            document.getElementById("main").style.marginRight = "50px";            
            QLocalStorage.setLocalStorage('rigthsidebaropen', "false");             
        }        

        function closeNav() {
            document.getElementById("mySidenav").classList.add("c-rightSidebar__closed")
            document.getElementById("mySidenav").classList.remove("c-rightSidebar__open")
            document.getElementById("main").style.marginRight = "0";            
            $('#opensidebarbtn').show();            
            $('#suggestcontent').css("right", "0");
            $('#mySidenav').css('width', '0');

            QLocalStorage.setLocalStorage('rigthsidebarnavclosed', "true");
            QLocalStorage.setLocalStorage('rigthsidebaropen', "false");

        }

        function openNavRSB() {
            document.getElementById("mySidenav").classList.add("c-rightSidebar__open")
            document.getElementById("mySidenav").classList.remove("c-rightSidebar__closed")
            document.getElementById("main").style.marginRight = "50px";
            $('#opensidebarbtn').hide();  
            $('#suggestcontent').css("right", "50px");
            $('#mySidenav').css('width', '50px');

            QLocalStorage.setLocalStorage('rigthsidebarnavclosed', "false");
        }

        function toggleSidebarTab(alreadyOpen) {
            var opened = QLocalStorage.getLocalStorage('rigthsidebaropen');		
            if (!$.isEmptyObject(opened) && opened == "true") {                
                if (alreadyOpen) {
                    closeSidebar();
                } else {
                    openSidebar();
                }               
            }
            else {                
                openSidebar();
            }
        }
    </script>	
</div>

<script type="text/javascript">
    $(document).ready(function () {
        //$('#dismiss, .overlay').off('click').on('click', sidebarToggle);
        //$('#sidebarCollapse').off('click').on('click', sidebarToggle);
		$.each($('[elem-identifier="sidebarCollapse"]'), function () {
            $(this).off('click').on('click', function(){
                $('#v-pills-2-tab').click();
            });
        });

		$('a[data-toggle="pill"]').on('show.bs.tab', function (e) {
            var targetId = $(e.target).attr('id');
            //var targetRelatedId = $(e.relatedTarget).attr('id');              
        });
        
        $('a[data-toggle="pill"]').on('click', function (e) {
            var targetId = $(this).attr('id');
            if (targetId == 'v-pills-1-tab' || targetId == 'v-pills-2-tab') {
                var alreadyOpen = $(this).hasClass('active');
                toggleSidebarTab(alreadyOpen);
            }
        });

        var closed = QLocalStorage.getLocalStorage('rigthsidebarnavclosed');		
        if (!$.isEmptyObject(closed) && closed == "true") {
            closeNav();
        }

        var defaultState = '@GenioMVC.LayoutConfig.config.defaultSidebarState'
        if (defaultState == "closed" && closed == "false") {
            openNavRSB();
        }
		
