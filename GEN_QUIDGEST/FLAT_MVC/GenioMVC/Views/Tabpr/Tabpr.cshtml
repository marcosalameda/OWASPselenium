@model GenioMVC.ViewModels.Tabpr.Tabpr_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Tabpr";
	ViewBag.Title = @Resources.TABLE_PRICE14309;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Tabpr", FormMethod.Post, new { @class = "form-horizontal", area="Tabpr", data_form="Tabpr" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Tabpr" area="Tabpr" data-form="Tabpr">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Tabpr_well" area="Tabpr" data-form="Tabpr">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

