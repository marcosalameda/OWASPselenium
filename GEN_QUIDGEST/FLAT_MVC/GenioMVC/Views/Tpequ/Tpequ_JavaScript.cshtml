		$.ajax({
            url: '@Url.Action("GetCarga_unico")',
            type: "GET",
            data: { idsrc : id }
        }).done(function(data) {
            bootbox.alert('@Resources.A_OPERACAO_FOI_CONCL36721');
            //QUtils.WindowReload();
        }).fail(function(jqXHR, textStatus) {
            bootbox.alert(quidgestGlobals.Resources.OCORREU_UM_ERRO_AO_P53091);
        });

		});

    }
