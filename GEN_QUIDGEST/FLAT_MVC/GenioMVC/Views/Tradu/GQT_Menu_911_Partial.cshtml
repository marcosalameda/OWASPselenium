@model GenioMVC.ViewModels.Tradu.GQT_Menu_911_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Tradu;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Tradu>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodtradu, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_911_TRADU_REFERENC]/
		column.Expression(p => p.ValReferenc).Title(@Resources.REF_A30225).Field("ValReferenc").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_911_LANG1_LANGUA]/
		column.Expression(p => p.Lang1.ValLangua).Title(@Resources.IDIOMA44057).Field("Lang1.ValLangua").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_911_TRADU_ATRADUZI]/
		column.Expression(p => p.ValAtraduzi).Title(@Resources.A_TRADUZIR48203).Field("ValAtraduzi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_911_LANG2_LANGUA]/
		column.Expression(p => p.Lang2.ValLangua).Title(@Resources.IDIOMA44057).Field("Lang2.ValLangua").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_911_TRADU_TRADUZID]/
		column.Expression(p => p.ValTraduzid).Title(@Resources.TRADUZIDO46556).Field("ValTraduzid").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Tradu")
        .Id("GQT_Menu_911")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Tradu", false, false)
        .SetFollowUp("Tradu_Show", "Tradu" , (Func<GenioMVC.Models.Tradu, object>)(item => new { id = item.ValCodtradu }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_911, #GQT_Menu_911_complex_filter th input, #GQT_Menu_911_filters input").change(function() {
                    $("#pGQT_Menu_911").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_911_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_911_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_911_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_911']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_911');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_911_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_911').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_911', 'TRADU', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_911]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_911]/
</script>