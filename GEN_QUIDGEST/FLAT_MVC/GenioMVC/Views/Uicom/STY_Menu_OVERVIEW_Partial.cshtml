@model GenioMVC.ViewModels.Uicom.STY_Menu_OVERVIEW_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Uicom;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Uicom>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoduicom, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_OVERVIEW_UICOM_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_OVERVIEW_UICOM_CATEGORY]/
		column.Expression(p => p.ValCategory).Title(@Resources.CATEGORY18978).Field("ValCategory").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_OVERVIEW_UICOM_MENUID]/
		column.Expression(p => p.ValMenuid).Title(@Resources.FIXED_MENU_NAME38578).Field("ValMenuid").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_OVERVIEW_UICOM_THUMBNAI]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValThumbnai, new {alt=@Resources.THUMBNAIL30025,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCoduicom, modelname = "Uicom", fldname = "ValThumbnai" }))).Title(@Resources.THUMBNAIL30025).Field("ValThumbnai").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Uicom")
        .Id("STY_Menu_OVERVIEW")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Uicom", false, false)
        .SetFollowUp("Uicom_Show", "Uicom" , (Func<GenioMVC.Models.Uicom, object>)(item => new { id = item.ValCoduicom }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
    var cards = data
        .ToSpecialRendering()
		.SetSpecialRendering(this.Model.ViewModesCfg.SpecialRenderings.FirstOrDefault(sr => sr.Id == "CARDS"))
        .Filters(this.Model.Menu.Filters)
        .Form("Uicom", false, false)
        .SetFollowUp("Uicom_Show", "Uicom" , (Func<GenioMVC.Models.Uicom, object>)(item => new { id = item.ValCoduicom }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@{ renderings.Clear(); }
@{ renderings.Add(Model.GetViewModePosition("CARDS"), cards.ToSpecialRenderingHtml(hidden: Model.IsViewModeHidden("CARDS"))); }

@{ renderings.Add(2, @tbl.ToHtml(hidden: true)); }

@foreach (var render in renderings.ToList().OrderBy(r => r.Key))
{
    @Html.Raw(render.Value.ToHtmlString());
}


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_OVERVIEW, #STY_Menu_OVERVIEW_complex_filter th input, #STY_Menu_OVERVIEW_filters input").change(function() {
                    $("#pSTY_Menu_OVERVIEW").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_OVERVIEW_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_OVERVIEW_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_OVERVIEW_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_OVERVIEW']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_OVERVIEW');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_OVERVIEW_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_OVERVIEW').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_OVERVIEW', 'UICOM', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_OVERVIEW]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
@*Platform: MVC | Type: LISTING_CODEJS | Module: GQT | Parameter: STY_MENU_OVERVIEW | File:  | Order: 0*@
@*BEGIN_MANUALCODE_CODMANUA:30535e7f-6267-4221-84b0-94d1db5898b7*@
    function linkSidebar() {
        const cardTitles = $('h5.c-card__title');

        cardTitles.each(function (index) {
            if (cardTitles[index].innerText === 'Notification') {
                const NotificationCard = cardTitles[index].parentElement.parentElement;
                $(NotificationCard).attr('id', 'NotiCard');
            }
        });

        const NotiCard = $('#NotiCard');
        NotiCard.click(function () {
            $('#sidebarCollapse').click();
        })
    }

    linkSidebar()
@*END_MANUALCODE*@
</script>