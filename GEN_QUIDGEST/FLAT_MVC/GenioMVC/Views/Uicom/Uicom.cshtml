{
<div class="hidden" id="FormJavaScript_UICOM" data-form-javascript="true">
@Html.Partial("Uicom_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

