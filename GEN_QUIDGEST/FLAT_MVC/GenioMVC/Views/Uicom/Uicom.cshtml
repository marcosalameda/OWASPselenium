@model GenioMVC.ViewModels.Uicom.Uicom_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Uicom";
	ViewBag.Title = @Resources.UI_COMPONENT15435;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Uicom", FormMethod.Post, new { @class = "form-horizontal", area="Uicom", data_form="Uicom" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Uicom" area="Uicom" data-form="Uicom">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Uicom_well" area="Uicom" data-form="Uicom">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-image draggable " id="CONTAINER_LED_UICOM___UICOMTHUMBNAI">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValThumbnai, new { label_id="LED_UICOM___UICOMTHUMBNAI", @class = " i-text__label", id="LABEL_LED_UICOM___UICOMTHUMBNAI"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_UICOM___UICOMTHUMBNAI','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								<div data-identifier="LED_UICOM___UICOMTHUMBNAI" pers-cs-area="Uicom" pers-cs-field="ValThumbnai" class="image-control-wrapper" >
								@if(Model.IsEditableMode) {
									@Html.EditorFor(m => m.ValThumbnai, new {help_id = "LED_UICOM___UICOMTHUMBNAI", @class = "col-auto ", data_identifier = "LED_UICOM___UICOMTHUMBNAI", title = @Resources.MINIATURE57617, guid = @Model.ValCoduicom, controller = "Uicom", fldname = "ValThumbnai", identifier = "FUICOM", style = "height: 47pt; display: inline-block;" })
								} else {
									@Html.DisplayFor(m => m.ValThumbnai, new {help_id = "LED_UICOM___UICOMTHUMBNAI", @class = "col-auto ", data_identifier = "LED_UICOM___UICOMTHUMBNAI", title = @Resources.MINIATURE57617, guid = @Model.ValCoduicom, controller = "Uicom", fldname = "ValThumbnai", identifier = "FUICOM", style = "height: 47pt; display: inline-block;" })
								}
								</div>
								@Html.ValidationMessageFor(model => model.ValThumbnai)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_UICOM___UICOMNAME____">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValName, new { label_id="LED_UICOM___UICOMNAME____", @class = " i-text__label", id="LABEL_LED_UICOM___UICOMNAME____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_UICOM___UICOMNAME____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValName, new {help_id = "LED_UICOM___UICOMNAME____", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_UICOM___UICOMNAME____", @pers_cs_area = "Uicom", @pers_cs_field = "ValName", @db_field = "ValName", title = @Resources.NAME31974, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValName)
							</div>
						<div class="i-text draggable " id="CONTAINER_LED_UICOM___UICOMCATEGORY">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValCategory, new { label_id="LED_UICOM___UICOMCATEGORY", @class = " i-text__label", id="LABEL_LED_UICOM___UICOMCATEGORY"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_UICOM___UICOMCATEGORY','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValCategory, new {help_id = "LED_UICOM___UICOMCATEGORY", @class = "i-text__field i-text input-large", data_identifier = "LED_UICOM___UICOMCATEGORY", @pers_cs_area = "Uicom", @pers_cs_field = "ValCategory", @db_field = "ValCategory", title = @Resources.CATEGORY18978, maxlength = "50", rows = "30" })
								@Html.ValidationMessageFor(model => model.ValCategory)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_UICOM___UICOMMENUID__">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValMenuid, new { label_id="LED_UICOM___UICOMMENUID__", @class = " i-text__label", id="LABEL_LED_UICOM___UICOMMENUID__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_UICOM___UICOMMENUID__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValMenuid, new {help_id = "LED_UICOM___UICOMMENUID__", @class = "i-text__field i-text input-large", data_identifier = "LED_UICOM___UICOMMENUID__", @pers_cs_area = "Uicom", @pers_cs_field = "ValMenuid", @db_field = "ValMenuid", title = @Resources.FIXED_MENU_NAME38578, maxlength = "30", rows = "30" })
								@Html.ValidationMessageFor(model => model.ValMenuid)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCoduicom, new { @pers_cs_field="ValCoduicom", @pers_cs_area="Uicom", data_refresh = "true", @form_area="true", @data_value = Model.ValCoduicom, @data_identifier = "LED_UICOM___UICOMCODUICOM" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Uicom" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Uicom" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Uicom" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Uicom", Model.FormMode).ToString(), "Uicom"))", "Uicom_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.GRAVAR45301
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Uicom_Delete", "Uicom", new {id = @Model.ValCoduicom} )", "Uicom_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Uicom_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Uicom_Delete", "Uicom", new {id = @Model.ValCoduicom} )", "Uicom_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Uicom_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitUicom(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Uicom", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteUicom(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Uicom", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitUicom(event)" title="@Resources.GRAVAR45301" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR45301
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Uicom_Cancel", "Uicom", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Uicom.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Uicom_Cancel","Uicom","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Uicom">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Uicom" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Uicom">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

