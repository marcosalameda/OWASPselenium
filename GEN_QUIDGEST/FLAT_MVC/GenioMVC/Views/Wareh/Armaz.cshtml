@model GenioMVC.ViewModels.Wareh.Armaz_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Armaz";
	ViewBag.Title = @Resources.TABLE_LIST35818;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Wareh", FormMethod.Post, new { @class = "form-horizontal", area="Wareh", data_form="Armaz" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Armaz" area="Wareh" data-form="Armaz">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Armaz_well" area="Wareh" data-form="Armaz">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ARMAZ___WAREHWAREHCOD">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValWarehcod, new { label_id="LED_ARMAZ___WAREHWAREHCOD", @class = " i-text__label", id="LABEL_LED_ARMAZ___WAREHWAREHCOD"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ARMAZ___WAREHWAREHCOD','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValWarehcod, new {help_id = "LED_ARMAZ___WAREHWAREHCOD", @class = "i-text__field i-text input-small", data_identifier = "LED_ARMAZ___WAREHWAREHCOD", @pers_cs_area = "Wareh", @pers_cs_field = "ValWarehcod", @db_field = "ValWarehcod", title = @Resources.ACRONYM00872, maxlength = "10", rows = "10" })
								@Html.ValidationMessageFor(model => model.ValWarehcod)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ARMAZ___WAREHWAREHDES">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValWarehdes, new { label_id="LED_ARMAZ___WAREHWAREHDES", @class = " i-text__label", id="LABEL_LED_ARMAZ___WAREHWAREHDES"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ARMAZ___WAREHWAREHDES','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValWarehdes, new {help_id = "LED_ARMAZ___WAREHWAREHDES", @class = "i-text__field i-text input-large", data_identifier = "LED_ARMAZ___WAREHWAREHDES", @pers_cs_area = "Wareh", @pers_cs_field = "ValWarehdes", @db_field = "ValWarehdes", title = @Resources.WAREHOUSE51864, maxlength = "85", rows = "30" })
								@Html.ValidationMessageFor(model => model.ValWarehdes)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_LED_ARMAZ___WAREHACTIVITY">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValActivity, new { label_id="LED_ARMAZ___WAREHACTIVITY", @class = " i-text__label", id="LABEL_LED_ARMAZ___WAREHACTIVITY"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ARMAZ___WAREHACTIVITY','Activida')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.ArrayLogicalFor(model => model.ValActivity, Model.List_ValActivity, CSGenio.business.ArrayActivida.GetElement, false, new {help_id = "LED_ARMAZ___WAREHACTIVITY", @class = "input-mini", data_identifier = "LED_ARMAZ___WAREHACTIVITY", @pers_cs_area = "Wareh", @pers_cs_field = "ValActivity", @db_field = "ValActivity", title = @Resources.ACTIVITY02681 })
								@Html.ValidationMessageFor(model => model.ValActivity)
							</div>
						</div>
						<div class="control-join-group row-group-checkbox">
						<div class="i-checkbox draggable " id="CONTAINER_LED_ARMAZ___WAREHSHOWRECO">
								@Html.CheckBoxFor(model => model.ValShowreco, new {help_id = "LED_ARMAZ___WAREHSHOWRECO", @class = "i-checkbox__field i-checkbox input-medium", data_identifier = "LED_ARMAZ___WAREHSHOWRECO", @pers_cs_area = "Wareh", @pers_cs_field = "ValShowreco", @db_field = "ValShowreco", title = @Resources.SHOW_RECORD11620 }, @Model.IsEditableMode, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								@Html.ValidationMessageFor(model => model.ValShowreco)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_ARMAZ___PSEUDPESSARMA">
								<div id="Armaz_ValPessarma" data-identifier="IFF_ARMAZ___PSEUDPESSARMA"  data-extra-options="" > 
									@{ Html.RenderAction("Armaz_ValPessarma", "Wareh", new { id = Model.ValCodwareh, partialView = "Armaz_ValPessarma"}); }
								</div>
						</div>
					</div>
				</div>
			</div>


		@Html.HiddenFor(model=> model.ValNum_employee, new { @pers_cs_area = "Wareh", @pers_cs_field = "ValNumemplo", @data_identifier = "LED_ARMAZ___WAREHNUMEMPLO" })


			@Html.HiddenFor(model => model.ValCodwareh, new { @pers_cs_field="ValCodwareh", @pers_cs_area="Wareh", data_refresh = "true", @form_area="true", @data_value = Model.ValCodwareh, @data_identifier = "LED_ARMAZ___WAREHCODWAREH" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Armaz" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Armaz" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Armaz" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Armaz", Model.FormMode).ToString(), "Wareh")", "Armaz_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Armaz_Delete", "Wareh", new {id = @Model.ValCodwareh} )", "Armaz_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Armaz_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Armaz_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitArmaz(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Armaz", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteArmaz(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Armaz", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitArmaz(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Armaz_Cancel", "Wareh", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Armaz.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Armaz_Cancel","Wareh","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Armaz">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Armaz" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Armaz">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

