@model GenioMVC.ViewModels.Wareh.Btnsform_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Btnsform";
	ViewBag.Title = @Resources.BUTTONS20612;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Wareh", FormMethod.Post, new { @class = "form-horizontal", area="Wareh", data_form="Btnsform" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Btnsform" area="Wareh" data-form="Btnsform">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Btnsform_well" area="Wareh" data-form="Btnsform">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

