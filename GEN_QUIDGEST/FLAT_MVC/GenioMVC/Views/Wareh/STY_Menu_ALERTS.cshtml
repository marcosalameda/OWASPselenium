@model GenioMVC.ViewModels.Wareh.STY_Menu_ALERTS_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Wareh.STY_Menu_ALERTS_ViewModel modelSTY_Menu_ALERTS = new GenioMVC.ViewModels.Wareh.STY_Menu_ALERTS_ViewModel(Navigation);
	var columns = modelSTY_Menu_ALERTS.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "wareh" && areaField.Field == "warehdes")
		{
			fields.Add("WAREH.WAREHDES", new TableFilterField("WAREH", "WAREHDES", Resources.WAREHOUSE51864, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("STY_Menu_ALERTS", "Wareh", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Wareh", data_form="STY_Menu_ALERTS" }))
{
		<input id="SearchFilters" type="hidden" value="" />
                 <div class="table-title c-table__title">
		     <h1>@ViewBag.Title</h1>
		</div>
                
                <div class="alert c-alert c-alert-W" role="alert">
                      <i class="glyphicons glyphicons-light-beacon c-alert__icon"></i>
                      <a href="#" class="c-alert__dismissible" data-dismiss="alert" aria-label="close">
                         <i class="glyphicons glyphicons-remove c-alert__icon"></i>
                      </a>                
                      <div class="c-alert__text">
			    &nbsp; This Alert is displayed when an record is pending            
                      </div> 
                </div>

		<div class="alert c-alert c-alert-OK" role="alert">
                     <i class="glyphicons glyphicons-ok-sign c-alert__icon"></i>
                     <a href="#" class="c-alert__dismissible" data-dismiss="alert" aria-label="close">
                        <i class="glyphicons glyphicons-remove c-alert__icon"></i>
                     </a>                
                     <div class="c-alert__text">
		        &nbsp; This Alert is displayed when an action is successfully made               
                     </div> 
                </div>

                <div class="alert c-alert c-alert-E" role="alert">
                      <i class="glyphicons glyphicons-light-beacon c-alert__icon"></i>
                      <a href="#" class="c-alert__dismissible" data-dismiss="alert" aria-label="close">
                         <i class="glyphicons glyphicons-remove c-alert__icon"></i>
                      </a>                
                      <div class="c-alert__text">
			    &nbsp; This Alert is displayed when an error occurs            
                      </div> 
                </div>

                <div class="alert c-alert c-alert OK_MAIS_W" role="alert">
                      <i class="glyphicons glyphicons-info-sign c-alert__icon"></i>
                      <a href="#" class="c-alert__dismissible" data-dismiss="alert" aria-label="close">
                         <i class="glyphicons glyphicons-remove c-alert__icon"></i>
                      </a>                
                      <div class="c-alert__text">
			    &nbsp; Information Alert          
                      </div> 
                </div>

		<div class="page-header row" style="display: none;">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="STY_Menu_ALERTS_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qSTY_Menu_ALERTS", Navigation.GetStrValue("qSTY_Menu_ALERTS"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('STY_Menu_ALERTS');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('STY_Menu_ALERTS');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.WAREHOUSE51864})
					<button id="qSTY_Menu_ALERTS-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("STY_Menu_ALERTS", fields, "WAREH")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('STY_Menu_ALERTS', 'WAREH', 'WAREH.WAREHDES');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="STY_Menu_ALERTS_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#STY_Menu_ALERTS_complex_filter', 'STY_Menu_ALERTS_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("STY_Menu_ALERTS")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="STY_Menu_ALERTS" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "STY_Menu_ALERTS", idlistController = "Wareh", idlistArea = "Wareh", codlista ="859c224b-b5e6-4d51-a8c8-5b6d5be2e655" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("STY_Menu_ALERTS_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "STY_Menu_ALERTS" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_STY_Menu_ALERTS = new QMenuForm($('[data-form="STY_Menu_ALERTS"]'), "Form_STY_Menu_ALERTS");
		window.Form_STY_Menu_ALERTS.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_STY_Menu_ALERTS.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qSTY_Menu_ALERTS");
		RegisterClearEvents("STY_Menu_ALERTS")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("STY_Menu_ALERTS", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="STY_Menu_ALERTS"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="STY_Menu_ALERTS"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
