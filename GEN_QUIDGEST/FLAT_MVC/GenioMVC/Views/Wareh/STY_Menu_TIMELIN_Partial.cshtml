@model GenioMVC.ViewModels.Wareh.STY_Menu_TIMELIN_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Wareh>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodwareh, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TIMELIN_WAREH_WAREHDES]/
		column.Expression(p => p.ValWarehdes).Title(@Resources.WAREHOUSE51864).Field("ValWarehdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TIMELIN_WAREH_WAREHCOD]/
		column.Expression(p => p.ValWarehcod).Title(@Resources.ACRONYM00872).Field("ValWarehcod").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_TIMELIN_WAREH_ACTIVITY]/
		column.Expression(p => p.ArrayValactivity).Title(@Resources.ACTIVIDADE44684).Field("ValActivity", "ArrayActivida").Size(1);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Wareh")
        .Id("STY_Menu_TIMELIN")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .SetFollowUp("Tmline_Show", "Wareh" , (Func<GenioMVC.Models.Wareh, object>)(item => new { id = item.ValCodwareh }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_TIMELIN, #STY_Menu_TIMELIN_complex_filter th input, #STY_Menu_TIMELIN_filters input").change(function() {
                    $("#pSTY_Menu_TIMELIN").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_TIMELIN_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_TIMELIN_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_TIMELIN_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_TIMELIN']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_TIMELIN');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_TIMELIN_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_TIMELIN').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_TIMELIN', 'WAREH', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_TIMELIN]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS STY_MENU_TIMELIN]/
</script>