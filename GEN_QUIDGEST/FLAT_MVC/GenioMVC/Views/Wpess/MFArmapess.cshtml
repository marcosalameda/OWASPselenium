	$("#Armapess_@multiformfId").unbind('FORM_LOADED');
	@formDataScript()
	$(document).ready(function () {
		var alreadyInitializedForm = false;
		if (window.Form_Armapess_@{@multiformfId} !== undefined) {
			alreadyInitializedForm = true;
		}
		else {
			window.Form_Armapess_@{@multiformfId} = new QForm($('div[data-form="Armapess_@multiformfId"]'), "Form_Armapess_@{@multiformfId}");
		}
