		window.Form_Armapess_@{@multiformfId}.FormMode = '@Model.GetFormMode';
		window.Form_Armapess_@{@multiformfId}.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_Armapess_@{@multiformfId}.UrlAction = {
			ReloadDBEdit:		'@Url.Action("ReloadDBEdit", "Wpess")',
			GetDependants:		'@Url.Action("GetDependants", "Wpess")',
			RecalculateFormulas:'@Url.Action("RecalculateFormulas_Armapess", "Wpess")',
			ChangeFormMode:		'@Url.Action("ChangeFormMode_Armapess", new { m = Model.GetQSModes() })',
			ReloadControl:		'@Url.Action("Wpess", "Wpess")',
		};
		window.Form_Armapess_@{@multiformfId}.FormButtons = {
			Modes: [
@if(Model.CanView)
{
