@model GenioMVC.ViewModels.Wpess.STY_Menu_CARDIMGTHUMB_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Wpess.STY_Menu_CARDIMGTHUMB_ViewModel modelSTY_Menu_CARDIMGTHUMB = new GenioMVC.ViewModels.Wpess.STY_Menu_CARDIMGTHUMB_ViewModel(Navigation);
	var columns = modelSTY_Menu_CARDIMGTHUMB.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrSexo = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArraySexo.GetDictionary())
	{
		arrSexo.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "wpess" && areaField.Field == "name")
		{
			fields.Add("WPESS.NAME", new TableFilterField("WPESS", "NAME", Resources.NAME31974, "text", defaultSearch : true));
		}
		if (areaField.Area == "wpess" && areaField.Field == "date")
		{
			fields.Add("WPESS.DATE", new TableFilterField("WPESS", "DATE", Resources.DATA_DE_NASCIMENTO48110, "date"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "sex")
		{
			fields.Add("WPESS.SEX", new TableFilterField("WPESS", "SEX", Resources.SEXO52099, "enum", array : arrSexo));
		}
		if (areaField.Area == "wpess" && areaField.Field == "nfunc")
		{
			fields.Add("WPESS.NFUNC", new TableFilterField("WPESS", "NFUNC", Resources.NOFUNCIONARIO21429, "num"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "adress")
		{
			fields.Add("WPESS.ADRESS", new TableFilterField("WPESS", "ADRESS", Resources.ADDRESS04342, "text"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "zipcode")
		{
			fields.Add("WPESS.ZIPCODE", new TableFilterField("WPESS", "ZIPCODE", Resources.ZIP_CODE56964, "text"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "country")
		{
			fields.Add("WPESS.COUNTRY", new TableFilterField("WPESS", "COUNTRY", Resources.PAIS04637, "text"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "email")
		{
			fields.Add("WPESS.EMAIL", new TableFilterField("WPESS", "EMAIL", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "cellphon")
		{
			fields.Add("WPESS.CELLPHON", new TableFilterField("WPESS", "CELLPHON", Resources.NOTELEFONE56747, "num"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "naturali")
		{
			fields.Add("WPESS.NATURALI", new TableFilterField("WPESS", "NATURALI", Resources.NATURALNESS33189, "text"));
		}
		if (areaField.Area == "wpess" && areaField.Field == "nacional")
		{
			fields.Add("WPESS.NACIONAL", new TableFilterField("WPESS", "NACIONAL", Resources.NACIONALIDADE23735, "text"));
		}
		if (areaField.Area == "wareh" && areaField.Field == "warehdes")
		{
			fields.Add("WAREH.WAREHDES", new TableFilterField("WAREH", "WAREHDES", Resources.WAREHOUSE51864, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("STY_Menu_CARDIMGTHUMB", "Wpess", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Wpess", data_form="STY_Menu_CARDIMGTHUMB" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="STY_Menu_CARDIMGTHUMB_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qSTY_Menu_CARDIMGTHUMB", Navigation.GetStrValue("qSTY_Menu_CARDIMGTHUMB"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('STY_Menu_CARDIMGTHUMB');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('STY_Menu_CARDIMGTHUMB');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NAME31974})
					<button id="qSTY_Menu_CARDIMGTHUMB-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("STY_Menu_CARDIMGTHUMB", fields, "WPESS")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('STY_Menu_CARDIMGTHUMB', 'WPESS', 'WPESS.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@if (!Model.IsViewModeHidden("LIST"))
						{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="STY_Menu_CARDIMGTHUMB_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#STY_Menu_CARDIMGTHUMB_complex_filter', 'STY_Menu_CARDIMGTHUMB_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("STY_Menu_CARDIMGTHUMB")
					</div>
				</div>
			</div>
			@{
				var listBtnCssClass = Model.IsViewModeHidden("LIST") ? "b-icon--secondary" : "b-icon--primary";
				var alternativeViewBtnCssClass = Model.IsViewModeHidden("LIST") ? "b-icon--primary" : "b-icon--secondary";

				<div class="col-auto" style="padding: 0; padding-right: 15px">
					<div class="b-btn-group">
						<button class="b-btn b-icon @listBtnCssClass" type="button" onclick="window.STY_Menu_CARDIMGTHUMB.ToggleViewMode('STY_Menu_CARDIMGTHUMB', 'Wpess', 'Wpess', '5b3c192d-de40-4fc4-bf07-308da67f2edd', 1)" title="@Resources.MUDAR_PARA_VISTA_EM_03626"><i class="glyphicons glyphicons-show-lines e-icon"></i></button>
						<button class="b-btn b-icon @alternativeViewBtnCssClass" type="button" onclick="window.STY_Menu_CARDIMGTHUMB.ToggleViewMode('STY_Menu_CARDIMGTHUMB', 'Wpess', 'Wpess', '5b3c192d-de40-4fc4-bf07-308da67f2edd', 2)" title="@Resources.MUDAR_PARA_VISTA_ALT46064"><i class="glyphicons glyphicons-show-big-thumbnails e-icon"></i></button>
					</div>
				</div>
			}
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="STY_Menu_CARDIMGTHUMB" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "STY_Menu_CARDIMGTHUMB", idlistController = "Wpess", idlistArea = "Wpess", codlista ="5b3c192d-de40-4fc4-bf07-308da67f2edd" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("STY_Menu_CARDIMGTHUMB_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "STY_Menu_CARDIMGTHUMB" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_STY_Menu_CARDIMGTHUMB = new QMenuForm($('[data-form="STY_Menu_CARDIMGTHUMB"]'), "Form_STY_Menu_CARDIMGTHUMB");
		window.Form_STY_Menu_CARDIMGTHUMB.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_STY_Menu_CARDIMGTHUMB.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qSTY_Menu_CARDIMGTHUMB");
		RegisterClearEvents("STY_Menu_CARDIMGTHUMB")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("STY_Menu_CARDIMGTHUMB", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="STY_Menu_CARDIMGTHUMB"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="STY_Menu_CARDIMGTHUMB"]'));
	}

	function ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer) {
		if (bottomInsertBtn) {
			if ($(window).scrollTop() + $(window).height() > $(document).height() - 50)
				insertBtnContainer.addClass("menu-insert-btn-top-hidden");
			else
				insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
		}
	}

	var nav = $('#header-container > nav')[0];
	var header = $(".page-header");
	var threshold_el = $('.c-header').length ? $('.c-header') : $('nav').first();
	var breadcrumbs = $('#breadcrumbs').height() ? $('#breadcrumbs') : $('[aria-label=breadcrumb]');
	header.css('min-height', 50);

	// get the insert button
	var bottomInsertBtn = $('[qbutton=insert]')[0];

	if (bottomInsertBtn) {
		var insertBtn = $.clone($('[qbutton=insert]')[0]);
		insertBtn.innerHTML = insertBtn.innerHTML.replace(insertBtn.innerText, '');
		insertBtn = $(insertBtn);
		insertBtn.removeClass();
		insertBtn.addClass('b-btn b-icon b-icon--secondary');

		// find the page header
		var pageHeader = $('.page-header')[0];
		var newCol = $("<div class='col'></div>");

		// insert
		var insertBtnContainer = $("<div class='menu-insert-btn-top c-action-bar b-btn-group'></div>");
		insertBtn.appendTo(insertBtnContainer);
		insertBtnContainer.appendTo(newCol);
		$(".page-header > div:nth-child(1)").after($(newCol));

		// adjust table title max width
		$('.table-title').parent().addClass("table-title-min");
		insertBtnContainer.parent().css("margin-left", "-.7rem");

		insertBtnContainer.addClass("menu-insert-btn-top-hidden");
		if ($(window).scrollTop() + $(window).height() <= $(document).height() - 50)
			insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
	}

	$(window).scroll(function () {
		ToggleMenuStickyHeader(nav, header, breadcrumbs, threshold_el);
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	});

	$(window).resize(function () {
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	})
</script>
}

@section code_javascript {
	@codeJavascript()
}
