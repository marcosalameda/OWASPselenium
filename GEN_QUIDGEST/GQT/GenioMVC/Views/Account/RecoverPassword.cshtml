@using CaptchaMvc.HtmlHelpers
@model GenioMVC.ViewModels.UserAdmin.PasswordRecoverViewModel
<html>

<div class="f-login">
    <div class="f-login__container">
        <div class="f-login__background">
            <div class="f-login__brand">
                <img src="@Url.Content("~/Content/img/f-login__brand.png")" alt="">
                <p>@Resources.GENIO_QUALITY_TESTS30896</p>
            </div>
            @using (@Html.BeginForm("RecoverPassword", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()                        
                <div class="form-flow">
                    @if (!Model.IsEmailSent)
                    {
                        <p>@Resources.ENTER_YOUR_EMAIL__YO19804</p>
                        <div class="input">
                            @Html.TextBoxFor(m => m.Email, new { placeholder = @Resources.EMAIL25170 , @class="form-control f-login__input-field" })
                        </div>
                        <div id="CaptchaField">
                            @Html.Captcha(@Resources.REFRESCAR60171, "captcha", 5)
                        </div>
                        <button type="submit" class="b-icon-text b-btn--full-width b-icon-text--primary b-icon-text--login text-uppercase">@Resources.REPOR35852</button>
                        @Html.QValidationSummary()
                    }
                    else
                    {
                        <p>@String.Format(@Resources.AN_EMAIL_WAS_SENT_TO34421, Model.Email)</p>
                    }
                    <a class="f-login__link" href="@Url.Content("~")">@Resources.BACK_TO_LOGIN01266</a>
                </div>
            }
        </div>
    </div>
</div>


</html>
