@model GenioMVC.ViewModels.Agreg.Agreg_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Agreg";
	ViewBag.Title = @Resources.AGREGA_POR_ANO62275;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Agreg", FormMethod.Post, new { @class = "form-horizontal", area="Agreg", data_form="Agreg" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Agreg" area="Agreg" data-form="Agreg">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Agreg_well" area="Agreg" data-form="Agreg">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

