								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_AGREG___PROJEPROJECTO','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodproje, Model.TableProjeProjecto.List , "", new {help_id = "IFF_AGREG___PROJEPROJECTO", @class = "i-select chosen-dropdown input-xxlarge", data_refresh = "true", data_tipoform = "ST", @readonly = "readonly", data_identifier = "IFF_AGREG___PROJEPROJECTO", @pers_cs_area = "Proje", @pers_cs_field = "ValCodproje", @db_field = "ValCodproje", @db_full_field_name = "agreg.codproje", data_has_more = Model.TableProjeProjecto.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableProjeProjecto.Selected, data_dbedit_value = Model.TableProjeProjecto.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodaggre, @data_see_more = "Agreg_ProjeValProjecto", title = @Resources.PROJECT37121, data_see_more_url = @Url.Action("Agreg_ProjeValProjecto","Agreg"), data_is_dbedit = "true", data_fields = "proje.codproje,proje.projecto", data_main_field = "Proje.ValProjecto", data_elements = 0, data_filled_by_history = Model.TableProjeProjecto.FilledByHistory, @dependant_fields = "proje.codproje,proje.projecto" })
								@Html.ValidationMessageFor(model => model.TableProjeProjecto)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row hidden">
				<div class="col-12 hidden">
					<div class="control-row-group hidden">
						<div>
								@Html.HiddenFor(model => model.ValCodyear, new {help_id = "IFF_AGREG___YEAR_YEAR____", @class = "", data_refresh = "true", data_tipoform = "ST", @readonly = "readonly", data_identifier = "IFF_AGREG___YEAR_YEAR____", @pers_cs_area = "Agreg", @dependant_fields = "year.codyear,year.year", data_main_field = "Year.ValYear", trelate = "Year", tfrelate = "Codyear", hidden_dbedit = "true", @pers_cs_field = "ValCodyear", data_value = Model.ValCodyear })
						</div>
						<div>
								@Html.NumberFor(model => model.ValValue, new {help_id = "LED_AGREG___AGREGVALUE___", @class = "i-input-group__field text-right i-text__field i-text input-small", data_refresh = "true", data_tipoform = "SR", data_identifier = "LED_AGREG___AGREGVALUE___", @pers_cs_area = "Agreg", @pers_cs_field = "ValValue", @db_field = "ValValue", fixed_field = "true", @readonly = "readonly", data_currency = "True", data_number_integer = "7", data_number_decimals = "2", data_number_format = "9999999.99" })
						</div>
					</div>
				</div>
			</div>



			@Html.HiddenFor(model => model.ValCodproje, new { @pers_cs_field="ValCodproje", @pers_cs_area="Agreg", @data_value = Model.ValCodproje, @db_field="ValCodproje", @trelate="Proje", @tfrelate="Codproje", @data_identifier="LED_AGREG___PROJECODPROJE" })
			@Html.HiddenFor(model => model.ValCodyear, new { @pers_cs_field="ValCodyear", @pers_cs_area="Agreg", @data_value = Model.ValCodyear, @db_field="ValCodyear", @trelate="Year", @tfrelate="Codyear", @data_identifier="LED_AGREG___YEAR_CODYEAR_" })

			@Html.HiddenFor(model => model.ValCodaggre, new { @pers_cs_field="ValCodaggre", @pers_cs_area="Agreg", data_refresh = "true", @form_area="true", @data_value = Model.ValCodaggre, @data_identifier = "LED_AGREG___AGREGCODAGGRE" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Agreg" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Agreg" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Agreg" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
