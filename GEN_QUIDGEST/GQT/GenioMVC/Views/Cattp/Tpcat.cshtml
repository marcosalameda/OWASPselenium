@model GenioMVC.ViewModels.Cattp.Tpcat_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Tpcat";
	ViewBag.Title = @Resources.CATEGORY_TYPE23058;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Cattp", FormMethod.Post, new { @class = "form-horizontal", area="Cattp", data_form="Tpcat" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Tpcat" area="Cattp" data-form="Tpcat">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Tpcat_well" area="Cattp" data-form="Tpcat">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_TPCAT___CATTPTPCATEGO">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValTpcatego, new { label_id="LED_TPCAT___CATTPTPCATEGO", @class = " i-text__label", id="LABEL_LED_TPCAT___CATTPTPCATEGO"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_TPCAT___CATTPTPCATEGO','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValTpcatego, new {help_id = "LED_TPCAT___CATTPTPCATEGO", @class = "i-text__field i-text input-xxlarge", data_identifier = "LED_TPCAT___CATTPTPCATEGO", @pers_cs_area = "Cattp", @pers_cs_field = "ValTpcatego", @db_field = "ValTpcatego", title = @Resources.CATEGORY_TYPE23058, maxlength = "85", rows = "85" })
								@Html.ValidationMessageFor(model => model.ValTpcatego)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_TPCAT___SBCATSUBCATEG">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableSbcatSubcateg, new { label_id="IFF_TPCAT___SBCATSUBCATEG", @class = " i-text__label", id="LABEL_IFF_TPCAT___SBCATSUBCATEG"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_TPCAT___SBCATSUBCATEG','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodsbcat, Model.TableSbcatSubcateg.List , "", new {help_id = "IFF_TPCAT___SBCATSUBCATEG", @class = "i-select chosen-dropdown input-xlarge", data_identifier = "IFF_TPCAT___SBCATSUBCATEG", @pers_cs_area = "Sbcat", @pers_cs_field = "ValCodsbcat", @db_field = "ValCodsbcat", @db_full_field_name = "cattp.codsbcat", data_has_more = Model.TableSbcatSubcateg.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableSbcatSubcateg.Selected, data_dbedit_value = Model.TableSbcatSubcateg.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodtpcat, @data_see_more = "Tpcat_SbcatValSubcateg", title = @Resources.SUB_CATEGORIA15612, data_see_more_url = @Url.Action("Tpcat_SbcatValSubcateg","Cattp"), data_is_dbedit = "true", data_support_form = @Url.Action("SBCAT_New", "SBCAT"), data_fields = "sbcat.codsbcat,sbcat.subcateg", data_main_field = "Sbcat.ValSubcateg", data_elements = 0, data_filled_by_history = Model.TableSbcatSubcateg.FilledByHistory, @dependant_fields = "sbcat.codsbcat,sbcat.subcateg" })
								@Html.ValidationMessageFor(model => model.TableSbcatSubcateg)
							</div>
						</div>
					</div>
				</div>
			</div>



			@Html.HiddenFor(model => model.ValCodsbcat, new { @pers_cs_field="ValCodsbcat", @pers_cs_area="Cattp", @data_value = Model.ValCodsbcat, @db_field="ValCodsbcat", @trelate="Sbcat", @tfrelate="Codsbcat", @data_identifier="LED_TPCAT___SBCATCODSBCAT" })

			@Html.HiddenFor(model => model.ValCodtpcat, new { @pers_cs_field="ValCodtpcat", @pers_cs_area="Cattp", data_refresh = "true", @form_area="true", @data_value = Model.ValCodtpcat, @data_identifier = "LED_TPCAT___CATTPCODTPCAT" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Tpcat" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Tpcat" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Tpcat" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Tpcat", Model.FormMode).ToString(), "Cattp"))", "Tpcat_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Tpcat_Delete", "Cattp", new {id = @Model.ValCodtpcat} )", "Tpcat_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Tpcat_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Tpcat_Delete", "Cattp", new {id = @Model.ValCodtpcat} )", "Tpcat_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Tpcat_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitTpcat(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Tpcat", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteTpcat(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Tpcat", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitTpcat(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Tpcat_Cancel", "Cattp", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Tpcat.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Tpcat_Cancel","Cattp","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Tpcat">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Tpcat" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Tpcat">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

