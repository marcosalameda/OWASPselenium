@model GenioMVC.ViewModels.Cav.GlobalViewModel
    <div id="ms-ConditionsSelected" class="ms-container">
        <div class="row">   
            <div class="col-md-6">
                <div class="g-reporting__flow-search">                    
                    <div class="i-input-group" id="">
                        <input id="search2" class="searchInput i-input-group__field input-medium" placeholder="@Resources.PESQUISA_DE_CAMPOS08087" type="text" autocomplete="off" title="@Resources.PESQUISA_DE_CAMPOS08087" type="text" value="">
                        <div class="i-input-group--right">
                            <button type="button" class="b-icon--primary i-input-group__button--secondary " title="@Resources.PESQUISAR34506">
                                <i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">                
                        <div class="ms-selectable g-reporting__flow-content-selectable">
                            <ul class="ms-list">
                                @for (int i = 0; i < Model.Tables.Count; i++)
                                {
                                    GenioMVC.Models.Cav.CAVTable table = Model.Tables[i];
                                    if (Model.Tables[i].Fields.Count > 0)
                                    {
                                        @:<li class="ms-optgroup-container g-reporting__flow-content-selectable-item" id="ms-FieldsSelected-optgroup-@i">
                                            @:<ul class="ms-optgroup" ms-value="@table.TableUpId">
                                                <li class="ms-optgroup-label">
                                                    <div>
                                                        <i class="glyphicons glyphicons-list e-icon--reporting mr-2" aria-hidden="true"></i>
                                                        @Resources.ResourceManager.GetString(@table.Description)
                                                        <i class="e-icon--group glyphicons glyphicons-plus-sign"></i>
                                                    </div>                                                    
                                                </li>
												foreach (GenioMVC.Models.Cav.Field field in @table.Fields)
												{
													if(!string.IsNullOrEmpty(field.Description))
													{
														string ArrayValue = "";
														string ArrayField = "";
														if(field.ArrayElements != null && field.ArrayElements.Count > 0)
														{
															ArrayValue = "Array=true";

															string FieldName = field.Id.Split('.').LastOrDefault();
															ArrayField = "array-id=Val" + FieldName.Substring(0, 1).ToUpper() + FieldName.Substring(1).ToLower();
														}
														@:<li class="ms-elem-selectable" ms-type="@field.Type" ms-value="@field.Id" @ArrayValue @ArrayField ms-group="@Resources.ResourceManager.GetString(@table.Description)">@Resources.ResourceManager.GetString(@field.Description)<i class="glyphicons glyphicons-circle-arrow-right e-icon--reporting"></i></li>
													}
												}
                                            @:</ul>
                                        @: </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="pagination mt-3 mb-1">
                    <a id="condBack" href="#" class="b-icon-text b-icon-text--secondary">
                        <i class="glyphicons glyphicons-chevron-left e-icon" aria-hidden="true"></i>
                        @Resources.RETROCEDER16633 
                    </a>
                    <a id="condNext" href="#" class="b-icon-text b-icon-text--primary">
                        @Resources.AVANCAR20939
                        <i class="glyphicons glyphicons-chevron-right e-icon" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="ms-selection">
                    <div>
                        <h4 class="g-reporting__flow-subtitle" style="margin-top: 1.25rem;">@Resources.CONDICOES_A_APLICAR25156</h4>
                    </div>
                    <div class="ui-widget-content ui-droppable">
                        <div class="g-reporting__flow-content-droppable">
                            <ul class="ms-list listSelected" ms-type="C">
                            @if (@Model.Query.Condition != null)
                            {
                                foreach (var cond in @Model.Query.Condition.Operands)
                                {
                                    string[] splited = cond.Operands[0].ValueReference.Split('.');
                                    string table = splited[0];
                                    var t = Model.Tables.Find(x => x.Id == table);
                                    var f = t.Fields.Find(x => x.Id == cond.Operands[0].ValueReference);
                                    string array = (f.ArrayElements != null && f.ArrayElements.Count > 0) ? f.ArrayElements[0].ArrayId : "";
                                    string completed = "incomplete";

                                    if (cond.Operation == "ISNULL" || cond.Operation == "ISNOTNULL" || ((cond.Operands.Count > 1 && !string.IsNullOrEmpty(cond.Operands[1].ValueReference)) && !string.IsNullOrEmpty(cond.Operation)))
                                    {
                                        completed = "complete";
                                    }

                                    @:<li class="ms-elem-selected @f.Type @completed" ms-value="@cond.Operands[0].ValueReference">
                                        <div class="imgState"></div>
                                        <div class="delete" style="position:relative; height: 20px; width:22px; float:right; cursor:pointer;"></div>
                                        <div class="text-lis"><div><strong>&nbsp;[@t.Description]</strong></div></div>
                                        <div class="text-lis">
                                            <div>@f.Description</div>
                                            @{ string value = cond.Operands[1].ValueReference; }
                                            @if (array.Equals(""))
                                            {
                                                if (!string.IsNullOrEmpty(cond.Operation))
                                                {
                                                    <div class="result1 condition">@GenioMVC.ViewModels.Cav.GlobalViewModel.types_to_operands[f.Type][cond.Operation]</div>
                                                }
                                                if (cond.Operation == "IN" || cond.Operation == "BETWEEN")
                                                {
                                                    List<string> values = new List<string>();
                                                    foreach (var op in cond.Operands.GetRange(1, cond.Operands.Count - 1))
                                                    {
                                                        values.Add(op.ValueReference);
                                                    }
                                                    value = string.Join(", ", values);
                                                }

                                                //MARTELADA PARA SER ALTERADO PARA ALGO MENOS....MARTELADO?
                                                if (f.Type.Equals("B"))
                                                {
                                                    if (value.Equals("1"))
                                                    {
                                                        value = "Verdadeiro";
                                                    }
                                                    else
                                                    {
                                                        value = "Falso";
                                                    }
                                                }

                                                <div class="result2 condition">@value</div>
                                            }
                                            else
                                            {
                                                if (!string.IsNullOrEmpty(cond.Operation))
                                                {
                                                    <div class="result1 condition">@GenioMVC.ViewModels.Cav.GlobalViewModel.types_to_operands["ARRAY"][cond.Operation]</div>
                                                }
                                                if (cond.Operation == "IN" || cond.Operation == "BETWEEN")
                                                {
                                                    List<string> values = new List<string>();
                                                    foreach (var op in cond.Operands.GetRange(1, cond.Operands.Count - 1))
                                                    {
                                                        //foreach (List<string> entry in Model.ArrayList[array.ToLower()])
                                                        //{
                                                        //    if (entry[0].Equals(op.ValueReference))
                                                        //    {
                                                        //        values.Add(entry[2]);
                                                        //        break;
                                                        //    }
                                                        //}
                                                    }
                                                    value = string.Join(", ", values);
                                                    <div class="result2 condition">@value</div>
                                                }
                                                else
                                                {
                                                    @*foreach (List<string> entry in Model.ArrayList[array.ToLower()])
                                            {
                                                if (entry[0].Equals(cond.Operands[1].ValueReference))
                                                {
                                                    @:<div class="result2 condition">@entry[2]</div>
                                                    value = entry[2];
                                                    break;
                                                }
                                            }*@
                                                }
                                            }
                                        </div>
                                        <span>@Resources.OPERADOR26143:&nbsp;</span>
                                        <select class="optionValues OP" id="@(cond.Operands[0].ValueReference)ConditionsSelectedOP" style="display: none; ">
                                            <option value=""></option>

                                            @foreach (KeyValuePair<string, string> entry in @GenioMVC.ViewModels.Cav.GlobalViewModel.types_to_operands[array.Equals("") ? f.Type : "ARRAY"])
                                            {
                                                if (@entry.Key.Equals(cond.Operation))
                                                {
                                                    @:<option selected value="@entry.Key">@entry.Value</option>
                                                }
                                                else
                                                {
                                                    @:<option value="@entry.Key">@entry.Value</option>
                                                }
                                            }

                                        </select>
                                        <br />
                                        string classCss = "";
                                        if (GenioMVC.ViewModels.Cav.GlobalViewModel.classes.ContainsKey(f.Type))
                                        {
                                            classCss = GenioMVC.ViewModels.Cav.GlobalViewModel.classes[f.Type];
                                        }
                                        if (!f.Type.Equals("B"))
                                        {
                                            if (!array.Equals(""))
											{
												<span>Escolha aqui:&nbsp;</span>
												<select class="optionValues @classCss" id="@(cond.Operands[0].ValueReference)ConditionsSelectVAL" style="display: none;">
													<option value=""></option>
												@foreach (GenioMVC.Models.Cav.FieldArray entry in f.ArrayElements)
												{
													if (entry.Id.Equals(cond.Operands[1].ValueReference))
													{
														<option selected value="@entry.Id">@entry.Description</option>
													}
													else
													{
														<option value="@entry.Id">@entry.Description</option>
													}
												}
												</select>
											}
                                            <span>@Resources.VALOR32448:&nbsp;</span>
											<input class="optionValues ov2 @classCss" type="text" style="width: auto; display: none;" value="@(cond.Operands[1].ValueReference)"></input>											
                                        }
                                        else
                                        {
                                            <span>@Resources.VALOR32448:&nbsp;</span>
                                            <select class="optionValues" id="@(cond.Operands[0].ValueReference)ConditionsSelectVAL" style="display: none;">
                                                <option value=""></option>
                                                @foreach (KeyValuePair<string, string> entry in GenioMVC.ViewModels.Cav.GlobalViewModel.logicos)
                                                {
                                                    if (entry.Key.Equals(cond.Operands[1].ValueReference))
                                                    {
                                                        <option selected value="@entry.Key">@entry.Value</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@entry.Key">@entry.Value</option>
                                                    }
                                                }
                                            </select>
                                        }

                                        string isChecked = cond.Operands[0].ShowNulls ? "checked" : "";
                                        <div class="condition-show-nulls">@Resources.MOSTRAR_LINHAS_VAZIA48693:<input type="checkbox" @isChecked /></div>
                                    @:</li>
                                }
                            }
                            </ul>
                        </div>
                    </div>                    
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#condBack').on('click', function () {
                $('#cavtabs a[data-target="#campos"]').click();
            });
            $('#condNext').on('click', function () {       
                $('#cavtabs a[data-target="#grupos"]').click();
            });
        });
    </script>