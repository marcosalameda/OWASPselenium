@model GenioMVC.ViewModels.Cav.GlobalViewModel    
        
        <div id="chosenTable" class="g-reporting__flow-content-header">
            <h4 key="@Model.Query.BaseTable"><i class="glyphicons glyphicons-list e-icon--reporting mr-2" aria-hidden="true"></i> @Resources.ResourceManager.GetString(@Model.Query.BaseTableDescription)</h4>
        </div>            
        <div id="columnList" class="g-reporting__flow-content-droppable">
            <div class="g-reporting__flow-content-subtitle">
                <i class="glyphicons glyphicons-stats e-icon--reporting" aria-hidden="true"></i>
                @Resources.CAMPOS13449
            </div>
            <ul>
                @foreach (GenioMVC.Helpers.Cav.ReportField item in @Model.FieldsSelectedList)
                {
                    string[] splited = item.FieldId.Split('.');
                    string table = splited[0];
                    var t = Model.Tables.Find(x => x.Id == table);
                    var f = t.Fields.Find(x => x.Id == item.FieldId);

                <li key="@item.FieldId" ms-type="@item." ms-value="@item.FieldId" class="g-reporting__flow-content-drop-item">                        
                    <div class="delete" style="position:relative;float:right;cursor:pointer;">
                        <a title="@Resources.ELIMINAR21155">
                            <i class="glyphicons glyphicons-bin e-icon--reporting"></i>
                            <span class="hidden-elem">@Resources.ELIMINAR21155</span>
                        </a>                            
                    </div>                        
                    <div class="text-lis">
                        <i class="glyphicons glyphicons-list e-icon--reporting" aria-hidden="true"></i>
                        @Resources.ResourceManager.GetString(@t.Description)
                    </div>
                    <div class="text-lis">
                        <strong>@Resources.ResourceManager.GetString(@f.Description)</strong>
                    </div>
                    <div class="colName">
                        "Coluna:"
                        <input type="text" value="@Resources.ResourceManager.GetString(@f.Description)" />
                    </div>
                </li>
                }
            </ul>
        </div>               

        <script type="text/javascript">
        $(document).ready(function () {
            var key = $("#chosenTable").children("h4").attr("key");

            $("div.delete a").click(function () {                
                $(this).closest('li').remove();
                UpdateDetails('@Url.Action("UpdateQuery","Cav")');
            });
        });
        </script>

