@model GenioMVC.ViewModels.Cav.GlobalViewModel
<div id="ms-OrderBySelected" class="ms-container">    
    <div class="row">
       <div class="col-md-6">
            <div class="g-reporting__flow-search">                    
                <div class="i-input-group" id="">
                    <input id="search3" class="searchInput i-input-group__field input-medium" placeholder="@Resources.PESQUISA_DE_CAMPOS08087" type="text" autocomplete="off" title="@Resources.PESQUISA_DE_CAMPOS08087" type="text" value="">
                    <div class="i-input-group--right">
                        <button type="button" class="b-icon--primary i-input-group__button--secondary " title="Pesquisar">
                            <i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="ms-selectable g-reporting__flow-content-selectable">
                        <ul class="ms-list">
                            @for (int i = 0; i < Model.Tables.Count; i++)
                            {
                                GenioMVC.Models.Cav.CAVTable table = Model.Tables[i];
                                if (Model.Tables[i].Fields.Count > 0)
                                {
                                    if (Model.FieldsSelectedList != null)
                                    {
                                        bool first = true;
                                        for (int j = 0; j < table.Fields.Count; j++)
                                        {
                                            GenioMVC.Models.Cav.Field field = table.Fields[j];
                                            if (Model.FieldsSelectedList.Exists(x => x.FieldId == field.Id))
                                            {
                                                if (first)
                                                {
                                                    @:<li class="ms-optgroup-container g-reporting__flow-content-selectable-item" id="ms-FieldsSelected-optgroup-@i">
                                                        @:<ul class="ms-optgroup" ms-value="@table.TableUpId">
                                                                <li class="ms-optgroup-label">
                                                                    <div>
                                                                        <i class="glyphicons glyphicons-list e-icon--reporting mr-2" aria-hidden="true"></i>
                                                                        @Resources.ResourceManager.GetString(@table.Description)
                                                                        <i class="e-icon--group glyphicons glyphicons-plus-sign"></i>
                                                                    </div>
                                                                    
                                                                </li>
                                                            first = false;
                                                        }
                                                        @:<li class="ms-elem-selectable" ms-type="@field.Type" ms-value="@field.Id" ms-group="@Resources.ResourceManager.GetString(@table.Description)">@Resources.ResourceManager.GetString(@field.Description)<i class="glyphicons glyphicons-circle-arrow-right e-icon--reporting"></i></li>
                                                    }
                                                }
                                                if (!first)
                                                {
                                                @:</ul>
                                            @:</li>
                                        }
                                    }
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="pagination mt-3 mb-1">
                <a id="orderBack" href="#" class="b-icon-text b-icon-text--secondary">
                    <i class="glyphicons glyphicons-chevron-left e-icon" aria-hidden="true"></i>
                    @Resources.RETROCEDER16633 
                </a>
                <a id="orderNext" href="#" class="b-icon-text b-icon-text--primary">
                    @Resources.AVANCAR20939
                    <i class="glyphicons glyphicons-chevron-right e-icon" aria-hidden="true"></i>
                </a>
            </div>
       </div>
       <div class="col-md-6">
           <div class="ms-selection">
               <div class="ui-widget-content ui-droppable">
                    <ul class="ms-list listSelected ui-sortable" ms-type="O">
                        @if (Model.Query.Orderings != null)
                        {
                            for (int i = 0; i < Model.Query.Orderings.Count; i++)
                            {
                                GenioMVC.Helpers.Cav.ReportOrdering entry = Model.Query.Orderings[i];
                                GenioMVC.Helpers.Cav.ReportField field = entry.Field;
                                String direction = entry.Direction;
                                string[] splited = field.FieldId.Split('.');
                                string table = splited[0];
                                var t = Model.Tables.Find(x => x.Id == table);
                                var f = t.Fields.Find(x => x.Id == field.FieldId);

                                <li class="ms-elem-selected @(f.Type)" ms-value="@(field.FieldId)">
                                    <div class="delete" style="width: 22px; height: 20px; float: right; position: relative; cursor: pointer;"></div>
                                    <div class="text-lis"><div><strong>[@Resources.ResourceManager.GetString(@t.Description)]</strong></div></div>
                                    <div class="text-lis">
                                        <div>@Resources.ResourceManager.GetString(@f.Description)</div>
                                        <div class="orders" style="display: inline;">
                                            <div class="@(direction == "ASC" ? "selectedOrder asc" : "")" key="ASC">
                                                Asc
                                            </div>
                                            <div class="@(direction == "DESC" ? "selectedOrder desc" : "")" key="DESC">
                                                Desc
                                            </div>
                                        </div>
                                                                            </div>
                                </li>
                            }
                        }
                    </ul>
               </div>                
           </div>
       </div>
   </div>    
</div>
<script type="text/javascript">
        $(document).ready(function () {
            $('#orderBack').on('click', function () {
                $('#cavtabs a[data-target="#grupos"]').click();
            });
            $('#orderNext').on('click', function () {
                $('#cavtabs a[data-target="#totais"]').click();
            });

            $("ul.listSelected[ms-type=F],ul.listSelected[ms-type=O]").sortable({ containment: 'parent' });
        });
</script>