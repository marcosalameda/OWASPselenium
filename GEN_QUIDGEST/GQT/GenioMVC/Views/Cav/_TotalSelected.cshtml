@model GenioMVC.ViewModels.Cav.GlobalViewModel
<div class="row">
    <div class="col">    
        <div id="ms-TotalSelect" class="ms-container">
            <div class="ms-selectable g-reporting__flow-content-droppable" >
                <ul class="ms-list listSelected totalizer" style="width: 100%;" ms-type="G">
                    @for (int i = 0; i < Model.TotalFieldsPerGroup.Count; i++)
                    {
                        List<GenioMVC.Helpers.Cav.ReportField> fields = Model.TotalFieldsPerGroup[i];
                        Dictionary<string, List<GenioMVC.Helpers.Cav.ReportField>> grupo = Model.Totals[i];

                    <li class="ms-elem-selected group currentSelection" style="width: auto; ">
                        @if (i == 0)
                        {
                            @:<div class="group-title">@Resources.GERAL08942</div>
                        }
                        else
                        {
                            @:<div class="group-title">@Resources.GRUPO22663 @i</div>
                        }
                        <ul class="">
                            @foreach (GenioMVC.Helpers.Cav.ReportField field in fields)
                            {
                                string[] splited = field.FieldId.Split('.');
                                string table = splited[0];
                                var t = Model.Tables.Find(x => x.Id == table);
                                var f = t.Fields.Find(x => x.Id == field.FieldId);
                                Dictionary<string, string> fieldTotalTypes = GenioMVC.ViewModels.Cav.GlobalViewModel.total[f.Type];
                                List<GenioMVC.Helpers.Cav.ReportField> totalizadoresNivel;

                                if (!grupo.TryGetValue(field.FieldId, out totalizadoresNivel))
                                {
                                    totalizadoresNivel = new List<GenioMVC.Helpers.Cav.ReportField>();
                                }

                                <li class="ms-elem-selectable" ms-type="@f.Type" ms-value="@f.Id" ms-group="@Resources.ResourceManager.GetString(@t.Description)" style="">
                                    <div class="text-lis"><div><strong>[@Resources.ResourceManager.GetString(@t.Description)]</strong></div></div>
                                    <div class="text-lis">@Resources.ResourceManager.GetString(@f.Description)</div>
                                    <div class="checkbTotal">
                                        @foreach (var totalType in fieldTotalTypes)
                                        {
                                            string isChecked = totalizadoresNivel.Exists(x => x.TotalType == totalType.Key) ? "checked" : "";
                                            @Resources.ResourceManager.GetString(@totalType.Value)@:&nbsp;<input type="checkbox" @isChecked value="@totalType.Key">
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </li>
                    }
                    </ul>
            </div>
        </div>
    </div>
</div>
<div class="pagination mt-3 mb-1">
    <a id="totalBack" href="#" class="b-icon-text b-icon-text--secondary">
        <i class="glyphicons glyphicons-chevron-left e-icon" aria-hidden="true"></i>
        @Resources.RETROCEDER16633 
    </a>
    <a id="totalNext" href="#" class="b-icon-text b-icon-text--primary">
        @Resources.AVANCAR20939
        <i class="glyphicons glyphicons-chevron-right e-icon" aria-hidden="true"></i>
    </a>
</div>
<script type="text/javascript">
        $(document).ready(function () {
            $('#totalBack').on('click', function () {
                $('#cavtabs a[data-target="#ordenacao"]').click();
            });
            $('#totalNext').on('click', function () {
                $('#cavtabs a[data-target="#executar"]').click();
            });
        });
</script>
