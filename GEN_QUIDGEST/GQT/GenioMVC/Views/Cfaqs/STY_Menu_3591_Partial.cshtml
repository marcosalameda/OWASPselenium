@model GenioMVC.ViewModels.Cfaqs.STY_Menu_3591_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Cfaqs>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodcfaqs, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_3591_CFAQS_ICON]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValIcon, new {alt="",}, Url.Action("ImageHandlerGet", "Home", new { ticket = Helpers.GetFileTicket(UserContext.Current.User, "Cfaqs", "ValIcon", "", p.ValCodcfaqs, null) }))).Field("ValIcon").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_3591_CFAQS_CATEGORY]/
		column.Expression(p => p.ValCategory).Title(@Resources.CATEGORY18978).Field("ValCategory").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_3591_CFAQS_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION07383).Field("ValDescript").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Cfaqs")
        .Id("STY_Menu_3591")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .SetFollowUp("STY_Menu_35911", "Faqs" , (Func<GenioMVC.Models.Cfaqs, object>)(item => new { cfaqs = item.ValCodcfaqs }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
    var cards = data
        .ToSpecialRendering()
		.SetSpecialRendering(this.Model.ViewModesCfg.SpecialRenderings.FirstOrDefault(sr => sr.Id == "CARDS"))
        .Filters(this.Model.Menu.Filters)
        .SetFollowUp("STY_Menu_35911", "Faqs" , (Func<GenioMVC.Models.Cfaqs, object>)(item => new { cfaqs = item.ValCodcfaqs }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@{ renderings.Clear(); }
@{ renderings.Add(Model.GetViewModePosition("CARDS"), cards.ToSpecialRenderingHtml(hidden: Model.IsViewModeHidden("CARDS"))); }

@{ renderings.Add(2, @tbl.ToHtml(hidden: true)); }

@foreach (var render in renderings.ToList().OrderBy(r => r.Key))
{
    @Html.Raw(render.Value.ToHtmlString());
}


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_3591, #STY_Menu_3591_complex_filter th input, #STY_Menu_3591_filters input").change(function() {
                    $("#pSTY_Menu_3591").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_3591_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_3591_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_3591_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_3591']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_3591');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_3591_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_3591').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_3591', 'CFAQS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_3591]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS STY_MENU_3591]/
</script>