@model GenioMVC.ViewModels.Cmpki.GQT_Menu_2A11_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Cmpki;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Cmpki>(edit: Model.IsEditableMode, canPage: false, canSort: false, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodcmpki, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2A11_CMPKI_ORDER]/
		column.Expression(p => p.ValOrder).Title(@Resources.ORDER39632).Field("ValOrder").Size(5);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2A11_TPEQU_TIPOEQUI]/
		column.Expression(p => p.Tpequ.ValTipoequi).Title(@Resources.TYPE_OF_EQUIPMENT18080).Field("Tpequ.ValTipoequi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2A11_TPEQ1_TIPOEQUI]/
		column.Expression(p => p.Tpeq1.ValTipoequi).Title(@Resources.TYPE_OF_EQUIPMENT18080).Field("Tpeq1.ValTipoequi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2A11_CMPKI_QUANTIDA]/
		column.Expression(p => p.ValQuantida).Title(@Resources.AMOUNT46885).Field("ValQuantida").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Cmpki")
        .Id("GQT_Menu_2A11")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Cmpki", false, false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {
	var link = '@Url.Action("ReorderGQT_Menu_2A11", "Cmpki")';
    OrderTable("GQT_Menu_2A11", link, "#order", "#order");

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_2A11, #GQT_Menu_2A11_complex_filter th input, #GQT_Menu_2A11_filters input").change(function() {
                    $("#pGQT_Menu_2A11").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_2A11_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_2A11_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_2A11_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_2A11']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_2A11');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_2A11_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_2A11').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_2A11', 'CMPKI', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_2A11]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_2A11]/
</script>