@model GenioMVC.ViewModels.Cmpny.Wid_cola_ViewModel

@{
    ViewBag.Title = @Resources.COMPANY52963;
}

@LoadDefault()

@helper LoadDefault() {
<div class="form-horizontal" area="Cmpny" data-form="Wid_cola">
	<fieldset>
		<legend class="form-header">@ViewBag.Title</legend>
        <div class="form-flow">
            @form_content_body()
        </div>
		@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Wid_cola" })
		@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Wid_cola" })
        @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Wid_cola" })
        @Html.AntiForgeryToken()
	</fieldset>
</div>

}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-image draggable " id="CONTAINER_LED_WID_COLACMPNYLOGO____">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValLogo, new { label_id="LED_WID_COLACMPNYLOGO____", @class = " i-text__label", id="LABEL_LED_WID_COLACMPNYLOGO____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_WID_COLACMPNYLOGO____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								<div data-identifier="LED_WID_COLACMPNYLOGO____" pers-cs-area="Cmpny" pers-cs-field="ValLogo" class="image-control-wrapper" >
								@if(Model.IsEditableMode) {
									@Html.EditorFor(m => m.ValLogo, new {help_id = "LED_WID_COLACMPNYLOGO____", @class = "col-auto ", data_identifier = "LED_WID_COLACMPNYLOGO____", title = @Resources.LOGO62483, guid = @Model.ValCodempre, controller = "Cmpny", fldname = "ValLogo", identifier = "FWID_COLA", style = "height: 47pt; display: inline-block;" })
								} else {
									@Html.DisplayFor(m => m.ValLogo, new {help_id = "LED_WID_COLACMPNYLOGO____", @class = "col-auto ", data_identifier = "LED_WID_COLACMPNYLOGO____", title = @Resources.LOGO62483, guid = @Model.ValCodempre, controller = "Cmpny", fldname = "ValLogo", identifier = "FWID_COLA", style = "height: 47pt; display: inline-block;" })
								}
								</div>
								@Html.ValidationMessageFor(model => model.ValLogo)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_WID_COLACMPNYDESIGNAT">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValDesignat, new { label_id="LED_WID_COLACMPNYDESIGNAT", @class = " i-text__label", id="LABEL_LED_WID_COLACMPNYDESIGNAT"}, true, true)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_WID_COLACMPNYDESIGNAT','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValDesignat, new {help_id = "LED_WID_COLACMPNYDESIGNAT", @class = "i-text__field i-text input-xxlarge", data_identifier = "LED_WID_COLACMPNYDESIGNAT", @pers_cs_area = "Cmpny", @pers_cs_field = "ValDesignat", @db_field = "ValDesignat", title = @Resources.DESIGNATION35876, maxlength = "85", rows = "85" })
								@Html.ValidationMessageFor(model => model.ValDesignat)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_WID_COLAPSEUDPESSLIST">
								<div id="Wid_cola_ValPesslist" data-identifier="IFF_WID_COLAPSEUDPESSLIST"  data-extra-options="" > 
									@{ Html.RenderAction("Wid_cola_ValPesslist", "Cmpny", new { id = Model.ValCodempre, partialView = "Wid_cola_ValPesslist"}); }
								</div>
						</div>
					</div>
				</div>
			</div>



}


