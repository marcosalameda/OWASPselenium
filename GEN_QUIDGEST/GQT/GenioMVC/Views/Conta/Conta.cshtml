{
	@codeJavascript()
	@includeStylesheets()
}

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_CONTA" data-form-javascript="true">
@Html.Partial("Conta_JavaScript", Model, ViewData)
</div>
}

@section code_javascript {
	@codeJavascript()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
	@includeStylesheets()
}
