			get tpcon() { return (this.formContext.Data.RelationKeysSelector.tpcon.getQControl() || {}).Value; /* DBEdit */ },
			set tpcon(newValue) { (this.formContext.Data.RelationKeysSelector.tpcon.getQControl() || {}).Value = newValue; /* DBEdit */ },
		};
