@model GenioMVC.ViewModels.Decom.Abate_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Abate";
	ViewBag.Title = @Resources.EQUIPMENT_DECOMMISSI11875;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Decom", FormMethod.Post, new { @class = "form-horizontal", area="Decom", data_form="Abate" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Abate" area="Decom" data-form="Abate">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Abate_well" area="Decom" data-form="Abate">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ABATE___DECOMDECOMNR_">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValDecomnr, new { label_id="LED_ABATE___DECOMDECOMNR_", @class = " i-text__label", id="LABEL_LED_ABATE___DECOMDECOMNR_"}, true, true)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ABATE___DECOMDECOMNR_','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.NumberFor(model => model.ValDecomnr, new {help_id = "LED_ABATE___DECOMDECOMNR_", @class = "Number text-right i-text__field i-text input-small", data_identifier = "LED_ABATE___DECOMDECOMNR_", @pers_cs_area = "Decom", @pers_cs_field = "ValDecomnr", @db_field = "ValDecomnr", title = @Resources.NO_DECOMISSION13045, data_number_integer = "10", data_number_decimals = "0", data_number_format = "9999999999" })
								@Html.ValidationMessageFor(model => model.ValDecomnr)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-date-picker draggable " id="CONTAINER_LED_ABATE___DECOMDTDECO__">
								<div class="d-inline-flex">
								@Html.LabelFor(model => model.ValDtdeco, new { label_id="LED_ABATE___DECOMDTDECO__", @class = " i-text__label", id="LABEL_LED_ABATE___DECOMDTDECO__"}, true, true)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ABATE___DECOMDTDECO__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DateFor(model => model.ValDtdeco, new {help_id = "LED_ABATE___DECOMDTDECO__", @class = "i-input-group__field b-icon-text input-medium", data_refresh = "true", data_tipoform = "DF", data_identifier = "LED_ABATE___DECOMDTDECO__", @pers_cs_area = "Decom", @pers_cs_field = "ValDtdeco", @db_field = "ValDtdeco", title = @Resources.DECOMISSION14486 })
								@Html.ValidationMessageFor(model => model.ValDtdeco)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-textarea draggable " id="CONTAINER_LED_ABATE___DECOMNOTE____">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValNote, new { label_id="LED_ABATE___DECOMNOTE____", @class = " i-text__label", id="LABEL_LED_ABATE___DECOMNOTE____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ABATE___DECOMNOTE____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextAreaFor(model => model.ValNote, 3, 85, new {help_id = "LED_ABATE___DECOMNOTE____", @class = "i-textarea__field i-textarea input-xxlarge", data_identifier = "LED_ABATE___DECOMNOTE____", @pers_cs_area = "Decom", @pers_cs_field = "ValNote", @db_field = "ValNote", title = @Resources.NOTES05274 })
								@Html.ValidationMessageFor(model => model.ValNote)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCoddeco, new { @pers_cs_field="ValCoddeco", @pers_cs_area="Decom", data_refresh = "true", @form_area="true", @data_value = Model.ValCoddeco, @data_identifier = "LED_ABATE___DECOMCODDECO_" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Abate" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Abate" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Abate" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Abate", Model.FormMode).ToString(), "Decom")", "Abate_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Abate_Delete", "Decom", new {id = @Model.ValCoddeco} )", "Abate_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Abate_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Abate_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitAbate(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Abate", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteAbate(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Abate", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitAbate(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Abate_Cancel", "Decom", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Abate.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Abate_Cancel","Decom","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Abate">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Abate" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Abate">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT ABATE]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_ABATE" data-form-javascript="true">
@Html.Partial("Abate_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
