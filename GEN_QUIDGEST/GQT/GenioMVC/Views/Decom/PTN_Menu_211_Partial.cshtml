@model GenioMVC.ViewModels.Decom.PTN_Menu_211_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Decom;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Decom>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoddeco, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_DTDECO]/
		column.Expression(p => p.ValDtdeco).Title(@Resources.DECOMISSION14486).Field("ValDtdeco").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_DECOMNR]/
		column.Expression(p => p.ValDecomnr).Title(@Resources.NO_BATE21045).Field("ValDecomnr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_NOTE]/
		column.Expression(p => p.ValNote).Title(@Resources.NOTES05274).Field("ValNote").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_CREATDAT]/
		column.Expression(p => p.ValCreatdat).Title(@Resources.CRIADO_EM61283).Field("ValCreatdat").Size(8);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_CREATOPE]/
		column.Expression(p => p.ValCreatope).Title(@Resources.CRIADO_POR17895).Field("ValCreatope").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_CHNGDATE]/
		column.Expression(p => p.ValChngdate).Title(@Resources.ALTERADO_EM23573).Field("ValChngdate").Size(8);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_211_DECOM_OPERCHNG]/
		column.Expression(p => p.ValOperchng).Title(@Resources.ALTERADO_POR39254).Field("ValOperchng").Size(20);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Decom")
        .Id("PTN_Menu_211")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Abatereq", false, false)
        .SetFollowUp("Abatereq_Edit", "Decom" , (Func<GenioMVC.Models.Decom, object>)(item => new { id = item.ValCoddeco }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qPTN_Menu_211, #PTN_Menu_211_complex_filter th input, #PTN_Menu_211_filters input").change(function() {
                    $("#pPTN_Menu_211").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#PTN_Menu_211_tableFilters').val(false);")
                    @Html.Raw("$('#PTN_Menu_211_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#PTN_Menu_211_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='PTN_Menu_211']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qPTN_Menu_211');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#PTN_Menu_211_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_PTN_Menu_211').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('PTN_Menu_211', 'ABATE', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PTN_MENU_211]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS PTN_MENU_211]/
</script>