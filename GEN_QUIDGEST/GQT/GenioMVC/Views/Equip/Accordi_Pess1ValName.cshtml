@model GenioMVC.ViewModels.Equip.Accordi_Pess1ValName_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.COMFORTERS51045</h2>
        </div>
        <div class="col-auto normal-view" id="Accordi_Pess1ValName_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qAccordi_Pess1ValName", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Accordi_Pess1ValName.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Accordi_Pess1ValName_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Accordi_Pess1ValName_complex_filter', 'Accordi_Pess1ValName_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
        <div class="col-auto">
            <div class="b-btn-group" id="viewMode">
                <button type="button" class="b-btn b-icon b-icon--secondary" onclick="hideShowDiv('Accordi_Pess1ValName_filters')" title="@Resources.MOSTRAR50268/@Resources.ESCONDER31385 @Resources.FILTROS01340"><i class="glyphicons glyphicons-filter e-icon"></i></button>
                <button type="button" class="active b-btn b-icon b-icon--secondary" id="normal_view"><i class="glyphicons glyphicons-list e-icon"></i></button>
                <button type="button" class="b-btn b-icon b-icon--secondary" id="tree_view"><i class="glyphicons glyphicons-tree-structure e-icon"></i></button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div id="Accordi_Pess1ValName_filters">
                <div class="filter-box">
                    <div class ="form-check-inline">
                        <label class="i-checkbox i-checkbox__label i-checkbox--inline">@Resources.FEMALE46107
                            @Html.CheckBox("filter_Accordi_Pess1ValName_FILTER1", Model.Navigation.CheckKey("filter_Accordi_Pess1ValName_FILTER1_1") ? (bool)Model.Navigation.GetValue("filter_Accordi_Pess1ValName_FILTER1_1") : false, new { @class="input-filter", value = "1", onclick="window.Accordi_Pess1ValName.Search()" })
                            <span class="i-checkbox__field"></span>
                        </label>
                    </div>
                </div>
                <div class="filter-box">
                    <div class ="form-check-inline">
                        <label class="i-checkbox i-checkbox__label i-checkbox--inline">@Resources.MALE32397
                            @Html.CheckBox("filter_Accordi_Pess1ValName_FILTER2", Model.Navigation.CheckKey("filter_Accordi_Pess1ValName_FILTER2_1") ? (bool)Model.Navigation.GetValue("filter_Accordi_Pess1ValName_FILTER2_1") : false, new { @class="input-filter", value = "1", onclick="window.Accordi_Pess1ValName.Search()" })
                            <span class="i-checkbox__field"></span>
                        </label>
                    </div>
                </div>
             @Html.Hidden("Menu_tableFilters", this.Model.Menu.TableFilters)
        </div>
    </div>
</div>

<div class="normal-view">
@using GenioMVC.ViewModels.Pess1;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Pess1>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodpesso, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN ACCORDI_NAME_PESS1_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(85);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValName).Field("ValName").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Pess1")
        .Id("Accordi_Pess1ValName")
        .AjaxRequest("Accordi_Pess1ValName")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Accordi_Pess1ValName", new { id = Model.ValCodequip, partialView = "Accordi_Pess1ValName", CmpnyValCodempre = Model.ValCodempre}))
        .Filters(this.Model.Menu.Filters)
        .Form("Pess1", false, false, new { data_skip_prevalida = "true" })
        .UpdateConditions((item)=>Pess1_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Pess1_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Pess1_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Pess1_ViewModel.InsertConditions(this.Model.Navigation))
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()
</div>
<div class="c-modal__body n-treeview" id="qSeeMoreTree_body" style="display:none;"></div>
<script>
    try {
        if (jQuery) {
            try {
                $("#viewMode.btn-group > .btn").click(function(){
                    $(".btn-group > .btn").removeClass("active");
                    $(this).addClass("active");
                });
                $("#tree_view", $("#viewMode.b-btn-group")).click(function(){
                    var modal = $(this).closest('#modal-dbedit');
                    var treeBody = $("#qSeeMoreTree_body", modal);
                    $(".normal-view", modal).hide(); treeBody.show();
                    if(!treeBody.data('tree')) {
                        $("#qSeeMoreTree_body", modal).treeSeeMoreFor($('[data-identifier="IFF_ACCORDI_PESS1NAME____"]'));
                    }
                });
                $("#normal_view", $("#viewMode.b-btn-group")).click(function(){
                    var modal = $(this).closest('#modal-dbedit');
                    var treeBody = $("#qSeeMoreTree_body", modal);
                    treeBody.hide(); $(".normal-view", modal).show();
                    if(treeBody.data('tree')) {
                        // Force a reload - some filters might be active on tree-view but not in normal-view
                        window.Accordi_Pess1ValName.Search();
                    }

                });
                $("#qAccordi_Pess1ValName, #TablePess1Name_complex_filter th input").change(function() {
                    var context = $("#TablePess1Name").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Accordi_Pess1ValName table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_ACCORDI_PESS1NAME____"]');

                    selectList.trigger("DBEditSetValue", key);

                    var changedFilters = localStorage.getItem("filter_Accordi_Pess1ValName");
                    if (changedFilters == "true"){
                        var selectListControl = selectList.getQControl();
                        $.when(selectListControl.ReloadDBEditContent()).then(function() { selectList.trigger("DBEditSetValue", key); });
                    }
                    localStorage.removeItem("filter_Accordi_Pess1ValName");
                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Accordi_Pess1ValName_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Accordi_Pess1ValName_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Accordi_Pess1ValName_extra').prop("disabled", true);
</text>
}


                $(document).ready(function() {
                    if (localStorage.getItem("filter_Accordi_Pess1ValName") == null)
                        localStorage.setItem("filter_Accordi_Pess1ValName", false);
                    else
                        localStorage.setItem("filter_Accordi_Pess1ValName", true);
                });
// USE /[MANUAL GQT LISTING_JS ACCORDI_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>
