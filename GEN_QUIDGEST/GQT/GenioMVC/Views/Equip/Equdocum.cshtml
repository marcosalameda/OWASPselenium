@model GenioMVC.ViewModels.Equip.Equdocum_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Equdocum";
	ViewBag.Title = @Resources.DOCUMENTS_FROM_EQUIP36805;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Equip", FormMethod.Post, new { @class = "form-horizontal", area="Equip", data_form="Equdocum" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Equdocum" area="Equip" data-form="Equdocum">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Equdocum_well" area="Equip" data-form="Equdocum">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_EQUDOCUMEQUIPDESIGNAT">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValDesignat, new { label_id="LED_EQUDOCUMEQUIPDESIGNAT", @class = " i-text__label", id="LABEL_LED_EQUDOCUMEQUIPDESIGNAT"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_EQUDOCUMEQUIPDESIGNAT','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValDesignat, new {help_id = "LED_EQUDOCUMEQUIPDESIGNAT", data_toggle = "tooltip", title = @Resources._112047598, data_placement = "top", description = @Resources._1120_VERBOSE06198, @class = "i-text__field i-text input-xxlarge", data_refresh = "true", data_tipoform = "DF", data_identifier = "LED_EQUDOCUMEQUIPDESIGNAT", @pers_cs_area = "Equip", @pers_cs_field = "ValDesignat", @db_field = "ValDesignat", maxlength = "85", rows = "30" })
								@Html.ValidationMessageFor(model => model.ValDesignat)
							</div>
						</div>
						<div class="control-join-group">
									<div class = "i-dbedit">
										@Html.ActionLinkWithIcon(@Resources.ADD_ANEXD17106, "", "", "", new { }, new {id = "equdocum_Btn_anex", data_identifier = "IFF_EQUDOCUMPSEUDBTN_ANEX", @class = "b-icon-text b-icon-text--secondary", data_btn_open_form = "true", data_form_area = "Anexd", data_form_name = "Anexd_New", data_form_mode = "NEW", @data_form_key = "LED_EQUDOCUMEQUIPCODEQUIP", data_skip_prevalida = "false", help_id = "IFF_EQUDOCUMPSEUDBTN_ANEX", data_toggle = "tooltip", title = @Resources._112414944, data_placement = "top", description = @Resources._1124_VERBOSE42774 })
									</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_EQUDOCUMPSEUDLISANEX_">
								<div id="Equdocum_ValLisanex" data-identifier="IFF_EQUDOCUMPSEUDLISANEX_"  data-extra-options="" > 
									@{ Html.RenderAction("Equdocum_ValLisanex", "Equip", new { id = Model.ValCodequip, partialView = "Equdocum_ValLisanex"}); }
								</div>
						</div>
					</div>
				</div>
			</div>


		@Html.HiddenFor(model=> model.ValRegistnr, new { @pers_cs_area = "Equip", @pers_cs_field = "ValRegistnr", @data_identifier = "LED_EQUDOCUMEQUIPREGISTNR" })
		@Html.HiddenFor(model=> model.ItemValItemdes, new { @pers_cs_area = "Item", @pers_cs_field = "ValItemdes", @data_identifier = "LED_EQUDOCUMITEM_ITEMDES_" })

			@Html.HiddenFor(model => model.ValCoddeco, new { @pers_cs_field="ValCoddeco", @pers_cs_area="Equip", @data_value = Model.ValCoddeco, @db_field="ValCoddeco", @trelate="Decom", @tfrelate="Coddeco", @data_identifier="LED_EQUDOCUMDECOMCODDECO_" })
			@Html.HiddenFor(model => model.ValCodpess1, new { @pers_cs_field="ValCodpess1", @pers_cs_area="Equip", @data_value = Model.ValCodpess1, @db_field="ValCodpess1", @trelate="Pess1", @tfrelate="Codpesso", @data_identifier="LED_EQUDOCUMPESS1CODPESSO" })
			@Html.HiddenFor(model => model.ValCodempre, new { @pers_cs_field="ValCodempre", @pers_cs_area="Equip", @data_value = Model.ValCodempre, @db_field="ValCodempre", @trelate="Cmpny", @tfrelate="Codempre", @data_identifier="LED_EQUDOCUMCMPNYCODEMPRE" })
			@Html.HiddenFor(model => model.ValCodwareh, new { @pers_cs_field="ValCodwareh", @pers_cs_area="Equip", @data_value = Model.ValCodwareh, @db_field="ValCodwareh", @trelate="Wareh", @tfrelate="Codwareh", @data_identifier="LED_EQUDOCUMWAREHCODWAREH" })
			@Html.HiddenFor(model => model.ValCoditem, new { @pers_cs_field="ValCoditem", @pers_cs_area="Equip", @data_value = Model.ValCoditem, @db_field="ValCoditem", @trelate="Item", @tfrelate="Coditem", @data_identifier="LED_EQUDOCUMITEM_CODITEM_" })
			@Html.HiddenFor(model => model.ValCodtpequ, new { @pers_cs_field="ValCodtpequ", @pers_cs_area="Equip", @data_value = Model.ValCodtpequ, @db_field="ValCodtpequ", @trelate="Tpequ", @tfrelate="Codtpequ", @data_identifier="LED_EQUDOCUMTPEQUCODTPEQU" })
			@Html.HiddenFor(model => model.ValCodrooms, new { @pers_cs_field="ValCodrooms", @pers_cs_area="Equip", @data_value = Model.ValCodrooms, @db_field="ValCodrooms", @trelate="Room1", @tfrelate="Codrooms", @data_identifier="LED_EQUDOCUMROOM1CODROOMS" })

			@Html.HiddenFor(model => model.ValCodequip, new { @pers_cs_field="ValCodequip", @pers_cs_area="Equip", data_refresh = "true", @form_area="true", @data_value = Model.ValCodequip, @data_identifier = "LED_EQUDOCUMEQUIPCODEQUIP" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Equdocum" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Equdocum" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Equdocum" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Equdocum", Model.FormMode).ToString(), "Equip"))", "Equdocum_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Equdocum_Delete", "Equip", new {id = @Model.ValCodequip} )", "Equdocum_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Equdocum_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Equdocum_Delete", "Equip", new {id = @Model.ValCodequip} )", "Equdocum_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Equdocum_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitEqudocum(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Equdocum", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteEqudocum(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Equdocum", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitEqudocum(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Equdocum_Cancel", "Equip", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Equdocum.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Equdocum_Cancel","Equip","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Equdocum">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Equdocum" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Equdocum">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

