{
<div class="hidden" id="FormJavaScript_EQUDOCUM" data-form-javascript="true">
@Html.Partial("Equdocum_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

