	window.Form_Equip.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValRegistnr' field *@
		$(qForm).bind('VALSEQUENNR_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.RIGHT("000000"+qApi.NumericToString( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValSequennr', $('[data-form="Equip"]'))),0),6));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValRegistnr', $('[data-form="Equip"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValRegistnr', $('[data-form="Equip"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValRegistnr', $('[data-form="Equip"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValRegistnr: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Default of the 'ValDesignat' field *@
		window.Form_Equip.SetFormulaDefault('LED_EQUIP___EQUIPDESIGNAT', function() {
						return ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValCoditem', $('[data-form="Equip"]')), true));
		}, 'ITEMVALITEMDES_CHANGE VALCODITEM_CHANGE');
		
		@* Formula of the 'ValBought' field *@
		$(qForm).bind('VALDTAQUISI_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDtaquisi', $('[data-form="Equip"]'))))==1,0,1));
