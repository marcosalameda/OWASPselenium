        {
            column.Expression(p => p.ValCodanexd, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_ANEXOS_ANEXD_DTHRANEX]/
		column.Expression(p => p.ValDthranex).Title(@Resources.ATTACHED26247).Field("ValDthranex").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_ANEXOS_ANEXD_TITLE]/
		column.Expression(p => p.ValTitle).Title(@Resources.TITLE21885).Field("ValTitle").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_ANEXOS_ANEXD_DOCUMENT]/
		column.Expression(p => p.ValDocument).Title(@Resources.DOCUMENT00695).Field("ValDocument").Size(30).Document(p => Url.Action("GetFile", "Anexd", new { ticket = p.GetTicketForDocField("ValDocument"), viewType = (int)CSGenio.framework.DocumentViewTypeMode.Print}));
