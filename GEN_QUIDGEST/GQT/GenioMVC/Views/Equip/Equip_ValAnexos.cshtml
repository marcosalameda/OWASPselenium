        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Anexd")
        .Id("ValAnexos")
        .AjaxRequest("Equip_ValAnexos")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Equip_ValAnexos", new { id = Model.ValCodequip, partialView = "Equip_ValAnexos"}))
        .Form("Anexd", false, false)
        .SetFollowUp("Anexd_Show", "Anexd" , (Func<GenioMVC.Models.Anexd, object>)(item => new { id = item.ValCodanexd }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

