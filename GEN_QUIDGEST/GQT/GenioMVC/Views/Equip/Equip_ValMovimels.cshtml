                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValMovimels_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
