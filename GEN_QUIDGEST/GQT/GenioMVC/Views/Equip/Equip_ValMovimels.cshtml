	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR EQUIP_MOVIMELS]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Movim;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Movim>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodmovim, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_MOVIMELS_MOVIM_DHMUDANC]/
		column.Expression(p => p.ValDhmudanc).Title(@Resources.CHANGE36355).Field("ValDhmudanc").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_MOVIMELS_ROOMS_ROOMNR]/
		column.Expression(p => p.Rooms.ValRoomnr).Title(@Resources.N_R__ROOM43805).Field("Rooms.ValRoomnr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_MOVIMELS_ROOMS_DESIGNAT]/
		column.Expression(p => p.Rooms.ValDesignat).Title(@Resources.ROOM_DESIGNATION37895).Field("Rooms.ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP_MOVIMELS_MOVIM_OBSERVAT]/
		column.Expression(p => p.ValObservat).Title(@Resources.OBSERVATION37880).Field("ValObservat").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Movim")
        .Id("ValMovimels")
        .AjaxRequest("Equip_ValMovimels")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Equip_ValMovimels", new { id = Model.ValCodequip, partialView = "Equip_ValMovimels"}))
        .Form("Movim", false, false)
        .SetFollowUp("Movim_Show", "Movim" , (Func<GenioMVC.Models.Movim, object>)(item => new { id = item.ValCodmovim }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


