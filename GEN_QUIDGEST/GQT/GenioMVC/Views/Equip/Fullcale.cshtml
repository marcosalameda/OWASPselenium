@model GenioMVC.ViewModels.Equip.Fullcale_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Fullcale";
	ViewBag.Title = @Resources.FULL_CALENDAR15524;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Equip", FormMethod.Post, new { @class = "form-horizontal", area="Equip", data_form="Fullcale" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Fullcale" area="Equip" data-form="Fullcale">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Fullcale_well" area="Equip" data-form="Fullcale">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_FULLCALEPSEUDFULLCALE">
								<div id="Fullcale_ValFullcale" data-identifier="IFF_FULLCALEPSEUDFULLCALE" class="ccontrol-FullCalendar" data-extra-options="dayGridMonth,timeGridWeek,timeGridDay" > 
									@{ Html.RenderAction("Fullcale_ValFullcale", "Equip", new { id = Model.ValCodequip, partialView = "Fullcale_ValFullcale"}); }
								</div>
						</div>
					</div>
				</div>
			</div>


		@Html.HiddenFor(model=> model.ValRegistnr, new { @pers_cs_area = "Equip", @pers_cs_field = "ValRegistnr", @data_identifier = "LED_FULLCALEEQUIPREGISTNR" })

			@Html.HiddenFor(model => model.ValCodtpequ, new { @pers_cs_field="ValCodtpequ", @pers_cs_area="Equip", @data_value = Model.ValCodtpequ, @db_field="ValCodtpequ", @trelate="Tpequ", @tfrelate="Codtpequ", @data_identifier="LED_FULLCALETPEQUCODTPEQU" })
			@Html.HiddenFor(model => model.ValCodrooms, new { @pers_cs_field="ValCodrooms", @pers_cs_area="Equip", @data_value = Model.ValCodrooms, @db_field="ValCodrooms", @trelate="Room1", @tfrelate="Codrooms", @data_identifier="LED_FULLCALEROOM1CODROOMS" })
			@Html.HiddenFor(model => model.ValCoddeco, new { @pers_cs_field="ValCoddeco", @pers_cs_area="Equip", @data_value = Model.ValCoddeco, @db_field="ValCoddeco", @trelate="Decom", @tfrelate="Coddeco", @data_identifier="LED_FULLCALEDECOMCODDECO_" })
			@Html.HiddenFor(model => model.ValCodpess1, new { @pers_cs_field="ValCodpess1", @pers_cs_area="Equip", @data_value = Model.ValCodpess1, @db_field="ValCodpess1", @trelate="Pess1", @tfrelate="Codpesso", @data_identifier="LED_FULLCALEPESS1CODPESSO" })
			@Html.HiddenFor(model => model.ValCodempre, new { @pers_cs_field="ValCodempre", @pers_cs_area="Equip", @data_value = Model.ValCodempre, @db_field="ValCodempre", @trelate="Cmpny", @tfrelate="Codempre", @data_identifier="LED_FULLCALECMPNYCODEMPRE" })
			@Html.HiddenFor(model => model.ValCodwareh, new { @pers_cs_field="ValCodwareh", @pers_cs_area="Equip", @data_value = Model.ValCodwareh, @db_field="ValCodwareh", @trelate="Wareh", @tfrelate="Codwareh", @data_identifier="LED_FULLCALEWAREHCODWAREH" })
			@Html.HiddenFor(model => model.ValCoditem, new { @pers_cs_field="ValCoditem", @pers_cs_area="Equip", @data_value = Model.ValCoditem, @db_field="ValCoditem", @trelate="Item", @tfrelate="Coditem", @data_identifier="LED_FULLCALEITEM_CODITEM_" })

			@Html.HiddenFor(model => model.ValCodequip, new { @pers_cs_field="ValCodequip", @pers_cs_area="Equip", data_refresh = "true", @form_area="true", @data_value = Model.ValCodequip, @data_identifier = "LED_FULLCALEEQUIPCODEQUIP" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Fullcale" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Fullcale" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Fullcale" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Fullcale", Model.FormMode).ToString(), "Equip"))", "Fullcale_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Fullcale_Delete", "Equip", new {id = @Model.ValCodequip} )", "Fullcale_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Fullcale_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Fullcale_Delete", "Equip", new {id = @Model.ValCodequip} )", "Fullcale_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Fullcale_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFullcale(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Fullcale", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteFullcale(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Fullcale", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFullcale(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Fullcale_Cancel", "Equip", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Fullcale.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Fullcale_Cancel","Equip","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Fullcale">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Fullcale" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Fullcale">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT FULLCALE]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_FULLCALE" data-form-javascript="true">
@Html.Partial("Fullcale_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

<link href="@Url.Content("~/Scripts/FullCalendar/packages/core/main.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/Scripts/FullCalendar/packages/bootstrap/main.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/Scripts/FullCalendar/packages/daygrid/main.min.css")" rel="stylesheet" />
   <link href="@Url.Content("~/Scripts/FullCalendar/packages/timegrid/main.min.css")" rel="stylesheet" />
       }

@section include_stylesheets {
    @includeStylesheets()
}
