@model GenioMVC.ViewModels.Equip.GQT_Menu_211_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Equip.GQT_Menu_211_ViewModel modelGQT_Menu_211 = new GenioMVC.ViewModels.Equip.GQT_Menu_211_ViewModel(Navigation);
	var columns = modelGQT_Menu_211.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "cmpny" && areaField.Field == "designat")
		{
			fields.Add("CMPNY.DESIGNAT", new TableFilterField("CMPNY", "DESIGNAT", Resources.DESIGNATION35876, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "sequennr")
		{
			fields.Add("EQUIP.SEQUENNR", new TableFilterField("EQUIP", "SEQUENNR", Resources.SEQUENTIAL_NO_38590, "num"));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text", defaultSearch : true));
		}
		if (areaField.Area == "tpequ" && areaField.Field == "tipoequi")
		{
			fields.Add("TPEQU.TIPOEQUI", new TableFilterField("TPEQU", "TIPOEQUI", Resources.TYPE_OF_EQUIPMENT18080, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "designat")
		{
			fields.Add("EQUIP.DESIGNAT", new TableFilterField("EQUIP", "DESIGNAT", Resources.DESIGNATION35876, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtaquisi")
		{
			fields.Add("EQUIP.DTAQUISI", new TableFilterField("EQUIP", "DTAQUISI", Resources.ACQUISITION44180, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtdeco")
		{
			fields.Add("EQUIP.DTDECO", new TableFilterField("EQUIP", "DTDECO", Resources.DECOMISSION14486, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "sitefabr")
		{
			fields.Add("EQUIP.SITEFABR", new TableFilterField("EQUIP", "SITEFABR", Resources.SITIO_FABRICANTE26458, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_211", "Equip", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Equip", data_form="GQT_Menu_211" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_211_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_211", Navigation.GetStrValue("qGQT_Menu_211"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_211');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_211');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__REGISTER04207})
					<button id="qGQT_Menu_211-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_211", fields, "EQUIP")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_211', 'EQUIP', 'EQUIP.REGISTNR');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@if (!Model.IsViewModeHidden("LIST"))
						{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_211_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_211_complex_filter', 'GQT_Menu_211_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_211")
					</div>
				</div>
			</div>
			@{
				var listBtnCssClass = Model.IsViewModeHidden("LIST") ? "b-icon--secondary" : "b-icon--primary";
				var alternativeViewBtnCssClass = Model.IsViewModeHidden("LIST") ? "b-icon--primary" : "b-icon--secondary";

				<div class="col-auto" style="padding: 0; padding-right: 15px">
					<div class="b-btn-group">
						<button class="b-btn b-icon @listBtnCssClass" type="button" onclick="window.GQT_Menu_211.ToggleViewMode('GQT_Menu_211', 'Equip', 'Equip', '9c20afa8-9950-45e5-9447-fccf9853de7d', 1)" title="@Resources.MUDAR_PARA_VISTA_EM_03626"><i class="glyphicons glyphicons-show-lines e-icon"></i></button>
						<button class="b-btn b-icon @alternativeViewBtnCssClass" type="button" onclick="window.GQT_Menu_211.ToggleViewMode('GQT_Menu_211', 'Equip', 'Equip', '9c20afa8-9950-45e5-9447-fccf9853de7d', 2)" title="@Resources.MUDAR_PARA_VISTA_ALT46064"><i class="glyphicons glyphicons-show-big-thumbnails e-icon"></i></button>
					</div>
				</div>
			}
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@Html.ExportListMenu("GQT_Menu_211")
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_211" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_211", idlistController = "Equip", idlistArea = "Equip", codlista ="9c20afa8-9950-45e5-9447-fccf9853de7d" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
		</div>
                    <!---------- Filters ------------>
                        <div class="row-fluid">
                            <div class="span12">
                                <div id="GQT_Menu_211_filters">
									<div class="filter-box">
                                        <div class="form-check-inline">
											<label class="i-checkbox i-checkbox__label i-checkbox--inline">
												@Resources.ATIVOS54304
												@Html.CheckBox("filter_GQT_Menu_211_ActiveFilter_A", Model.Navigation.CheckKey("filter_GQT_Menu_211_ActiveFilter_A") ? (bool)Model.Navigation.GetValue("filter_GQT_Menu_211_ActiveFilter_A") : true, new { @class = "input-filter", value = "true"})
												<span class="i-checkbox__field"></span>
											</label>
											<label class="i-checkbox i-checkbox__label i-checkbox--inline">
												@Resources.INATIVOS00149
												@Html.CheckBox("filter_GQT_Menu_211_ActiveFilter_I", Model.Navigation.CheckKey("filter_GQT_Menu_211_ActiveFilter_I") ? (bool)Model.Navigation.GetValue("filter_GQT_Menu_211_ActiveFilter_I") : false, new { @class = "input-filter", value = "true"})
												<span class="i-checkbox__field"></span>
											</label>
											<label class="i-checkbox i-checkbox__label i-checkbox--inline">
												@Resources.FUTUROS10545
												@Html.CheckBox("filter_GQT_Menu_211_ActiveFilter_F", Model.Navigation.CheckKey("filter_GQT_Menu_211_ActiveFilter_F") ? (bool)Model.Navigation.GetValue("filter_GQT_Menu_211_ActiveFilter_F") : false, new { @class = "input-filter", value = "true"})
												<span class="i-checkbox__field"></span>
											</label>
											<div class="i-date-picker labelleft" id="CONTAINER_LED_CAMPO___CAMPODATA____">
												<div class="d-inline-flex">
													@Html.LabelFor(model => model.DataRef, new { label_id = "LED_DATAREF", @class = " i-text__label" }, true, false)                                
												</div>
												@Html.DateFor(model => model.DataRef, new {id = "GQT_Menu_211_dataRef",  @class = "i-input-group__field b-icon-text input-small"})
												@Html.ValidationMessageFor(model => model.DataRef)
											</div>										
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_211_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_211" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_211 = new QMenuForm($('[data-form="GQT_Menu_211"]'), "Form_GQT_Menu_211");
		window.Form_GQT_Menu_211.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_211.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_211");
		RegisterClearEvents("GQT_Menu_211")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("GQT_Menu_211", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_211"]'));

		$($("[data-form='GQT_Menu_211']")).bind('GQT_MENU_211_DATAREF_CHANGE', function (event, eTarget) {
			window.GQT_Menu_211.Search();
		});

 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_211"]'));
	}

	function ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer) {
		if (bottomInsertBtn) {
			if ($(window).scrollTop() + $(window).height() > $(document).height() - 50)
				insertBtnContainer.addClass("menu-insert-btn-top-hidden");
			else
				insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
		}
	}

	var nav = $('#header-container > nav')[0];
	var header = $(".page-header");
	var threshold_el = $('.c-header').length ? $('.c-header') : $('nav').first();
	var breadcrumbs = $('#breadcrumbs').height() ? $('#breadcrumbs') : $('[aria-label=breadcrumb]');
	header.css('min-height', 50);

	// get the insert button
	var bottomInsertBtn = $('[qbutton=insert]')[0];

	if (bottomInsertBtn) {
		var insertBtn = $.clone($('[qbutton=insert]')[0]);
		insertBtn.innerHTML = insertBtn.innerHTML.replace(insertBtn.innerText, '');
		insertBtn = $(insertBtn);
		insertBtn.removeClass();
		insertBtn.addClass('b-btn b-icon b-icon--secondary');

		// find the page header
		var pageHeader = $('.page-header')[0];
		var newCol = $("<div class='col'></div>");

		// insert
		var insertBtnContainer = $("<div class='menu-insert-btn-top c-action-bar b-btn-group'></div>");
		insertBtn.appendTo(insertBtnContainer);
		insertBtnContainer.appendTo(newCol);
		$(".page-header > div:nth-child(1)").after($(newCol));

		// adjust table title max width
		$('.table-title').parent().addClass("table-title-min");
		insertBtnContainer.parent().css("margin-left", "-.7rem");

		insertBtnContainer.addClass("menu-insert-btn-top-hidden");
		if ($(window).scrollTop() + $(window).height() <= $(document).height() - 50)
			insertBtnContainer.removeClass("menu-insert-btn-top-hidden");
	}

	$(window).scroll(function () {
		ToggleMenuStickyHeader(nav, header, breadcrumbs, threshold_el);
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	});

	$(window).resize(function () {
		ToggleTopInsertButton(bottomInsertBtn, insertBtnContainer);
	})
</script>
}

@section code_javascript {
	@codeJavascript()
}
