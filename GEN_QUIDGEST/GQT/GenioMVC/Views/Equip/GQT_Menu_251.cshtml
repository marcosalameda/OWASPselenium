
@using GenioMVC.Resources
@model GenioMVC.ViewModels.Equip.GQT_Menu_251_ViewModel
@using System.Web.Script.Serialization
@{
    var Navigation = Model.Navigation;
    //Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
 } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	GenioMVC.ViewModels.Equip.GQT_Menu_251_ViewModel modelGQT_Menu_251 = new GenioMVC.ViewModels.Equip.GQT_Menu_251_ViewModel(Navigation);
	var columns = modelGQT_Menu_251.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text", defaultSearch : true));
		}
		if (areaField.Area == "equip" && areaField.Field == "designat")
		{
			fields.Add("EQUIP.DESIGNAT", new TableFilterField("EQUIP", "DESIGNAT", Resources.EQUIPMENT03632, "text"));
		}
		if (areaField.Area == "room1" && areaField.Field == "roomnr")
		{
			fields.Add("ROOM1.ROOMNR", new TableFilterField("ROOM1", "ROOMNR", Resources.N_R__ROOM43805, "text"));
		}
		if (areaField.Area == "tpequ" && areaField.Field == "tipoequi")
		{
			fields.Add("TPEQU.TIPOEQUI", new TableFilterField("TPEQU", "TIPOEQUI", Resources.TYPE_OF_EQUIPMENT18080, "text"));
		}
		if (areaField.Area == "wareh" && areaField.Field == "warehdes")
		{
			fields.Add("WAREH.WAREHDES", new TableFilterField("WAREH", "WAREHDES", Resources.WAREHOUSE51864, "text"));
		}
		if (areaField.Area == "item" && areaField.Field == "itemdes")
		{
			fields.Add("ITEM.ITEMDES", new TableFilterField("ITEM", "ITEMDES", Resources.ARTICLE60065, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>

<div data-form="GQT_Menu_251" id="Menu_tabs">
    <div elem-identifier="Tabbable" class="tabbable">
        <ul class="nav c-tab c-tab__divider">
            <li class="nav-item c-tab__item active"><a class="nav-link" data-toggle="tab" href="#FirstTab">@Resources.EQUIPMENT03632</a></li>
            <li class="nav-item c-tab__item"> <a class="nav-link" data-toggle="tab" href="#SecondTab">
					@Resources.ROOMS06809
			</a></li>
        </ul>

        <div class="c-tab__item-container">
            <div id="FirstTab" class="c-tab__item-content fade in active">
                @using (Ajax.BeginForm("GQT_Menu_251", "Equip", new AjaxOptions
                {
                    HttpMethod= "POST",
                    InsertionMode = InsertionMode.Replace,
                    UpdateTargetId = "GQT_Menu_251_Container",
                    OnSuccess = "InitMenuSpecialControls"
                }, new { @class = "form-horizontal", area="Equip", data_form="GQT_Menu_251" }))
                {
                    <div id="Menu">
                        
                            <div class="row">
                               <div class="col"></div>
                               <div class="col-auto search" style="padding:0; padding-right: 15px">
                                    <div class="i-input-group input-xxlarge" id="GQT_Menu_251_simple_filter">
                                       <div data-search-filter-menu-elem="filter-box-list"></div>
                                        @Html.TextBox("qGQT_Menu_251", Navigation.GetStrValue("qGQT_Menu_251"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_251');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_251');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__REGISTER04207})                                        <div class="i-input-group--right">
                                        <button id="qGQT_Menu_251-clearBtn" class="clear-search d-none" type="button">
                                            <i class="glyphicons glyphicons-remove mr-1"></i>
                                        </button>

                                        @Html.SearchFieldMenu("GQT_Menu_251", fields, "EQUIP")


                                            <button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" title="@Resources.PESQUISAR34506"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
                                            <button id="GQT_Menu_251_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_251_complex_filter', 'GQT_Menu_251_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                                        </div>
                                    </div>  
                                </div>
                            
                            </div>
                        <div class="row-fluid">
                            <div class="span3 row-large-control pull-right">
								</div>
                        </div>

                        <div id="row">
                            <div id="col-12">
                                <div data-identifier="GQT_Menu_251" id="GQT_Menu_251_Container" class="noselect">
                                    @{ Html.RenderPartial("GQT_Menu_251_Partial"); }
                                </div>
                            </div>
                        </div>
                        @Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_251" })
                        @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "GQT_Menu_251" })
                        @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "GQT_Menu_251" })
                        @Html.AntiForgeryToken()
                    </div>
                }
            </div>
            <div id="SecondTab" class="c-tab__item-content fade">
                <div class="row">
                    <div class="col-12">
                        <div data-identifier="GQT_Menu_2511" id="GQT_Menu_2511_Container" class="noselect">
                            @{ Html.RenderAction("GQT_Menu_2511", "Rooms"); }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 mt-1 mb-1">
                        <button elem-identifier="ButtonPrimary" id="secondTabApply" class="b-icon-text b-icon-text--secondary" onclick="window.GQT_Menu_251_Control.Send('@HttpUtility.JavaScriptStringEncode(Url.Action("GQT_Menu_251_Execute"))', '@Url.Action("GQT_Menu_251", Helpers.ToRouteValues(Request.QueryString))')" qbutton="apply"><i class="glyphicons glyphicons-bring-forward e-icon"></i>@Resources.APLICAR33981</button>
                    </div>
                </div>
                <div class="row">
                    <div id="PreviewTable" class="col-12">
                        <span class="f-header__title">@Resources.SELECIONADOS52011</span>
                        <div class="table-responsive">
                            <p id="PreviewTableCaption"></p>
                            <table  class="c-table table-resizable">
                                <thead class="c-table__head">
                                    <tr>
                                        <th class="thead-actions pull-right"><button class="b-icon-text b-icon-text--secondary" title="Reset" type="reset" id="btnExTableReset" qbutton="reset"><i class="glyphicons glyphicons-refresh e-icon"></i></button></th>
                                        <th><a>@Resources.N_R__ROOM43805</a></th>
                                        <th><a>@Resources.ROOM_DESIGNATION37895</a></th>
                                </thead>
                                <tbody class="c-table__body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>    </div></div>
@section code_javascript
{
<script>
    QLocalStorage.remLocalStorage("savedInfo");
    function InitMenuSpecialControls() {
        InitSpecialControls($('[data-form="GQT_Menu_251"]'));
    }
    $(document).ready(function (e) { 
        InitMenuSpecialControls();
        var activeTab = QLocalStorage.getLocalStorage("Tab");
        if(!$.isEmptyObject(activeTab)) { $('a[href="#' + activeTab + '"]').click(); }
        else { $('a[href="#FirstTab"]').click(); }
        var saveTabState = function(tabEvent) {
            QLocalStorage.setLocalStorage("Tab", tabEvent.data);
        };
        $('a[href="#FirstTab"]').click('FirstTab', saveTabState);
        $('a[href="#SecondTab"]').click('SecondTab', saveTabState);
        window.GQT_Menu_251_Control = new QMenuDFControl('#GQT_Menu_251_Container', '#GQT_Menu_2511_Container');
        window.GQT_Menu_251_Control.Init();
        $(document).trigger('GQT_Menu_251_FirstTabInit');

        window.Form_GQT_Menu_251 = new QMenuForm($('[data-form="GQT_Menu_251"]'), "Form_GQT_Menu_251");
        window.Form_GQT_Menu_251.Init();
    });

    InitSearchFieldMenu("qGQT_Menu_251");
    RegisterClearEvents("GQT_Menu_251");
	$(document).ready(applyComplexFilterIDs());
</script>
}
