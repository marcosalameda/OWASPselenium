
@using GenioMVC.Resources
@model GenioMVC.ViewModels.Equip.GQT_Menu_2C11_ViewModel
@using System.Web.Script.Serialization
@{
    var Navigation = Model.Navigation;
    //Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
 } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	GenioMVC.ViewModels.Equip.GQT_Menu_2C11_ViewModel modelGQT_Menu_2C11 = new GenioMVC.ViewModels.Equip.GQT_Menu_2C11_ViewModel(Navigation);
	var columns = modelGQT_Menu_2C11.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text", defaultSearch : true));
		}
		if (areaField.Area == "equip" && areaField.Field == "designat")
		{
			fields.Add("EQUIP.DESIGNAT", new TableFilterField("EQUIP", "DESIGNAT", Resources.EQUIPMENT03632, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtaquisi")
		{
			fields.Add("EQUIP.DTAQUISI", new TableFilterField("EQUIP", "DTAQUISI", Resources.ACQUISITION44180, "date"));
		}
		if (areaField.Area == "decom" && areaField.Field == "decomnr")
		{
			fields.Add("DECOM.DECOMNR", new TableFilterField("DECOM", "DECOMNR", Resources.NO_BATE21045, "num"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtdeco")
		{
			fields.Add("EQUIP.DTDECO", new TableFilterField("EQUIP", "DTDECO", Resources.DECOMISSION14486, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "ifabatif")
		{
			fields.Add("EQUIP.IFABATIF", new TableFilterField("EQUIP", "IFABATIF", Resources.DOWNED_EQUIPMENT43331, "bool"));
		}
		if (areaField.Area == "room1" && areaField.Field == "roomnr")
		{
			fields.Add("ROOM1.ROOMNR", new TableFilterField("ROOM1", "ROOMNR", Resources.N_R__ROOM43805, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>

<div data-form="GQT_Menu_2C11" id="Menu_tabs">
    <div elem-identifier="Tabbable" class="tabbable">
        <ul class="nav c-tab c-tab__divider">
            <li class="nav-item c-tab__item active"><a class="nav-link" data-toggle="tab" href="#FirstTab">@Resources.EQUIPMENT03632</a></li>
            <li class="nav-item c-tab__item"> <a class="nav-link" data-toggle="tab" href="#SecondTab">
					@Resources.EQUIPMENT_DECOMISSIO62648
			</a></li>
        </ul>

        <div class="c-tab__item-container">
            <div id="FirstTab" class="c-tab__item-content fade in active">
                @using (Ajax.BeginForm("GQT_Menu_2C11", "Equip", new AjaxOptions
                {
                    HttpMethod= "POST",
                    InsertionMode = InsertionMode.Replace,
                    UpdateTargetId = "GQT_Menu_2C11_Container",
                    OnSuccess = "InitMenuSpecialControls"
                }, new { @class = "form-horizontal", area="Equip", data_form="GQT_Menu_2C11" }))
                {
                    <div id="Menu">
                        
                            <div class="row">
                               <div class="col"></div>
                               <div class="col-auto search" style="padding:0; padding-right: 15px">
                                    <div class="i-input-group input-xxlarge" id="GQT_Menu_2C11_simple_filter">
                                       <div data-search-filter-menu-elem="filter-box-list"></div>
                                        @Html.TextBox("qGQT_Menu_2C11", Navigation.GetStrValue("qGQT_Menu_2C11"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_2C11');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_2C11');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__REGISTER04207})                                        <div class="i-input-group--right">
                                        <button id="qGQT_Menu_2C11-clearBtn" class="clear-search d-none" type="button">
                                            <i class="glyphicons glyphicons-remove mr-1"></i>
                                        </button>

                                        @Html.SearchFieldMenu("GQT_Menu_2C11", fields, "EQUIP")


                                            <button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" title="@Resources.PESQUISAR34506"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
                                            <button id="GQT_Menu_2C11_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_2C11_complex_filter', 'GQT_Menu_2C11_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                                        </div>
                                    </div>  
                                </div>
                            
                            </div>
                        <div class="row-fluid">
                            <div class="span3 row-large-control pull-right">
								</div>
                        </div>

                        <div id="row">
                            <div id="col-12">
                                <div data-identifier="GQT_Menu_2C11" id="GQT_Menu_2C11_Container" class="noselect">
                                    @{ Html.RenderPartial("GQT_Menu_2C11_Partial"); }
                                </div>
                            </div>
                        </div>
                        @Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_2C11" })
                        @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "GQT_Menu_2C11" })
                        @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "GQT_Menu_2C11" })
                        @Html.AntiForgeryToken()
                    </div>
                }
            </div>
            <div id="SecondTab" class="c-tab__item-content fade">
                <div class="row">
                    <div class="col-12">
                        <div data-identifier="GQT_Menu_2C111" id="GQT_Menu_2C111_Container" class="noselect">
                            @{ Html.RenderAction("GQT_Menu_2C111", "Decom"); }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 mt-1 mb-1">
                        <button elem-identifier="ButtonPrimary" id="secondTabApply" class="b-icon-text b-icon-text--secondary" onclick="window.GQT_Menu_2C11_Control.Send('@HttpUtility.JavaScriptStringEncode(Url.Action("GQT_Menu_2C11_Execute"))', '@Url.Action("GQT_Menu_2C11", Helpers.ToRouteValues(Request.QueryString))')" qbutton="apply"><i class="glyphicons glyphicons-bring-forward e-icon"></i>@Resources.APLICAR33981</button>
                    </div>
                </div>
                <div class="row">
                    <div id="PreviewTable" class="col-12">
                        <span class="f-header__title">@Resources.SELECIONADOS52011</span>
                        <div class="table-responsive">
                            <p id="PreviewTableCaption"></p>
                            <table  class="c-table table-resizable">
                                <thead class="c-table__head">
                                    <tr>
                                        <th class="thead-actions pull-right"><button class="b-icon-text b-icon-text--secondary" title="Reset" type="reset" id="btnExTableReset" qbutton="reset"><i class="glyphicons glyphicons-refresh e-icon"></i></button></th>
                                        <th><a>@Resources.NO__REGISTER04207</a></th>
                                        <th><a>@Resources.EQUIPMENT03632</a></th>
                                        <th><a>@Resources.ACQUISITION44180</a></th>
                                        <th><a>@Resources.NO_BATE21045</a></th>
                                        <th><a>@Resources.DECOMISSION14486</a></th>
                                        <th><a>@Resources.DOWNED_EQUIPMENT43331</a></th>
                                        <th><a>@Resources.PHOTO51874</a></th>
                                        <th><a>@Resources.N_R__ROOM43805</a></th>
                                </thead>
                                <tbody class="c-table__body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>    </div></div>
@section code_javascript
{
<script>
    QLocalStorage.remLocalStorage("savedInfo");
    function InitMenuSpecialControls() {
        InitSpecialControls($('[data-form="GQT_Menu_2C11"]'));
    }
    $(document).ready(function (e) { 
        InitMenuSpecialControls();
        var activeTab = QLocalStorage.getLocalStorage("Tab");
        if(!$.isEmptyObject(activeTab)) { $('a[href="#' + activeTab + '"]').click(); }
        else { $('a[href="#FirstTab"]').click(); }
        var saveTabState = function(tabEvent) {
            QLocalStorage.setLocalStorage("Tab", tabEvent.data);
        };
        $('a[href="#FirstTab"]').click('FirstTab', saveTabState);
        $('a[href="#SecondTab"]').click('SecondTab', saveTabState);
        window.GQT_Menu_2C11_Control = new QMenuDEControl('#GQT_Menu_2C11_Container', '#GQT_Menu_2C111_Container');
        window.GQT_Menu_2C11_Control.Init();
        $(document).trigger('GQT_Menu_2C11_FirstTabInit');

        window.Form_GQT_Menu_2C11 = new QMenuForm($('[data-form="GQT_Menu_2C11"]'), "Form_GQT_Menu_2C11");
        window.Form_GQT_Menu_2C11.Init();
    });

    InitSearchFieldMenu("qGQT_Menu_2C11");
    RegisterClearEvents("GQT_Menu_2C11");
	$(document).ready(applyComplexFilterIDs());
</script>
}
