        .ToGoogleMaps(hasFilters: false)
		;
        
}

@tbl.ToGoogleMapsHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValInstalac, #ValInstalac_complex_filter th input, #ValInstalac_filters input").change(function() {
                    $("#pValInstalac").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValInstalac_tableFilters').val(false);")
