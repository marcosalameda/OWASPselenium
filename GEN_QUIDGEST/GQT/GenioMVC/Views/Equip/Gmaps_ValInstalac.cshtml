                    @:      $('#ValInstalac_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValInstalac_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValInstalac').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
