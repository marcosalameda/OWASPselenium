	window.Form_Groupbx.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValRegistnr' field *@
		$(qForm).bind('VALSEQUENNR_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.RIGHT("000000"+qApi.NumericToString( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValSequennr', $('[data-form="Groupbx"]'))),0),6));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValRegistnr', $('[data-form="Groupbx"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValRegistnr', $('[data-form="Groupbx"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValRegistnr', $('[data-form="Groupbx"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValRegistnr: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Default of the 'ValDesignat' field *@
		window.Form_Groupbx.SetFormulaDefault('LED_GROUPBX_EQUIPDESIGNAT', function() {
						return ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValCoditem', $('[data-form="Groupbx"]')), true));
		}, 'ITEMVALITEMDES_CHANGE VALCODITEM_CHANGE');
		
		@* Formula of the 'ValBought' field *@
		$(qForm).bind('VALDTAQUISI_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDtaquisi', $('[data-form="Groupbx"]'))))==1,0,1));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValBought', $('[data-form="Groupbx"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValBought', $('[data-form="Groupbx"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValBought', $('[data-form="Groupbx"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValBought: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Recalculate formulas (server side) *@
		$(qForm).bind('VALCODDECO_CHANGE VALDTREFERE_CHANGE VALCODEQUIP_CHANGE', function(event, eTarget) {
				window.Form_Groupbx.RecalculateFormulas();
		});
		





	</text>
}

