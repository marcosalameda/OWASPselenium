@model GenioMVC.ViewModels.Equip.STY_Menu_ACCORD_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Equip;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Equip>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodequip, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_CMPNY_DESIGNAT]/
		column.Expression(p => p.Cmpny.ValDesignat).Title(@Resources.DESIGNATION35876).Field("Cmpny.ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_EQUIP_SEQUENNR]/
		column.Expression(p => p.ValSequennr).Title(@Resources.SEQUENTIAL_NO_38590).Field("ValSequennr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_EQUIP_REGISTNR]/
		column.Expression(p => p.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("ValRegistnr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_TPEQU_TIPOEQUI]/
		column.Expression(p => p.Tpequ.ValTipoequi).Title(@Resources.TYPE_OF_EQUIPMENT18080).Field("Tpequ.ValTipoequi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_EQUIP_DESIGNAT]/
		column.Expression(p => p.ValDesignat).Title(@Resources.DESIGNATION35876).Field("ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_EQUIP_DTAQUISI]/
		column.Expression(p => p.ValDtaquisi).Title(@Resources.ACQUISITION44180).Field("ValDtaquisi").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_EQUIP_DTDECO]/
		column.Expression(p => p.ValDtdeco).Title(@Resources.DECOMISSION14486).Field("ValDtdeco").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_ACCORD_EQUIP_SITEFABR]/
		column.Expression(p => p.ValSitefabr).Title(@Resources.SITIO_FABRICANTE26458).Field("ValSitefabr").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Equip")
        .Id("STY_Menu_ACCORD")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Accordi", false, true)
        .SetFollowUp("Accordi_Show", "Equip" , (Func<GenioMVC.Models.Equip, object>)(item => new { id = item.ValCodequip }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_ACCORD, #STY_Menu_ACCORD_complex_filter th input, #STY_Menu_ACCORD_filters input").change(function() {
                    $("#pSTY_Menu_ACCORD").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_ACCORD_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_ACCORD_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_ACCORD_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_ACCORD']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_ACCORD');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_ACCORD_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_ACCORD').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_ACCORD', 'EQUIP', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_ACCORD]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS STY_MENU_ACCORD]/
</script>