{
<div class="hidden" id="FormJavaScript_TIMEQUIP" data-form-javascript="true">
@Html.Partial("Timequip_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

