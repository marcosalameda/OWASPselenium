@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
	<text>
		window.Form_Despe.OnPreValida = function (mode, target) {
			var deferred = $.Deferred();
			var onPreValidaCode = function () {
				var deferred = $.Deferred();
				var stopReturn = false;

// USE /[MANUAL GQT PREVALI DESPE]/

				@*Return é obrigatorio to execução sincrona do código*@
				if (!stopReturn) deferred.resolve(true);
				return deferred.promise();
			};

			$.when(onPreValidaCode(), { deferred: deferred, mode: mode }).done(function (resManual, rData) {
				if (resManual) {
						rData.deferred.resolve(true);
				}
				else rData.deferred.resolve(false);
			});

			return deferred.promise();
		};

		window.Form_Despe.OnBeforeSave = function () {
			var stopReturn = false;
			var deferred = $.Deferred();
// USE /[MANUAL GQT BEFORE_SAVE_JS DESPE]/
			@*Return é obrigatorio to execução sincrona do código*@
			if(!stopReturn) deferred.resolve(true);
			return deferred.promise();
		};

		window.Form_Despe.OnAfterSave = function (data) {
			var stopReturn = false;
			var deferred = $.Deferred();
// USE /[MANUAL GQT AFTER_SAVE_JS DESPE]/
			@*Return é obrigatorio to execução sincrona do código*@
			if(!stopReturn) deferred.resolve(true);
			return deferred.promise();
		};
	</text>
}
@{
	<text>
		window.Form_Despe.Data.RelationKeysSelector = {
				get proje() { return $(':not([elem-identifier="Multiform"]) > #ValCodproje[pers-cs-area="Proje"]', $('[data-form="Despe"]')); /* DBEdit */ },
				get year() { return $(':not([elem-identifier="Multiform"]) > #ValCodyear[pers-cs-area="Year"]', $('[data-form="Despe"]')); /* DBEdit */ },
				get agreg() { return $(':not([elem-identifier="Multiform"]) > #ValCodaggre[pers-cs-area="Agreg"]', $('[data-form="Despe"]')); /* DBEdit */ },
		};

		window.Form_Despe.getAllForeignKeySelectors = function () {
			@* Get all selectors of foreign keys present on the form *@
			return this.Data.RelationKeysSelector;
		};

		window.Form_Despe.Data.RelationKeys = {
			get formContext() { return window.Form_Despe; },
			get proje() { return (this.formContext.Data.RelationKeysSelector.proje.getQControl() || {}).Value; /* DBEdit */ },
			set proje(newValue) { (this.formContext.Data.RelationKeysSelector.proje.getQControl() || {}).Value = newValue; /* DBEdit */ },
			get year() { return (this.formContext.Data.RelationKeysSelector.year.getQControl() || {}).Value; /* DBEdit */ },
			set year(newValue) { (this.formContext.Data.RelationKeysSelector.year.getQControl() || {}).Value = newValue; /* DBEdit */ },
			get agreg() { return (this.formContext.Data.RelationKeysSelector.agreg.getQControl() || {}).Value; /* DBEdit */ },
			set agreg(newValue) { (this.formContext.Data.RelationKeysSelector.agreg.getQControl() || {}).Value = newValue; /* DBEdit */ },
		};
	</text>
}

	window.Form_Despe.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValYearprev' field *@
		$(qForm).bind('YEARVALYEARNUM_CHANGE', function(event, eTarget) {
				try {
						var newValue = ( getFieldValue($(':not([elem-identifier="Multiform"]) > #YearValYearnum', $('[data-form="Despe"]')))-1);
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValYearprev', $('[data-form="Despe"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValYearprev', $('[data-form="Despe"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValYearprev', $('[data-form="Despe"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValYearprev: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Recalculate formulas (server side) *@
		$(qForm).bind('VALYEARPREV_CHANGE', function(event, eTarget) {
				window.Form_Despe.RecalculateFormulas();
		});
		





	</text>
}

