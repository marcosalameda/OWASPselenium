@model GenioMVC.ViewModels.Expen.GQT_Menu_A21_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Expen;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Expen>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoddespe, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_YEAR_YEAR]/
		column.Expression(p => p.Year.ValYear).Title(@Resources.ANO33022).Field("Year.ValYear").Size(4);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_EXPEN_YEARNUMB]/
		column.Expression(p => p.ValYearnumb).Title(@Resources.ANO_NUMERICO_51058).Field("ValYearnumb").Size(4);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_AGREG_VALUE]/
		column.Expression(p => p.Agreg.ValValue).Title(@Resources.VALUE10285).Field("Agreg.ValValue").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_EXPEN_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION07383).Field("ValDescript").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_EXPEN_VALUE]/
		column.Expression(p => p.ValValue).Title(@Resources.VALUE10285).Field("ValValue").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_EXPEN_PREVVAL]/
		column.Expression(p => p.ValPrevval).Title(@Resources.VALOR_ANTERIOR54849).Field("ValPrevval").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_A21_PROJE_PROJECTO]/
		column.Expression(p => p.Proje.ValProjecto).Title(@Resources.PROJECTO50142).Field("Proje.ValProjecto").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Expen")
        .Id("GQT_Menu_A21")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Despe", false, false)
        .SetFollowUp("Despe_Show", "Expen" , (Func<GenioMVC.Models.Expen, object>)(item => new { id = item.ValCoddespe }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_A21, #GQT_Menu_A21_complex_filter th input, #GQT_Menu_A21_filters input").change(function() {
                    $("#pGQT_Menu_A21").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_A21_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_A21_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_A21_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_A21']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_A21');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_A21_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_A21').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_A21', 'DESPE', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_A21]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_A21]/
</script>