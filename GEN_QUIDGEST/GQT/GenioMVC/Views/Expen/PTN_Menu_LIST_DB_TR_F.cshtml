@model GenioMVC.ViewModels.Expen.PTN_Menu_LIST_DB_TR_F_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Expen.PTN_Menu_LIST_DB_TR_F_ViewModel modelPTN_Menu_LIST_DB_TR_F = new GenioMVC.ViewModels.Expen.PTN_Menu_LIST_DB_TR_F_ViewModel(Navigation);
	var columns = modelPTN_Menu_LIST_DB_TR_F.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "year" && areaField.Field == "year")
		{
			fields.Add("YEAR.YEAR", new TableFilterField("YEAR", "YEAR", Resources.ANO33022, "text"));
		}
		if (areaField.Area == "expen" && areaField.Field == "yearnumb")
		{
			fields.Add("EXPEN.YEARNUMB", new TableFilterField("EXPEN", "YEARNUMB", Resources.ANO_NUMERICO_51058, "num"));
		}
		if (areaField.Area == "agreg" && areaField.Field == "value")
		{
			fields.Add("AGREG.VALUE", new TableFilterField("AGREG", "VALUE", Resources.VALUE10285, "num"));
		}
		if (areaField.Area == "expen" && areaField.Field == "descript")
		{
			fields.Add("EXPEN.DESCRIPT", new TableFilterField("EXPEN", "DESCRIPT", Resources.DESCRIPTION07383, "text", defaultSearch : true));
		}
		if (areaField.Area == "expen" && areaField.Field == "value")
		{
			fields.Add("EXPEN.VALUE", new TableFilterField("EXPEN", "VALUE", Resources.VALUE10285, "num"));
		}
		if (areaField.Area == "expen" && areaField.Field == "prevval")
		{
			fields.Add("EXPEN.PREVVAL", new TableFilterField("EXPEN", "PREVVAL", Resources.VALOR_ANTERIOR54849, "num"));
		}
		if (areaField.Area == "proje" && areaField.Field == "projecto")
		{
			fields.Add("PROJE.PROJECTO", new TableFilterField("PROJE", "PROJECTO", Resources.PROJECTO50142, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("PTN_Menu_LIST_DB_TR_F", "Expen", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Expen", data_form="PTN_Menu_LIST_DB_TR_F" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="PTN_Menu_LIST_DB_TR_F_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qPTN_Menu_LIST_DB_TR_F", Navigation.GetStrValue("qPTN_Menu_LIST_DB_TR_F"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('PTN_Menu_LIST_DB_TR_F');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('PTN_Menu_LIST_DB_TR_F');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.DESCRIPTION07383})
					<button id="qPTN_Menu_LIST_DB_TR_F-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("PTN_Menu_LIST_DB_TR_F", fields, "EXPEN")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('PTN_Menu_LIST_DB_TR_F', 'EXPEN', 'EXPEN.DESCRIPT');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="PTN_Menu_LIST_DB_TR_F_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#PTN_Menu_LIST_DB_TR_F_complex_filter', 'PTN_Menu_LIST_DB_TR_F_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("PTN_Menu_LIST_DB_TR_F")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="PTN_Menu_LIST_DB_TR_F" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "PTN_Menu_LIST_DB_TR_F", idlistController = "Expen", idlistArea = "Expen", codlista ="a393a10a-95b6-4384-8269-4b89e5ab094a" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("PTN_Menu_LIST_DB_TR_F_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "PTN_Menu_LIST_DB_TR_F" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_PTN_Menu_LIST_DB_TR_F = new QMenuForm($('[data-form="PTN_Menu_LIST_DB_TR_F"]'), "Form_PTN_Menu_LIST_DB_TR_F");
		window.Form_PTN_Menu_LIST_DB_TR_F.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_PTN_Menu_LIST_DB_TR_F.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qPTN_Menu_LIST_DB_TR_F");
		RegisterClearEvents("PTN_Menu_LIST_DB_TR_F")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("PTN_Menu_LIST_DB_TR_F", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="PTN_Menu_LIST_DB_TR_F"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="PTN_Menu_LIST_DB_TR_F"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
