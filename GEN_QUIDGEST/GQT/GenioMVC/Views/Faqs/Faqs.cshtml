@model GenioMVC.ViewModels.Faqs.Faqs_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Faqs";
	ViewBag.Title = @Resources.FAQS53959;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Faqs", FormMethod.Post, new { @class = "form-horizontal", area="Faqs", data_form="Faqs" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Faqs" area="Faqs" data-form="Faqs">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Faqs_well" area="Faqs" data-form="Faqs">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-textarea draggable " id="CONTAINER_LED_FAQS____FAQS_QUESTION">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValQuestion, new { label_id="LED_FAQS____FAQS_QUESTION", @class = " i-text__label", id="LABEL_LED_FAQS____FAQS_QUESTION"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_FAQS____FAQS_QUESTION','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextAreaFor(model => model.ValQuestion, 0, 99, new {help_id = "LED_FAQS____FAQS_QUESTION", @class = "i-textarea__field i-textarea input-xxlarge", data_identifier = "LED_FAQS____FAQS_QUESTION", @pers_cs_area = "Faqs", @pers_cs_field = "ValQuestion", @db_field = "ValQuestion", title = @Resources.QUESTION00194 })
								@Html.ValidationMessageFor(model => model.ValQuestion)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group control-wrap">
						<div class="i-textarea draggable " id="CONTAINER_IFF_FAQS____FAQS_ANSWER__">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValAnswer, new { label_id="IFF_FAQS____FAQS_ANSWER__", @class = " i-text__label", id="LABEL_IFF_FAQS____FAQS_ANSWER__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_FAQS____FAQS_ANSWER__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								<div data-field-name="ValAnswer" data-identifier="IFF_FAQS____FAQS_ANSWER__" pers-cs-area="Faqs" pers-cs-field="ValAnswer"  help-id="IFF_FAQS____FAQS_ANSWER__">
								@if(Model.IsEditableMode) {
									@Html.EditorFor(model => model.ValAnswer, new {help_id = "IFF_FAQS____FAQS_ANSWER__", @class = "input-xxlarge", data_identifier = "IFF_FAQS____FAQS_ANSWER__", data_readonly = !Model.IsEditableMode })
								} else {
									@Html.Raw(Helpers.SanitizeHTML(Server.HtmlDecode(Model.ValAnswer), true))
								}
								</div>
								@Html.ValidationMessageFor(model => model.ValAnswer)
							</div>
						</div>
					</div>
				</div>
			</div>



			@Html.HiddenFor(model => model.ValCodcfaqs, new { @pers_cs_field="ValCodcfaqs", @pers_cs_area="Faqs", @data_value = Model.ValCodcfaqs, @db_field="ValCodcfaqs", @trelate="Cfaqs", @tfrelate="Codcfaqs", @data_identifier="LED_FAQS____CFAQSCODCFAQS" })

			@Html.HiddenFor(model => model.ValCodfaqs, new { @pers_cs_field="ValCodfaqs", @pers_cs_area="Faqs", data_refresh = "true", @form_area="true", @data_value = Model.ValCodfaqs, @data_identifier = "LED_FAQS____FAQS_CODFAQS_" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Faqs" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Faqs" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Faqs" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Faqs", Model.FormMode).ToString(), "Faqs"))", "Faqs_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Faqs_Delete", "Faqs", new {id = @Model.ValCodfaqs} )", "Faqs_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Faqs_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Faqs_Delete", "Faqs", new {id = @Model.ValCodfaqs} )", "Faqs_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Faqs_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFaqs(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Faqs", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteFaqs(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Faqs", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitFaqs(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Faqs_Cancel", "Faqs", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Faqs.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Faqs_Cancel","Faqs","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Faqs">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Faqs" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Faqs">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT FAQS]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_FAQS" data-form-javascript="true">
@Html.Partial("Faqs_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
