@model GenioMVC.ViewModels.Faqs.STY_Menu_35911_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Faqs>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodfaqs, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_35911_FAQS_QUESTION]/
		column.Expression(p => p.ValQuestion).Title(@Resources.QUESTION00194).Field("ValQuestion").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_35911_FAQS_ANSWER]/
		column.Expression(p => p.ValAnswer).Title(@Resources.ANSWER22961).Field("ValAnswer").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Faqs")
        .Id("STY_Menu_35911")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
    var collapsiblerowslist = data
        .ToSpecialRendering()
		.SetSpecialRendering(this.Model.ViewModesCfg.SpecialRenderings.FirstOrDefault(sr => sr.Id == "COLLAPSIBLEROWSLIST"))
        .Filters(this.Model.Menu.Filters)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@{ renderings.Clear(); }
@{ renderings.Add(Model.GetViewModePosition("COLLAPSIBLEROWSLIST"), collapsiblerowslist.ToSpecialRenderingHtml(hidden: Model.IsViewModeHidden("COLLAPSIBLEROWSLIST"))); }

@{ renderings.Add(2, @tbl.ToHtml(hidden: true)); }

@foreach (var render in renderings.ToList().OrderBy(r => r.Key))
{
    @Html.Raw(render.Value.ToHtmlString());
}


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_35911, #STY_Menu_35911_complex_filter th input, #STY_Menu_35911_filters input").change(function() {
                    $("#pSTY_Menu_35911").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_35911_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_35911_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_35911_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_35911']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_35911');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_35911_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_35911').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_35911', 'FAQS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_35911]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS STY_MENU_35911]/
</script>