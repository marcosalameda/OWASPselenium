@model GenioMVC.ViewModels.Feeca.Feeca_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Feeca";
	ViewBag.Title = @Resources.FEEDBACK_CAMPO42437;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Feeca", FormMethod.Post, new { enctype="multipart/form-data", @class = "form-horizontal", area="Feeca", data_form="Feeca" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Feeca" area="Feeca" data-form="Feeca">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Feeca_well" area="Feeca" data-form="Feeca">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

