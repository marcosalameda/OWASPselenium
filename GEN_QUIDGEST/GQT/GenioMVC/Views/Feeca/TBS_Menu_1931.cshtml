@model GenioMVC.ViewModels.Feeca.TBS_Menu_1931_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Feeca.TBS_Menu_1931_ViewModel modelTBS_Menu_1931 = new GenioMVC.ViewModels.Feeca.TBS_Menu_1931_ViewModel(Navigation);
	var columns = modelTBS_Menu_1931.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "flds" && areaField.Field == "descrip")
		{
			fields.Add("FLDS.DESCRIP", new TableFilterField("FLDS", "DESCRIP", Resources.DESCRICAO51618, "text"));
		}
		if (areaField.Area == "feeca" && areaField.Field == "feedback")
		{
			fields.Add("FEECA.FEEDBACK", new TableFilterField("FEECA", "FEEDBACK", Resources.FEEDBACK52855, "text", defaultSearch : true));
		}
		if (areaField.Area == "flds" && areaField.Field == "attach")
		{
			fields.Add("FLDS.ATTACH", new TableFilterField("FLDS", "ATTACH", Resources.ANEXOS65235, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("TBS_Menu_1931", "Feeca", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Feeca", data_form="TBS_Menu_1931" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="TBS_Menu_1931_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qTBS_Menu_1931", Navigation.GetStrValue("qTBS_Menu_1931"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('TBS_Menu_1931');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('TBS_Menu_1931');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.FEEDBACK52855})
					<button id="qTBS_Menu_1931-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("TBS_Menu_1931", fields, "FEECA")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('TBS_Menu_1931', 'FEECA', 'FEECA.FEEDBACK');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="TBS_Menu_1931_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#TBS_Menu_1931_complex_filter', 'TBS_Menu_1931_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("TBS_Menu_1931")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="TBS_Menu_1931" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "TBS_Menu_1931", idlistController = "Feeca", idlistArea = "Feeca", codlista ="bcd28de4-9e50-4d1a-92e0-3c661c0ab999" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("TBS_Menu_1931_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "TBS_Menu_1931" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_TBS_Menu_1931 = new QMenuForm($('[data-form="TBS_Menu_1931"]'), "Form_TBS_Menu_1931");
		window.Form_TBS_Menu_1931.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_TBS_Menu_1931.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qTBS_Menu_1931");
		RegisterClearEvents("TBS_Menu_1931")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("TBS_Menu_1931", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="TBS_Menu_1931"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="TBS_Menu_1931"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
