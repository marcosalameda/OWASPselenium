        {
            column.Expression(p => p.ValCodfeeca, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN FLDSTBL_FEECA_FLDS_DESCRIP]/
		column.Expression(p => p.Flds.ValDescrip).Title(@Resources.DESCRIPTION07383).Field("Flds.ValDescrip").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN FLDSTBL_FEECA_FEECA_FEEDBACK]/
