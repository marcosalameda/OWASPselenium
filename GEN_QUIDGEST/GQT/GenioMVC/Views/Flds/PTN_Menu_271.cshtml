@model GenioMVC.ViewModels.Flds.PTN_Menu_271_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Flds.PTN_Menu_271_ViewModel modelPTN_Menu_271 = new GenioMVC.ViewModels.Flds.PTN_Menu_271_ViewModel(Navigation);
	var columns = modelPTN_Menu_271.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrAcondtst = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayAcondtst.GetDictionary())
	{
		arrAcondtst.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "flds" && areaField.Field == "cond")
		{
			fields.Add("FLDS.COND", new TableFilterField("FLDS", "COND", Resources.FIELD_STATE03599, "enum", array : arrAcondtst));
		}
		if (areaField.Area == "flds" && areaField.Field == "fclient1")
		{
			fields.Add("FLDS.FCLIENT1", new TableFilterField("FLDS", "FCLIENT1", Resources.FIELD_WITH_CLIENT_SI60452, "text"));
		}
		if (areaField.Area == "flds" && areaField.Field == "fserver1")
		{
			fields.Add("FLDS.FSERVER1", new TableFilterField("FLDS", "FSERVER1", Resources.FIELD_WITH_SERVER_SI13554, "date"));
		}
		if (areaField.Area == "flds" && areaField.Field == "fclient2")
		{
			fields.Add("FLDS.FCLIENT2", new TableFilterField("FLDS", "FCLIENT2", Resources.FIELD_WITH_CLIENT_SI60452, "bool"));
		}
		if (areaField.Area == "flds" && areaField.Field == "fserver2")
		{
			fields.Add("FLDS.FSERVER2", new TableFilterField("FLDS", "FSERVER2", Resources.FIELD_WITH_SERVER_SI13554, "num"));
		}
		if (areaField.Area == "flds" && areaField.Field == "fclient3")
		{
			fields.Add("FLDS.FCLIENT3", new TableFilterField("FLDS", "FCLIENT3", Resources.FIELD_WITH_CLIENT_SI60452, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("PTN_Menu_271", "Flds", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Flds", data_form="PTN_Menu_271" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="PTN_Menu_271_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qPTN_Menu_271", Navigation.GetStrValue("qPTN_Menu_271"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('PTN_Menu_271');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('PTN_Menu_271');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.FIELD_STATE03599})
					<button id="qPTN_Menu_271-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("PTN_Menu_271", fields, "FLDS")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('PTN_Menu_271', 'FLDS', 'FLDS.COND');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="PTN_Menu_271_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#PTN_Menu_271_complex_filter', 'PTN_Menu_271_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("PTN_Menu_271")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="PTN_Menu_271" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "PTN_Menu_271", idlistController = "Flds", idlistArea = "Flds", codlista ="32a1f511-9029-4390-aa28-2f7ddfc6c2c6" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("PTN_Menu_271_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "PTN_Menu_271" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_PTN_Menu_271 = new QMenuForm($('[data-form="PTN_Menu_271"]'), "Form_PTN_Menu_271");
		window.Form_PTN_Menu_271.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_PTN_Menu_271.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qPTN_Menu_271");
		RegisterClearEvents("PTN_Menu_271")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("PTN_Menu_271", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="PTN_Menu_271"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="PTN_Menu_271"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
