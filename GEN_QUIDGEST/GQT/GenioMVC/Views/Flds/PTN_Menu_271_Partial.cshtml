@model GenioMVC.ViewModels.Flds.PTN_Menu_271_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Flds;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Flds>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodflds, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_COND]/
		column.Expression(p => p.ArrayValcond).Title(@Resources.FIELD_STATE03599).Field("ValCond", "ArrayAcondtst").Size(8);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_FCLIENT1]/
		column.Expression(p => p.ValFclient1).Title(@Resources.FIELD_WITH_CLIENT_SI60452).Field("ValFclient1").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_FSERVER1]/
		column.Expression(p => p.ValFserver1).Title(@Resources.FIELD_WITH_SERVER_SI13554).Field("ValFserver1").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_FCLIENT2]/
		column.Expression(p => p.ValFclient2).Title(@Resources.FIELD_WITH_CLIENT_SI60452).Field("ValFclient2").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_FSERVER2]/
		column.Expression(p => p.ValFserver2).Title(@Resources.FIELD_WITH_SERVER_SI13554).Field("ValFserver2").Size(8);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_FCLIENT3]/
		column.Expression(p => p.ValFclient3).Title(@Resources.FIELD_WITH_CLIENT_SI60452).Field("ValFclient3").Size(30).Document(p => Url.Action("GetFile", "Flds", new { ticket = p.GetTicketForDocField("ValFclient3"), viewType = (int)CSGenio.framework.DocumentViewTypeMode.Preview})).AddHtmlAttribute("target", "_blank");
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_271_FLDS_FSERVER3]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValFserver3, new {alt=@Resources.FIELD_WITH_SERVER_SI13554,}, Url.Action("ImageHandlerGet", "Home", new { ticket = Helpers.GetFileTicket(UserContext.Current.User, "Flds", "ValFserver3", "", p.ValCodflds, null) }))).Title(@Resources.FIELD_WITH_SERVER_SI13554).Field("ValFserver3").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Flds")
        .Id("PTN_Menu_271")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Fldscond", false, true)
        .UpdateConditions((item)=>Fldscond_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Fldscond_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Fldscond_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Fldscond_ViewModel.InsertConditions(this.Model.Navigation))
        .SetFollowUp("Fldscond_Show", "Flds" , (Func<GenioMVC.Models.Flds, object>)(item => new { id = item.ValCodflds }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qPTN_Menu_271, #PTN_Menu_271_complex_filter th input, #PTN_Menu_271_filters input").change(function() {
                    $("#pPTN_Menu_271").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#PTN_Menu_271_tableFilters').val(false);")
                    @Html.Raw("$('#PTN_Menu_271_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#PTN_Menu_271_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='PTN_Menu_271']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qPTN_Menu_271');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#PTN_Menu_271_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_PTN_Menu_271').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('PTN_Menu_271', 'FLDS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PTN_MENU_271]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS PTN_MENU_271]/
</script>