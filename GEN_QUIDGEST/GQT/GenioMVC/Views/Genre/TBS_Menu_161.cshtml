@model GenioMVC.ViewModels.Genre.TBS_Menu_161_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Genre.TBS_Menu_161_ViewModel modelTBS_Menu_161 = new GenioMVC.ViewModels.Genre.TBS_Menu_161_ViewModel(Navigation);
	var columns = modelTBS_Menu_161.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrGenconta = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayGenconta.GetDictionary())
	{
		arrGenconta.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "genre" && areaField.Field == "gender")
		{
			fields.Add("GENRE.GENDER", new TableFilterField("GENRE", "GENDER", Resources.GENUS37471, "text", defaultSearch : true));
		}
		if (areaField.Area == "genre" && areaField.Field == "agencont")
		{
			fields.Add("GENRE.AGENCONT", new TableFilterField("GENRE", "AGENCONT", Resources.GENDER_CONTACT17830, "enum", array : arrGenconta));
		}
		if (areaField.Area == "genre" && areaField.Field == "backcolo")
		{
			fields.Add("GENRE.BACKCOLO", new TableFilterField("GENRE", "BACKCOLO", Resources.BACKGROUND_COLOR47883, "text"));
		}
		if (areaField.Area == "genre" && areaField.Field == "textcolo")
		{
			fields.Add("GENRE.TEXTCOLO", new TableFilterField("GENRE", "TEXTCOLO", Resources.TEXT_COLOR24820, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("TBS_Menu_161", "Genre", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Genre", data_form="TBS_Menu_161" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="TBS_Menu_161_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qTBS_Menu_161", Navigation.GetStrValue("qTBS_Menu_161"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('TBS_Menu_161');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('TBS_Menu_161');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.GENUS37471})
					<button id="qTBS_Menu_161-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("TBS_Menu_161", fields, "GENRE")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('TBS_Menu_161', 'GENRE', 'GENRE.GENDER');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="TBS_Menu_161_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#TBS_Menu_161_complex_filter', 'TBS_Menu_161_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("TBS_Menu_161")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="TBS_Menu_161" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "TBS_Menu_161", idlistController = "Genre", idlistArea = "Genre", codlista ="367a8002-7b01-45e4-9022-ea27414db6de" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("TBS_Menu_161_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "TBS_Menu_161" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_TBS_Menu_161 = new QMenuForm($('[data-form="TBS_Menu_161"]'), "Form_TBS_Menu_161");
		window.Form_TBS_Menu_161.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_TBS_Menu_161.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qTBS_Menu_161");
		RegisterClearEvents("TBS_Menu_161")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("TBS_Menu_161", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="TBS_Menu_161"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="TBS_Menu_161"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
