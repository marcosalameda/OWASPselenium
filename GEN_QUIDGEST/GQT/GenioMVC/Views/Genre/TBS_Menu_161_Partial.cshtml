@model GenioMVC.ViewModels.Genre.TBS_Menu_161_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Genre;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Genre>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodgenre, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN TBS_MENU_161_GENRE_GENDER]/
		column.Expression(p => p.ValGender).Title(@Resources.GENUS37471).Field("ValGender").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN TBS_MENU_161_GENRE_AGENCONT]/
		column.Expression(p => p.ArrayValagencont).Title(@Resources.GENDER_CONTACT17830).Field("ValAgencont", "ArrayGenconta").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN TBS_MENU_161_GENRE_BACKCOLO]/
		column.Expression(p => p.ValBackcolo).Title(@Resources.BACKGROUND_COLOR47883).Hidden().Field("ValBackcolo").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN TBS_MENU_161_GENRE_TEXTCOLO]/
		column.Expression(p => p.ValTextcolo).Title(@Resources.TEXT_COLOR24820).Hidden().Field("ValTextcolo").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Genre")
        .Id("TBS_Menu_161")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .BackgroundColourOnCondition(p => p.ValZzstate != 0 ? "" : ((CSGenio.business.GlobalFunctions.emptyC((p.ValBackcolo))==1)?("RGB(255,255,255)"):((p.ValBackcolo))))
        .ForegroundColourOnCondition(p => p.ValZzstate != 0 ? "" : ((CSGenio.business.GlobalFunctions.emptyC((p.ValTextcolo))==1)?("RGB(0,0,0)"):((p.ValTextcolo))))
        .Form("Genco", false, false)
        .SetFollowUp("Genco_Show", "Genre" , (Func<GenioMVC.Models.Genre, object>)(item => new { id = item.ValCodgenre }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qTBS_Menu_161, #TBS_Menu_161_complex_filter th input, #TBS_Menu_161_filters input").change(function() {
                    $("#pTBS_Menu_161").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#TBS_Menu_161_tableFilters').val(false);")
                    @Html.Raw("$('#TBS_Menu_161_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#TBS_Menu_161_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='TBS_Menu_161']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qTBS_Menu_161');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#TBS_Menu_161_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_TBS_Menu_161').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('TBS_Menu_161', 'GENCO', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS TBS_MENU_161]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS TBS_MENU_161]/
</script>