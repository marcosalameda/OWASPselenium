@model GenioMVC.ViewModels.Gitem.Artgl_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = @Resources.GLOBAL_ARTICLE63861;
	ViewBag.formmode = Model.GetFormMode;
}

<div class="c-modal__dialog c-modal--lg">
	@using (Ajax.BeginForm("Action", "Gitem", null, new AjaxOptions { UpdateTargetId = "form-modal" }, new { @class = "c-modal__content", area = "Gitem", data_form = "Artgl" }))
	{
		<div class="c-modal__content">
			<div class="c-modal__header" elem-identifier="modal-header">
				@form_header()
			</div>
			<div elem-identifier="ModalBody" class="c-modal__body">
				<div class="form-flow">
					@form_body()
				</div>
			</div>
			<div class="c-modal__footer">
				<div elem-identifier="Actions" class="actions" data-form-actions="Artgl">
					@form_footer()
				</div>
			</div>
		</div>
	}
</div>

@helper form_header() {
	@* BEGIN MVC Flash messages *@
	@Html.Action("Index", "Messages")
	@* END MVC Flash messages *@
		<div class="c-modal__header-title">
			<div class="d-flex">
				<div class="c-action-bar d-flex">
					<i class="form-popup-header-legend icon-@ViewBag.formmode ViewMode-@ViewBag.formmode"></i><h2>@ViewBag.Title</h2>
					<div data-parent-form="Artgl" data-q-ref="form-btns-main_container"></div>
				</div>
			</div>
		</div>
}

@helper form_body() {
	@form_content_alert()
	@Html.QValidationSummary()
	<fieldset>
		<legend class="hidden-elem">@ViewBag.Title</legend>
		<div class="form-flow">
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ARTGL___GITEMITEMDES_">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValItemdes, new { label_id="LED_ARTGL___GITEMITEMDES_", @class = " i-text__label", id="LABEL_LED_ARTGL___GITEMITEMDES_"}, true, true)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ARTGL___GITEMITEMDES_','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValItemdes, new {help_id = "LED_ARTGL___GITEMITEMDES_", @class = "i-text__field i-text input-xxlarge", data_identifier = "LED_ARTGL___GITEMITEMDES_", @pers_cs_area = "Gitem", @pers_cs_field = "ValItemdes", @db_field = "ValItemdes", title = @Resources.GLOBAL_ITEM49586, maxlength = "85", rows = "85" })
								@Html.ValidationMessageFor(model => model.ValItemdes)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ARTGL___GITEMITEMGCOD">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValItemgcod, new { label_id="LED_ARTGL___GITEMITEMGCOD", @class = " i-text__label", id="LABEL_LED_ARTGL___GITEMITEMGCOD"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ARTGL___GITEMITEMGCOD','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValItemgcod, new {help_id = "LED_ARTGL___GITEMITEMGCOD", @class = "i-text__field i-text input-medium", data_identifier = "LED_ARTGL___GITEMITEMGCOD", @pers_cs_area = "Gitem", @pers_cs_field = "ValItemgcod", @db_field = "ValItemgcod", title = @Resources.CODE49225, maxlength = "15", rows = "15" })
								@Html.ValidationMessageFor(model => model.ValItemgcod)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-document draggable " id="CONTAINER_LED_ARTGL___GITEMDOCUMENT">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValDocument, new { label_id="LED_ARTGL___GITEMDOCUMENT", @class = " i-text__label", id="LABEL_LED_ARTGL___GITEMDOCUMENT"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ARTGL___GITEMDOCUMENT','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@if (Model.IsEditableMode) {
									@Html.EditorFor(model => model.ValDocument, new { fieldFk = Model.ValDocumentfk, docProperties = Model.ValDocumentPropertiesVM, baseArea = "Gitem", baseAreaKey = Model.ValCodgitem, useTemplates =  false, data_identifier="LED_ARTGL___GITEMDOCUMENT", identifier = "FARTGL", fieldSize = "input-xxlarge", isRequired = false, maxSize = "null", allowedTypes = "null", htmlAttributes = new {help_id = "LED_ARTGL___GITEMDOCUMENT", data_toggle = "tooltip", title = @Resources.___1537256, data_placement = "top", description = @Resources.___15_VERBOSE09201 }})
								} else {
									@Html.DisplayFor(model => model.ValDocument, new { fieldFk = Model.ValDocumentfk, docProperties = Model.ValDocumentPropertiesVM, baseArea = "Gitem", baseAreaKey = Model.ValCodgitem, useTemplates =  false, data_identifier="LED_ARTGL___GITEMDOCUMENT", identifier = "FARTGL", fieldSize = "input-xxlarge", htmlAttributes = new {help_id = "LED_ARTGL___GITEMDOCUMENT", data_toggle = "tooltip", title = @Resources.___1537256, data_placement = "top", description = @Resources.___15_VERBOSE09201 }})
								}
								@Html.ValidationMessageFor(model => model.ValDocument)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodgitem, new { @pers_cs_field="ValCodgitem", @pers_cs_area="Gitem", @form_area="true", @data_value = Model.ValCodgitem, @data_identifier = "LED_ARTGL___GITEMCODGITEM" })

			@Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Artgl" })
			@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Artgl" })
			@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Artgl" })
			@Html.AntiForgeryToken()
		</div>
	</fieldset>
}

@helper form_content_alert(){
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_footer() {



			if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
			{

				if(Model.FormMode == FormMode.New && Convert.ToBoolean(Request.QueryString.Get("repeatInsertion")))
				{
				<button type="button" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" data-modal-form="true" data-modal-repeat-insertion="true" name="@(Helpers.FormModeActionName("Artgl", Model.FormMode))" data-modal-url='@Url.Action(Helpers.FormModeActionName("Artgl", Model.FormMode).ToString())' qbutton="ok_new"><i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
				}
				<button type="button" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" data-modal-form="true" name="@(Helpers.FormModeActionName("Artgl", Model.FormMode))" data-modal-url='@Url.Action(Helpers.FormModeActionName("Artgl", Model.FormMode).ToString(), "Gitem")' qbutton="ok">
				@if(Model.FormMode == FormMode.Delete)
				{
					<i class="glyphicons glyphicons-glyphicons-check e-icon" aria-hidden="true"></i>
					@Resources.CONFIRMAR09808
				}
				else
				{
					<i class="SaveIcon e-icon" aria-hidden="true"></i>
					@Resources.SAVE04165
				}
				</button>
			}
		   <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-modal-close="true" data-modal-form="true" data-modal-cancel="true" data-modal-url='@Url.Action("Artgl_Cancel")' qbutton="cancel"><i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428</button>
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT ARTGL]/ *@

@if (Request.IsAjaxRequest())
{
	@codeJavascript()
	@includeStylesheets()
}

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_ARTGL" data-form-javascript="true">
@Html.Partial("Artgl_JavaScript", Model, ViewData)
</div>
}

@section code_javascript {
	@codeJavascript()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
	@includeStylesheets()
}
