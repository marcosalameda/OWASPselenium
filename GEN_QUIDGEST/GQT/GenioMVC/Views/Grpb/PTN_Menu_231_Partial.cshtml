@model GenioMVC.ViewModels.Grpb.PTN_Menu_231_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Grpb;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Grpb>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: true)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodgrpb, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_231_GRPB_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Grpb")
        .Id("PTN_Menu_231")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Grpb", false, false)
        .SetFollowUp("Grpb_Show", "Grpb" , (Func<GenioMVC.Models.Grpb, object>)(item => new { id = item.ValCodgrpb }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qPTN_Menu_231, #PTN_Menu_231_complex_filter th input, #PTN_Menu_231_filters input").change(function() {
                    $("#pPTN_Menu_231").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#PTN_Menu_231_tableFilters').val(false);")
                    @Html.Raw("$('#PTN_Menu_231_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#PTN_Menu_231_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='PTN_Menu_231']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qPTN_Menu_231');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#PTN_Menu_231_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_PTN_Menu_231').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('PTN_Menu_231', 'GRPB', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PTN_MENU_231]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS PTN_MENU_231]/
</script>