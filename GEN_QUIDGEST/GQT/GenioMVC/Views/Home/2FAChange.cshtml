@model GenioMVC.ViewModels.TwoFAViewModel

@using GenioMVC.Models.Navigation;
@using CaptchaMvc.HtmlHelpers
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    ViewBag.Form = "Change2FA";
    ViewBag.Title = @Resources.TWO_FACTOR_AUTHENTIC05303;
    ViewBag.formmode = Model.GetFormMode;
    ViewBag.ClassForFormLayout = "form-flow profile-form";
}

@using (Html.BeginForm("Change2FA", "Home", FormMethod.Post, new { enctype = "multipart/form-data", @class = "container profile-form" }))
{
   @Html.QValidationSummary()
    <div class="well nested-form" id="Change2FA" area="Psw" data-form="psw-profile">
        @LoadDefault()
    </div>
}

@helper LoadDefault()
{
    <fieldset>
        <legend class="hidden-elem">@ViewBag.Title</legend>
        <div class="@ViewBag.ClassForFormLayout">
            <div id="c-stickyHeader">
                <div class="c-action-bar d-flex" style="margin-left: 2%; ">
                    <span class="form-header">
                        <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                    </span>
                </div>
            </div>
            <div class="container password-change-container ">
                <div class="c-card c-card__body mb-4">
                    @form_content_body()
                </div>
            </div>
            <div elem-identifier="FormActions" class="form-actions" data-form-actions="psw-profile">
                @form_content_buttons()
            </div>
        </div>
    </fieldset>
}

<script src="@Url.Content(UrlNames.JQueryValidate)" type="application/javascript"></script>
<script src="@Url.Content(UrlNames.JQueryValidateUnobtrusive)" type="application/javascript"></script>
<script src="@Url.Content(UrlNames.JQueryQRCode)" type="application/javascript"></script>
<script src="@Url.Content(UrlNames.QuidgestWebAuth)" type="application/javascript"></script>

@helper form_content_body()
{



        <fieldset>
            <div class="row">
                <div class="col">
                    <div class="f-header">
                        <span class="f-header__title mb-2">@Resources.POR_APLICACAO__TOTP_54459</span>
                        <div class="float-right">
                            @Html.ArrayLogicalFor(m => m.HasTotp, Model.EmptySelectList, s => null, true, null)
                        </div>
                    </div>                    
                    @if (!Model.ShowTotp)
                    {
                        <p>@Resources.USE_A_TIME_BASED_ONE08754</p>
                        <button type="button" class="b-icon-text b-icon-text--primary" onclick="QUtils.NavigateTo = '@Url.Action("CreateTOTP")'">
                            <i class="glyphicons glyphicons-rotation-lock e-icon"></i>
                            @if (Model.HasTotp == 1)
                            {
                                @Resources.ALTERAR60169
                            }
                            else
                            {
                                @Resources.CRIAR24836
                            }

                        </button>
                    }
                    else
                    {
                        <div id="panelTOTP" class="row-group">
                            <div class="zone-field">
                                <p>@Resources._1__INSTALL_ONE_OF_T16684</p>
                                <ul>
                                    <li><a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank">Google authenticator</a></li>
                                    <li><a href="https://www.microsoft.com/pt-pt/security/mobile-authenticator-app" target="_blank">Microsoft authenticator</a></li>
                                    <li><a href="https://authy.com/download/" target="_blank">Authy</a></li>
                                </ul>
                                <p>@Resources._2__USE_THE_APPLICAT04769</p>
                                <div class="i-text__error mb-2">@Resources.ESTA_INFORMACAO_SO_S55226</div>
                                <div id="qrcode"></div>
                                <b>@Resources.CODIGO_27320</b>
                                @Html.DisplayFor(m => m.TotpDisplayCode)
                                <p>@Resources._3__FILL_THE_6_DIGIT12132</p>
                                @Html.TextBoxFor(m => m.Totp6Code)
                            </div>
                        </div>
                    }
                </div>
                <div class="col">
                    <span class="f-header__title mb-2">@Resources.SECURITY_KEY47415</span>
                    @Html.ArrayLogicalFor(m => m.HasWebAuthN, Model.EmptySelectList, s => null, true, null)
                    @if (!Model.ShowWebAuthN)
                    {
                    <p>@Resources.A_SECURITY_KEY_IS_A_56031</p>
                    <button type="button" class="b-icon-text b-icon-text--primary mb-3" onclick=" QUtils.NavigateTo = '@Url.Action("CreateWebAuthN", "Home")'">
                        <i class="glyphicons glyphicons-rotation-lock e-icon"></i>@Resources.ADD_SECURITY_KEY18935
                    </button>
                    }
                    else
                    {
                    <p>@Resources.ADD_SECURITY_KEY18935</p>
                    <p>@Resources.MAKE_SURE_YOU_HAVE_Y33627<a href="https://www.google.com/search?q=fido+u2f+security+key" target="_blank">@Resources.ORDER_ONE_AT_A_SUPPL48566</a></p>
                    <button type="button" class="b-icon-text b-icon-text--primary mb-3" onclick="javascript:createRegisterWebAuth()">
                        <i class="glyphicons glyphicons-rotation-lock e-icon"></i>@Resources.SETUP44001
                    </button>
                    }
                </div>
            </div>

                @Html.AntiForgeryToken()
            @Html.HiddenFor(m=>m.HasTotp)
</fieldset>

}

@helper form_content_buttons()
{

    <button type="submit" class="b-icon-text b-icon-text--primary">
        <i class="glyphicons glyphicons-rotation-lock e-icon"></i>@Resources.GRAVAR45301
    </button>
    <button id="RegistrationCanceltButton" type="button" class="b-icon-text b-icon-text--secondary" onclick="javascript: QUtils.NavigateTo = '@Url.Action("Index", "Home")'">
        <i class="glyphicons glyphicons-ban-circle e-icon"></i>
        @Resources.SAIR20169
    </button>
}

@helper LoadFromLayout()
{
}


@helper codeJavascript()
{

}

@section code_javascript {
    @codeJavascript()

    <script type="text/javascript">
        $(document).ready(function () {               
            jQuery('#qrcode').html('');
            jQuery('#qrcode').qrcode({
                render: 'div',
                size: 150,
                text: "@Model.TotpUrl"
            });
        });


    </script>
}