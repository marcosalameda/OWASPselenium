                                    @Html.ValidationMessageFor(model => model.NewPassword)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @Html.HiddenFor(m => m.ValCodpsw)
                @Html.AntiForgeryToken()


            </div>
        </fieldset>




	if (Model.OpenIdConnAuthMethods != null && Model.OpenIdConnAuthMethods.Count != 0)
    {
	<div class="c-card c-card__body mb-4">
        <fieldset>
            <div class="f-header">
                <span class="f-header__title mb-2">OpenId Connect</span>
            </div>
			@foreach (string idMethod in Model.OpenIdConnAuthMethods)
            {
            <button type="button" class="b-icon-text b-icon-text--primary mb-3" value="idMethod" onclick="javascript:CreateOpenIdLoginRedirect()">
                @(String.IsNullOrEmpty(idMethod) ? "OpenId Connect Auth" : idMethod)
            </button>
			}
        </fieldset>
    </div>
	}
}

@helper form_content_buttons()
{

    <button type="submit" class="b-icon-text b-icon-text--primary">
        <i class="glyphicons glyphicons-rotation-lock e-icon"></i>@Resources.ALTERAR_PASSWORD32166
    </button>
    <button id="RegistrationCanceltButton" type="button" class="b-icon-text b-icon-text--secondary" onclick="window.Form.Cancel()">
        <i class="glyphicons glyphicons-ban-circle e-icon"></i>
        @Resources.SAIR20169
    </button>
}

@helper form_content_2FA()
{
    <div class="c-card c-card__body mb-4">
        <span class="f-header__title mb-2">@Resources.TWO_FACTOR_AUTHENTIC05303</span>
        <p>@Resources.TWO_FACTOR_AUTHENTIC35091 @CSGenio.framework.Configuration.Application.Name</p>
        <p>@Resources.THE_FIRST_FACTOR_IS_45516</p>
        <button id="Change2FAButton" type="button" class="b-icon-text b-icon-text--secondary fit-content" onclick="QUtils.NavigateTo = '@Url.Action("Change2FA")'">
            <i class="glyphicons glyphicons-arrow-right e-icon"></i>
            @Resources.SETUP_2FA29281
        </button>
    </div>
}

@helper LoadFromLayout()
{
}


@helper codeJavascript()
{

}

@section code_javascript {
    @codeJavascript()

    <script type="text/javascript">
        $(document).ready(function () {               
            jQuery('#fprofile').closest('.content').addClass("c-profile");
            $('.passwordtoggle').click(function () {togglePassword(this)});
        });

        $('#Profile').submit(function () {
            window.Form.submit();
        });
        
        
        function togglePassword(element) {
            let identifier = $(element).attr('data-identifier');
            let inputElement = $('input[data-identifier="' + identifier + '"]');

            if ($(inputElement).attr('type') == 'text') {
                $(inputElement).attr('type', 'password');
                $(element).removeClass('glyphicons glyphicons-eye-close')
                $(element).addClass('glyphicons glyphicons-eye-open')
            }
            else {
                $(inputElement).attr('type', 'password');
                $(inputElement).attr('type', 'text');
                $(element).removeClass('glyphicons glyphicons-eye-open')
                $(element).addClass('glyphicons glyphicons-eye-close')
            }                
        }

        function CreateOpenIdLoginRedirect() {
            $.post("@Url.Action("CreateOpenIdLoginRedirect", "Home")", function (data) {
                if (data.url) {
                    window.location.replace(data.url);
                }
            });
        }



        class ChangePassWordForm {

            constructor() {
                this.mandatoryFld = ["LED_PSWUSER_PSW__OLDPASSWORD", "LED_PSWUSER_PSW__PASSWORD", "LED_PSWUSER_PSW__CONFPASSWORD"];
            }
            Cancel() {
                for (var idx = 0; idx < this.mandatoryFld.length; idx++) {

                    var control = $('[data-identifier="' + this.mandatoryFld[idx] + '"]')

                    var pergunta

                    if (control.val() != '') {
                        pergunta = true;
                        break;
                    }

                }

                if (pergunta) {
                    displayMessage(quidgestGlobals.Resources.CONFIRM_EXIT_FORM_DIRTY, MessageDefs.StatusEnum.Q, undefined,
                        [
                            {
                                label: quidgestGlobals.Resources.YES,
                                callback: function (result) {
                                
                                        QUtils.NavigateTo = '@Url.Action("Index", "Home")'

                                },
                                icon: "check"
                            },
                            {
                                label: quidgestGlobals.Resources.NO,
                                style: MessageDefs.ButtonTypes.Secondary,
                                icon: "ban-circle"
                            }
                        ]
                    )

                }
                else
                    QUtils.NavigateTo = '@Url.Action("Index", "Home")'
            }
            submit() {

                for (var idx = 0; idx < this.mandatoryFld.length; idx++) {

                    var control = $('[data-identifier="' + this.mandatoryFld[idx] + '"]')

                    if (control.val() == '') {

                        control.addClass('form-control');
                        control.addClass('is-invalid');
                    }
                    else {
                        control.removeClass('form-control');
                        control.removeClass('is-invalid');
                    }

                }
            }


        };

    window.Form = new ChangePassWordForm();

    </script>
}