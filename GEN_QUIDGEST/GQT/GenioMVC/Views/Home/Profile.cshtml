                                            <div class="i-input-group--left">
                                                <span class="i-input-group__tag i-input-group__tag--primary password-change-icon"><i class="glyphicons glyphicons-rotation-lock i-input-group__tag-icon"></i></span>
                                            </div>
                                            @Html.PasswordEditFor(model => model.ConfirmPassword, new { help_id = "LED_PSWUSER_PSW__CONFPASSWORD", data_toggle = "tooltip", data_placement = "top", @class = "i-text__field i-text input-large password-change-input-fld", data_identifier = "LED_PSWUSER_PSW__CONFPASSWORD", @pers_cs_area = "Psw", @pers_cs_field = "ValConfPassword", maxlength = "50", rows = "30" })

                                        </div>
                                    </div>
