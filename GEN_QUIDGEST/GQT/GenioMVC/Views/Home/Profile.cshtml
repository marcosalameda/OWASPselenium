@model GenioMVC.Models.ProfileModel

@using GenioMVC.Models.Navigation;
@using CaptchaMvc.HtmlHelpers
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    ViewBag.Form = "Profile";
    ViewBag.Title = @Resources.PERFIL18952;
    ViewBag.formmode = Model.GetFormMode;
    ViewBag.ClassForFormLayout = "form-flow profile-form";
}

@using (Html.BeginForm("Profile", "Home", FormMethod.Post, new { enctype = "multipart/form-data", @class = "container profile-form", area = "Psw", id = "Profile"  }))
{
   @Html.QValidationSummary()
    <div class="well nested-form" id="Psw_Profile" area="Psw" data-form="psw-profile">
        @LoadDefault()
    </div>
}

@helper LoadDefault()
{
    <fieldset>
        <legend class="hidden-elem">@ViewBag.Title</legend>
        <div class="@ViewBag.ClassForFormLayout">
            <div id="c-stickyHeader">
                <div class="c-action-bar d-flex" style="margin-left: 2%; ">
                    <span class="form-header">
                        <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                    </span>
                </div>
            </div>
            <div class="container password-change-container ">
                <div class="c-card c-card__body mb-4">
                    @form_content_body()
                </div>
            </div>
            <div elem-identifier="FormActions" class="form-actions" data-form-actions="psw-profile">
                @form_content_buttons()
            </div>
            @if(Model.Enable2FAOptions)
            {
                @form_content_2FA()
            }
        </div>
    </fieldset>
}

<script src="@Url.Content(UrlNames.JQueryValidate)" type="application/javascript"></script>
<script src="@Url.Content(UrlNames.JQueryValidateUnobtrusive)" type="application/javascript"></script>
<script src="@Url.Content(UrlNames.QuidgestWebAuth)" type="application/javascript"></script>

@helper form_content_body()
{


        <fieldset>
            <div class="f-header">
                <span class="f-header__title mb-2">@Resources.ALTERAR_PASSWORD32166</span>
            </div>
            <div class="form-group f-body">
                <div class="row">
                    <div class="col-12">
                        <div class="control-row-group">
                            <div>
                                <div class="i-text__label i-text " id="CONTAINER_LED_PSWUSER_PSW__NOME____">
                                    <div class="d-flex">
                                        @Html.LabelFor(model => model.ValNome, new { label_id = "LED_PSWUSER_PSW__NOME____", @class = " i-text__label", id = "LABEL_LED_PSWUSER_PSW__NOME____" }, true, false)
                                        <span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode password-change-icon"></span>
                                        <a href="javascript:OpenSuggestion('LED_PSWUSER_PSW__NOME____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem"></span></a>
                                    </div>
                                    <div class="profile-input-group">
                                        <div class="i-input-group--left">
                                            <span class="i-input-group__tag password-change-icon"><i class="glyphicons glyphicons-user i-input-group__tag-icon password-change-icon password-change-icon"></i></span>
                                        </div>
                                        @Html.TextBoxFor(model => model.ValNome, new { help_id = "LED_PSWUSER_PSW__NOME____", data_toggle = "tooltip", data_placement = "top", @class = "i-input-group__field valid password-change-input-fld-user-name", data_identifier = "LED_PSWUSER_PSW__NOME____", @pers_cs_area = "Psw", @pers_cs_field = "ValNome", @db_field = "ValNome", rows = "30", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.ValNome)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="control-row-group">
                            <div>
                                <div class="i-text__label i-textpasswordgroup  " id="CONTAINER_LED_PSWUSER_PSW__PASSWORD">
                                    <div class="d-flex">
                                        @Html.LabelFor(model => model.OldPassword, new { label_id = "LED_PSWUSER_PSW__OLDPASSWORD", @class = " i-text__label", id = "LABEL_LED_PSWUSER_PSW__OLDPASSWORD" }, true, true)
                                        <span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
                                        <a href="javascript:OpenSuggestion('LED_PSWUSER_PSW__PASSWORD','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem"></span></a>
                                    </div>
                                    <div class="profile-input-group">
                                        <div class="i-input-group--left">
                                            <span class="i-input-group__tag password-change-icon"><i class="glyphicons glyphicons-lock i-input-group__tag-icon password-change-icon"></i></span>
                                        </div>
                                        @Html.PasswordEditFor(model => model.OldPassword, new { help_id = "LED_PSWUSER_PSW__OLDPASSWORD", data_toggle = "tooltip",  data_placement = "top", @class = "i-text__field i-text input-large password-change-input-fld", data_identifier = "LED_PSWUSER_PSW__OLDPASSWORD", @pers_cs_area = "Psw", @pers_cs_field = "ValOldPassword", maxlength = "50", rows = "30" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="control-row-group">
                            <div>
                                <div class="i-text__label i-textpasswordgroup  " id="CONTAINER_LED_PSWUSER_PSW__PASSWORD">
                                    <div class="d-flex">
                                        @Html.LabelFor(model => model.NewPassword, new { label_id = "LED_PSWUSER_PSW__PASSWORD", @class = " i-text__label", id = "LABEL_LED_PSWUSER_PSW__PASSWORD" }, true, true)
                                        <span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
                                        <a href="javascript:OpenSuggestion('LED_PSWUSER_PSW__PASSWORD','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a>
                                    </div>
                                    <div class="profile-input-group">
                                        <div class="i-input-group--left">
                                            <span class="i-input-group__tag i-input-group__tag--primary password-change-icon"><i class="glyphicons glyphicons-rotation-lock i-input-group__tag-icon"></i></span>
                                        </div>
