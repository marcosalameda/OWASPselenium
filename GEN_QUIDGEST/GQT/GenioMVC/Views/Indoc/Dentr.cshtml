@model GenioMVC.ViewModels.Indoc.Dentr_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Dentr";
	ViewBag.Title = @Resources.INPUT_DOCUMENT28194;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Indoc", FormMethod.Post, new { @class = "form-horizontal", area="Indoc", data_form="Dentr" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Dentr" area="Indoc" data-form="Dentr">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Dentr_well" area="Indoc" data-form="Dentr">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

