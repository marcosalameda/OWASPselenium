	window.Form_Leafletd.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValHours' field *@
		$(qForm).bind('VALSINCE_CHANGE VALUNTIL_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValSince', $('[data-form="Leafletd"]'))))==1||qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValUntil', $('[data-form="Leafletd"]'))))==1,0,qApi.Diferenca_entre_Datas( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValSince', $('[data-form="Leafletd"]'))), getFieldValue($(':not([elem-identifier="Multiform"]) > #ValUntil', $('[data-form="Leafletd"]'))),"H")));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValHours', $('[data-form="Leafletd"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValHours', $('[data-form="Leafletd"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValHours', $('[data-form="Leafletd"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValHours: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Formula of the 'ValValue' field *@
		$(qForm).bind('VALHOURS_CHANGE VALPRECOHOR_CHANGE', function(event, eTarget) {
				try {
						var newValue = ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValHours', $('[data-form="Leafletd"]')))* getFieldValue($(':not([elem-identifier="Multiform"]) > #ValPrecohor', $('[data-form="Leafletd"]'))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValValue', $('[data-form="Leafletd"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValValue', $('[data-form="Leafletd"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValValue', $('[data-form="Leafletd"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValValue: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Recalculate formulas (server side) *@
		$(qForm).bind('VALSINCE_CHANGE VALCODTPEQU_CHANGE', function(event, eTarget) {
				window.Form_Leafletd.RecalculateFormulas();
		});
		





	</text>
