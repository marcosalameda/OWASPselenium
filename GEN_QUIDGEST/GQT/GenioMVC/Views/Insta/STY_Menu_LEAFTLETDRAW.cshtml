@model GenioMVC.ViewModels.Insta.STY_Menu_LEAFTLETDRAW_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Insta.STY_Menu_LEAFTLETDRAW_ViewModel modelSTY_Menu_LEAFTLETDRAW = new GenioMVC.ViewModels.Insta.STY_Menu_LEAFTLETDRAW_ViewModel(Navigation);
	var columns = modelSTY_Menu_LEAFTLETDRAW.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "tpequ" && areaField.Field == "tipoequi")
		{
			fields.Add("TPEQU.TIPOEQUI", new TableFilterField("TPEQU", "TIPOEQUI", Resources.TYPE_OF_EQUIPMENT18080, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text"));
		}
		if (areaField.Area == "insta" && areaField.Field == "designat")
		{
			fields.Add("INSTA.DESIGNAT", new TableFilterField("INSTA", "DESIGNAT", Resources.SCHEDULING24801, "text"));
		}
		if (areaField.Area == "insta" && areaField.Field == "dtiniage")
		{
			fields.Add("INSTA.DTINIAGE", new TableFilterField("INSTA", "DTINIAGE", Resources.BEGINNING18124, "date"));
		}
		if (areaField.Area == "insta" && areaField.Field == "dtfimage")
		{
			fields.Add("INSTA.DTFIMAGE", new TableFilterField("INSTA", "DTFIMAGE", Resources.END47577, "date"));
		}
		if (areaField.Area == "insta" && areaField.Field == "descript")
		{
			fields.Add("INSTA.DESCRIPT", new TableFilterField("INSTA", "DESCRIPT", Resources.DESCRIPTION07383, "text"));
		}
		if (areaField.Area == "insta" && areaField.Field == "allday")
		{
			fields.Add("INSTA.ALLDAY", new TableFilterField("INSTA", "ALLDAY", Resources.ALL_DAY18496, "bool"));
		}
		if (areaField.Area == "insta" && areaField.Field == "since")
		{
			fields.Add("INSTA.SINCE", new TableFilterField("INSTA", "SINCE", Resources.SINCE47259, "date", defaultSearch : true));
		}
		if (areaField.Area == "insta" && areaField.Field == "until")
		{
			fields.Add("INSTA.UNTIL", new TableFilterField("INSTA", "UNTIL", Resources.UNTIL39173, "date"));
		}
		if (areaField.Area == "insta" && areaField.Field == "hours")
		{
			fields.Add("INSTA.HOURS", new TableFilterField("INSTA", "HOURS", Resources.QTD_HOURS28684, "num"));
		}
		if (areaField.Area == "insta" && areaField.Field == "precohor")
		{
			fields.Add("INSTA.PRECOHOR", new TableFilterField("INSTA", "PRECOHOR", Resources.HOURLY_PRICE48005, "num"));
		}
		if (areaField.Area == "insta" && areaField.Field == "value")
		{
			fields.Add("INSTA.VALUE", new TableFilterField("INSTA", "VALUE", Resources.VALUE10285, "num"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("STY_Menu_LEAFTLETDRAW", "Insta", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Insta", data_form="STY_Menu_LEAFTLETDRAW" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="STY_Menu_LEAFTLETDRAW_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qSTY_Menu_LEAFTLETDRAW", Navigation.GetStrValue("qSTY_Menu_LEAFTLETDRAW"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('STY_Menu_LEAFTLETDRAW');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('STY_Menu_LEAFTLETDRAW');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.SINCE47259})
					<button id="qSTY_Menu_LEAFTLETDRAW-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("STY_Menu_LEAFTLETDRAW", fields, "INSTA")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('STY_Menu_LEAFTLETDRAW', 'INSTA', 'INSTA.SINCE');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="STY_Menu_LEAFTLETDRAW_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#STY_Menu_LEAFTLETDRAW_complex_filter', 'STY_Menu_LEAFTLETDRAW_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("STY_Menu_LEAFTLETDRAW")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="STY_Menu_LEAFTLETDRAW" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "STY_Menu_LEAFTLETDRAW", idlistController = "Insta", idlistArea = "Insta", codlista ="5b5648c2-338b-4f0a-8b4e-33bb84218448" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("STY_Menu_LEAFTLETDRAW_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "STY_Menu_LEAFTLETDRAW" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_STY_Menu_LEAFTLETDRAW = new QMenuForm($('[data-form="STY_Menu_LEAFTLETDRAW"]'), "Form_STY_Menu_LEAFTLETDRAW");
		window.Form_STY_Menu_LEAFTLETDRAW.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_STY_Menu_LEAFTLETDRAW.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qSTY_Menu_LEAFTLETDRAW");
		RegisterClearEvents("STY_Menu_LEAFTLETDRAW")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("STY_Menu_LEAFTLETDRAW", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="STY_Menu_LEAFTLETDRAW"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="STY_Menu_LEAFTLETDRAW"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
