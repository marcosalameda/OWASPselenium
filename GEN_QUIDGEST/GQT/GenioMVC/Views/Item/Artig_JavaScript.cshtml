		@* Formula of the 'ValDisponib' field *@
		$(qForm).bind('VALEXISTENC_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValExistenc', $('[data-form="Artig"]')))>0,"A",qApi.iif( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValExistenc', $('[data-form="Artig"]')))@(Html.Raw("<"))=0,"O","D")));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValDisponib', $('[data-form="Artig"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValDisponib', $('[data-form="Artig"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValDisponib', $('[data-form="Artig"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { window.QError?.AppendError('Formula of field ValDisponib: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Recalculate formulas (server side) *@
		$(qForm).bind('Artig_ValLentrada_RELOADED Artig_ValLsaidas_RELOADED', function(event, eTarget) {
