@model GenioMVC.ViewModels.Item.Artig_ValLentrada_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_ARTIG___PSEUDLENTRADA" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.ENTRIES32319</h2 list-header> </label></div>
	</div>
	<div class="col-auto search">
	<div id="ValLentrada_simple_filter">
		<div class="i-input-group input-xxlarge">
			@Html.TextBox("qValLentrada", Model.Menu.Query, new { @class="i-input-group__field ", @onkeydown = "ListSearchEnter(event)", @style="height: inherit" } )
			<div class="i-input-group--right">
				<button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" elem-identifier="ListSearchButton" onclick="window.ValLentrada.Search();"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
				<button id="ValLentrada_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#ValLentrada_complex_filter', 'ValLentrada_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
			</div>
		</div>
	</div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR ARTIG_LENTRADA]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Ldent;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Ldent>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodldent, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_LENTRADA_LDENT_DHENTRA]/
		column.Expression(p => p.ValDhentra).Title(@Resources.INSTANT_ENTRANCE27379).Field("ValDhentra").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_LENTRADA_INDOC_DOCUMENR]/
		column.Expression(p => p.Indoc.ValDocumenr).Title(@Resources.DOCUMENT_NO_30174).Form("Dentr_Show","Indoc",p => p.Indoc.ValCoddentr, false, false).Field("Indoc.ValDocumenr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_LENTRADA_LDENT_LINE]/
		column.Expression(p => p.ValLine).Title(@Resources.LINE27983).Field("ValLine").Size(5);
// USE /[MANUAL GQT CUSTOM_COLUMN ARTIG_LENTRADA_LDENT_QTDENTRA]/
		column.Expression(p => p.ValQtdentra).Title(@Resources.QTD_ENTRY35144).Field("ValQtdentra").Size(10);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Ldent")
        .Id("ValLentrada")
        .AjaxRequest("Artig_ValLentrada")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Artig_ValLentrada", new { id = Model.ValCoditem, partialView = "Artig_ValLentrada"}))
        .Filters(this.Model.Menu.Filters)
        .ForegroundColourOnCondition(p => p.ValZzstate != 0 ? "" : "RGB(207,255,158)")
        .Form("Ldent", true, false)
        .SetFollowUp("Ldent_Show", "Ldent" , (Func<GenioMVC.Models.Ldent, object>)(item => new { id = item.ValCodldent }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: true)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValLentrada, #ValLentrada_complex_filter th input, #ValLentrada_filters input").change(function() {
                    $("#pValLentrada").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValLentrada_tableFilters').val(false);")
                    @Html.Raw("$('#ValLentrada_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValLentrada_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValLentrada_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValLentrada_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValLentrada').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValLentrada']"));
                    InitSpecialControls($('#ValLentrada'));
                    $('#ValLentrada').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS ARTIG_VALLENTRADA]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>