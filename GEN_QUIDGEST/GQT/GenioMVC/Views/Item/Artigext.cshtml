        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Artigext" area="Item" data-form="Artigext">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Artigext_well" area="Item" data-form="Artigext">
