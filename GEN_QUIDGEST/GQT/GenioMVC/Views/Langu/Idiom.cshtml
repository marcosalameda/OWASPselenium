@model GenioMVC.ViewModels.Langu.Idiom_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Idiom";
	ViewBag.Title = @Resources.IDIOMA44057;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Langu", FormMethod.Post, new { @class = "form-horizontal", area="Langu", data_form="Idiom" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Idiom" area="Langu" data-form="Idiom">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Idiom_well" area="Langu" data-form="Idiom">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_IDIOM___LANGULANGUA__">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValLangua, new { label_id="LED_IDIOM___LANGULANGUA__", @class = " i-text__label", id="LABEL_LED_IDIOM___LANGULANGUA__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_IDIOM___LANGULANGUA__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValLangua, new {help_id = "LED_IDIOM___LANGULANGUA__", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_IDIOM___LANGULANGUA__", @pers_cs_area = "Langu", @pers_cs_field = "ValLangua", @db_field = "ValLangua", title = @Resources.LANGUAGE16872, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValLangua)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_IDIOM___LANGUACRON___">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValAcron, new { label_id="LED_IDIOM___LANGUACRON___", @class = " i-text__label", id="LABEL_LED_IDIOM___LANGUACRON___"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_IDIOM___LANGUACRON___','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValAcron, new {help_id = "LED_IDIOM___LANGUACRON___", @class = "i-text__field i-text input-mini", data_identifier = "LED_IDIOM___LANGUACRON___", @pers_cs_area = "Langu", @pers_cs_field = "ValAcron", @db_field = "ValAcron", title = @Resources.ACRONYM00872, maxlength = "5", rows = "5" })
								@Html.ValidationMessageFor(model => model.ValAcron)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodlang, new { @pers_cs_field="ValCodlang", @pers_cs_area="Langu", data_refresh = "true", @form_area="true", @data_value = Model.ValCodlang, @data_identifier = "LED_IDIOM___LANGUCODLANG_" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Idiom" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Idiom" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Idiom" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Idiom", Model.FormMode).ToString(), "Langu"))", "Idiom_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.INSERIR43365
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Idiom_Delete", "Langu", new {id = @Model.ValCodlang} )", "Idiom_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Idiom_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Idiom_Delete", "Langu", new {id = @Model.ValCodlang} )", "Idiom_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Idiom_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitIdiom(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Idiom", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteIdiom(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Idiom", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitIdiom(event)" title="@Resources.INSERIR43365" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.INSERIR43365
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Idiom_Cancel", "Langu", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Idiom.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Idiom_Cancel","Langu","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Idiom">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Idiom" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Idiom">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT IDIOM]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_IDIOM" data-form-javascript="true">
@Html.Partial("Idiom_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
