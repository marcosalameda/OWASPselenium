@model GenioMVC.ViewModels.Ldent.Ldent_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = @Resources.ENTRY29068;
	ViewBag.formmode = Model.GetFormMode;
}

<div class="c-modal__dialog c-modal--lg">
	@using (Ajax.BeginForm("Action", "Ldent", null, new AjaxOptions { UpdateTargetId = "form-modal" }, new { @class = "c-modal__content", area = "Ldent", data_form = "Ldent" }))
	{
		<div class="c-modal__content">
			<div class="c-modal__header" elem-identifier="modal-header">
				@form_header()
			</div>
			<div elem-identifier="ModalBody" class="c-modal__body">
				<div class="form-flow">
					@form_body()
				</div>
			</div>
			<div class="c-modal__footer">
				<div elem-identifier="Actions" class="actions" data-form-actions="Ldent">
					@form_footer()
				</div>
			</div>
		</div>
	}
</div>

@helper form_header() {
	@* BEGIN MVC Flash messages *@
	@Html.Action("Index", "Messages")
	@* END MVC Flash messages *@
		<div class="c-modal__header-title">
			<div class="d-flex">
				<div class="c-action-bar d-flex">
					<i class="form-popup-header-legend icon-@ViewBag.formmode ViewMode-@ViewBag.formmode"></i><h2>@ViewBag.Title</h2>
					<div data-parent-form="Ldent" data-q-ref="form-btns-main_container"></div>
				</div>
			</div>
		</div>
}

