        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Ldentnor" area="Ldent" data-form="Ldentnor">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Ldentnor_well" area="Ldent" data-form="Ldentnor">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

