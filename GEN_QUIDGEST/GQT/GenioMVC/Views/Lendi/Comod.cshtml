@model GenioMVC.ViewModels.Lendi.Comod_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Comod";
	ViewBag.Title = "";
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Lendi", FormMethod.Post, new { @class = "form-horizontal", area="Lendi", data_form="Comod" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Comod" area="Lendi" data-form="Comod">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Comod_well" area="Lendi" data-form="Comod">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

