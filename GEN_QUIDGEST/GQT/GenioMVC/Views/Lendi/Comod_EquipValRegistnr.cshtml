@model GenioMVC.ViewModels.Lendi.Comod_EquipValRegistnr_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.EQUIPMENT03632</h2>
        </div>
        <div class="col-auto normal-view" id="Comod_EquipValRegistnr_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qComod_EquipValRegistnr", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Comod_EquipValRegistnr.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Comod_EquipValRegistnr_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Comod_EquipValRegistnr_complex_filter', 'Comod_EquipValRegistnr_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="normal-view">
@using GenioMVC.ViewModels.Equip;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Equip>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodequip, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_EQUIP_REGISTNR]/
		column.Expression(p => p.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("ValRegistnr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_TPEQU_TIPOEQUI]/
		column.Expression(p => p.Tpequ.ValTipoequi).Title(@Resources.TYPE00312).Field("Tpequ.ValTipoequi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_EQUIP_DESIGNAT]/
		column.Expression(p => p.ValDesignat).Title(@Resources.DESIGNATION35876).Field("ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_EQUIP_DTAQUISI]/
		column.Expression(p => p.ValDtaquisi).Title(@Resources.ACQUISITION44180).Field("ValDtaquisi").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_EQUIP_DTDECO]/
		column.Expression(p => p.ValDtdeco).Title(@Resources.DECOMISSION14486).Field("ValDtdeco").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_EQUIP_PHOTOGRA]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValPhotogra, new {alt=@Resources.PHOTO51874,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodequip, modelname = "Equip", fldname = "ValPhotogra" }))).Title(@Resources.PHOTO51874).Field("ValPhotogra").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN COMOD_REGISTNR_EQUIP_VALORTOT]/
		column.Expression(p => p.ValValortot).Title(@Resources.TOTAL_VALUE30570).Field("ValValortot").Size(12);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValRegistnr).Field("ValRegistnr").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Equip")
        .Id("Comod_EquipValRegistnr")
        .AjaxRequest("Comod_EquipValRegistnr")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Comod_EquipValRegistnr", new { id = Model.ValCodlendi, partialView = "Comod_EquipValRegistnr", Pess1ValCodpesso = Model.ValCodpess1}))
        .Filters(this.Model.Menu.Filters)
        .Form("Equip", false, false, new { data_skip_prevalida = "true" })
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()
</div>
<script>
    try {
        if (jQuery) {
            try {
                $("#qComod_EquipValRegistnr, #TableEquipRegistnr_complex_filter th input").change(function() {
                    var context = $("#TableEquipRegistnr").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Comod_EquipValRegistnr table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_COMOD___EQUIPREGISTNR"]');

                    selectList.trigger("DBEditSetValue", key);

                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Comod_EquipValRegistnr_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Comod_EquipValRegistnr_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Comod_EquipValRegistnr_extra').prop("disabled", true);
</text>
}


// USE /[MANUAL GQT LISTING_JS COMOD_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>