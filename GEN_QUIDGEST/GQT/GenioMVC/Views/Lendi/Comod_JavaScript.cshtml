	window.Form_Comod.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValWarndt' field *@
		$(qForm).bind('VALSTART_CHANGE EQUIPVALFREQUENC_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.SomaDias( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValStart', $('[data-form="Comod"]'))), getFieldValue($(':not([elem-identifier="Multiform"]) > #EquipValFrequenc', $('[data-form="Comod"]')))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValWarndt', $('[data-form="Comod"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValWarndt', $('[data-form="Comod"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValWarndt', $('[data-form="Comod"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValWarndt: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Formula of the 'ValEnd' field *@
		$(qForm).bind('VALWARNDT_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.SomaDias( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValWarndt', $('[data-form="Comod"]'))),1));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValEnd', $('[data-form="Comod"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValEnd', $('[data-form="Comod"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValEnd', $('[data-form="Comod"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValEnd: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Formula of the 'ValReturned' field *@
		$(qForm).bind('VALRETURNDT_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValReturndt', $('[data-form="Comod"]'))))==1,0,1));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValReturned', $('[data-form="Comod"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValReturned', $('[data-form="Comod"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValReturned', $('[data-form="Comod"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValReturned: ' + err.message, err.stack, window.location.href); }
		});
		





	</text>
