@model GenioMVC.ViewModels.Lendi.GQT_Menu_1311_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Lendi.GQT_Menu_1311_ViewModel modelGQT_Menu_1311 = new GenioMVC.ViewModels.Lendi.GQT_Menu_1311_ViewModel(Navigation);
	var columns = modelGQT_Menu_1311.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrFreqempr = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayFreqempr.GetDictionary())
	{
		arrFreqempr.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "pess1" && areaField.Field == "name")
		{
			fields.Add("PESS1.NAME", new TableFilterField("PESS1", "NAME", Resources.NAME31974, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text"));
		}
		if (areaField.Area == "pess2" && areaField.Field == "name")
		{
			fields.Add("PESS2.NAME", new TableFilterField("PESS2", "NAME", Resources.NAME31974, "text"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "lendinnr")
		{
			fields.Add("LENDI.LENDINNR", new TableFilterField("LENDI", "LENDINNR", Resources.NO__OF_THE_DADATO35934, "num", defaultSearch : true));
		}
		if (areaField.Area == "lendi" && areaField.Field == "start")
		{
			fields.Add("LENDI.START", new TableFilterField("LENDI", "START", Resources.BEGINNING18124, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "frequenc")
		{
			fields.Add("EQUIP.FREQUENC", new TableFilterField("EQUIP", "FREQUENC", Resources.LOAN_FREQUENCY00701, "enum", array : arrFreqempr));
		}
		if (areaField.Area == "lendi" && areaField.Field == "warndt")
		{
			fields.Add("LENDI.WARNDT", new TableFilterField("LENDI", "WARNDT", Resources.WARNING52043, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "end")
		{
			fields.Add("LENDI.END", new TableFilterField("LENDI", "END", Resources.END47577, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "observat")
		{
			fields.Add("LENDI.OBSERVAT", new TableFilterField("LENDI", "OBSERVAT", Resources.OBSERVATIONS03729, "text"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "returndt")
		{
			fields.Add("LENDI.RETURNDT", new TableFilterField("LENDI", "RETURNDT", Resources.RETURN32222, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "returned")
		{
			fields.Add("LENDI.RETURNED", new TableFilterField("LENDI", "RETURNED", Resources.RETURNED01606, "bool"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "dayslimi")
		{
			fields.Add("LENDI.DAYSLIMI", new TableFilterField("LENDI", "DAYSLIMI", Resources.DAYS_FOR_RETURN14598, "num"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_1311", "Lendi", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Lendi", data_form="GQT_Menu_1311" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_1311_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_1311", Navigation.GetStrValue("qGQT_Menu_1311"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_1311');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_1311');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__OF_THE_DADATO35934})
					<button id="qGQT_Menu_1311-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_1311", fields, "LENDI")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_1311', 'LENDI', 'LENDI.LENDINNR');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_1311_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_1311_complex_filter', 'GQT_Menu_1311_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_1311")
						<button type="button" class="b-btn b-icon b-icon--secondary" onclick="hideShowDiv('GQT_Menu_1311_filters')" title="@Resources.MOSTRAR50268/@Resources.ESCONDER31385 @Resources.FILTROS01340"><i class="glyphicons glyphicons-filter e-icon"></i></button>
					</div>
				</div>
			</div>
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@Html.ExportListMenu("GQT_Menu_1311")
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_1311" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_1311", idlistController = "Lendi", idlistArea = "Lendi", codlista ="7c5b168c-36e1-428a-b409-4b372e706c23" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
		</div>
                    <!---------- Filters ------------>
                        <div class="row-fluid">
                            <div class="span12">
                                <div id="GQT_Menu_1311_filters">
                                    <div class="filter-box">
                                        <div class="form-check-inline">
                                            <label class="i-radio i-radio__label i-radio--inline">
                                                @Resources.FOR_RETURNING61907
                                                @Html.RadioButton("filter_GQT_Menu_1311_DEVOLUCAO", "1", Model.Navigation.CheckKey("filter_GQT_Menu_1311_DEVOLUCAO_1") ? (bool)Model.Navigation.GetValue("filter_GQT_Menu_1311_DEVOLUCAO_1") : true, new { @class="input-filter"}) 
                                                <span class="i-radio__field"></span>
                                            </label>
                                            <label class="i-radio i-radio__label i-radio--inline">
                                                @Resources.RETURNED01606
                                                @Html.RadioButton("filter_GQT_Menu_1311_DEVOLUCAO", "2", Model.Navigation.CheckKey("filter_GQT_Menu_1311_DEVOLUCAO_2") ? (bool)Model.Navigation.GetValue("filter_GQT_Menu_1311_DEVOLUCAO_2") : false, new { @class="input-filter"}) 
                                                <span class="i-radio__field"></span>
                                            </label>
                                            <label class="i-radio i-radio__label i-radio--inline">
                                                @Resources.ALL38603
                                                @Html.RadioButton("filter_GQT_Menu_1311_DEVOLUCAO", "3", Model.Navigation.CheckKey("filter_GQT_Menu_1311_DEVOLUCAO_3") ? (bool)Model.Navigation.GetValue("filter_GQT_Menu_1311_DEVOLUCAO_3") : false, new { @class="input-filter"}) 
                                                <span class="i-radio__field"></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_1311_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_1311" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_1311 = new QMenuForm($('[data-form="GQT_Menu_1311"]'), "Form_GQT_Menu_1311");
		window.Form_GQT_Menu_1311.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_1311.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_1311");
		RegisterClearEvents("GQT_Menu_1311")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("GQT_Menu_1311", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_1311"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_1311"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
