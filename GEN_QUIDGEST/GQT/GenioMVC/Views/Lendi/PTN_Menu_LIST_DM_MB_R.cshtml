@model GenioMVC.ViewModels.Lendi.PTN_Menu_LIST_DM_MB_R_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Lendi.PTN_Menu_LIST_DM_MB_R_ViewModel modelPTN_Menu_LIST_DM_MB_R = new GenioMVC.ViewModels.Lendi.PTN_Menu_LIST_DM_MB_R_ViewModel(Navigation);
	var columns = modelPTN_Menu_LIST_DM_MB_R.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "pess1" && areaField.Field == "name")
		{
			fields.Add("PESS1.NAME", new TableFilterField("PESS1", "NAME", Resources.NAME31974, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text"));
		}
		if (areaField.Area == "pess2" && areaField.Field == "name")
		{
			fields.Add("PESS2.NAME", new TableFilterField("PESS2", "NAME", Resources.NAME31974, "text"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "lendinnr")
		{
			fields.Add("LENDI.LENDINNR", new TableFilterField("LENDI", "LENDINNR", Resources.NO__OF_THE_DADATO35934, "num", defaultSearch : true));
		}
		if (areaField.Area == "lendi" && areaField.Field == "start")
		{
			fields.Add("LENDI.START", new TableFilterField("LENDI", "START", Resources.BEGINNING18124, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "warndt")
		{
			fields.Add("LENDI.WARNDT", new TableFilterField("LENDI", "WARNDT", Resources.WARNING52043, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "end")
		{
			fields.Add("LENDI.END", new TableFilterField("LENDI", "END", Resources.END47577, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "observat")
		{
			fields.Add("LENDI.OBSERVAT", new TableFilterField("LENDI", "OBSERVAT", Resources.OBSERVATIONS03729, "text"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "returndt")
		{
			fields.Add("LENDI.RETURNDT", new TableFilterField("LENDI", "RETURNDT", Resources.RETURN32222, "date"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "returned")
		{
			fields.Add("LENDI.RETURNED", new TableFilterField("LENDI", "RETURNED", Resources.RETURNED01606, "bool"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "dayslimi")
		{
			fields.Add("LENDI.DAYSLIMI", new TableFilterField("LENDI", "DAYSLIMI", Resources.DAYS_FOR_RETURN_PERI04559, "num"));
		}
		if (areaField.Area == "lendi" && areaField.Field == "ifoutdt")
		{
			fields.Add("LENDI.IFOUTDT", new TableFilterField("LENDI", "IFOUTDT", Resources.IF_OUT_OF_DATE49042, "bool"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("PTN_Menu_LIST_DM_MB_R", "Lendi", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Lendi", data_form="PTN_Menu_LIST_DM_MB_R" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="PTN_Menu_LIST_DM_MB_R_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qPTN_Menu_LIST_DM_MB_R", Navigation.GetStrValue("qPTN_Menu_LIST_DM_MB_R"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('PTN_Menu_LIST_DM_MB_R');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('PTN_Menu_LIST_DM_MB_R');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__OF_THE_DADATO35934})
					<button id="qPTN_Menu_LIST_DM_MB_R-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("PTN_Menu_LIST_DM_MB_R", fields, "LENDI")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('PTN_Menu_LIST_DM_MB_R', 'LENDI', 'LENDI.LENDINNR');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="PTN_Menu_LIST_DM_MB_R_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#PTN_Menu_LIST_DM_MB_R_complex_filter', 'PTN_Menu_LIST_DM_MB_R_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("PTN_Menu_LIST_DM_MB_R")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="PTN_Menu_LIST_DM_MB_R" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "PTN_Menu_LIST_DM_MB_R", idlistController = "Lendi", idlistArea = "Lendi", codlista ="5e4e7e69-c5b2-478b-bb88-e077baaaf55b" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("PTN_Menu_LIST_DM_MB_R_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "PTN_Menu_LIST_DM_MB_R" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_PTN_Menu_LIST_DM_MB_R = new QMenuForm($('[data-form="PTN_Menu_LIST_DM_MB_R"]'), "Form_PTN_Menu_LIST_DM_MB_R");
		window.Form_PTN_Menu_LIST_DM_MB_R.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_PTN_Menu_LIST_DM_MB_R.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qPTN_Menu_LIST_DM_MB_R");
		RegisterClearEvents("PTN_Menu_LIST_DM_MB_R")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("PTN_Menu_LIST_DM_MB_R", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="PTN_Menu_LIST_DM_MB_R"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="PTN_Menu_LIST_DM_MB_R"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
