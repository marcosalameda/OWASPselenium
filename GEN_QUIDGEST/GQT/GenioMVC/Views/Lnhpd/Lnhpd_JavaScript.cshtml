	function Lnhpd_ValDesconju_BC_CONJUNTO (id) {

		var sourceId =  $('#ValCodtpequ').val();
		$.ajax({
            url: '@Url.Action("GetCarga_CONJUNTO")',
            type: "GET",
            data: { idsrc :sourceId, iddst : id }
        }).done(function(data) {
            bootbox.alert(data.data);
            QUtils.WindowReload();
        }).fail(function(jqXHR, textStatus) {
            bootbox.alert(quidgestGlobals.Resources.OCORREU_UM_ERRO_AO_P53091);
        });

    }
	</text>
}
  

    $($('[elem-identifier="FormActions"]'), $('[data-form="Lnhpd"]')).click(function(event){
