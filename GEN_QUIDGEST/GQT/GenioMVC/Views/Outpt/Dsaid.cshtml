@model GenioMVC.ViewModels.Outpt.Dsaid_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Dsaid";
	ViewBag.Title = @Resources.OUTPUT_DOCUMENT44972;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Outpt", FormMethod.Post, new { @class = "form-horizontal", area="Outpt", data_form="Dsaid" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Dsaid" area="Outpt" data-form="Dsaid">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Dsaid_well" area="Outpt" data-form="Dsaid">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

