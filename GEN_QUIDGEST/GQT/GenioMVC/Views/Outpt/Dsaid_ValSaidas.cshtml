@model GenioMVC.ViewModels.Outpt.Dsaid_ValSaidas_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
@if (this.Model.Menu.Elements.Count() >= 1)
{
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_DSAID___PSEUDSAIDAS__" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.OUTPUT_10769</h2 list-header> </label></div>
	</div>
	<div class="col-auto search">
	<div id="ValSaidas_simple_filter">
		<div class="i-input-group input-xxlarge">
			@Html.TextBox("qValSaidas", Model.Menu.Query, new { @class="i-input-group__field ", @onkeydown = "ListSearchEnter(event)", @style="height: inherit" } )
			<div class="i-input-group--right">
				<button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" elem-identifier="ListSearchButton" onclick="window.ValSaidas.Search();"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
				<button id="ValSaidas_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#ValSaidas_complex_filter', 'ValSaidas_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
			</div>
		</div>
	</div>
	</div>
	<div class="col-auto"  style="padding: 0; padding-right: 15px">
		<div class="b-btn-group">
			<button id="order_ValSaidas" class="b-btn b-icon b-icon--secondary" type="button" title="@Resources.REORDENAR52758" @if(!Model.IsEditableMode){ <text>disabled</text> }><i class="glyphicons glyphicons-move e-icon @if(!Model.IsEditableMode){ <text>disabled</text> }"></i></button>
			@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
			{
				<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="ValSaidas" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "Dsaid_ValSaidas", idlistController = "Outpt", idlistArea = "Outpu" , codlista =""  })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
			}
		</div>
	</div>
</div>

}
@* USE /[MANUAL GQT TABLE_FOR DSAID_SAIDAS]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Outpu;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Outpu>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodoutpu, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN DSAID_SAIDAS_OUTPU_LINE]/
		column.Expression(p => p.ValLine).Title(@Resources.LINE27983).Field("ValLine").Size(5);
// USE /[MANUAL GQT CUSTOM_COLUMN DSAID_SAIDAS_ITEM_ITEMDES]/
		column.Expression(p => p.Item.ValItemdes).Title(@Resources.ARTICLE60065).Field("Item.ValItemdes").Size(50);
// USE /[MANUAL GQT CUSTOM_COLUMN DSAID_SAIDAS_ITEM_ITEMCOD]/
		column.Expression(p => p.Item.ValItemcod).Title(@Resources.CODE49225).Field("Item.ValItemcod").Size(15);
// USE /[MANUAL GQT CUSTOM_COLUMN DSAID_SAIDAS_OUTPU_EXITQNTY]/
		column.Expression(p => p.ValExitqnty).Title(@Resources.QTD_OUTPUT12876).Field("ValExitqnty").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN DSAID_SAIDAS_WAREH_WAREHDES]/
		column.Expression(p => p.Wareh.ValWarehdes).Title(@Resources.WAREHOUSE51864).Form("Armazpop_Show","Wareh",p => p.Wareh.ValCodwareh, false, true).Field("Wareh.ValWarehdes").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Outpu")
        .Id("ValSaidas")
        .AjaxRequest("Dsaid_ValSaidas")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Dsaid_ValSaidas", new { id = Model.ValCodoutpt, partialView = "Dsaid_ValSaidas"}))
        .Filters(this.Model.Menu.Filters)
        .Form("Ldsai", false, true)
        .SetFollowUp("Ldsai_Show", "Outpu" , (Func<GenioMVC.Models.Outpu, object>)(item => new { id = item.ValCodoutpu }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {
	var link = '@Url.Action("ReorderDsaid_ValSaidas", "Outpt")';
	OrderTable("ValSaidas", link, "#CONTAINER_IFF_DSAID___PSEUDSAIDAS__", "#order_ValSaidas");

    try {
        if (jQuery) {
            try {
                $("#qValSaidas, #ValSaidas_complex_filter th input, #ValSaidas_filters input").change(function() {
                    $("#pValSaidas").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValSaidas_tableFilters').val(false);")
                    @Html.Raw("$('#ValSaidas_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValSaidas_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValSaidas_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValSaidas_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValSaidas').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValSaidas']"));
                    InitSpecialControls($('#ValSaidas'));
                    $('#ValSaidas').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS DSAID_VALSAIDAS]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>