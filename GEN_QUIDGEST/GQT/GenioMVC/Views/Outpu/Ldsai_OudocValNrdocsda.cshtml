        .RequestLink(@Url.Action("Ldsai_OudocValNrdocsda", new { id = Model.ValCodoutpu, partialView = "Ldsai_OudocValNrdocsda"}))
        .Filters(this.Model.Menu.Filters)
        .Form("Docsd", false, false, new { data_skip_prevalida = "true" })
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()
</div>
<script>
    try {
        if (jQuery) {
            try {
                $("#qLdsai_OudocValNrdocsda, #TableOudocNrdocsda_complex_filter th input").change(function() {
                    var context = $("#TableOudocNrdocsda").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Ldsai_OudocValNrdocsda table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_LDSAI___OUDOCNRDOCSDA"]');

                    selectList.trigger("DBEditSetValue", key);

                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Ldsai_OudocValNrdocsda_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Ldsai_OudocValNrdocsda_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Ldsai_OudocValNrdocsda_extra').prop("disabled", true);
</text>
}


// USE /[MANUAL GQT LISTING_JS LDSAI_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>
