<div class="normal-view">
@using GenioMVC.ViewModels.Oudoc;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Oudoc>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoddocsd, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN LDSAI_NRDOCSDA_OUDOC_NRDOCSDA]/
		column.Expression(p => p.ValNrdocsda).Title(@Resources.NO_14817).Field("ValNrdocsda").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN LDSAI_NRDOCSDA_OUDOC_DTDOCSDA]/
		column.Expression(p => p.ValDtdocsda).Title(@Resources.DATE18475).Field("ValDtdocsda").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN LDSAI_NRDOCSDA_OUDOC_TITLE]/
		column.Expression(p => p.ValTitle).Title(@Resources.TITLE21885).Field("ValTitle").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValNrdocsda).Field("ValNrdocsda").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Oudoc")
        .Id("Ldsai_OudocValNrdocsda")
        .AjaxRequest("Ldsai_OudocValNrdocsda")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
