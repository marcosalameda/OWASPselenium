@model GenioMVC.ViewModels.Pesso.PTN_Menu_1411_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Pesso.PTN_Menu_1411_ViewModel modelPTN_Menu_1411 = new GenioMVC.ViewModels.Pesso.PTN_Menu_1411_ViewModel(Navigation);
	var columns = modelPTN_Menu_1411.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrGenero = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayGenero.GetDictionary())
	{
		arrGenero.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "cmpny" && areaField.Field == "designat")
		{
			fields.Add("CMPNY.DESIGNAT", new TableFilterField("CMPNY", "DESIGNAT", Resources.DESIGNATION35876, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "name")
		{
			fields.Add("PESSO.NAME", new TableFilterField("PESSO", "NAME", Resources.NAME31974, "text", defaultSearch : true));
		}
		if (areaField.Area == "pesso" && areaField.Field == "gender")
		{
			fields.Add("PESSO.GENDER", new TableFilterField("PESSO", "GENDER", Resources.GENUS37471, "enum", array : arrGenero));
		}
		if (areaField.Area == "pesso" && areaField.Field == "dtnascim")
		{
			fields.Add("PESSO.DTNASCIM", new TableFilterField("PESSO", "DTNASCIM", Resources.BIRTH21799, "date"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "idade")
		{
			fields.Add("PESSO.IDADE", new TableFilterField("PESSO", "IDADE", Resources.AGE28663, "num"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "idfuncio")
		{
			fields.Add("PESSO.IDFUNCIO", new TableFilterField("PESSO", "IDFUNCIO", Resources.OFFICIAL_NO_34819, "num"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "telephon")
		{
			fields.Add("PESSO.TELEPHON", new TableFilterField("PESSO", "TELEPHON", Resources.PHONE56703, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "email")
		{
			fields.Add("PESSO.EMAIL", new TableFilterField("PESSO", "EMAIL", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "email2")
		{
			fields.Add("PESSO.EMAIL2", new TableFilterField("PESSO", "EMAIL2", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "dtultcat")
		{
			fields.Add("PESSO.DTULTCAT", new TableFilterField("PESSO", "DTULTCAT", Resources.SINCE47259, "date"));
		}
		if (areaField.Area == "categ" && areaField.Field == "category")
		{
			fields.Add("CATEG.CATEGORY", new TableFilterField("CATEG", "CATEGORY", Resources.CATEGORY18978, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "externa")
		{
			fields.Add("PESSO.EXTERNA", new TableFilterField("PESSO", "EXTERNA", Resources.EXTERNAL13375, "bool"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "interna")
		{
			fields.Add("PESSO.INTERNA", new TableFilterField("PESSO", "INTERNA", Resources.INTERNAL04894, "bool"));
		}
		if (areaField.Area == "cntry" && areaField.Field == "country")
		{
			fields.Add("CNTRY.COUNTRY", new TableFilterField("CNTRY", "COUNTRY", Resources.COUNTRY64133, "text"));
		}
		if (areaField.Area == "pais1" && areaField.Field == "country")
		{
			fields.Add("PAIS1.COUNTRY", new TableFilterField("PAIS1", "COUNTRY", Resources.COUNTRY64133, "text"));
		}
		if (areaField.Area == "regi1" && areaField.Field == "regiao")
		{
			fields.Add("REGI1.REGIAO", new TableFilterField("REGI1", "REGIAO", Resources.REGION12723, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("PTN_Menu_1411", "Pesso", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Pesso", data_form="PTN_Menu_1411" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="PTN_Menu_1411_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qPTN_Menu_1411", Navigation.GetStrValue("qPTN_Menu_1411"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('PTN_Menu_1411');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('PTN_Menu_1411');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NAME31974})
					<button id="qPTN_Menu_1411-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("PTN_Menu_1411", fields, "PESSO")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('PTN_Menu_1411', 'PESSO', 'PESSO.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="PTN_Menu_1411_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#PTN_Menu_1411_complex_filter', 'PTN_Menu_1411_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("PTN_Menu_1411")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="PTN_Menu_1411" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "PTN_Menu_1411", idlistController = "Pesso", idlistArea = "Pesso", codlista ="70d754f6-18c4-4fa0-9c99-0e776084a3e4" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("PTN_Menu_1411_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "PTN_Menu_1411" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_PTN_Menu_1411 = new QMenuForm($('[data-form="PTN_Menu_1411"]'), "Form_PTN_Menu_1411");
		window.Form_PTN_Menu_1411.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_PTN_Menu_1411.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qPTN_Menu_1411");
		RegisterClearEvents("PTN_Menu_1411")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("PTN_Menu_1411", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="PTN_Menu_1411"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="PTN_Menu_1411"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
