		column.Expression(p => p.ValSince).Title(@Resources.SINCE47259).Field("ValSince").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN PESSO1_EVOLUCAO_CATE1_CATEGORY]/
		column.Expression(p => p.Cate1.ValCategoria).Title(@Resources.CATEGORY18978).Field("Cate1.ValCategoria").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PESSO1_EVOLUCAO_EVCAT_FIMPERIO]/
		column.Expression(p => p.ValFimperio).Title(@Resources.END_OF_PERIOD44616).Field("ValFimperio").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN PESSO1_EVOLUCAO_EVCAT_OBSERVAT]/
		column.Expression(p => p.ValObservat).Title(@Resources.OBSERVATION37880).Field("ValObservat").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Evcat")
        .Id("ValEvolucao")
        .AjaxRequest("Pesso1_ValEvolucao")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Pesso1_ValEvolucao", new { id = Model.ValCodpesso, partialView = "Pesso1_ValEvolucao"}))
        .Form("Evcat", false, false)
        .SetFollowUp("Evcat_Show", "Evcat" , (Func<GenioMVC.Models.Evcat, object>)(item => new { id = item.ValCodprogr }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValEvolucao, #ValEvolucao_complex_filter th input, #ValEvolucao_filters input").change(function() {
                    $("#pValEvolucao").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValEvolucao_tableFilters').val(false);")
                    @Html.Raw("$('#ValEvolucao_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValEvolucao_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValEvolucao_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValEvolucao_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValEvolucao').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValEvolucao']"));
                    InitSpecialControls($('#ValEvolucao'));
                    $('#ValEvolucao').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PESSO1_VALEVOLUCAO]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>