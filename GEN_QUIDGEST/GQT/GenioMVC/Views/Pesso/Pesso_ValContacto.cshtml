@model GenioMVC.ViewModels.Pesso.Pesso_ValContacto_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR PESSO_CONTACTO]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Conta;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Conta>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodconta, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PESSO_CONTACTO_TPCON_TIPOCONT]/
		column.Expression(p => p.Tpcon.ValTipocont).Title(@Resources.GENUS37471).Field("Tpcon.ValTipocont").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN PESSO_CONTACTO_CONTA_CONTACTO]/
		column.Expression(p => p.ValContacto).Title(@Resources.CONTACT59247).Field("ValContacto").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Conta")
        .Id("ValContacto")
        .AjaxRequest("Pesso_ValContacto")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Pesso_ValContacto", new { id = Model.ValCodpesso, partialView = "Pesso_ValContacto"}))
        .Form("Conta", true, false)
        .SetFollowUp("Conta_Show", "Conta" , (Func<GenioMVC.Models.Conta, object>)(item => new { id = item.ValCodconta }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: true)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValContacto, #ValContacto_complex_filter th input, #ValContacto_filters input").change(function() {
                    $("#pValContacto").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValContacto_tableFilters').val(false);")
                    @Html.Raw("$('#ValContacto_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValContacto_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValContacto_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValContacto_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValContacto').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValContacto']"));
                    InitSpecialControls($('#ValContacto'));
                    $('#ValContacto').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PESSO_VALCONTACTO]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>