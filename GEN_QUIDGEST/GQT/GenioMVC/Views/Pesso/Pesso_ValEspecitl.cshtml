	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR PESSO_ESPECITL]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Esppe;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Esppe>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodesppe, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PESSO_ESPECITL_SPECI_ESPECIAL]/
		column.Expression(p => p.Speci.ValEspecial).Title(@Resources.SPECIALTY09304).Field("Speci.ValEspecial").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PESSO_ESPECITL_SPECI_AREATECN]/
		column.Expression(p => p.Speci.ArrayValareatecn).Title(@Resources.TECHNICAL_AREA50773).Field("Speci.ValAreatecn", "ArrayAreatecn").Size(1);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Esppe")
        .Id("ValEspecitl")
        .AjaxRequest("Pesso_ValEspecitl")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Pesso_ValEspecitl", new { id = Model.ValCodpesso, partialView = "Pesso_ValEspecitl"}))
        .Form("Esppe", false, false)
        .SetFollowUp("Esppe_Show", "Esppe" , (Func<GenioMVC.Models.Esppe, object>)(item => new { id = item.ValCodesppe }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


