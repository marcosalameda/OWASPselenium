@model GenioMVC.ViewModels.Pesso.Pessohis_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Pessohis";
	ViewBag.Title = @Resources.PERSON10446;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Pesso", FormMethod.Post, new { @class = "form-horizontal", area="Pesso", data_form="Pessohis" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Pessohis" area="Pesso" data-form="Pessohis">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Pessohis_well" area="Pesso" data-form="Pessohis">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
