@model GenioMVC.ViewModels.Pesso.TBS_Menu_121_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Pesso.TBS_Menu_121_ViewModel modelTBS_Menu_121 = new GenioMVC.ViewModels.Pesso.TBS_Menu_121_ViewModel(Navigation);
	var columns = modelTBS_Menu_121.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrGenero = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayGenero.GetDictionary())
	{
		arrGenero.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "pesso" && areaField.Field == "name")
		{
			fields.Add("PESSO.NAME", new TableFilterField("PESSO", "NAME", Resources.NAME31974, "text", defaultSearch : true));
		}
		if (areaField.Area == "pesso" && areaField.Field == "gender")
		{
			fields.Add("PESSO.GENDER", new TableFilterField("PESSO", "GENDER", Resources.GENUS37471, "enum", array : arrGenero));
		}
		if (areaField.Area == "pesso" && areaField.Field == "dtnascim")
		{
			fields.Add("PESSO.DTNASCIM", new TableFilterField("PESSO", "DTNASCIM", Resources.BIRTH21799, "date"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "telephon")
		{
			fields.Add("PESSO.TELEPHON", new TableFilterField("PESSO", "TELEPHON", Resources.PHONE56703, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "email")
		{
			fields.Add("PESSO.EMAIL", new TableFilterField("PESSO", "EMAIL", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "idfuncio")
		{
			fields.Add("PESSO.IDFUNCIO", new TableFilterField("PESSO", "IDFUNCIO", Resources.OFFICIAL_NO_34819, "num"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "dtultcat")
		{
			fields.Add("PESSO.DTULTCAT", new TableFilterField("PESSO", "DTULTCAT", Resources.SINCE47259, "date"));
		}
		if (areaField.Area == "categ" && areaField.Field == "category")
		{
			fields.Add("CATEG.CATEGORY", new TableFilterField("CATEG", "CATEGORY", Resources.CATEGORY18978, "text"));
		}
		if (areaField.Area == "cmpny" && areaField.Field == "designat")
		{
			fields.Add("CMPNY.DESIGNAT", new TableFilterField("CMPNY", "DESIGNAT", Resources.COMPANY52963, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("TBS_Menu_121", "Pesso", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Pesso", data_form="TBS_Menu_121" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="TBS_Menu_121_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qTBS_Menu_121", Navigation.GetStrValue("qTBS_Menu_121"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('TBS_Menu_121');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('TBS_Menu_121');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NAME31974})
					<button id="qTBS_Menu_121-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("TBS_Menu_121", fields, "PESSO")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('TBS_Menu_121', 'PESSO', 'PESSO.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="TBS_Menu_121_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#TBS_Menu_121_complex_filter', 'TBS_Menu_121_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("TBS_Menu_121")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="TBS_Menu_121" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "TBS_Menu_121", idlistController = "Pesso", idlistArea = "Pesso", codlista ="5bbb3c85-0f2b-4e4a-a096-baeef7fb9b34" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("TBS_Menu_121_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "TBS_Menu_121" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_TBS_Menu_121 = new QMenuForm($('[data-form="TBS_Menu_121"]'), "Form_TBS_Menu_121");
		window.Form_TBS_Menu_121.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_TBS_Menu_121.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qTBS_Menu_121");
		RegisterClearEvents("TBS_Menu_121")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("TBS_Menu_121", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="TBS_Menu_121"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="TBS_Menu_121"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
