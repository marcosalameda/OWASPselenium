@model GenioMVC.ViewModels.Proje.Proje_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Proje";
	ViewBag.Title = @Resources.PROJECTO50142;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Proje", FormMethod.Post, new { @class = "form-horizontal", area="Proje", data_form="Proje" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Proje" area="Proje" data-form="Proje">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Proje_well" area="Proje" data-form="Proje">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

