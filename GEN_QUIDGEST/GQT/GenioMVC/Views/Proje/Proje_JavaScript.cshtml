	window.Form_Proje.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValSaldo1' field *@
		$(qForm).bind('VALFOLLOWIN_CHANGE VALBEFORE_CHANGE', function(event, eTarget) {
				try {
						var newValue = ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValFollowin', $('[data-form="Proje"]')))- getFieldValue($(':not([elem-identifier="Multiform"]) > #ValBefore', $('[data-form="Proje"]'))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValSaldo1', $('[data-form="Proje"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValSaldo1', $('[data-form="Proje"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValSaldo1', $('[data-form="Proje"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValSaldo1: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Formula of the 'ValSaldo2' field *@
		$(qForm).bind('VALULTIMO_CHANGE VALPRIMEIRO_CHANGE', function(event, eTarget) {
				try {
						var newValue = ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValUltimo', $('[data-form="Proje"]')))- getFieldValue($(':not([elem-identifier="Multiform"]) > #ValPrimeiro', $('[data-form="Proje"]'))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValSaldo2', $('[data-form="Proje"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValSaldo2', $('[data-form="Proje"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValSaldo2', $('[data-form="Proje"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValSaldo2: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Recalculate formulas (server side) *@
		$(qForm).bind('VALYEAR_CHANGE VALCODPROJE_CHANGE', function(event, eTarget) {
				window.Form_Proje.RecalculateFormulas();
		});
		





	</text>
}

