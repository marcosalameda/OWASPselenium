@model GenioMVC.ViewModels.Proje.Proje_ValDespesas_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
@if (this.Model.Menu.Elements.Count() >= 1)
{
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_PROJE___PSEUDDESPESAS" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.EXPENSES11381</h2 list-header> </label></div>
	</div>
</div>

}
@* USE /[MANUAL GQT TABLE_FOR PROJE_DESPESAS]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Expen;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Expen>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoddespe, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PROJE_DESPESAS_EXPEN_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION07383).Field("ValDescript").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PROJE_DESPESAS_EXPEN_VALUE]/
		column.Expression(p => p.ValValue).Title(@Resources.VALUE10285).Field("ValValue").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN PROJE_DESPESAS_YEAR_YEAR]/
		column.Expression(p => p.Year.ValYear).Title(@Resources.ANO33022).Field("Year.ValYear").Size(4);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Expen")
        .Id("ValDespesas")
        .AjaxRequest("Proje_ValDespesas")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Proje_ValDespesas", new { id = Model.ValCodproje, partialView = "Proje_ValDespesas"}))
        .Form("Despe", false, false)
        .SetFollowUp("Despe_Show", "Expen" , (Func<GenioMVC.Models.Expen, object>)(item => new { id = item.ValCoddespe }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValDespesas, #ValDespesas_complex_filter th input, #ValDespesas_filters input").change(function() {
                    $("#pValDespesas").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValDespesas_tableFilters').val(false);")
                    @Html.Raw("$('#ValDespesas_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValDespesas_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValDespesas_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValDespesas_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValDespesas').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValDespesas']"));
                    InitSpecialControls($('#ValDespesas'));
                    $('#ValDespesas').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PROJE_VALDESPESAS]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>