@model GenioMVC.ViewModels.Psw.PswViewModel
@using GenioMVC.Models.Navigation;
@{
    switch (Model.FormMode)
    {
        case FormMode.Show:
            ViewBag.Title = @Resources.CONSULTAR57388;
            break;
        case FormMode.New:
            ViewBag.Title = @Resources.CRIAR24836;
            break;
        case FormMode.Edit:
            ViewBag.Title = @Resources.EDITAR11616;
            break;
        case FormMode.Delete:
            ViewBag.Title = @Resources.ELIMINAR21155;
            break;
    }
}

@if(Model.FormMode == FormMode.Delete)
{
<div class="c-alert c-alert--warning">
    <i class="glyphicons glyphicons-alert c-alert__icon"></i>
    <div class="c-alert__text">    
        &ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
    </div>
<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
</div>
}

@if (!Model.NestedForm && Model.FormMode != FormMode.Show) {
    using (Html.BeginForm("Action", "Psw", FormMethod.Post, new { @class = "form-horizontal", area="Psw", data_form="User" }))
    {
	    @form_content()
    }
}
else {
    <div class="well nested-form" id="User_well" area="Psw" data-form="User">
        @form_content()
    </div>
}

@helper form_content() {
	@Html.ValidationSummary(!Model.IsEditableMode)
	<fieldset>
		<legend class="form-header">@ViewBag.Title</legend>
        <div class="row">
            <div class="col-12">
                <div class="i-text">
                    @Html.LabelFor(model => model.ValNome, new { @class = "i-text__label" }, true)
                    @if (Model.FormMode == FormMode.New || Model.FormMode == FormMode.Duplicate)
                    {
                        @Html.TextBoxFor(model => model.ValNome, new { @class = "i-text__field input-xlarge", title = @Resources.NOME_DE_UTILIZADOR58858 })
                    }
                    else
                    {
                        @Html.TextBoxFor(model => model.ValNome, new { @class = "i-text__field input-xlarge", @readonly = "readonly", title = @Resources.NOME_DE_UTILIZADOR58858 })
                    }
                </div>
                <div class="i-text">
                    @Html.LabelFor(model => model.ValEmail, new { @class = "i-text__label" })
                    @Html.TextBoxFor(model => model.ValEmail, new { @class = "i-text__field input-xlarge", placeholder = @Resources.EMAIL25170, title = @Resources.EMAIL25170 })
                </div>
            </div>
        </div>
        @if (Model.IsEditableMode && CSGenio.framework.Configuration.LoginType != CSGenio.framework.Configuration.LoginTypes.PUREAD)
        {
            <div class="row">
                <div class="col-12">
                    <div class="i-text">
                        @Html.LabelFor(model => model.ValPassword, new { @class = "i-text__label" })
                        @Html.PasswordFor(model => model.ValPassword, new { autocomplete = "off", @class = "i-text__field input-xlarge", placeholder = @Resources.NOVA_PALAVRA_CHAVE09647, title = @Resources.NOVA_PALAVRA_CHAVE09647 })
                    </div>
                    <div class="i-text">
                        @Html.LabelFor(model => model.ValConfirmPassword, new { @class = "i-text__label" })
                        @Html.PasswordFor(model => model.ValConfirmPassword, new { autocomplete = "off", @class = "i-text__field input-xlarge", placeholder = @Resources.CONFIRMAR_NOVA_PALAV02846, title = @Resources.CONFIRMAR_NOVA_PALAV02846 })
                    </div>
                    @Html.PasswordMeter(model => model.ValPassword)
                </div>
            </div>
        }
        
        <table id="user-authorizations" class="c-table c-table-bordered c-table-striped">
            <thead class="c-table__head">
                <tr>
                    <th>@Resources.SIGLA14738</th>
                    <th>@Resources.MODULO43834</th>
                    <th>@Resources.PERMISSOES38545</th>
                </tr>
            </thead>
            <tbody class="c-table__body">
                <tr>
                    <td>
                        @Html.Label("GQT")
                    </td>
                    <td>
                        @Html.Label(Resources.GENIO_QUALITY_TESTS30896)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.GQTLevel, Model.UserGQT, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserGQT.SelectedValue, title = Resources.GENIO_QUALITY_TESTS30896 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.Label("PTN")
                    </td>
                    <td>
                        @Html.Label(Resources.PATTERNS16056)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.PTNLevel, Model.UserPTN, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserPTN.SelectedValue, title = Resources.PATTERNS16056 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.Label("STY")
                    </td>
                    <td>
                        @Html.Label(Resources.STYLE47121)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.STYLevel, Model.UserSTY, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserSTY.SelectedValue, title = Resources.STYLE47121 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.Label("TBS")
                    </td>
                    <td>
                        @Html.Label(Resources.BASE_TABLES04823)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.TBSLevel, Model.UserTBS, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserTBS.SelectedValue, title = Resources.BASE_TABLES04823 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.Label("REG")
                    </td>
                    <td>
                        @Html.Label(Resources.REGISTRATION03584)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.REGLevel, Model.UserREG, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserREG.SelectedValue, title = Resources.REGISTRATION03584 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.Label("IMO")
                    </td>
                    <td>
                        @Html.Label(Resources.REAL_ESTATE24996)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.IMOLevel, Model.UserIMO, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserIMO.SelectedValue, title = Resources.REAL_ESTATE24996 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.Label("WMS")
                    </td>
                    <td>
                        @Html.Label(Resources.WAREHOUSE_MANAGEMENT10443)
                    </td>
                    <td>
						@Html.DropDownListFor(model => Model.WMSLevel, Model.UserWMS, new { @class = "i-select chosen-dropdown", @elem_identifier = "ChosenDropdown", data_value = Model.UserWMS.SelectedValue, title = Resources.WAREHOUSE_MANAGEMENT10443 + " " + Resources.PERMISSOES38545 })
						@Html.ValidationMessageFor(model => model.ValCodpsw)
                    </td>
                </tr>
            </tbody>
        </table>

		@Html.HiddenFor(model => model.ValCodpsw, new { @pers_cs_field="ValCodpsw", @pers_cs_area="Psw" })
		@Html.AntiForgeryToken()

			<div class="form-actions">
				@if (!Model.NestedForm)
				{
                    if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
                    {
						<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("User", Model.FormMode))" class="b-icon-text b-icon-text--primary" title = "@Resources.GRAVAR45301 / @Resources.CONFIRMAR09808">
                    		@if(Model.FormMode == FormMode.Delete)
			                {
			                	<i class="glyphicons glyphicons-check e-icon"></i>
			                    @Resources.CONFIRMAR09808
			                }
			                else
			                {
			                	<i class="SaveIcon e-icon"></i>
			                    @Resources.GRAVAR45301
			                }
                    	</button>
						@Html.ActionLinkWithIcon(@Resources.CANCELAR49513, "User_Cancel","Psw","glyphicons glyphicons-ban-circle e-icon", new { id=@Model.ValCodpsw }, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", title = Resources.CANCELAR49513 })
                    }
                    else
                    {
                        @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "User_Cancel","Psw","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", title = Resources.RETROCEDER16633})
                    }
				}
				else if (Model.IsEditableMode)
				{
					<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("User", Model.FormMode).ToString(), "Psw"))", "User_well")'>
                        <i class="SaveIcon e-icon"></i>
                        @Resources.GRAVAR45301
                    </button>
					<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action("User_Delete", "Psw"))", "User_well")'><i class="glyphicons glyphicons-ban-circle e-icon"></i>@Resources.CANCELAR49513</button>

					//javascript code_javascript
					@codeJavascript()
					//reload things
					<script type="application/javascript">
					    $(document).ready(function () { loaded($("#User_well")); });
					</script>
				}
			</div>
	</fieldset>
}

@helper codeJavascript()
{
@Scripts.Render("~/Scripts/validateJs")
<script>
    var ajaxCallsRemaining = $(".flash object embed").length;

    $("form .btn.btn-primary").click(function () {
        var flashObjects = $(".flash object embed");
        ajaxCallsRemaining = flashObjects.length;
        if (flashObjects.length == 0)
            return true;
        else {
            flashObjects.each(function () {
                var flashObj = GetFlash($(this).attr('id'))
                flashObj.UsedFlash.TriggerSave(flashObj);
            });
            return false;
        }
    });
    QLocalStorage.remLocalStorage("savedInfo");
    $(document).ready(function (e) {
        InitSpecialControls($('[data-form="User"]'));
        @if(!Model.IsEditableMode)
        {
<text>
        @* Block all fields in Show mode *@
        $('[data-form="User"]')
            .find('[elem-identifier="ChosenDropdown"], #ValNome')
            .prop('readonly', true).attr('readonly', true)
            .trigger("liszt:updated");
</text>
        }
    });
</script>
}

@section code_javascript {
	@codeJavascript()
}
