@model GenioMVC.ViewModels.Pworg.Pworg_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Pworg";
	ViewBag.Title = @Resources.ACESSO_A_ORGANIZACAO01976;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Pworg", FormMethod.Post, new { @class = "form-horizontal", area="Pworg", data_form="Pworg" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Pworg" area="Pworg" data-form="Pworg">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Pworg_well" area="Pworg" data-form="Pworg">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

