@model GenioMVC.ViewModels.Pwreg.Pwreg_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Pwreg";
	ViewBag.Title = @Resources.ACESSO_REGIAO41894;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Pwreg", FormMethod.Post, new { @class = "form-horizontal", area="Pwreg", data_form="Pwreg" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Pwreg" area="Pwreg" data-form="Pwreg">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Pwreg_well" area="Pwreg" data-form="Pwreg">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_PWREG___PSW__NOME____">
								<div class="d-flex">
								@Html.LabelFor(model => model.TablePswNome, new { label_id="IFF_PWREG___PSW__NOME____", @class = " i-text__label", id="LABEL_IFF_PWREG___PSW__NOME____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_PWREG___PSW__NOME____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodpsw, Model.TablePswNome.List , "", new {help_id = "IFF_PWREG___PSW__NOME____", @class = "i-select chosen-dropdown input-large", data_identifier = "IFF_PWREG___PSW__NOME____", @pers_cs_area = "Psw", @pers_cs_field = "ValCodpsw", @db_field = "ValCodpsw", @db_full_field_name = "pwreg.codpsw", data_has_more = Model.TablePswNome.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TablePswNome.Selected, data_dbedit_value = Model.TablePswNome.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodpwreg, @data_see_more = "Pwreg_PswValNome", title = @Resources.LOGIN_NAME03494, data_see_more_url = @Url.Action("Pwreg_PswValNome","Pwreg"), data_is_dbedit = "true", data_fields = "psw.codpsw,psw.nome", data_main_field = "Psw.ValNome", data_elements = 0, data_filled_by_history = Model.TablePswNome.FilledByHistory, @dependant_fields = "psw.codpsw,psw.nome" })
								@Html.ValidationMessageFor(model => model.TablePswNome)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_PWREG___REGIOREGIAO__">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableRegioRegiao, new { label_id="IFF_PWREG___REGIOREGIAO__", @class = " i-text__label", id="LABEL_IFF_PWREG___REGIOREGIAO__"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_PWREG___REGIOREGIAO__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodregia, Model.TableRegioRegiao.List , "", new {help_id = "IFF_PWREG___REGIOREGIAO__", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_PWREG___REGIOREGIAO__", @pers_cs_area = "Regio", @pers_cs_field = "ValCodregia", @db_field = "ValCodregia", @db_full_field_name = "pwreg.codregia", data_has_more = Model.TableRegioRegiao.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableRegioRegiao.Selected, data_dbedit_value = Model.TableRegioRegiao.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodpwreg, @data_see_more = "Pwreg_RegioValRegiao", title = @Resources.REGION12723, data_see_more_url = @Url.Action("Pwreg_RegioValRegiao","Pwreg"), data_is_dbedit = "true", data_fields = "regio.codregia,regio.regiao", data_main_field = "Regio.ValRegiao", data_elements = 0, data_filled_by_history = Model.TableRegioRegiao.FilledByHistory, @dependant_fields = "regio.codregia,regio.regiao" })
								@Html.ValidationMessageFor(model => model.TableRegioRegiao)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodpwreg, new { @pers_cs_field="ValCodpwreg", @pers_cs_area="Pwreg", data_refresh = "true", @form_area="true", @data_value = Model.ValCodpwreg, @data_identifier = "LED_PWREG___PWREGCODPWREG" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Pwreg" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Pwreg" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Pwreg" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Pwreg", Model.FormMode).ToString(), "Pwreg"))", "Pwreg_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.GRAVAR45301
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Pwreg_Delete", "Pwreg", new {id = @Model.ValCodpwreg} )", "Pwreg_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Pwreg_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Pwreg_Delete", "Pwreg", new {id = @Model.ValCodpwreg} )", "Pwreg_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Pwreg_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitPwreg(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Pwreg", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeletePwreg(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Pwreg", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitPwreg(event)" title="@Resources.GRAVAR45301" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR45301
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Pwreg_Cancel", "Pwreg", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Pwreg.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Pwreg_Cancel","Pwreg","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Pwreg">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Pwreg" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Pwreg">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

