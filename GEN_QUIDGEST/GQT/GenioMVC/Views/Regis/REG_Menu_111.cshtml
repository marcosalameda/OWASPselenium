@model GenioMVC.ViewModels.Regis.REG_Menu_111_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Regis.REG_Menu_111_ViewModel modelREG_Menu_111 = new GenioMVC.ViewModels.Regis.REG_Menu_111_ViewModel(Navigation);
	var columns = modelREG_Menu_111.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "regis" && areaField.Field == "name")
		{
			fields.Add("REGIS.NAME", new TableFilterField("REGIS", "NAME", Resources.NAME31974, "text", defaultSearch : true));
		}
		if (areaField.Area == "regis" && areaField.Field == "nif")
		{
			fields.Add("REGIS.NIF", new TableFilterField("REGIS", "NIF", Resources.NIF55908, "text"));
		}
		if (areaField.Area == "regis" && areaField.Field == "email1")
		{
			fields.Add("REGIS.EMAIL1", new TableFilterField("REGIS", "EMAIL1", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "regis" && areaField.Field == "email2")
		{
			fields.Add("REGIS.EMAIL2", new TableFilterField("REGIS", "EMAIL2", Resources.EMAIL25170, "text"));
		}
		if (areaField.Area == "regis" && areaField.Field == "telephon")
		{
			fields.Add("REGIS.TELEPHON", new TableFilterField("REGIS", "TELEPHON", Resources.PHONE56703, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("REG_Menu_111", "Regis", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Regis", data_form="REG_Menu_111" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="REG_Menu_111_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qREG_Menu_111", Navigation.GetStrValue("qREG_Menu_111"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('REG_Menu_111');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('REG_Menu_111');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NAME31974})
					<button id="qREG_Menu_111-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("REG_Menu_111", fields, "REGIS")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('REG_Menu_111', 'REGIS', 'REGIS.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="REG_Menu_111_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#REG_Menu_111_complex_filter', 'REG_Menu_111_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("REG_Menu_111")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="REG_Menu_111" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "REG_Menu_111", idlistController = "Regis", idlistArea = "Regis", codlista ="9cd10358-e74c-413f-9913-baa3ad3afa58" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("REG_Menu_111_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "REG_Menu_111" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_REG_Menu_111 = new QMenuForm($('[data-form="REG_Menu_111"]'), "Form_REG_Menu_111");
		window.Form_REG_Menu_111.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_REG_Menu_111.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qREG_Menu_111");
		RegisterClearEvents("REG_Menu_111")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("REG_Menu_111", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="REG_Menu_111"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="REG_Menu_111"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
