@model GenioMVC.ViewModels.Regis.REG_Menu_111_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Regis;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Regis>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodregis, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN REG_MENU_111_REGIS_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(50);
// USE /[MANUAL GQT CUSTOM_COLUMN REG_MENU_111_REGIS_NIF]/
		column.Expression(p => p.ValNif).Title(@Resources.NIF55908).Field("ValNif").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN REG_MENU_111_REGIS_EMAIL1]/
		column.Expression(p => p.ValEmail1).Title(@Resources.EMAIL25170).Field("ValEmail1").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN REG_MENU_111_REGIS_EMAIL2]/
		column.Expression(p => p.ValEmail2).Title(@Resources.EMAIL25170).Field("ValEmail2").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN REG_MENU_111_REGIS_TELEPHON]/
		column.Expression(p => p.ValTelephon).Title(@Resources.PHONE56703).Field("ValTelephon").Size(15);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Regis")
        .Id("REG_Menu_111")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Regis", false, false)
        .UpdateConditions((item)=>Regis_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Regis_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Regis_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Regis_ViewModel.InsertConditions(this.Model.Navigation))
        .SetFollowUp("Regis_Edit", "Regis" , (Func<GenioMVC.Models.Regis, object>)(item => new { id = item.ValCodregis }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qREG_Menu_111, #REG_Menu_111_complex_filter th input, #REG_Menu_111_filters input").change(function() {
                    $("#pREG_Menu_111").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#REG_Menu_111_tableFilters').val(false);")
                    @Html.Raw("$('#REG_Menu_111_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#REG_Menu_111_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='REG_Menu_111']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qREG_Menu_111');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#REG_Menu_111_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_REG_Menu_111').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('REG_Menu_111', 'REGIS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS REG_MENU_111]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS REG_MENU_111]/
</script>