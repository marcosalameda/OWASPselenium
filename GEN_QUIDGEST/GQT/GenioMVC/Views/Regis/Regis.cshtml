@model GenioMVC.ViewModels.Regis.Regis_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Regis";
	ViewBag.Title = @Resources.REGISTRATION_ON_THE_28460;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Regis", FormMethod.Post, new { @class = "form-horizontal", area="Regis", data_form="Regis" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Regis" area="Regis" data-form="Regis">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Regis_well" area="Regis" data-form="Regis">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

