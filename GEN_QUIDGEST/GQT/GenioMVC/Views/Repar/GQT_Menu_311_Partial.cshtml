		column.Expression(p => p.Speci.ValEspecial).Title(@Resources.SPECIALTY09304).Field("Speci.ValEspecial").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_311_REPAR_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION_OF_THE_R26085).Field("ValDescript").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_311_REPAR_HOURS]/
		column.Expression(p => p.ValHours).Title(@Resources.SPENT_ON_HOURS19285).Field("ValHours").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_311_CMPNY_DESIGNAT]/
		column.Expression(p => p.Cmpny.ValDesignat).Title(@Resources.COMPANY52963).Hidden().Field("Cmpny.ValDesignat").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Repar")
        .Id("GQT_Menu_311")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Repar", false, false)
        .SetFollowUp("Repar_Show", "Repar" , (Func<GenioMVC.Models.Repar, object>)(item => new { id = item.ValCodrepar }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_311, #GQT_Menu_311_complex_filter th input, #GQT_Menu_311_filters input").change(function() {
                    $("#pGQT_Menu_311").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_311_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_311_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_311_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_311']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_311');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_311_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_311').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_311', 'REPAR', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_311]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_311]/
</script>