		column.Expression(p => p.ValDtrepara).Title(@Resources.FIXED_IN00179).Field("ValDtrepara").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_311_EQUIP_REGISTNR]/
		column.Expression(p => p.Equip.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("Equip.ValRegistnr").Size(6);
