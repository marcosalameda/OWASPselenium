@model GenioMVC.ViewModels.Repar.GQT_Menu_REPAIR_LIST_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Repar.GQT_Menu_REPAIR_LIST_ViewModel modelGQT_Menu_REPAIR_LIST = new GenioMVC.ViewModels.Repar.GQT_Menu_REPAIR_LIST_ViewModel(Navigation);
	var columns = modelGQT_Menu_REPAIR_LIST.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrAreatecn = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayAreatecn.GetDictionary())
	{
		arrAreatecn.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "repar" && areaField.Field == "nrrepara")
		{
			fields.Add("REPAR.NRREPARA", new TableFilterField("REPAR", "NRREPARA", Resources.REPAIR_NO_45492, "num"));
		}
		if (areaField.Area == "repar" && areaField.Field == "dtrepara")
		{
			fields.Add("REPAR.DTREPARA", new TableFilterField("REPAR", "DTREPARA", Resources.FIXED_IN00179, "date", defaultSearch : true));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "designat")
		{
			fields.Add("EQUIP.DESIGNAT", new TableFilterField("EQUIP", "DESIGNAT", Resources.EQUIPMENT03632, "text"));
		}
		if (areaField.Area == "pesso" && areaField.Field == "name")
		{
			fields.Add("PESSO.NAME", new TableFilterField("PESSO", "NAME", Resources.TECHNICAL18245, "text"));
		}
		if (areaField.Area == "repar" && areaField.Field == "tipoarea")
		{
			fields.Add("REPAR.TIPOAREA", new TableFilterField("REPAR", "TIPOAREA", Resources.TECHNICAL_AREA50773, "enum", array : arrAreatecn));
		}
		if (areaField.Area == "speci" && areaField.Field == "especial")
		{
			fields.Add("SPECI.ESPECIAL", new TableFilterField("SPECI", "ESPECIAL", Resources.SPECIALTY09304, "text"));
		}
		if (areaField.Area == "repar" && areaField.Field == "descript")
		{
			fields.Add("REPAR.DESCRIPT", new TableFilterField("REPAR", "DESCRIPT", Resources.DESCRIPTION_OF_THE_R26085, "text"));
		}
		if (areaField.Area == "repar" && areaField.Field == "hours")
		{
			fields.Add("REPAR.HOURS", new TableFilterField("REPAR", "HOURS", Resources.SPENT_ON_HOURS19285, "num"));
		}
		if (areaField.Area == "cmpny" && areaField.Field == "designat")
		{
			fields.Add("CMPNY.DESIGNAT", new TableFilterField("CMPNY", "DESIGNAT", Resources.COMPANY52963, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("GQT_Menu_REPAIR_LIST", "Repar", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Repar", data_form="GQT_Menu_REPAIR_LIST" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="GQT_Menu_REPAIR_LIST_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qGQT_Menu_REPAIR_LIST", Navigation.GetStrValue("qGQT_Menu_REPAIR_LIST"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('GQT_Menu_REPAIR_LIST');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('GQT_Menu_REPAIR_LIST');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.FIXED_IN00179})
					<button id="qGQT_Menu_REPAIR_LIST-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("GQT_Menu_REPAIR_LIST", fields, "REPAR")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('GQT_Menu_REPAIR_LIST', 'REPAR', 'REPAR.DTREPARA');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="GQT_Menu_REPAIR_LIST_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#GQT_Menu_REPAIR_LIST_complex_filter', 'GQT_Menu_REPAIR_LIST_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("GQT_Menu_REPAIR_LIST")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="GQT_Menu_REPAIR_LIST" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "GQT_Menu_REPAIR_LIST", idlistController = "Repar", idlistArea = "Repar", codlista ="eb5c42d7-9401-4743-a232-b08f9c554f17" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("GQT_Menu_REPAIR_LIST_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "GQT_Menu_REPAIR_LIST" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_GQT_Menu_REPAIR_LIST = new QMenuForm($('[data-form="GQT_Menu_REPAIR_LIST"]'), "Form_GQT_Menu_REPAIR_LIST");
		window.Form_GQT_Menu_REPAIR_LIST.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_GQT_Menu_REPAIR_LIST.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qGQT_Menu_REPAIR_LIST");
		RegisterClearEvents("GQT_Menu_REPAIR_LIST")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0) {
			searchFilterGroups = JSON.parse(SearchFilters.value);
			UpdateSearchFilterStatus("GQT_Menu_REPAIR_LIST", searchFilterGroups)
		}
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="GQT_Menu_REPAIR_LIST"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="GQT_Menu_REPAIR_LIST"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
