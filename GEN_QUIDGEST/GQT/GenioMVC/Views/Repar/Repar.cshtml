@model GenioMVC.ViewModels.Repar.Repar_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Repar";
	ViewBag.Title = @Resources.REPAIR34508;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Repar", FormMethod.Post, new { @class = "form-horizontal", area="Repar", data_form="Repar" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Repar" area="Repar" data-form="Repar">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Repar_well" area="Repar" data-form="Repar">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

