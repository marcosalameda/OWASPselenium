@model GenioMVC.ViewModels.Rules.PTN_Menu_131_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Rules;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Rules>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodregra, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_131_RULES_TIPOCOND]/
		column.Expression(p => p.ArrayValtipocond).Title(@Resources.TIPO_DE_CONDICAO09986).Field("ValTipocond", "ArrayTipocond").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_131_RULES_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION07383).Field("ValDescript").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN PTN_MENU_131_RULES_LOCAL]/
		column.Expression(p => p.ArrayVallocal).Title(@Resources.LOCAL_ONDE_EXECUTA12798).Field("ValLocal", "ArrayAlocregr").Size(1);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Rules")
        .Id("PTN_Menu_131")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Regra", false, false)
        .UpdateConditions((item)=>Regra_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Regra_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Regra_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Regra_ViewModel.InsertConditions(this.Model.Navigation))
        .SetFollowUp("Regra_Show", "Rules" , (Func<GenioMVC.Models.Rules, object>)(item => new { id = item.ValCodregra }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qPTN_Menu_131, #PTN_Menu_131_complex_filter th input, #PTN_Menu_131_filters input").change(function() {
                    $("#pPTN_Menu_131").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#PTN_Menu_131_tableFilters').val(false);")
                    @Html.Raw("$('#PTN_Menu_131_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#PTN_Menu_131_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='PTN_Menu_131']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qPTN_Menu_131');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#PTN_Menu_131_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_PTN_Menu_131').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('PTN_Menu_131', 'REGRA', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PTN_MENU_131]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS PTN_MENU_131]/
</script>