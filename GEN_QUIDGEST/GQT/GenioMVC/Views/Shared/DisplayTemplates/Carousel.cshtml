@using System.Collections.Generic;
@{
    #region Properties
    // Common
    var containerId = (string)ViewData["container-id"];
    var subtype = (string)ViewData["subtype"];
    var rows = (List<Dictionary<string, object>>)ViewData["rows"];
    var style = (Dictionary<string, string>)ViewData["style-vars"];

    // Data (default values)
    var showIndicators = "true";
    var showControls = "true";
    var keyboardControllable = "true";
    var autoCycleInterval = "5000";
    var autoCyclePause = "hover";
    var ride = "carousel";
    var wrap = "true";

    // Init configuration
    if (style.ContainsKey("show-indicators")) { showIndicators = style["show-indicators"]; }
    if (style.ContainsKey("show-controls")) { showControls = style["show-controls"]; }
    if (style.ContainsKey("keyboard-controllable")) { keyboardControllable = style["keyboard-controllable"]; }
    if (style.ContainsKey("auto-cycle-interval")) { autoCycleInterval = style["auto-cycle-interval"]; }
    if (style.ContainsKey("auto-cycle-pause")) { autoCyclePause = style["auto-cycle-pause"]; }
    if (style.ContainsKey("ride")) { ride = style["ride"]; }
    if (style.ContainsKey("wrap")) { wrap = style["wrap"]; }

// USE /[MANUAL GQT SPECIAL_RENDERING_VARS CAROUSEL]/

    #endregion
}

<div class="carousel-container">
    <div id="@containerId"
         class="carousel slide"
         data-interval="@autoCycleInterval"
         data-keyboard="@keyboardControllable"
         data-pause="@autoCyclePause"
         data-ride="@ride"
         data-wrap="@wrap">
        @if (showIndicators == "true")
        {
            <ol class="carousel-indicators">
                @for (int i = 0; i < rows.Count; i++)
                {
                    if (i == 0)
                    {
                        <li data-target="#@containerId" data-slide-to="@i" class="active"></li>
                    }
                    else
                    {
                        <li data-target="#@containerId" data-slide-to="@i"></li>
                    }
                }
            </ol>
        }
        <div class="carousel-inner">
            @foreach (var row in rows)
            {
                string active = row == rows.First() ? "active" : "";
                string title = row.ContainsKey("slide-title") ? (string)row["slide-title"] : "";
                string subtitle = row.ContainsKey("slide-subtitle") ? (string)row["slide-subtitle"] : "";
                string src = row.ContainsKey("slide-image") ? (string)row["slide-image"] : "";
                string dominantColor = row.ContainsKey("dominantColor") ? (string)row["dominantColor"] : "";
                string followup = row.ContainsKey("followup") ? (string)row["followup"] : "";

                <div class="carousel-item @active" data-src="@src" style="background-color: @dominantColor">
                    @if (!String.IsNullOrEmpty(followup))
                    {
                        @Html.Raw(followup);
                    }
                    <div class="carousel-content">
                        <div class="carousel-caption d-none d-md-block">
                            <h2>@title</h2>
                            <p>@subtitle</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (showControls == "true")
        {
            <a class="carousel-control-prev" role="button" data-slide="prev" onclick="$('#@containerId').carousel('prev')">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" role="button" data-slide="next" onclick="$('#@containerId').carousel('next')">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        }
    </div>
</div>

<script>
    /* Set the click event of each slide */
    function onSlideClick(slide) {

        var selection = window.getSelection();
        if (selection.toString().length !== 0) {
            return;
        }

        let followup = slide.children()[0]
        let isPopup = followup.getAttribute('data-modal-form') == 'true';
        let href = followup.getAttribute('href');

        if (isPopup)
            OpenModalForm(href, {});
        else
            QUtils.NavigateTo = href;
    }

    $(document).ready(function() {
        // Load images async
        $('#@containerId .carousel-item').each(function() {
            if ($(this).attr("data-src")) {
                var style = $(this).attr('style');
                style += '; background-image: url(' + $(this).attr("data-src") + ')';
                $(this).attr('style', style);
                $(this).removeAttr("data-src");
            }
        })

        $('#@containerId .carousel-item').click(function() { onSlideClick($(this)) });
    });
</script>

<style>
    .carousel-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 1rem;
    }

    .carousel {
        width: 100%;
        height: 360px;
        overflow: hidden;
        border-radius: 5px;
    }

    .carousel-inner {
        height: 100%;
    }

    .carousel-item {
        height: 100%;
        background-size: cover;
        background-clip: padding-box;
        background-repeat: no-repeat;
        background-position: center;
    }

    .carousel-item:hover,
    .carousel-control-next:hover,
    .carousel-control-prev:hover {
        cursor: pointer;
    }

    .carousel-caption h2:hover,
    .carousel-caption p:hover {
        cursor: auto;
    }

    .carousel-content {
        position: absolute;
        left: 0;
        width: 100%;
        bottom: 0;
        height: 66%;
        color: white;
        background: linear-gradient( hsl(0 0% 0% / 0), hsl(20 0% 0% / 0.1) 20%, hsl(0 0% 0% / 1) );
    }
</style>
