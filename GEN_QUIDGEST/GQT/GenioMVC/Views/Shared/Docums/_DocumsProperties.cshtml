@model GenioMVC.ViewModels.DocumsProperties_ViewModel

<form class="properties">
    <fieldset>
        <legend>@Resources.PROPRIEDADES45924</legend>
        <div class="list-flow">
	        <div class="row">
		        <div class="col-12">
			        <div elem-identifier="RowControls" class="control-row-group">
				        <div class="properties-row row-group" >
					        @Html.LabelFor(model => model.Name, new { @class = "flow-label"}, false)
					        @Html.DisplayForWithNull(model => model.Name, new {@class = "input-xlarge" })
				        </div>
					</div>
			        <div elem-identifier="RowControls" class="control-row-group">
				        <div class="control-join-group" >
					        @Html.LabelFor(model => model.Size, new { @class = "flow-label"}, false)
					        @Html.DisplayForWithNull(model => model.Size, new {@class = "input-xlarge" })
				        </div>
					</div>
			        <div elem-identifier="RowControls" class="control-row-group">
				        <div class="control-join-group" >
					        @Html.LabelFor(model => model.FileType, new { @class = "flow-label"}, false)
					        @Html.DisplayForWithNull(model => model.FileType, new {@class = "input-xlarge" })
				        </div>
					</div>
			        <div elem-identifier="RowControls" class="control-row-group">
                        <div class="control-join-group" >
					        @Html.LabelFor(model => model.Author, new { @class = "flow-label"}, false)
					        @Html.DisplayForWithNull(model => model.Author, new {@class = "input-xlarge" })
				        </div>
					</div>
			        <div elem-identifier="RowControls" class="control-row-group">
                        <div class="control-join-group" >
					        @Html.LabelFor(model => model.CreatedAt, new { @class = "flow-label"}, false)
					        @Html.DisplayForWithNull(model => model.CreatedAt, new {@class = "input-xlarge" })
				        </div>
					</div>
			        <div elem-identifier="RowControls" class="control-row-group">
                        <div class="control-join-group" >
					        @Html.LabelFor(model => model.Version, new { @class = "flow-label"}, false)
					        @Html.DisplayForWithNull(model => model.Version, new {@class = "input-xlarge" })
				        </div>
					</div>
					@if(Model.IsCheckout)
					{
						<div elem-identifier="RowControls" class="control-row-group">
							<div class="control-join-group" >
								@Html.LabelFor(model => model.CheckoutEditor, new { @class = "flow-label"}, false)
								@Html.DisplayForWithNull(model => model.CheckoutEditor, new {@class = "input-xlarge" })
							</div>
						</div>
					}
		        </div>
	        </div>
        </div>
    </fieldset>
</form>