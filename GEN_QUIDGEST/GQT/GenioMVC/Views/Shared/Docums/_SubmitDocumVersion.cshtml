@model GenioMVC.ViewModels.DocumsControl_ViewModel
@using GenioMVC.Resources

@{
    ViewBag.Title = @Resources.SUBMISSAO_DE_FICHEIR50281;
    string fldSize = ViewData["fieldSize"] == null ? "" : ViewData["fieldSize"].ToString();
    bool isRequired = ViewData["isRequired"] == null ? false : Convert.ToBoolean(ViewData["isRequired"]);
}

<form>
    <fieldset>
        <legend>@ViewBag.Title</legend>
        <div class="form-flow">
            <div class="row">
                <div class="col-12">
                    <div class="control-row-group">
                        <div class="control-join-group">
                            @Html.Label("file", @Resources.SELECCIONE_O_FICHEIR54804, new { @class = "flow-label" })
                            <div class="i-input-group">
                                @Html.TextBox("versionProgress", null, new { @readonly = "readonly", @class = "file-input-box" })
                                <a id="submitVersion" class="btn b-icon-text--secondary" href="#">
                                    <i class="e-icon glyphicons glyphicons-upload"></i>
                                    @Resources.SUBMETER21206
                                </a>
                                <input class="custom-file-input i-input-group-file__field hidden" data-ticket="@Model.Ticket" data-use-templates="@Model.UsesTemplates.ToString().ToLower()" data-mode="Submit" data-modelname="@Model.Model" id="submitVersionFile" name="@{@Model.FieldName}_file" type="file">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="row-large-control">
                        <div class="row-line-group">
                            <label class="i-radio i-radio__label">
                                @Resources.DESBLOQUEAR__IGNORA_48447
                                <input class="i-radio" id="action" name="action" type="radio" value="UnlockFile">
                                <span class="i-radio__field"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="row-large-control">
                        <div class="row-line-group">
                            <label class="i-radio i-radio__label">
                                @Resources.SUBMETER__DESBLOQUEI57783
                                <input checked="checked" class="i-radio" id="action" name="action" type="radio" value="Submit">
                                <span class="i-radio__field"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-11 offset-1">
                    <div class="control-row-group">
                        <div class="control-join-group">
                            <div class="input-group i-input-group">
                                <label class="i-radio i-radio__label i-radio--inline">
                                    @Resources.VERSAO_PRINCIPAL03233
                                    <input checked="checked" class="i-radio" id="version" name="version" type="radio" value="@Model.MajorVersion">
                                    <span class="i-radio__field"></span>
                                </label>
                                @Html.TextBox("MajorVersion", Model.MajorVersion, new { @class = "i-text--inline input-mini" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-11 offset-1">
                    <div class="control-row-group">
                        <div class="control-join-group">
                            <div class="input-group i-input-group">
                                <label class="i-radio i-radio__label i-radio--inline">
                                    @Resources.VERSAO_SECUNDARIA37682
                                    <input class="i-radio" id="version" name="version" type="radio" value="@Model.MinorVersion">
                                    <span class="i-radio__field"></span>
                                </label>
                                @Html.TextBox("MinorVersion", Model.MinorVersion, new { @class = "i-text--inline input-mini" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
</form>

<script>
    var DBControl = $("#@Model.FieldName" + "_file").closest('[elem-identifier="DocumContainer"]').data('dbdocument');
	var setFileUrl = '@Url.Action("SetFile", Model.Model, new { fieldSize = fldSize, isRequired })';
	var fieldContainer = $("#@Model.FieldName");

    setFileUrl = setFileUrl.replace('amp;', '');
	DBControl.initSubmitVersion(setFileUrl, fieldContainer);
</script>