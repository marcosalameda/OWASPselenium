@model byte[]

@using System.Web.Mvc;

@{
    string guid = ViewData["guid"] == null ? "" : ViewData["guid"].ToString();
    string controller = ViewData["controller"] == null ? "" : ViewData["controller"].ToString();
    string fldname = ViewData["fldname"] == null ? "" : ViewData["fldname"].ToString();
    string cssClass = ViewData["class"] == null ? "" : ViewData["class"].ToString();
    string formIdentifier = ViewData["identifier"] == null ? "" : ViewData["identifier"].ToString();
    var style = (ViewData["style"] ?? "").ToString();
	string data_toggle = ViewData["data_toggle"] == null ? "" : ViewData["data_toggle"].ToString();
    string title = ViewData["title"] == null ? "" : ViewData["title"].ToString();
	string data_original_title = ViewData["title"] == null ? "" : ViewData["title"].ToString();
	string description = ViewData["description"] == null ? "" : ViewData["description"].ToString();
}

@Html.EditImage(@Model, guid, controller, fldname, formIdentifier, new { @class = cssClass, style, data_toggle, title, data_original_title, description })
