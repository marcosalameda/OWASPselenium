@model GenioMVC.ViewModels.Bookmarks.Bookmarks_ViewModel

<div data-identifier="bookmarks_container" class="bookmarks__container">
    <ul class="nav">
        <li class="dropdown">
            <a class="bookmarks__header" href="#" data-toggle="dropdown" aria-expanded="false" title="@Resources.FAVORITOS12992">
                <i class="glyphicons glyphicons-star nav-icon n-sidebar__icon e-icon"></i>
            </a>
            <ul data-identifier="bookmarks__content" class="dropdown-menu bookmarks__content">
                @foreach (var fav in @Model.Bookmarks)
                {
                    <li bookmark-id="@(fav.Codusrcfg)" class="nav-item n-sidebar__nav-item bookmarks__item">
                        @if (fav.MenuEntryObj != null)
                        {
                            @Html.MenuAction(fav.MenuEntryObj, Url, fav.Module, formatLinkButton(fav).ToHtmlString(), new { @class = "bookmarks__btn--link", data_toggle = "tooltip", data_placement = "down", title = fav.Description, module = fav.Module })
                            <br />
                            <button class="b-btn b-btn--link bookmarks__btn--remove" onclick="QBookmarks.onClickRemoveBookmark(this)">
                                    @Resources.REMOVER50666
                            </button>
                        }
                        else
                        {
                            <span class="bookmarks__text">@fav.Description</span>
                            <br />
                            <button class="b-btn b-btn--link bookmarks__btn--remove" onclick="QBookmarks.onClickRemoveBookmark(this)">
                                    @Resources.REMOVER50666
                            </button>
                        }
                    </li>
                }
                <li class="nav-item n-sidebar__nav-item bookmarks__item">
                    <button class="b-btn b-btn--link bookmarks__btn--add" onclick="QBookmarks.ActivateSelectionMode(this)">
                        @Resources.ADICIONAR17177
                    </button>
                </li>
            </ul>
        </li>
    </ul>
    <script>
        if ($.SpecialMenus) {
            $.SpecialMenus();
        } else {
            $(document).ready(function () {
                $.SpecialMenus();
            });
        }
    </script>
</div>

@helper formatLinkButton(GenioMVC.ViewModels.Bookmarks.Bookmark_Menu_ViewModel fav)
{
    <span class="bookmarks__text">@Helpers.GetTextFromResources(fav.MenuEntryObj.Title)</span>
    <br />
    <span class="bookmarks__full-path">@fav.Description</span>
}
