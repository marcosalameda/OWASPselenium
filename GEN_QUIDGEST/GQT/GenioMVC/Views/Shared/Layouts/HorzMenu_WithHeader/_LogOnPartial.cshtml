@using GenioMVC.Resources

@if (!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
{
        if (GenioMVC.Models.Navigation.UserContext.Current.User.Years.Count > 1)
        {
            <div class="dropdown mr-2" >
                <a class="dropdown-toggle" data-toggle="dropdown" href="#"><span class="glyphicons glyphicons-calendar n-menu__icon n-DByear__icon"></span>@GenioMVC.Models.Navigation.UserContext.Current.User.Year</a>
                <div class="nav-item dropdown-menu">
                    @foreach (var year in GenioMVC.Models.Navigation.UserContext.Current.User.Years)
                    {
                    <a class="dropdown-item" style="text-align: center;" href="@Url.Action("Index", "Home", new { system = year })">@year</a>
                    }
                </div>
            </div>
        }
		<ul class="navbar-nav ml-auto n-menu__aside">
			@Html.Partial("_UserAvatar")
		</ul>
}
else if (CSGenio.framework.Configuration.LoginType != CSGenio.framework.Configuration.LoginTypes.AD)
{
    if (GenioMVC.LayoutConfig.config.loginStyle.Equals(GenioMVC.LoginStyle.single_page))
    {
        @Html.ActionLink(@Resources.ENTRAR16118, "LogOn", "Account", null, new { @class = "btn btn-primary" })
    }
    else
    {
        if(GenioMVC.LayoutConfig.config.logonPlacement.Equals(GenioMVC.LogonPlacement.in_header) || (GenioMVC.LayoutConfig.config.logonPlacement.Equals(GenioMVC.LogonPlacement.in_navmenu)))
        {
            <div id="login-btn" class="dropdown_login">
                <a class="dropdown-toggle b-icon-text b-icon-text--primary" data-toggle="dropdown" href="#">@Resources.ENTRAR16118</a>
                <div id="dropdown_login_menu" class="dropdown-menu dropdown-menu-right c-user__dropdown" aria-labelledby="dropdownMenuButton" style="padding: 15px; padding: 0px;">
                    <div class="c-card c-card--text-center">
                        <div class="c-card__body">
                            @{ Html.RenderAction("LogOnPartial", "Account", new { }); }
                        </div>
                    </div>
                </div>
            </div>
            <script>
                $('#dropdown_login_menu').click(function (e) {
                    e.stopPropagation();
                });
            </script>
        }
    }
}