@model List<GenioMVC.Models.Navigation.MenuResult>

@helper ResultText(GenioMVC.Models.Navigation.MenuResult result)
{
    <span class="menu-result__text">@result.Text</span>
    <br/>
    <span class="menu-result__full-path"><b>@result.Module</b> > @result.FlatMenu</span>
}

<ul class="nav nav-pills nav-sidebar flex-column n-sidebar__nav list-group">
    <li class="nav-item n-sidebar__nav-item"><span class="menu-result__count">@Model.Count @Resources.RESULTADOS20000.ToLower()</span></li>
    @foreach (GenioMVC.Models.Navigation.MenuResult result in Model)
    {
    <li class="nav-item n-sidebar__nav-item menu-result">
        @Html.MenuAction(result.MenuObj, Url, result.Module, ResultText(result).ToString(), new { @class = "nav-link n-sidebar__nav-link" })
    </li>
    }
</ul>