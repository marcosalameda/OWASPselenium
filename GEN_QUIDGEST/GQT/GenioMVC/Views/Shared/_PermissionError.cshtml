@model string

@{
    ViewBag.Title = @Resources.ERRO38355;
}

@{
    string css = String.Empty;
    if (Request.IsAjaxRequest())
    {
        css = "permissionErrorPopUp";
    }
    else
    {
        css = "permissionError";
    }
}
@if (Request.IsAjaxRequest())
{
    <div class="c-modal__dialog c-modal--lg">
        <div class="c-modal__content">
            <div elem-identifier="ModalBody" class="c-modal__body">
                <div class="@css">
                    <img src="~/Content/img/PermissionError.png" alt="@Resources.PERMISSAO_DO_FORM26112" title="@Resources.PERMISSAO_DO_FORM26112" />
                    <p><strong>@Model</strong></p>
                </div>
            </div>
            <div class="modal-footer">
                <div class="actions">
                    <button class="b-icon-text b-icon-text--secondary" data-dismiss="modal" aria-hidden="true">@Resources.FECHAR32496</button>
                </div>    
            </div>
        </div>
    </div>
}
else
{ 
<div class="@css">
    <img src="~/Content/img/PermissionError.png"  alt="@Resources.PERMISSAO_DO_FORM26112" title="@Resources.PERMISSAO_DO_FORM26112" />
    <p><strong>@Model</strong></p>
</div>
}