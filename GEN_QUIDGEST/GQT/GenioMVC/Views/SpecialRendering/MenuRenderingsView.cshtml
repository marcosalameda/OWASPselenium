@model GenioMVC.ViewModels.MenuRenderingViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var tbl = Html.newTableFor<GenioMVC.Models.Lstren>(edit: true, canPage: false, canSort: false, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodlstren, true).Hidden();
            column.Expression(p => p.ValPosicao).Title(@Resources.ORDEM38897).Field("ValPosicao").Size(3);
            column.Expression(p => p.ValRenderizacao).Title(@Resources.NOME47814).Field("ValRenderizacao").Size(30);
            column.Expression(p => p.ValVisivel).Title(@Resources.VISIVEL07768).Field("ValVisivel").Size(1);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .Id("ValLstcol")
        .AjaxRequest("Lstusr_ValLstren_Edit")
        .DataSource(this.Model.lstren.Elements,true)
        .Sort(this.Model.lstren.Sort)
        .Pager(this.Model.lstren.Pagination)
        .Focus(this.Model.lstren.FocusOnRecord)
        .GridTableList()
        .RequestLink(@Url.Action("Lstusr_ValLstcol", new { id = Model.ValCodlstusr, partialView = "SpecialRendering_Edit" }))
        .Form<GenioMVC.ViewModels.Lstusr.SpecialRenderingViewModel>("../SpecialRendering/SpecialRenderingView")
        .DataKeyName("ValCodlstren")
        .ForeignKeyData("ValCodlstusr", Model.ValCodlstusr)
        .SaveActionLink(@Url.Action("EditRendering", "SpecialRendering"))
;}
@tbl.ToHtml()




<script>



$(document).ready(function() {
	
    try {
        if (jQuery) {
            try {
                jQuery("#qValLstcol, #ValLstcol_complex_filter th input, #ValLstcol_filters input").change(function() {
                    jQuery("#pValLstcol").val("1");
                });
                @{ var disable = (Model.lstren.Elements.Count() == 0 && Model.lstren.Filters.FiltersValues.Count == 0); }

				loaded(jQuery("[id='ValLstcol']"));
				InitSpecialControls(jQuery('#ValLstcol'));
				jQuery('#ValLstcol').trigger('SET_QCONTROL_LOADED', [true]);
				jQuery("#ValLstcol").attr('style', 'width', '100%');
				
				//----------------------------------------------------------
				//remove the standard checkbox column of the table grid
				jQuery("#form-modal tr td:first-child").remove();
				jQuery("#form-modal th").first().remove();

				//add a column with the sortable icon and style the table accordingly
				appendColumn('ValLstcol');
				jQuery("#ValLstcol").css('cursor', 'all-scroll');

				//setup the sortable handler
				jQuery("#ValLstcol tbody").sortable({
					helper: function (e, tr) {
						var originals = tr.children();
						var helper = tr.clone();
						helper.children().each(function (index) {
							jQuery(this).width(originals.eq(index).width());
						}); return helper;
					},
					change: function (event, ui) {
						jQuery("#ValLstcol tbody tr[data-key=" + jQuery(ui.item).attr("data-key") + "]").addClass('highlighted');
					},
					stop: function (event, ui) {
						jQuery("#ValLstcol tbody tr[data-key=" + jQuery(ui.item).attr("data-key") + "]").removeClass('highlighted');
						
						var posSource = parseInt($(ui.item).find("input[db-field=ValPosicao]").first().val())-1;
						var posDest = ui.item.index();

						if (posSource != posDest) {
							var start = Math.min(posSource, posDest);
							var end = Math.max(posSource, posDest);
							var items = jQuery("#ValLstcol input[db-field=ValPosicao]");
							for (i = start; i <= end; i++) {
								jQuery(items[i]).val(i + 1).change();
								//still have not found a way to call the lose focus that triggers the row save handler
								//even better would be to keep all changes pending and only submit all changed rows on explicit Save button press
								//, otherwise the cancel button is not doing much
							}
							window.ValLstcol.SaveEditRows();
						}
					},
					update: function (event, ui) {
						jQuery("#ValLstcol tbody tr[data-key=" + jQuery(ui.item).attr("data-key") + "]").removeClass('highlighted');
					}
				}).disableSelection();

				//forces the checkbox clicks to commit immediately instead of waiting for lost focus
				jQuery('[name="ValVisivel"]').change(function () {
						window.ValLstcol.SaveEditRows();
				});
				//----------------------------------------------------------
				 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>
