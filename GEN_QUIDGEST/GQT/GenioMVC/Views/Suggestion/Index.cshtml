@model GenioMVC.ViewModels.SuggestionViewModel
@using GenioMVC.Models
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{
    ViewBag.Form = "Suggestion";
    ViewBag.Title = @Resources.NOVA_SUGESTAO38551;
    ViewBag.formmode = FormMode.Edit;
    ViewBag.ClassForFormLayout = "form-flow";
}


@helper field_zone()
{
    @Html.LabelFor(model => model.NewLabel, new { @class = "i-text__label" }, false, false)
    @Html.TextBoxFor(model => model.NewLabel, new { @class = "i-text__field", id = "NewLabel" })

    @Html.LabelFor(model => model.NewHelp, new { @class = " i-text__label" }, false, false)

    @Html.TextAreaFor(model => model.NewHelp, new { @class = "i-textarea ", id = "NewHelp", rows = 10 })
    <p>@Resources.PREENCHA_OS_CAMPOS_A35510</p>
}


@helper array_suggestion()
{
    <ul class="nav c-tab c-tab__divider">
        <li class="nav-item c-tab__item tl_li" data-tab="field">
            <a data-target="#field" class="nav-link active" role="tab" data-toggle="tab">@Resources.CAMPO46284</a>
        </li>
        <li class="nav-item c-tab__item" data-tab="array">
            <a data-target="#array" data-toggle="tab" role="tab" class="nav-link">@Resources.ENUMERADO62124</a>
        </li>
    </ul>
    <div class="c-tab__item-container">
        <div class="tab-pane c-tab__item-content active" id="field">
            @field_zone()
        </div>
        <div class="tab-pane c-tab__item-content" id="array">
            <div class="container">
                <div class="row">
                    <ul class="nav c-tab nav-pills flex-column col-3 nav-scrollable">   

                        @foreach (var element in Model.Elements)
                        {
                            <li class="nav-item c-tab__item" data-tab="el_@element.Id">
                                @if (element == Model.Elements.First())
                                {
                                    <a data-target="#el_@element.Id" class="nav-link active" role="tab" data-toggle="tab">@element.NewLabel</a>
                                }
                                else
                                {
                                    <a data-target="#el_@element.Id" class="nav-link" role="tab" data-toggle="tab">@element.NewLabel</a>
                                }
                            </li>
                        }
                    </ul>
                    <div class="c-tab__item-container col-9">
                        @for (var i = 0; i < Model.Elements.Count(); i++)
                        {
                        if (i == 0)
                        {
                        <div class="tab-pane c-tab__item-content active" id="el_@Model.Elements[i].Id">
                            @Html.LabelFor(model => Model.Elements[i].NewLabel, new { @class = "i-text__label" }, false, false)
                            @Html.TextBoxFor(model => Model.Elements[i].NewLabel, new { @class = "i-text__field" })

                            @Html.LabelFor(model =>Model.Elements[i].NewHelp, new { @class = " i-text__label" }, false, false)

                            @Html.TextAreaFor(model => Model.Elements[i].NewHelp, new { @class = "i-textarea ", rows = 10 })
                        </div>
                        }
                        else
                        {
                        <div class="tab-pane c-tab__item-content" id="el_@Model.Elements[i].Id">
                            @Html.LabelFor(model => Model.Elements[i].NewLabel, new { @class = "i-text__label" }, false, false)
                            @Html.TextBoxFor(model => Model.Elements[i].NewLabel, new { @class = "i-text__field", })

                            @Html.LabelFor(model => Model.Elements[i].NewHelp, new { @class = " i-text__label" }, false, false)

                            @Html.TextAreaFor(model => Model.Elements[i].NewHelp, new { @class = "i-textarea no-resize ", rows = 10 })                            
                        </div>
                        }

                        }
                        <p>@Resources.PREENCHA_OS_CAMPOS_A35510</p>
                        @Html.HiddenFor(model => Model.ArrayName)
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@helper openSuggestion()
{
<div class="content">
    @Html.LabelFor(model => model.SuggestionText, new { @class = " i-text__label" }, false, false)

    @Html.TextAreaFor(model => model.SuggestionText, new { @class = "i-textarea ", id = "SuggestionText", rows = 10 })
</div>
}

@helper field_only() { 
    <div class="content">
        @field_zone()    
    </div>
    }

<div class="c-modal__dialog c-modal--lg">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "SuggestionForm" }))
    {

        <div class="c-modal__content">

            <div class="c-modal__header d-flex">
                <h5 class="c-modal__header-title">@ViewBag.Title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div elem-identifier="ModalBody" class="c-modal__body">
                @if (String.IsNullOrEmpty(Model.FieldId))
                {
                    @openSuggestion()
                }
                else if (Model.Elements.Any())
                {
                    @array_suggestion()
                }
                else
                {
                    @field_only()
                }
            </div>
            <div class="c-modal__footer" id="xptoActions">
                <div class="actions"> 
                    <button type="button" class="b-icon-text b-icon-text--primary" onclick="SaveSuggestion()">
                        <i class="SaveIcon e-icon"></i>
                        @Resources.SUGERIR53069
                    </button>
                    <button type="button" class="b-icon-text b-icon-text--secondary" data-dismiss="modal" aria-label="Close">
                        <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>
                        @Resources.CANCELAR49513
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<style>
textarea {
    resize:none;
}

.nav-scrollable {
    flex-wrap:nowrap;
    overflow-y:auto;
    max-height:320px;
}
</style>
<script>
    function SaveSuggestion() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Index","Suggestion")',
            data: $("#SuggestionForm").serialize(),
            dataType: 'json',

        }).done(function (data) {
            if (data.Success == true) {
                $("#form-modal").modal("hide");
            }
            bootbox.alert(data.Message);
        });
    }

</script>
