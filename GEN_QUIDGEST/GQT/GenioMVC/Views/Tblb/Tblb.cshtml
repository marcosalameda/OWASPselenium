@model GenioMVC.ViewModels.Tblb.Tblb_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Tblb";
	ViewBag.Title = @Resources.TABLE__BASIC_TYPES_42027;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Tblb", FormMethod.Post, new { @class = "form-horizontal", area="Tblb", data_form="Tblb" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Tblb" area="Tblb" data-form="Tblb">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Tblb_well" area="Tblb" data-form="Tblb">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

