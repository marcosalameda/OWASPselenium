@model GenioMVC.ViewModels.Tpcon.Tpcon_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Tpcon";
	ViewBag.Title = @Resources.CONTACT_TYPE65233;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Tpcon", FormMethod.Post, new { @class = "form-horizontal", area="Tpcon", data_form="Tpcon" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Tpcon" area="Tpcon" data-form="Tpcon">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Tpcon_well" area="Tpcon" data-form="Tpcon">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="row-line-group">
                            <div class="c-groupbox " id="GROUPBOX_TPCON_NOVOGR01">

                                <div class="c-groupbox__title" elem-identifier="GroupZone"  help-id="IFF_TPCON___PSEUDNOVOGR01" 
                                    label-id="IFF_TPCON___PSEUDNOVOGR01">
                                    <span>@Resources.CONTACT_TYPE40756</span>
                                    <span><a href="javascript:OpenSuggestion('IFF_TPCON___PSEUDNOVOGR01','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></span>
								</div>
                                <div class="form-flow">
									<div class="row">
										<div class="col-12">
											<div class="control-row-group">
												<div class="control-join-group">
												<div class="i-dbedit draggable " id="CONTAINER_IFF_TPCON___GENREGENDER__">
													<div class="d-flex">
													@Html.LabelFor(model => model.TableGenreGender, new { label_id="IFF_TPCON___GENREGENDER__", @class = " i-text__label", id="LABEL_IFF_TPCON___GENREGENDER__"}, true, false)
													<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
													<a href="javascript:OpenSuggestion('IFF_TPCON___GENREGENDER__','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
													@Html.DropDownListFor(model => model.ValCodgenre, Model.TableGenreGender.List , "", new {help_id = "IFF_TPCON___GENREGENDER__", @class = "i-select chosen-dropdown input-large", data_identifier = "IFF_TPCON___GENREGENDER__", @pers_cs_area = "Genre", @pers_cs_field = "ValCodgenre", @db_field = "ValCodgenre", @db_full_field_name = "tpcon.codgenre", data_has_more = Model.TableGenreGender.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableGenreGender.Selected, data_dbedit_value = Model.TableGenreGender.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodtpcon, @data_see_more = "Tpcon_GenreValGender", title = @Resources.GENRE63303, data_see_more_url = @Url.Action("Tpcon_GenreValGender","Tpcon"), data_is_dbedit = "true", data_support_form = @Url.Action("GENCO_New", "GENRE"), data_fields = "genre.codgenre,genre.gender", data_main_field = "Genre.ValGender", data_elements = 0, data_filled_by_history = Model.TableGenreGender.FilledByHistory, @dependant_fields = "genre.codgenre,genre.gender" })
													@Html.ValidationMessageFor(model => model.TableGenreGender)
													</div>
												</div>
											</div>
										</div>
									</div>
									<div class="row">
										<div class="col-12">
											<div class="control-row-group">
												<div class="control-join-group">
												<div class="i-text draggable " id="CONTAINER_LED_TPCON___TPCONTIPOCONT">
													<div class="d-flex">
													@Html.LabelFor(model => model.ValTipocont, new { label_id="LED_TPCON___TPCONTIPOCONT", @class = " i-text__label", id="LABEL_LED_TPCON___TPCONTIPOCONT"}, true, false)
													<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
													<a href="javascript:OpenSuggestion('LED_TPCON___TPCONTIPOCONT','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
													@Html.TextBoxFor(model => model.ValTipocont, new {help_id = "LED_TPCON___TPCONTIPOCONT", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_TPCON___TPCONTIPOCONT", @pers_cs_area = "Tpcon", @pers_cs_field = "ValTipocont", @db_field = "ValTipocont", title = @Resources.CONTACT_TYPE_27897, maxlength = "50", rows = "50" })
													@Html.ValidationMessageFor(model => model.ValTipocont)
													</div>
												</div>
											</div>
										</div>
									</div>
                                </div>
                            </div>
 						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodtpcon, new { @pers_cs_field="ValCodtpcon", @pers_cs_area="Tpcon", data_refresh = "true", @form_area="true", @data_value = Model.ValCodtpcon, @data_identifier = "LED_TPCON___TPCONCODTPCON" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Tpcon" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Tpcon" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Tpcon" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Tpcon", Model.FormMode).ToString(), "Tpcon"))", "Tpcon_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Tpcon_Delete", "Tpcon", new {id = @Model.ValCodtpcon} )", "Tpcon_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Tpcon_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Tpcon_Delete", "Tpcon", new {id = @Model.ValCodtpcon} )", "Tpcon_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Tpcon_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitTpcon(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Tpcon", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteTpcon(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Tpcon", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitTpcon(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Tpcon_Cancel", "Tpcon", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Tpcon.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Tpcon_Cancel","Tpcon","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Tpcon">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Tpcon" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Tpcon">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT TPCON]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_TPCON" data-form-javascript="true">
@Html.Partial("Tpcon_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
