async function SubmitMultiSelection2D2111(jsonRouteValues, multipleValues = false) {
    var url = '@Url.Action("GQT_Menu_2D21_Selections", "Tpequ", new { nav = @Navigation.NavigationId })';

    let promiseRes = await new Promise((resolve, reject) => {
        $.ajax({
            url: url,
            cache: false,
            type: "POST",
            dataType: "json",
            data: $.param(jsonRouteValues, true)
        }).done(function() {
            urlNext = '@Url.Action("GQT_Menu_2D2111", "Equip", new { nav = @Navigation.NavigationId })';

            let tblId = "GQT_Menu_2D21";
            let tblControl = $(`#${tblId}`).getQTableList();

            if(urlNext.includes('?')) urlNext = `${urlNext}&allSelected=${tblControl.isAllSelected()}`;
            else urlNext = `${urlNext}?allSelected=${tblControl.isAllSelected()}`;

            QUtils.NavigateTo = urlNext;
        });
    });

	if (promiseRes && !multipleValues) {
		QUtils.NavigateTo = promiseRes;
	}

    return promiseRes;
}
