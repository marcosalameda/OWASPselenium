@model GenioMVC.ViewModels.Tpequ.Tpequ_ValEvolucao_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_TPEQU___PSEUDEVOLUCAO" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.C51806</h2 list-header> </label></div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR TPEQU_EVOLUCAO]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Tabpr;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Tabpr>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodtabpr, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN TPEQU_EVOLUCAO_TABPR_SINCE]/
		column.Expression(p => p.ValSince).Title(@Resources.SINCE47259).Field("ValSince").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN TPEQU_EVOLUCAO_TABPR_PRECOHOR]/
		column.Expression(p => p.ValPrecohor).Title(@Resources.PRICE_BY_HOUR01060).Field("ValPrecohor").Size(16);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Tabpr")
        .Id("ValEvolucao")
        .AjaxRequest("Tpequ_ValEvolucao")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Tpequ_ValEvolucao", new { id = Model.ValCodtpequ, partialView = "Tpequ_ValEvolucao"}))
        .Form("Tabpr", false, false)
        .SetFollowUp("Tabpr_Show", "Tabpr" , (Func<GenioMVC.Models.Tabpr, object>)(item => new { id = item.ValCodtabpr }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValEvolucao, #ValEvolucao_complex_filter th input, #ValEvolucao_filters input").change(function() {
                    $("#pValEvolucao").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValEvolucao_tableFilters').val(false);")
                    @Html.Raw("$('#ValEvolucao_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValEvolucao_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValEvolucao_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValEvolucao_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValEvolucao').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValEvolucao']"));
                    InitSpecialControls($('#ValEvolucao'));
                    $('#ValEvolucao').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS TPEQU_VALEVOLUCAO]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>