@model GenioMVC.ViewModels.Tradu.Tradu_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Tradu";
	ViewBag.Title = @Resources.TRADUCOES14996;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Tradu", FormMethod.Post, new { @class = "form-horizontal", area="Tradu", data_form="Tradu" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Tradu" area="Tradu" data-form="Tradu">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Tradu_well" area="Tradu" data-form="Tradu">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

