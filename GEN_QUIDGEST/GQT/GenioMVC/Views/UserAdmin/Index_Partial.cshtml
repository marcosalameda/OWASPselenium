@model GenioMVC.ViewModels.UserAdmin.UserAdminViewModel

@{  
    var tbl = Html.newTableFor<GenioMVC.Models.Psw>(edit: true, canPage: true, canSort: true)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodpsw, true).Hidden();
    		column.Expression(p => p.ValNome).Title(@Resources.UTILIZADORES39761).Field("ValNome").Size(20);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .Id("Index")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("User", false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: false)
;}
@tbl.ToHtml()
<script>
 $(document).ready(function() {
    try {
        if (jQuery) {
            try {
                $("#qIndex, #Index_complex_filter th input, #Index_filters input").change(function () {
                    $("#pIndex").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }
			    
                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#Index_tableFilters').val(false);")
                    @Html.Raw("$('#Index_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#Index_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#Index_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#Index_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")

                setupHistoryClicks()
				// TODO: FIX THIS!!!
				@* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () { loaded($("[id='Menu']")); });
                HideTableEmptyFooter();
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>