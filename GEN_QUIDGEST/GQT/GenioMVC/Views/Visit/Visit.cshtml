@model GenioMVC.ViewModels.Visit.Visit_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Visit";
	ViewBag.Title = @Resources.VISIT42885;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Visit", FormMethod.Post, new { @class = "form-horizontal", area="Visit", data_form="Visit" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Visit" area="Visit" data-form="Visit">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Visit_well" area="Visit" data-form="Visit">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

