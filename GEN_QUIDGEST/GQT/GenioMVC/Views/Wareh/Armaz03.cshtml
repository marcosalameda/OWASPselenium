@model GenioMVC.ViewModels.Wareh.Armaz03_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = @Resources.WAREHOUSE51864;
	ViewBag.formmode = Model.GetFormMode;
}

<div class="c-modal__dialog c-modal--lg">
	@using (Ajax.BeginForm("Action", "Wareh", null, new AjaxOptions { UpdateTargetId = "form-modal" }, new { @class = "c-modal__content", area = "Wareh", data_form = "Armaz03" }))
	{
		<div class="c-modal__content">
			<div class="c-modal__header" elem-identifier="modal-header">
				@form_header()
			</div>
			<div elem-identifier="ModalBody" class="c-modal__body">
				<div class="form-flow">
					@form_body()
				</div>
			</div>
			<div class="c-modal__footer">
				<div elem-identifier="Actions" class="actions" data-form-actions="Armaz03">
					@form_footer()
				</div>
			</div>
		</div>
	}
</div>

@helper form_header() {
	@* BEGIN MVC Flash messages *@
	@Html.Action("Index", "Messages")
	@* END MVC Flash messages *@
		<div class="c-modal__header-title">
			<div class="d-flex">
				<div class="c-action-bar d-flex">
					<i class="form-popup-header-legend icon-@ViewBag.formmode ViewMode-@ViewBag.formmode"></i><h2>@ViewBag.Title</h2>
					<div data-parent-form="Armaz03" data-q-ref="form-btns-main_container"></div>
				</div>
			</div>
		</div>
}

@helper form_body() {
	@form_content_alert()
	@Html.QValidationSummary()
	<fieldset>
		<legend class="hidden-elem">@ViewBag.Title</legend>
		<div class="form-flow">
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_ARMAZ03_PSEUDARTIGAPO">
								<div id="ARTIGAPO" data-target="ValArtigos" elem-identifier="extended-support">
									<div class="alert alert-block alert-info">@Resources.ESCOLHA_UM_ELEMENTO_24060</div>
								</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_ARMAZ03_PSEUDARTIGOS_">
								<div id="Armaz03_ValArtigos" data-identifier="IFF_ARMAZ03_PSEUDARTIGOS_"  data-extra-options="" > 
									@{ Html.RenderAction("Armaz03_ValArtigos", "Wareh", new { id = Model.ValCodwareh, partialView = "Armaz03_ValArtigos"}); }
								</div>
						</div>
					</div>
				</div>
			</div>


		@Html.HiddenFor(model=> model.ValWarehdes, new { @pers_cs_area = "Wareh", @pers_cs_field = "ValWarehdes", @data_identifier = "LED_ARMAZ03_WAREHWAREHDES" })


			@Html.HiddenFor(model => model.ValCodwareh, new { @pers_cs_field="ValCodwareh", @pers_cs_area="Wareh", @form_area="true", @data_value = Model.ValCodwareh, @data_identifier = "LED_ARMAZ03_WAREHCODWAREH" })

			@Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Armaz03" })
			@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Armaz03" })
			@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Armaz03" })
			@Html.AntiForgeryToken()
		</div>
	</fieldset>
}

@helper form_content_alert(){
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_footer() {



			if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
			{

				if(Model.FormMode == FormMode.New && Convert.ToBoolean(Request.QueryString.Get("repeatInsertion")))
				{
				<button type="button" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" data-modal-form="true" data-modal-repeat-insertion="true" name="@(Helpers.FormModeActionName("Armaz03", Model.FormMode))" data-modal-url='@Url.Action(Helpers.FormModeActionName("Armaz03", Model.FormMode).ToString())' qbutton="ok_new"><i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
				}
				<button type="button" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" data-end-pers="true" data-modal-close="true" data-modal-form="true" name="@(Helpers.FormModeActionName("Armaz03", Model.FormMode))" data-modal-url='@Url.Action(Helpers.FormModeActionName("Armaz03", Model.FormMode).ToString(), "Wareh")' qbutton="ok">
				@if(Model.FormMode == FormMode.Delete)
				{
					<i class="glyphicons glyphicons-glyphicons-check e-icon" aria-hidden="true"></i>
					@Resources.CONFIRMAR09808
				}
				else
				{
					<i class="SaveIcon e-icon" aria-hidden="true"></i>
					@Resources.SAVE04165
				}
				</button>
			}
		   <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-modal-close="true" data-modal-form="true" data-modal-cancel="true" data-modal-url='@Url.Action("Armaz03_Cancel")' qbutton="cancel"><i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428</button>
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT ARMAZ03]/ *@

@if (Request.IsAjaxRequest())
{
	@codeJavascript()
	@includeStylesheets()
}

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_ARMAZ03" data-form-javascript="true">
@Html.Partial("Armaz03_JavaScript", Model, ViewData)
</div>
}

@section code_javascript {
	@codeJavascript()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
	@includeStylesheets()
}
