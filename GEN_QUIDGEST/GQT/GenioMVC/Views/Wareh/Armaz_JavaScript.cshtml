    <text>
    var ajaxCallsRemaining = $(".flash object embed").length;
    $('form [elem-identifier="ButtonPrimary"]').click(function() {
        var flashObjects = $(".flash object embed");
        ajaxCallsRemaining = flashObjects.length;
        if(flashObjects.length == 0)
            return true;
        else {
            flashObjects.each(function() {
               var flashObj = GetFlash($(this).attr('id'));
               flashObj.UsedFlash.TriggerSave(flashObj);
            });
            return false;
        }
    });
    </text>
}
