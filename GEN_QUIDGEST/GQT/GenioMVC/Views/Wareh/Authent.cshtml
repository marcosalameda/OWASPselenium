@model GenioMVC.ViewModels.Wareh.Authent_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Authent";
	ViewBag.Title = @Resources.WAREHOUSE51864;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Wareh", FormMethod.Post, new { @class = "form-horizontal", area="Wareh", data_form="Authent" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Authent" area="Wareh" data-form="Authent">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Authent_well" area="Wareh" data-form="Authent">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
    <div class="f-login__container">
                                <div class="f-login__background">
                                    <div class="f-login__brand">
                                        <img src="@Url.Content("~/Content/img/f-login__brand.png")" alt="">
                                        <p>Quidgest</p>
                                    </div>
                                    <div id="loginContain">
                                        <form id="form0">
                                            <div id="loginFormx">
                                                <fieldset>                            
                                                <div class="form-flow">
                                                    <div class="input-group f-login__input-group">
                                                        <div class="i-input-group--left">
                                                            <span class="i-input-group__tag f-login__input-tag">
                                                                <i class="glyphicons glyphicons-user f-login__input-icon"></i>
                                                            </span>
                                                        </div>					
                                                        <input class="form-control f-login__input-field" data-val="true" id="UserName" name="UserName" placeholder="Username" type="text" value="" />
                                                    </div>
                                                    <div class="input-group f-login__input-group">
                                                        <div class="i-input-group--left">
                                                            <span class="i-input-group__tag f-login__input-tag">
                                                                <i class="glyphicons glyphicons-lock f-login__input-icon"></i></span>
                                                            </div>					
                                                        <input autocomplete="off" class="form-control f-login__input-field" id="Password" name="Password" placeholder="Password" type="password" />
                                                        <div class="i-input-group--right">
                                                            <span class="i-input-group__tag f-login__input-tag">
                                                                <i class="glyphicons glyphicons-eye-open f-login__input-icon" id="passwordtoggle" onclick="togglePassword()"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <button type="button" class="b-icon-text b-btn--full-width b-icon-text--primary b-icon-text--login text-uppercase">Login</button>
                                                    <button type="button" class="b-icon-text b-btn--full-width b-icon-text--primary b-icon-text--login text-uppercase" style = "margin-left:0;">Register</button>
                                                    <div class="validation-summary-valid" id="formLoginValidation"></div>
                                                    <div>
                                                    </div>  
                                                        
                                                </div>

                                                </fieldset>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

<script>
                             function togglePassword() {
                                if ($('#Password').attr('type') == 'text') {
                                    $('#Password').attr('type', 'password');
                                    $('#passwordtoggle').removeClass('glyphicons glyphicons-eye-close')
                                    $('#passwordtoggle').addClass('glyphicons glyphicons-eye-open')
                                }
                                else {
                                    $('#Password').attr('type', 'password');        
                                    $('#Password').attr('type', 'text');
                                    $('#passwordtoggle').removeClass('glyphicons glyphicons-eye-open')
                                    $('#passwordtoggle').addClass('glyphicons glyphicons-eye-close')
                                }            
                            }

</script>


		@Html.HiddenFor(model=> model.ValWarehdes, new { @pers_cs_area = "Wareh", @pers_cs_field = "ValWarehdes", @data_identifier = "LED_AUTHENT_WAREHWAREHDES" })


			@Html.HiddenFor(model => model.ValCodwareh, new { @pers_cs_field="ValCodwareh", @pers_cs_area="Wareh", data_refresh = "true", @form_area="true", @data_value = Model.ValCodwareh, @data_identifier = "LED_AUTHENT_WAREHCODWAREH" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Authent" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Authent" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Authent" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Authent", Model.FormMode).ToString(), "Wareh"))", "Authent_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.GRAVAR45301
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Authent_Delete", "Wareh", new {id = @Model.ValCodwareh} )", "Authent_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Authent_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Authent_Delete", "Wareh", new {id = @Model.ValCodwareh} )", "Authent_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Authent_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitAuthent(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Authent", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteAuthent(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Authent", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitAuthent(event)" title="@Resources.GRAVAR45301" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR45301
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Authent_Cancel", "Wareh", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Authent.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Authent_Cancel","Wareh","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Authent">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Authent" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Authent">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT AUTHENT]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_AUTHENT" data-form-javascript="true">
@Html.Partial("Authent_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
