	var ajaxCallsRemaining = $("#form-modal .flash object embed").length;
	$('#form-modal form [elem-identifier="ButtonPrimary"]').click(function() {
		var flashObjects = $("#form-modal .flash object embed");
		ajaxCallsRemaining = flashObjects.length;
		if(flashObjects.length == 0)
			return true;
		else {
			flashObjects.each(function() {
			   var flashObj = GetFlash($(this).attr('id'))
