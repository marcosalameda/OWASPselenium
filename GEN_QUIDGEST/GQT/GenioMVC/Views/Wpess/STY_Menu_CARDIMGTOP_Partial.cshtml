            column.Expression(p => p.ValCodpess, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.NAME31974).Field("ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_DATE]/
		column.Expression(p => p.ValDate).Title(@Resources.DATA_DE_NASCIMENTO48110).Field("ValDate").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_SEX]/
		column.Expression(p => p.ArrayValsex).Title(@Resources.SEXO52099).Field("ValSex", "ArraySexo").Size(9);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_NFUNC]/
		column.Expression(p => p.ValNfunc).Title(@Resources.NOFUNCIONARIO21429).Field("ValNfunc").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_ADRESS]/
