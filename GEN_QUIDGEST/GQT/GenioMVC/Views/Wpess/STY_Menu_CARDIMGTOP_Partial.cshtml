		column.Expression(p => p.ValEmail).Title(@Resources.EMAIL25170).Field("ValEmail").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_CELLPHON]/
		column.Expression(p => p.ValCellphon).Title(@Resources.NOTELEFONE56747).Field("ValCellphon").Size(9);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_NATURALI]/
		column.Expression(p => p.ValNaturali).Title(@Resources.NATURALNESS33189).Field("ValNaturali").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_NACIONAL]/
		column.Expression(p => p.ValNacional).Title(@Resources.NACIONALIDADE23735).Field("ValNacional").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WAREH_WAREHDES]/
		column.Expression(p => p.Wareh.ValWarehdes).Title(@Resources.WAREHOUSE51864).Field("Wareh.ValWarehdes").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN STY_MENU_CARDIMGTOP_WPESS_FTIMGTOP]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValFtimgtop, new {alt=@Resources.IMAGE_TOP34930,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodpess, modelname = "Wpess", fldname = "ValFtimgtop" }))).Title(@Resources.IMAGE_TOP34930).Field("ValFtimgtop").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Wpess")
        .Id("STY_Menu_CARDIMGTOP")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Armapess", false, false)
        .SetFollowUp("Armapess_Show", "Wpess" , (Func<GenioMVC.Models.Wpess, object>)(item => new { id = item.ValCodpess }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: true, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
    var cards = data
        .ToSpecialRendering()
		.SetSpecialRendering(this.Model.ViewModesCfg.SpecialRenderings.FirstOrDefault(sr => sr.Id == "CARDS"))
        .Filters(this.Model.Menu.Filters)
        .Form("Armapess", false, false)
        .SetFollowUp("Armapess_Show", "Wpess" , (Func<GenioMVC.Models.Wpess, object>)(item => new { id = item.ValCodpess }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: false, canInsert: true, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@{ renderings.Clear(); }
@{ renderings.Add(Model.GetViewModePosition("LIST"), tbl.ToHtml(hidden: Model.IsViewModeHidden("LIST"))); }

@{ renderings.Add(Model.GetViewModePosition("CARDS"), cards.ToSpecialRenderingHtml(hidden: Model.IsViewModeHidden("CARDS"))); }


@foreach (var render in renderings.ToList().OrderBy(r => r.Key))
{
    @Html.Raw(render.Value.ToHtmlString());
}


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qSTY_Menu_CARDIMGTOP, #STY_Menu_CARDIMGTOP_complex_filter th input, #STY_Menu_CARDIMGTOP_filters input").change(function() {
                    $("#pSTY_Menu_CARDIMGTOP").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#STY_Menu_CARDIMGTOP_tableFilters').val(false);")
                    @Html.Raw("$('#STY_Menu_CARDIMGTOP_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#STY_Menu_CARDIMGTOP_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='STY_Menu_CARDIMGTOP']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qSTY_Menu_CARDIMGTOP');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#STY_Menu_CARDIMGTOP_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_STY_Menu_CARDIMGTOP').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('STY_Menu_CARDIMGTOP', 'WPESS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS STY_MENU_CARDIMGTOP]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS STY_MENU_CARDIMGTOP]/
</script>