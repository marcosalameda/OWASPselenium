@model GenioMVC.ViewModels.Year.Ano_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Ano";
	ViewBag.Title = @Resources.YEAR61794;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Year", FormMethod.Post, new { @class = "form-horizontal", area="Year", data_form="Ano" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Ano" area="Year" data-form="Ano">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Ano_well" area="Year" data-form="Ano">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

@helper form_content_body() {
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ANO_____YEAR_YEAR____">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValYear, new { label_id="LED_ANO_____YEAR_YEAR____", @class = " i-text__label", id="LABEL_LED_ANO_____YEAR_YEAR____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ANO_____YEAR_YEAR____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValYear, new {help_id = "LED_ANO_____YEAR_YEAR____", @class = "i-text__field i-text input-mini", data_identifier = "LED_ANO_____YEAR_YEAR____", @pers_cs_area = "Year", @pers_cs_field = "ValYear", @db_field = "ValYear", title = @Resources.YEAR61794, maxlength = "4", rows = "4" })
								@Html.ValidationMessageFor(model => model.ValYear)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ANO_____YEAR_YEARNUM_">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValYearnum, new { label_id="LED_ANO_____YEAR_YEARNUM_", @class = " i-text__label", id="LABEL_LED_ANO_____YEAR_YEARNUM_"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ANO_____YEAR_YEARNUM_','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.NumberFor(model => model.ValYearnum, new {help_id = "LED_ANO_____YEAR_YEARNUM_", @class = "Number text-right i-text__field i-text input-small", data_identifier = "LED_ANO_____YEAR_YEARNUM_", @pers_cs_area = "Year", @pers_cs_field = "ValYearnum", @db_field = "ValYearnum", title = @Resources.YEAR__NUMBERS_29394, data_number_integer = "4", data_number_decimals = "0", data_number_format = "9999" })
								@Html.ValidationMessageFor(model => model.ValYearnum)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_ANO_____PSEUDTODASDES">
								<div id="Ano_ValTodasdes" data-identifier="IFF_ANO_____PSEUDTODASDES"  data-extra-options="" > 
									@{ Html.RenderAction("Ano_ValTodasdes", "Year", new { id = Model.ValCodyear, partialView = "Ano_ValTodasdes"}); }
								</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row-large-control">
						<div class="row-line-group" id="CONTAINER_IFF_ANO_____PSEUDAGREGADO">
								<div id="Ano_ValAgregado" data-identifier="IFF_ANO_____PSEUDAGREGADO"  data-extra-options="" > 
									@{ Html.RenderAction("Ano_ValAgregado", "Year", new { id = Model.ValCodyear, partialView = "Ano_ValAgregado"}); }
								</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ANO_____YEAR_VALUE___">
								<div class="d-inline-flex">
								@Html.LabelFor(model => model.ValValue, new { label_id="LED_ANO_____YEAR_VALUE___", @class = " i-text__label", id="LABEL_LED_ANO_____YEAR_VALUE___"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ANO_____YEAR_VALUE___','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.NumberFor(model => model.ValValue, new {help_id = "LED_ANO_____YEAR_VALUE___", @class = "i-input-group__field text-right i-text__field i-text input-small", data_refresh = "true", data_tipoform = "SR", data_identifier = "LED_ANO_____YEAR_VALUE___", @pers_cs_area = "Year", @pers_cs_field = "ValValue", @db_field = "ValValue", fixed_field = "true", @readonly = "readonly", title = @Resources.VALUE10285, data_currency = "True", data_number_integer = "7", data_number_decimals = "2", data_number_format = "9999999.99" })
								@Html.ValidationMessageFor(model => model.ValValue)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodyear, new { @pers_cs_field="ValCodyear", @pers_cs_area="Year", data_refresh = "true", @form_area="true", @data_value = Model.ValCodyear, @data_identifier = "LED_ANO_____YEAR_CODYEAR_" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Ano" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Ano" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Ano" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Ano", Model.FormMode).ToString(), "Year"))", "Ano_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.INSERIR43365
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Ano_Delete", "Year", new {id = @Model.ValCodyear} )", "Ano_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Ano_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Ano_Delete", "Year", new {id = @Model.ValCodyear} )", "Ano_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Ano_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitAno(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Ano", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteAno(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Ano", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitAno(event)" title="@Resources.INSERIR43365" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.INSERIR43365
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Ano_Cancel", "Year", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Ano.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Ano_Cancel","Year","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Ano">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Ano" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Ano">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

@* USE /[MANUAL GQT FORM_VIEW_ADDITIONAL_CONTENT ANO]/ *@

@helper codeJavascript()
{
<div class="hidden" id="FormJavaScript_ANO" data-form-javascript="true">
@Html.Partial("Ano_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

@helper includeStylesheets()
{

 }

@section include_stylesheets {
    @includeStylesheets()
}
