@model GenioMVC.ViewModels.Year.Ano_ValAgregado_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
@if (this.Model.Menu.Elements.Count() >= 1)
{
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_ANO_____PSEUDAGREGADO" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.AGGREGATED_PER_YEAR01261</h2 list-header> </label></div>
	</div>
</div>

}
@* USE /[MANUAL GQT TABLE_FOR ANO_AGREGADO]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Agreg;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Agreg>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodaggre, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN ANO_AGREGADO_AGREG_VALUE]/
		column.Expression(p => p.ValValue).Title(@Resources.VALUE10285).Field("ValValue").Size(10);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Agreg")
        .Id("ValAgregado")
        .AjaxRequest("Ano_ValAgregado")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Ano_ValAgregado", new { id = Model.ValCodyear, partialView = "Ano_ValAgregado"}))
        .Form("Agreg", false, false)
        .SetFollowUp("Agreg_Show", "Agreg" , (Func<GenioMVC.Models.Agreg, object>)(item => new { id = item.ValCodaggre }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValAgregado, #ValAgregado_complex_filter th input, #ValAgregado_filters input").change(function() {
                    $("#pValAgregado").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValAgregado_tableFilters').val(false);")
                    @Html.Raw("$('#ValAgregado_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValAgregado_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValAgregado_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValAgregado_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValAgregado').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValAgregado']"));
                    InitSpecialControls($('#ValAgregado'));
                    $('#ValAgregado').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS ANO_VALAGREGADO]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>