@model GenioMVC.ViewModels.Psw.Defaultpsw_ViewModel

@{
    ViewBag.Form = "Registro";
    ViewBag.Title = @Resources.REGISTE_SE48908;
    ViewBag.formmode = "Registro";
    ViewBag.ClassForFormLayout = "form-flow";
}

    <div class="well nested-form" id="Defaultpsw_well" area="Registro" data-form="Registro">        
        @LoadDefault()
    </div>

@helper form_content_body()
{
    <div class="form-group f-body">
            <div class="f-header">
                <h3>@Resources.CRIE_UMA_NOVA_CONTA42494</h3>
            </div>
        </div>
            <div class="c-card c-card__body mb-4" style="max-width: 520px">
                <div class="f-header">
                    <span class="f-header__title mb-2">@Resources.INFORMACOES_DE_CONTA48032</span>
                </div>
                <div class="form-group f-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="control-row-group">
                                <div>
                                    <div class="i-text__label i-text">
                                        <div class="d-flex">
                                            @Html.LabelFor(m => m.ValNome, new { @class = "i-text__label" }, true, false)
                                            <span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode password-change-icon"></span>
                                        </div>
                                        <div class="profile-input-group">
                                            <div class="i-input-group--left">
                                                <span class="i-input-group__tag password-change-icon"><i class="glyphicons glyphicons-user i-input-group__tag-icon password-change-icon password-change-icon"></i></span>
                                            </div>
                                            @Html.TextBoxFor(m => m.ValNome, new { @class = "i-input-group__field valid password-change-input-fld-user-name", @style = "height: inherit" })
                                            @Html.ValidationMessageFor(m => m.ValNome)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="control-row-group">
                                <div>
                                    <div class="i-text__label i-text">
                                        <div class="d-flex">
                                            @Html.LabelFor(m => m.ValEmail, new { @class = "i-text__label" }, true, false)
                                            <span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode password-change-icon"></span>
                                        </div>
                                        <div class="profile-input-group">
                                            <div class="i-input-group--left">
                                                <span class="i-input-group__tag password-change-icon">
                                                    <i class="glyphicons glyphicons-envelope i-input-group__tag-icon password-change-icon password-change-icon"></i>
                                                </span>
                                            </div>
                                            @Html.TextBoxFor(m => m.ValEmail, new { @class = "i-input-group__field valid password-change-input-fld-user-name", @style = "height: inherit" })
                                            @Html.ValidationMessageFor(m => m.ValEmail)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="control-row-group">
                                <div>
                                    <div class="i-text__label i-textpasswordgroup" id="CONTAINER_LED_PSWUSER_PSW__PASSWORD">
                                        <div class="d-flex">
                                            @Html.LabelFor(m => m.ValPassword, new { @class = "i-text__label" }, true, true)
                                            <span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
                                        </div>
                                        <div class="profile-input-group">
                                            <div class="i-input-group--left">
                                                <span class="i-input-group__tag i-input-group__tag--primary password-change-icon">
                                                    <i class="glyphicons glyphicons-lock i-input-group__tag-icon"></i>
                                                </span>
                                            </div>
                                            @Html.PasswordEditFor(m => m.ValPassword, new { autocomplete = "off", @class = "i-text__field i-text input-large password-change-input-fld", @style = "height:inherit", data_identifier = "PasswordInput" })
                                            @Html.ValidationMessageFor(m => m.ValPassword)
                                        </div>
                                        <p class="text-danger" style="display:none">
                                            @Resources.NOVAS_PASSWORDS_NECE55754 @CSGenio.framework.Configuration.Security.MinCharacters @Resources.CARATERES_EM_COMPRIM18333
                                        </p>

                                        <div style="margin-top:3px;">
                                            @Html.LabelFor(m => m.ConfirmValPassword, new { @class = "i-text__label" }, true, true)
                                            <div class="profile-input-group">
                                                <div class="i-input-group--left">
                                                    <span class="i-input-group__tag i-input-group__tag--primary password-change-icon"><i class="glyphicons glyphicons-lock i-input-group__tag-icon"></i></span>
                                                </div>
                                                @Html.PasswordEditFor(model => model.ConfirmValPassword, new { autocomplete = "off", @class = "i-text__field i-text input-large password-change-input-fld", @style = "height:inherit", data_identifier = "ConfirmPasswordInput" })
                                                @Html.ValidationMessageFor(m => m.ConfirmValPassword)
                                            </div>
                                        </div>
                                        <div class="control-group">
                                            <div class="row-fluid">
                                                @Html.PasswordMeter(m => m.ValPassword)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                 </div>
            </div>
    
    //@Html.AntiForgeryToken()
}


@helper LoadDefault()
{
    <fieldset>
        <div class="@ViewBag.ClassForFormLayout">
            @form_content_body()
        </div>
    </fieldset>

    <script>
        $(document).ready(function() {

            $('.passwordtoggle').click(function () { togglePassword(this) });

            $('input[data-identifier="PasswordInput"]').keydown(function () {
                $('p.text-danger').css({
                    'display': 'block',
                })

                $(this).focusout(function () {
                    $('p.text-danger').css({
                        'display': 'none',
                    })
                })
            });
        });

        function togglePassword(element) {
            let identifier = $(element).attr('data-identifier');
            let inputElement = $('input[data-identifier="' + identifier + '"]');

            if ($(inputElement).attr('type') == 'text') {
                $(inputElement).attr('type', 'password');
                $(element).removeClass('glyphicons glyphicons-eye-close')
                $(element).addClass('glyphicons glyphicons-eye-open')
            }
            else {
                $(inputElement).attr('type', 'password');
                $(inputElement).attr('type', 'text');
                $(element).removeClass('glyphicons glyphicons-eye-open')
                $(element).addClass('glyphicons glyphicons-eye-close')
            }
        }

    </script>
}
