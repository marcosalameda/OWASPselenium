@model GenioMVC.Models.PasswordRecoverChangeModel
@{
    ViewBag.Title = @Resources.ALTERAR_PASSWORD06295;
}


<script src="@Url.Content(UrlNames.JQueryValidate)" type="application/javascript"></script>
<script src="@Url.Content(UrlNames.JQueryValidateUnobtrusive)" type="application/javascript"></script>
<html>

<div class="f-login">
    <div class="f-login__container">
        <div class="f-login__background">
                <div class="f-login__brand">
                    <img src="@Url.Content("~/Content/img/f-login__brand.png")" alt="">
                    <p>@Resources.HORIZONTAL_LAYOUT62933</p>
                </div>
                <h2>@Resources.ALTERAR_PASSWORD06295</h2>
                @using (Html.BeginForm("RecoverPasswordChange", "Account", FormMethod.Post))
                {                    
                    @Html.ValidationSummary(false)
                    <div>
                        <fieldset>
                            <div class="clearfix">
                                @Html.LabelFor(m => m.UserId)
                                <div class="input">
                                    @Html.TextBoxFor(m => m.UserId, new {@readonly = "readonly", @class="form-control f-login__input-field" })
                                </div>
                            </div>
                            <div class="clearfix">
                                @Html.LabelFor(m => m.NewPassword)
                                <div class="input">
                                    @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "off", @class="form-control f-login__input-field" })
                                    @Html.ValidationMessageFor(m => m.NewPassword)
                                </div>
                            </div>
                            <div class="clearfix">
                                @Html.LabelFor(m => m.ConfirmPassword)
                                <div class="input">
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "off", @class="form-control f-login__input-field" })
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword)
                                </div>
                            </div>
                            <div class="actions">
                                <input type="submit" class="b-icon-text b-btn--full-width b-icon-text--primary b-icon-text--login text-uppercase" value="@Resources.REPOR35852"/>
                            </div>
                            @Html.AntiForgeryToken()
                        </fieldset>
                    </div>
                }
        </div>
    </div>
</div>


</html>
