@model GenioMVC.Models.AuditModel
@using System.ComponentModel.DataAnnotations
@using GenioMVC.Models
@using GenioMVC.Helpers

@{
	ViewBag.Title = @Resources.AUDITORIA_DO_SISTEMA08460;
}

<div class="content-wrapper audit-container">
    @using (Html.BeginForm("Refresh", "AuditViewer", FormMethod.Post, new { enctype = "multipart/form-data" }))
	{
		<h1 class="page-header">@ViewBag.Title @if (Model.LockTable){ <span> - @Model.LogTable </span>}</h1>	
	
        if (!string.IsNullOrEmpty(Model.ResultMsg))
        {
        <div class="editor-label">
            @Html.LabelFor(model => model.ResultMsg)
            <span style="white-space: pre-line">
            <b class="status-message">@Html.DisplayForWithNull(model => model.ResultMsg)</b>
            </span>
        </div>
        }
        else
        {
    	<div class="input">
            @if (Model.LockTable)
			{
					@Html.HiddenFor(model => model.LogTable)	
			} else
            {		
				@Html.LabelFor(model => model.LogTable, new { @style = "display:inline-block;" })
				@Html.DropDownListFor(model => model.LogTable, from v in (AuditModel.LogTables[])(Enum.GetValues(typeof(AuditModel.LogTables)))
					select new SelectListItem()
					{
						Text = ((DisplayAttribute)(typeof(AuditModel.LogTables).GetField(v.ToString()).GetCustomAttributes(typeof(DisplayAttribute), false).First())).GetName(),
						Value = v.ToString(),
						Selected = v == Model.LogTable
					}, new { @style = "border: 1px solid rgb(226, 226, 226);background: none repeat scroll 0 0 rgb(255, 255, 255);color: rgb(51, 51, 51); font-size: 1.2em;margin: 5px 0 6px; padding: 5px; width: 312px;" })
            }
            @if (Model.LogDatabaseExists)
            { 
                @Html.LabelFor(model => model.LogDatabaseSelected, new { @style = "display:inline-block; margin-left:10px;" })

                @Html.RadioButtonFor(model => model.LogDatabaseSelected, "false", new { id = "systemDatabase", @style = "display:inline-block; margin-left:10px; width:auto; background:none;" }) 
                @Html.Label("systemDatabase", Resources.ATUAIS07948, new { @style = "display:inline-block; margin-left:5px;" })

                @Html.RadioButtonFor(model => model.LogDatabaseSelected, "true", new { id = "logDatabase", @style = "display:inline-block; margin-left:10px; width:auto; background:none;" })
                @Html.Label("logDatabase", Resources.HISTORICO16073, new { @style = "display:inline-block; margin-left:5px;" })

                
                if (Model.LogTable == AuditModel.LogTables.logGQTall)
                { 
                    <div id="TransferLogControls" class="dropdown" style="float:right; margin: 5px 0px 6px;">
                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown">@Resources.TRANSFERIR_DADOS_PAR38484</button>
                        <ul id="TransferLogDiv" class="dropdown-menu pull-right">
                            @if (Model.MaxLogRowDays > 0)
                            { 
                            <li>
								<a id="TransferLog" tabindex="1" class="dt-button" aria-controls="Table" onclick="TransferLog(false);">
									<span>@string.Format(Resources.TRANSFERIR_DADOS_COM36042, Model.MaxLogRowDays)</span>
								</a>
							</li>
                            }
							<li>
								<a id="TransferLogAll" tabindex="1" class="dt-button" aria-controls="Table" onclick="TransferLog(true);">
									<span>@Resources.TRANSFERIR_TODOS48543</span>
								</a>
							</li>
                        </ul>
                    </div>
                }
            }
            else
            {
                @Html.HiddenFor(model => model.LogDatabaseSelected)
            }

		</div>
		@Html.HiddenFor(model => model.SelectedRow)
        @Html.HiddenFor(model => model.Year)
        @Html.HiddenFor(model => model.LogDatabaseExists)
		@Html.HiddenFor(model => model.LockRow)
		@Html.HiddenFor(model => model.LockTable)		
        <br />
        <table id="Table" class="table table-striped table-bordered @if (Model.LogTable != AuditModel.LogTables.logGQTall && string.IsNullOrEmpty(Model.SelectedRow)){ @Html.Raw("hover") } nowrap">
            <thead>
            <tr>
                @foreach (var column in Model.Result.ColumnNames)
                {
                    <th>
                        @column
                    </th>
                }
            </tr>
            @if (!string.IsNullOrEmpty(Model.SelectedRow))
            {
                <tr>
                    <th colspan="4">@Resources.VALORES_CURRENTES_21555</th>
                    @if (Model.SelectedRowValues.Count > 0)
                    {
                        foreach (var column in Model.SelectedRowValues)
                        {
                            <td>
                                @column
                            </td>
                        }
                    }
                    else
                    {
                        for (var i = 4; i < Model.Result.ColumnNames.Count; i++)
                        {
                            <td>
                                &lt;@Resources.ELIMINADO39258&gt;
                            </td>
                        }
                    }
                </tr>
                <tr>
                     <th colspan="@Model.Result.ColumnNames.Count">@Resources.VALORES_ANTERIORES_41932:</th>
                </tr>
            }					
            </thead>
            <tbody>
            </tbody>
        </table>
        }
		@Html.AntiForgeryToken()
    }

</div>


@section include_javascript {}

@Scripts.Render("~/Scripts/jquerydatatables")

<script type="text/javascript">



    $(document).ready(function () {
        
		$('#LogTable').on("change", function() {
			unSelectRow();
		});
		
		
		$('#systemDatabase, #logDatabase').on("change", function () {
			unSelectRow();
		});		
		
        // Disable default dataTable error message
        $.fn.dataTable.ext.errMode = 'none';
    
        // Create dataTable
        var table = $('#Table').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '@Url.Action("Reload","AuditViewer")',
                type: 'POST',
                contentType: "application/json",
                data: function (data) {
                    var params = {};
                    params.param = data;
                    params.logTable = '@Model.LogTable.ToString()';
                    params.logdatabase = '@Model.LogDatabaseSelected';
                    params.year = '@Model.Year';
                    params.export = false;
                    params.exportType = '';
					params.rowSelected = '@Model.SelectedRow';
                    return JSON.stringify(params);
                }
            },
            columnDefs: [
                {
                    targets: '_all',
                    createdCell: function(td, cellData, rowData, row, col) {
                        if (col >= 4 && cellData.length > 150) {
                            var text = $(td).text();
                            td.title = text;
                            $(td).text(text.substr(0, 100) + "...");
                        }
                    }
                }
                @if (!string.IsNullOrEmpty(Model.SelectedRow))
                {
                    @Html.Raw(",{ targets: [3], visible: false }")
                }			
            ],
            @if (Model.LogTable == AuditModel.LogTables.logGQTall)
            {
                @Html.Raw("order: [[0, \"desc\"], [3, \"desc\"], [4, \"desc\"], [2, \"desc\"]],")
            }
            else
            {
                @Html.Raw("order: [[0, \"desc\"], [2, \"desc\"]],")
            }
            @if (Model.LogTable != AuditModel.LogTables.logGQTall && string.IsNullOrEmpty(Model.SelectedRow))
            {
                @Html.Raw(@"createdRow: function ( row, data, index ) {  
                                            $(row).on('click', SelectRow);
                                        },")
            }
            scrollX : true,
			autoWidth: false,
            dom: '<"top"<"search">B>rtlip',
            buttons: [
                @if (!string.IsNullOrEmpty(Model.SelectedRow) && !Model.LockRow)
                {
                    @Html.Raw("{text: '" + Resources.VOLTAR01353 + "', action: function(e, dt) { unSelectRow(); } }," )
                }
                {
                    extend: 'collection',
                    text: '@Html.Raw(Resources.EXPORTAR35632)',
                    buttons: [
@*                        {
                            text: '@Html.Raw(Resources.FORMATO_DE_DOCUMENTO48724)', 
                            action: function(e, dt) {
                                LogExport(dt, "pdf",this);
                            }
                        },*@
                        {
                            text: '@Html.Raw(Resources.FOLHA_DE_CALCULO__OD46941)',
                            action: function(e, dt) {
                                LogExport(dt, "ods",this);
                            }
                        },
                        {
                            text: '@Html.Raw(Resources.FOLHA_DE_CALCULO_EXC59518)',
                            action: function(e, dt) {
                                LogExport(dt, "xlsx",this);
                            }
                        },
                        {
                            text: '@Html.Raw(Resources.VALORES_SEPARADOS_PO10397)',
                            action: function(e, dt) {
                                LogExport(dt, "csv",this);
                            }
                        },
                        {
                            text: '@Html.Raw(Resources.FORMATO_XML__XML_44251)',
                            action: function (e, dt) {
                                LogExport(dt, "xml",this);
                            }
                        }
                    ],
                    background: false
                }
            ],
            lengthMenu : [25, 50, 100, 200],
            language: {
				"sProcessing":      "@Html.Raw(Resources.A_PROCESSAR___18164)",
                "sInfo":            "@Html.Raw(Resources.MOSTRANDO_DE__START_29995)",
                "sInfoEmpty":       "@Html.Raw(Resources.MOSTRANDO_DE_0_ATE_037698)",
                "sInfoFiltered":    "@Html.Raw(Resources._FILTRADO_DE__MAX__R29170)",
                "sLengthMenu":      "@Html.Raw(Resources.MOSTRAR__MENU__REGIS19759)",
                "sSearch":          "@Html.Raw(Resources.PROCURAR_51641)",
                "sZeroRecords":     "@Html.Raw(Resources.NAO_FORAM_ENCONTRADO35207)",
                "oPaginate": {
                    "sFirst":       "@Html.Raw(Resources.PRIMEIRO38981)",
                    "sPrevious":    "@Html.Raw(Resources.ANTERIOR34904)",
                    "sNext":        "@Html.Raw(Resources.SEGUINTE24541)",
                    "sLast":        "@Html.Raw(Resources.ULTIMO62389)"
                }
            }
        });
        
        // Error handling from dataTable
        $('#Table').on('error.dt', function (e, settings, techNote, message) {
			bootbox.alert(message.replace('DataTables warning: table id=Table - ',''), function () { });
        });

        // Custom dataTable filter (with search button)
        $(".audit-container .search").addClass("dataTables_filter").html('\
            @Html.Label(Resources.PROCURAR_51641, new { @style = "display:inline-block;" }) \
            @Html.TextBox("CustomSearch", "", new { @style = "margin-left: 0.5em;" }) \
            <a id="SearchBtn" tabindex="2" class="dt-button" aria-controls="Table" style="display:inline; font-size:small;" > \
                <img id="searchImg" src="/images/magnifying_glass.png" /> \
            </a>');

        $("#SearchBtn img").attr("src", "@Request.ApplicationPath.TrimEnd(new char[] {'/'})" + "/images/magnifying_glass.png");

        $("#SearchBtn").on("click", function () {
            $("#SearchBtn").blur();
            table.search($("#CustomSearch").val()).draw();
        });

        $("#CustomSearch").on("keydown", function (event) {
            if (event.which == 13) {
                table.search($("#CustomSearch").val()).draw();
            }
            return event.keyCode != 13;
        });
    });
	
	function SelectRow() {
		var id = $('td', this).eq(3).text();
		$('#SelectedRow').val(id);
		DataSubmit();
	};

	function unSelectRow() {
		$('#SelectedRow').val("");
		DataSubmit();
	};	

	function DataSubmit() {
		var formEl = $('.audit-container form');
		var formURL = formEl.attr("action");

		@if(Request.IsAjaxRequest()) {
			<text>
					$.post(
						formURL, formEl.serialize(),
						function (data) { // this is the CALLBACK function
							$('.audit-container').parent().html(data);
						}
					);
			</text>
		} else
		{
			<text>
			formEl.submit();
			</text>
		}
	}	
	
	function RunExport(result, dt, exportType) {
		if (result == true) {
			$('#Table_processing').show().text("@Html.Raw(Resources.A_EXPORTAR___20494)");
			$('.dt-button-collection').fadeOut();
	
			var url = '@Url.Action("Reload", "AuditViewer")';
			var params = JSON.parse(dt.ajax.params());
			params.export = true;
			params.exportType = exportType;
			$.ajax({
				url: url,
				type: 'POST',
				contentType: "application/json",
				data: JSON.stringify(params)
			})
			.done(function (data) {
				$('#Table_processing').hide().text("@Html.Raw(Resources.A_PROCESSAR___18164)");
				try {
					window.open(data.Url, "_self");
				}
				catch (e) {
					bootbox.alert("@Html.Raw(Resources.NAO_FOI_POSSIVEL_CON47430)", function () { });
				}
			})
			.fail(function (jqXhr, textStatus, errorThrown) {
				$('#Table_processing').hide().text("@Html.Raw(Resources.A_PROCESSAR___18164)");
				if (errorThrown !== "canceled")
					bootbox.alert("@Html.Raw(Resources.NAO_FOI_POSSIVEL_CON47430)", function () { });
			});
		}
	}
	
	function LogExport(dt, exportType, table) {
	    var result = true;
		var totalFilteredRows = table.page.info().recordsDisplay;
		if (totalFilteredRows > 5000){
			bootbox.confirm("@Html.Raw(string.Format(Resources.O_NUMERO_DE_REGISTOS44061, 5000))", function (result) {
				RunExport(result, dt, exportType);
			});
		}
		else
		{
			RunExport(result, dt, exportType);
		}
	}
</script>