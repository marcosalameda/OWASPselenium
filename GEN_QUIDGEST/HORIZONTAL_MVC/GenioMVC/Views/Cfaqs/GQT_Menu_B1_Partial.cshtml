@model GenioMVC.ViewModels.Cfaqs.GQT_Menu_B1_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Cfaqs;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Cfaqs>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodcfaqs, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_B1_CFAQS_ICON]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValIcon, new {alt="",}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodcfaqs, modelname = "Cfaqs", fldname = "ValIcon" }))).Field("ValIcon").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_B1_CFAQS_CATEGORY]/
		column.Expression(p => p.ValCategory).Title(@Resources.CATEGORY18978).Field("ValCategory").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_B1_CFAQS_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION07383).Field("ValDescript").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Cfaqs")
        .Id("GQT_Menu_B1")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Cfaqs", false, false)
        .SetFollowUp("Cfaqs_Show", "Cfaqs" , (Func<GenioMVC.Models.Cfaqs, object>)(item => new { id = item.ValCodcfaqs }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_B1, #GQT_Menu_B1_complex_filter th input, #GQT_Menu_B1_filters input").change(function() {
                    $("#pGQT_Menu_B1").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_B1_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_B1_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_B1_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_B1']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_B1');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_B1_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_B1').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_B1', 'CFAQS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_B1]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_B1]/
</script>