@model GenioMVC.ViewModels.Equip.GQT_Menu_2C211_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Equip;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Equip>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodequip, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_EQUIP_REGISTNR]/
		column.Expression(p => p.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("ValRegistnr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_EQUIP_DESIGNAT]/
		column.Expression(p => p.ValDesignat).Title(@Resources.EQUIPMENT03632).Field("ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_EQUIP_DTAQUISI]/
		column.Expression(p => p.ValDtaquisi).Title(@Resources.ACQUISITION44180).Field("ValDtaquisi").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_DECOM_DECOMNR]/
		column.Expression(p => p.Decom.ValDecomnr).Title(@Resources.NO_BATE21045).Field("Decom.ValDecomnr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_EQUIP_DTDECO]/
		column.Expression(p => p.ValDtdeco).Title(@Resources.DECOMISSION14486).Field("ValDtdeco").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_EQUIP_IFABATIF]/
		column.Expression(p => p.ValIfabatif).Title(@Resources.DOWNED_EQUIPMENT43331).Field("ValIfabatif").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_EQUIP_PHOTOGRA]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValPhotogra, new {alt=@Resources.PHOTO51874,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodequip, modelname = "Equip", fldname = "ValPhotogra" }))).Title(@Resources.PHOTO51874).Field("ValPhotogra").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2C211_ROOM1_ROOMNR]/
		column.Expression(p => p.Room1.ValRoomnr).Title(@Resources.N_R__ROOM43805).Field("Room1.ValRoomnr").Size(10);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Equip")
        .Id("GQT_Menu_2C211")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Equip", false, false)
        .SetFollowUp("Equip_Show", "Equip" , (Func<GenioMVC.Models.Equip, object>)(item => new { id = item.ValCodequip }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_2C211, #GQT_Menu_2C211_complex_filter th input, #GQT_Menu_2C211_filters input").change(function() {
                    $("#pGQT_Menu_2C211").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_2C211_tableFilters').val(false);")
