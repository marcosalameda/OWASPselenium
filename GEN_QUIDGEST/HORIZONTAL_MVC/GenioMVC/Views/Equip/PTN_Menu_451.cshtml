@model GenioMVC.ViewModels.Equip.PTN_Menu_451_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Equip.PTN_Menu_451_ViewModel modelPTN_Menu_451 = new GenioMVC.ViewModels.Equip.PTN_Menu_451_ViewModel(Navigation);
	var columns = modelPTN_Menu_451.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrFreqempr = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayFreqempr.GetDictionary())
	{
		arrFreqempr.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "cmpny" && areaField.Field == "designat")
		{
			fields.Add("CMPNY.DESIGNAT", new TableFilterField("CMPNY", "DESIGNAT", Resources.DESIGNATION35876, "text"));
		}
		if (areaField.Area == "pess1" && areaField.Field == "name")
		{
			fields.Add("PESS1.NAME", new TableFilterField("PESS1", "NAME", Resources.NAME31974, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "sequennr")
		{
			fields.Add("EQUIP.SEQUENNR", new TableFilterField("EQUIP", "SEQUENNR", Resources.SEQUENTIAL_NO_38590, "num"));
		}
		if (areaField.Area == "equip" && areaField.Field == "registnr")
		{
			fields.Add("EQUIP.REGISTNR", new TableFilterField("EQUIP", "REGISTNR", Resources.NO__REGISTER04207, "text", defaultSearch : true));
		}
		if (areaField.Area == "tpequ" && areaField.Field == "tipoequi")
		{
			fields.Add("TPEQU.TIPOEQUI", new TableFilterField("TPEQU", "TIPOEQUI", Resources.TYPE_OF_EQUIPMENT18080, "text"));
		}
		if (areaField.Area == "wareh" && areaField.Field == "warehdes")
		{
			fields.Add("WAREH.WAREHDES", new TableFilterField("WAREH", "WAREHDES", Resources.WAREHOUSE51864, "text"));
		}
		if (areaField.Area == "item" && areaField.Field == "itemdes")
		{
			fields.Add("ITEM.ITEMDES", new TableFilterField("ITEM", "ITEMDES", Resources.ARTICLE60065, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "designat")
		{
			fields.Add("EQUIP.DESIGNAT", new TableFilterField("EQUIP", "DESIGNAT", Resources.DESIGNATION35876, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtaquisi")
		{
			fields.Add("EQUIP.DTAQUISI", new TableFilterField("EQUIP", "DTAQUISI", Resources.ACQUISITION44180, "date"));
		}
		if (areaField.Area == "decom" && areaField.Field == "decomnr")
		{
			fields.Add("DECOM.DECOMNR", new TableFilterField("DECOM", "DECOMNR", Resources.NO_BATE21045, "num"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtdeco")
		{
			fields.Add("EQUIP.DTDECO", new TableFilterField("EQUIP", "DTDECO", Resources.DECOMISSION14486, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "ifabatif")
		{
			fields.Add("EQUIP.IFABATIF", new TableFilterField("EQUIP", "IFABATIF", Resources.DOWNED_EQUIPMENT43331, "bool"));
		}
		if (areaField.Area == "equip" && areaField.Field == "valortot")
		{
			fields.Add("EQUIP.VALORTOT", new TableFilterField("EQUIP", "VALORTOT", Resources.TOTAL_VALUE30570, "num"));
		}
		if (areaField.Area == "equip" && areaField.Field == "frequenc")
		{
			fields.Add("EQUIP.FREQUENC", new TableFilterField("EQUIP", "FREQUENC", Resources.LOAN_FREQUENCY00701, "enum", array : arrFreqempr));
		}
		if (areaField.Area == "equip" && areaField.Field == "bought")
		{
			fields.Add("EQUIP.BOUGHT", new TableFilterField("EQUIP", "BOUGHT", Resources.BOUGHT32044, "bool"));
		}
		if (areaField.Area == "room1" && areaField.Field == "roomnr")
		{
			fields.Add("ROOM1.ROOMNR", new TableFilterField("ROOM1", "ROOMNR", Resources.N_R__ROOM43805, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "dtrefere")
		{
			fields.Add("EQUIP.DTREFERE", new TableFilterField("EQUIP", "DTREFERE", Resources.REFERENCE28402, "date"));
		}
		if (areaField.Area == "equip" && areaField.Field == "first")
		{
			fields.Add("EQUIP.FIRST", new TableFilterField("EQUIP", "FIRST", Resources.FIRST42972, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "before")
		{
			fields.Add("EQUIP.BEFORE", new TableFilterField("EQUIP", "BEFORE", Resources.BEFORE60156, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "followin")
		{
			fields.Add("EQUIP.FOLLOWIN", new TableFilterField("EQUIP", "FOLLOWIN", Resources.FOLLOWING22170, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "last")
		{
			fields.Add("EQUIP.LAST", new TableFilterField("EQUIP", "LAST", Resources.LAST49207, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "sitefabr")
		{
			fields.Add("EQUIP.SITEFABR", new TableFilterField("EQUIP", "SITEFABR", Resources.MANUFACTURER_S_WEBSI11084, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "moviment")
		{
			fields.Add("EQUIP.MOVIMENT", new TableFilterField("EQUIP", "MOVIMENT", Resources.DRIVES34119, "text"));
		}
		if (areaField.Area == "equip" && areaField.Field == "qtdmovim")
		{
			fields.Add("EQUIP.QTDMOVIM", new TableFilterField("EQUIP", "QTDMOVIM", Resources.QTD__MOVIMENTACOES28400, "num"));
		}
		if (areaField.Area == "equip" && areaField.Field == "showrc")
		{
			fields.Add("EQUIP.SHOWRC", new TableFilterField("EQUIP", "SHOWRC", Resources.SHOW_RECORD53851, "bool"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("PTN_Menu_451", "Equip", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Equip", data_form="PTN_Menu_451" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="PTN_Menu_451_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qPTN_Menu_451", Navigation.GetStrValue("qPTN_Menu_451"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('PTN_Menu_451');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('PTN_Menu_451');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NO__REGISTER04207})
					<button id="qPTN_Menu_451-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("PTN_Menu_451", fields, "EQUIP")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('PTN_Menu_451', 'EQUIP', 'EQUIP.REGISTNR');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="PTN_Menu_451_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#PTN_Menu_451_complex_filter', 'PTN_Menu_451_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("PTN_Menu_451")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="PTN_Menu_451" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "PTN_Menu_451", idlistController = "Equip", idlistArea = "Equip", codlista ="78f755ff-cf65-4633-86d1-399c04d9bb97" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("PTN_Menu_451_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "PTN_Menu_451" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_PTN_Menu_451 = new QMenuForm($('[data-form="PTN_Menu_451"]'), "Form_PTN_Menu_451");
		window.Form_PTN_Menu_451.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_PTN_Menu_451.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qPTN_Menu_451");
		RegisterClearEvents("PTN_Menu_451")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("PTN_Menu_451", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="PTN_Menu_451"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="PTN_Menu_451"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
