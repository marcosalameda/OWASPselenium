@model GenioMVC.ViewModels.Evcat.Evcat_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Evcat";
	ViewBag.Title = @Resources.EVOLUTION_IN_THE_CAT03122;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Evcat", FormMethod.Post, new { @class = "form-horizontal", area="Evcat", data_form="Evcat" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Evcat" area="Evcat" data-form="Evcat">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Evcat_well" area="Evcat" data-form="Evcat">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

