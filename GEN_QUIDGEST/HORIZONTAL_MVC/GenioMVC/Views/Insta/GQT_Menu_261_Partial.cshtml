@model GenioMVC.ViewModels.Insta.GQT_Menu_261_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Insta;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Insta>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodinsta, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_INSTA_SINCE]/
		column.Expression(p => p.ValSince).Title(@Resources.SINCE47259).Field("ValSince").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_INSTA_UNTIL]/
		column.Expression(p => p.ValUntil).Title(@Resources.UNTIL39173).Field("ValUntil").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_EQUIP_REGISTNR]/
		column.Expression(p => p.Equip.ValRegistnr).Title(@Resources.NO__REGISTER04207).Field("Equip.ValRegistnr").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_EQUIP_DESIGNAT]/
		column.Expression(p => p.Equip.ValDesignat).Title(@Resources.EQUIPMENT03632).Field("Equip.ValDesignat").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_TPEQU_TIPOEQUI]/
		column.Expression(p => p.Tpequ.ValTipoequi).Title(@Resources.TYPE00312).Field("Tpequ.ValTipoequi").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_INSTA_HOURS]/
		column.Expression(p => p.ValHours).Title(@Resources.QTD_HOURS28684).Field("ValHours").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_INSTA_PRECOHOR]/
		column.Expression(p => p.ValPrecohor).Title(@Resources.HOURLY_PRICE48005).Field("ValPrecohor").Size(12);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_INSTA_VALUE]/
		column.Expression(p => p.ValValue).Title(@Resources.VALUE10285).Field("ValValue").Size(12);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_261_INSTA_COORDGEO]/
		column.Expression(p => p.ValCoordgeo).Title(@Resources.GEOGRAPHIC_COORDINAT21394).Field("ValCoordgeo").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Insta")
        .Id("GQT_Menu_261")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Insta", false, false)
        .SetFollowUp("Insta_Edit", "Insta" , (Func<GenioMVC.Models.Insta, object>)(item => new { id = item.ValCodinsta }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_261, #GQT_Menu_261_complex_filter th input, #GQT_Menu_261_filters input").change(function() {
                    $("#pGQT_Menu_261").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_261_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_261_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_261_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_261']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_261');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_261_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_261').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_261', 'INSTA', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_261]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_261]/
</script>