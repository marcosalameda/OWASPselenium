@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Leaflett";
	ViewBag.Title = @Resources.INSTALLATION12952;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Insta", FormMethod.Post, new { @class = "form-horizontal", area="Insta", data_form="Leaflett" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Leaflett" area="Insta" data-form="Leaflett">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Leaflett_well" area="Insta" data-form="Leaflett">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

