@model GenioMVC.ViewModels.Item.Artig_ViewModel
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@* USE /[MANUAL GQT TABLE_FOR ARTIG_CATEGORI]/ *@
	<div class="input-xxlarge checkList">
		@(Html.CheckListFor<GenioMVC.Models.Cattp>(edit: Model.IsEditableMode)
			.Columns(column =>
			{
				column.Expression(p => p.ValCodtpcat, true).Hidden();
						column.Expression(p => p.ValTpcatego).Title(@Resources.CATEGORY_TYPE23058).Field("ValTpcatego").Size(30);
						column.Expression(p => p.Sbcat.ValSubcateg).Title(@Resources.SUB_CATEGORIA15612).Field("Sbcat.ValSubcateg").Size(30);
			})
			.DataSource(this.Model.List_Categori)
			.Name("List_Categori_Ids")
			.SelectedIds(this.Model.List_Categori_SelectedIds)
			.Extended("List_Esccateg_Extended")
			.ToHtml()
		)
	</div>


<script>
$(document).ready(function() {
    try {
        if (jQuery) {
            try {
                $(document).ready(function () {
                    loaded($("[id='List_Categori']"));
                    InitSpecialControls($('#List_Categori'));
                });

// USE /[MANUAL GQT LISTING_JS ARTIG_CATEGORI]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>
