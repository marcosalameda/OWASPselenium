				<div class="c-action-bar d-flex">
					<i class="form-popup-header-legend icon-@ViewBag.formmode ViewMode-@ViewBag.formmode"></i><h2>@ViewBag.Title</h2>
					<div data-parent-form="Artigval" data-q-ref="form-btns-main_container"></div>
