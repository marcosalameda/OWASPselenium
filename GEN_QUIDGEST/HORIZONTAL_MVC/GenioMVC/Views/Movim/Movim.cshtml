@model GenioMVC.ViewModels.Movim.Movim_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Movim";
	ViewBag.Title = @Resources.DRIVE03517;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Movim", FormMethod.Post, new { @class = "form-horizontal", area="Movim", data_form="Movim" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Movim" area="Movim" data-form="Movim">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Movim_well" area="Movim" data-form="Movim">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

