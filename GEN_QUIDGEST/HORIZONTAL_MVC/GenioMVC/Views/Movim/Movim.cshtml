								@Html.TextAreaFor(model => model.ValObservat, 2, 50, new {help_id = "LED_MOVIM___MOVIMOBSERVAT", @class = "i-textarea__field i-textarea input-xlarge", data_identifier = "LED_MOVIM___MOVIMOBSERVAT", @pers_cs_area = "Movim", @pers_cs_field = "ValObservat", @db_field = "ValObservat", title = @Resources.OBSERVATION37880 })
