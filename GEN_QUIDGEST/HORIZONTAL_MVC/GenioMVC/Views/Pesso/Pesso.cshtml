@model GenioMVC.ViewModels.Pesso.Pesso_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Pesso";
	ViewBag.Title = @Resources.PERSON10446;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Pesso", FormMethod.Post, new { @class = "form-horizontal", area="Pesso", data_form="Pesso" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Pesso" area="Pesso" data-form="Pesso">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Pesso_well" area="Pesso" data-form="Pesso">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

