@model GenioMVC.ViewModels.Pwcom.GQT_Menu_711_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Pwcom;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Pwcom>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodpwcom, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_711_PSW_NOME]/
		column.Expression(p => p.Psw.ValNome).Title(@Resources.LOGIN48703).Field("Psw.ValNome").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_711_PESS1_NAME]/
		column.Expression(p => p.Pess1.ValName).Title(@Resources.NAME31974).Field("Pess1.ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_711_PWCOM_FOTO]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValFoto, new {alt=@Resources.FOTO19492,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodpwcom, modelname = "Pwcom", fldname = "ValFoto" }))).Title(@Resources.FOTO19492).Field("ValFoto").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_711_PWCOM_NRIDENTI]/
		column.Expression(p => p.ValNridenti).Title(@Resources.IDENTIFICATION37731).Field("ValNridenti").Size(6);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Pwcom")
        .Id("GQT_Menu_711")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Pwcom", false, false)
        .SetFollowUp("Pwcom_Show", "Pwcom" , (Func<GenioMVC.Models.Pwcom, object>)(item => new { id = item.ValCodpwcom }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_711, #GQT_Menu_711_complex_filter th input, #GQT_Menu_711_filters input").change(function() {
                    $("#pGQT_Menu_711").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_711_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_711_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_711_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_711']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_711');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_711_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_711').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_711', 'PWCOM', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_711]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_711]/
</script>