@model GenioMVC.ViewModels.Roigf.Roigf_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Roigf";
	ViewBag.Title = @Resources.ORDER_IN_GROUP__FLOA51083;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Roigf", FormMethod.Post, new { @class = "form-horizontal", area="Roigf", data_form="Roigf" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Roigf" area="Roigf" data-form="Roigf">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Roigf_well" area="Roigf" data-form="Roigf">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

