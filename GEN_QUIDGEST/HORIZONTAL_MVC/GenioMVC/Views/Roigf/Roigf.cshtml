								<div class="d-flex">
								@Html.LabelFor(model => model.TableRogl1Title, new { label_id="IFF_ROIGF___ROGL1TITLE___", @class = " i-text__label", id="LABEL_IFF_ROIGF___ROGL1TITLE___"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_ROIGF___ROGL1TITLE___','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValCodrogl1, Model.TableRogl1Title.List , "", new {help_id = "IFF_ROIGF___ROGL1TITLE___", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_ROIGF___ROGL1TITLE___", @pers_cs_area = "Rogl1", @pers_cs_field = "ValCodrogl1", @db_field = "ValCodrogl1", @db_full_field_name = "roigf.codrogl1", data_has_more = Model.TableRogl1Title.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableRogl1Title.Selected, data_dbedit_value = Model.TableRogl1Title.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodroigf, @data_see_more = "Roigf_Rogl1ValTitle", title = @Resources.TITLE21885, data_see_more_url = @Url.Action("Roigf_Rogl1ValTitle","Roigf"), data_is_dbedit = "true", data_fields = "rogl1.codrogl1,rogl1.title", data_main_field = "Rogl1.ValTitle", data_elements = 0, data_filled_by_history = Model.TableRogl1Title.FilledByHistory, @dependant_fields = "rogl1.codrogl1,rogl1.title" })
								@Html.ValidationMessageFor(model => model.TableRogl1Title)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_ROIGF___ROIGFORDER___">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValOrder, new { label_id="LED_ROIGF___ROIGFORDER___", @class = " i-text__label", id="LABEL_LED_ROIGF___ROIGFORDER___"}, true, true)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ROIGF___ROIGFORDER___','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.NumberFor(model => model.ValOrder, new {help_id = "LED_ROIGF___ROIGFORDER___", @class = "Number text-right i-text__field i-text input-small", data_sequencial = "M1", data_identifier = "LED_ROIGF___ROIGFORDER___", @pers_cs_area = "Roigf", @pers_cs_field = "ValOrder", @db_field = "ValOrder", title = @Resources.ORDER39632, data_number_integer = "8", data_number_decimals = "1", data_number_format = "99999999.9" })
								@Html.ValidationMessageFor(model => model.ValOrder)
							</div>
						<div class="i-text draggable " id="CONTAINER_LED_ROIGF___ROIGFTITLE___">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValTitle, new { label_id="LED_ROIGF___ROIGFTITLE___", @class = " i-text__label", id="LABEL_LED_ROIGF___ROIGFTITLE___"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_ROIGF___ROIGFTITLE___','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValTitle, new {help_id = "LED_ROIGF___ROIGFTITLE___", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_ROIGF___ROIGFTITLE___", @pers_cs_area = "Roigf", @pers_cs_field = "ValTitle", @db_field = "ValTitle", title = @Resources.TITLE21885, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValTitle)
							</div>
						</div>
					</div>
				</div>
			</div>




			@Html.HiddenFor(model => model.ValCodroigf, new { @pers_cs_field="ValCodroigf", @pers_cs_area="Roigf", data_refresh = "true", @form_area="true", @data_value = Model.ValCodroigf, @data_identifier = "LED_ROIGF___ROIGFCODROIGF" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Roigf" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Roigf" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Roigf" })
			if (!Model.NestedForm)
            {
                @Html.AntiForgeryToken()
            }
}

@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@HttpUtility.JavaScriptStringEncode(Url.Action(Helpers.FormModeActionName("Roigf", Model.FormMode).ToString(), "Roigf"))", "Roigf_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.SAVE04165
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Roigf_Delete", "Roigf", new {id = @Model.ValCodroigf} )", "Roigf_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Roigf_well")); });
            </script>
        }
		else if (Model.FormMode == FormMode.Delete)
		{
			<button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Roigf_Delete", "Roigf", new {id = @Model.ValCodroigf} )", "Roigf_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>
		}

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Roigf_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitRoigf(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Roigf", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteRoigf(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Roigf", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitRoigf(event)" title="@Resources.SAVE04165" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.SAVE04165
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Roigf_Cancel", "Roigf", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Roigf.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Roigf_Cancel","Roigf","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Roigf">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Roigf" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Roigf">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

@helper LoadFromLayout()
{
}

