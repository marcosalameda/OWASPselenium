@model GenioMVC.ViewModels.Rooms.GQT_Menu_2311_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Rooms;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Rooms>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodrooms, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2311_ROOMS_ROOMNR]/
		column.Expression(p => p.ValRoomnr).Title(@Resources.N_R__ROOM43805).Field("ValRoomnr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN GQT_MENU_2311_ROOMS_DESIGNAT]/
		column.Expression(p => p.ValDesignat).Title(@Resources.ROOM_DESIGNATION37895).Field("ValDesignat").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Rooms")
        .Id("GQT_Menu_2311")
        .AjaxRequest("GQT_Menu_2311_Container")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Salas", false, false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qGQT_Menu_2311, #GQT_Menu_2311_complex_filter th input, #GQT_Menu_2311_filters input").change(function() {
                    $("#pGQT_Menu_2311").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#GQT_Menu_2311_tableFilters').val(false);")
                    @Html.Raw("$('#GQT_Menu_2311_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#GQT_Menu_2311_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='GQT_Menu_2311']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qGQT_Menu_2311');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#GQT_Menu_2311_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_GQT_Menu_2311').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('GQT_Menu_2311', 'SALAS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                    $(document).trigger('GQT_Menu_2311_SecondTabInit');
                });





// USE /[MANUAL GQT LISTING_JS GQT_MENU_2311]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS GQT_MENU_2311]/
</script>