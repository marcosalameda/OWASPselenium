			beforeSave: function(event, state)
			{
// USE /[MANUAL GQT FORM_CODEJS VENDAWP_FASES_BEFORE_SAVE]/
			},
			// Called when the user clicks the "forward" button, after moving forward.
			afterForward: function(event, state)
			{
// USE /[MANUAL GQT FORM_CODEJS VENDAWP_FASES_AFTER_FORWARD]/
			},
			// Called when the user clicks the "back" button, after moving backward.
			afterBackward: function(event, state)
			{
				var stepIndex = state.stepIndex;
				if (stepIndex >= 0 && stepIndex < window.stepForms.length && window.wizardConfig.stepConfig[stepIndex].clearOnBackward)
				{
					let stepName = window.stepForms[stepIndex];
					let primaryKey = $('#q-wizard-FASES').attr('q-record-id');
					let formId = $('#' + primaryKey).val();
					let wizardValues = JSON.parse(localStorage['WizardValues']);
					let stepValues = wizardValues['Vendawp' + formId]['FASES'][stepName];

					for (let i in stepValues)
					{
						window[stepName].Controls[i].Value = stepValues[i].control;
						$('input[data-identifier="' + i + '"]:not("[type=radio]")').val(stepValues[i].view);
					}
				}

// USE /[MANUAL GQT FORM_CODEJS VENDAWP_FASES_AFTER_BACKWARD]/
			},
			// Called whenever a new step/phase is selected, after the content is loaded.
			afterSelect: function(event, state)
			{
				var wizard = state.step.closest('.wizard-area').attr('id');
				var step = state.stepIndex + 1;
				toggleSaveButton(wizard, step);
				$(document).ready(setNavigationId);

// USE /[MANUAL GQT FORM_CODEJS VENDAWP_FASES_AFTER_SELECT]/
			},
			// Called whenever the state of a step/phase is saved, after the save action.
