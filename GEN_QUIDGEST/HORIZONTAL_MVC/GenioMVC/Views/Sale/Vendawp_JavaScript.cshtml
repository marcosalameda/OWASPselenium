	// Stores the steps, for each wizard, where the save button of the main form should be hidden.
	var wizardSaveOptions = {
		'q-wizard-FASES': { 'current': 0, 'steps': [] },
	};

	/**
	 * Updates the current step of the specified wizard and checks if the save button should be visible.
	 * @@param {string} wizard The wizard name
	 * @@param {number} step The current step order
	 */
	function toggleSaveButton(wizard, step)
	{
		if (window.Form_Vendawp.FormMode == 'delete')
			return;

		wizardSaveOptions[wizard].current = step;

		// Iterates all the current steps, in all the wizards, to check if the save button should be visible.
		var isVisible = true;
		for (let i in wizardSaveOptions)
		{
			let current = wizardSaveOptions[i].current;
			let steps = wizardSaveOptions[i].steps;
			if (steps.includes(current))
			{
				isVisible = false;
				break;
			}
		}

		// The main save button at the bottom of the form.
		var bottomBtnName = '@(Helpers.FormModeActionName("Vendawp", Model.FormMode))';
		var bottomBtn = $('button[type="submit"][name="' + bottomBtnName + '"]');

		// The action buttons on the sidebar.
		var sidebarBtnSelector = '[data-q-ref="sidebar-main_container"] > [data-q-ref="sidebar-btns-actions"]';
		var sidebarBtns = $(sidebarBtnSelector);

		// The small save button on the top of the form.
		var defaultTitle = '@(Resources.GRAVAR45301)';
		var btnTitle = bottomBtn.attr('title');
		var topBtn = $('[data-q-ref="form-btns-container-modes"] > button[title="' + btnTitle + '"]');
		if (topBtn.length == 0)
			topBtn = $('[data-q-ref="form-btns-container-modes"] > button[title="' + defaultTitle + '"]');

		if (isVisible)
		{
			bottomBtn.show();
			window.Form_Vendawp.initBtns();
			if (sidebarBtns.length == 0)
				$(sidebarBtnSelector).remove();
		}
		else
		{
			bottomBtn.hide();
			if (topBtn.length > 0)
				topBtn.remove();
			if (sidebarBtns.length > 0)
			{
				$(sidebarBtnSelector).find('[data-q-ref="sidebar-btn-action"]:contains("' + btnTitle + '")').remove();
				$(sidebarBtnSelector).find('[data-q-ref="sidebar-btn-action"]:contains("' + defaultTitle + '")').remove();
			}
		}
	}

	/**
	 * Finds and loads the next step of the wizard.
	 * @@param {string} wizardId The id of the wizard.
	 * @@param {string} stepId The id of the step.
	 * @@param {function} resolve A function that will be called if the step is successfully loaded.
	 * @@param {function} reject A function that will be called if an error occurs while loading the step.
	 */
	function goToNextStep(wizardId, stepId, resolve, reject)
	{
		getNextStep($(wizardId), stepId, function(data, isSuccess)
		{
			if (isSuccess)
			{
				let nextStep = $('#' + data);
				let isLoaded = nextStep.attr('step-loaded') == 'true';
				if (!isLoaded)
				{
					loadWizardStep(nextStep, function(error)
					{
						QAnimation.hidePleaseWait();
						if (error === undefined)
							resolve(data);
						else
							reject(error);
					});
				}
				else
				{
					QAnimation.hidePleaseWait();
					resolve(data);
				}
			}
			else
			{
				QAnimation.hidePleaseWait();
				reject(data);
				bootbox.alert(data);
			}
		});
	}

	/**
	 * Creates a promise that tries to make the transition from the current step to the next.
	 * @@param {string} wizardId The id of the wizard.
	 * @@param {string} stepId The id of the step.
	 * @@param {string} stepForm The form variable.
	 * @@param {boolean} saveBefore True if an "apply" should be done before advancing to the next step, false otherwise.
	 * @@returns A promise, to be executed afterward, which will try to select the next step of the wizard.
	 */
	function makeTransition(wizardId, stepId, stepForm, saveBefore)
	{
		QAnimation.showPleaseWait();
		return new Promise(function(resolve, reject)
		{
			if (saveBefore)
			{
				saveWizardState($(wizardId), stepId, function(message, isSuccess, view)
				{
					$(wizardId).find('.validation-summary-errors').remove();
					if (isSuccess)
						goToNextStep(wizardId, stepId, resolve, reject);
					else
					{
						QAnimation.hidePleaseWait();
						if (view !== undefined && view.length > 0)
						{
							let form = window[stepForm];
							delete window[stepForm];
							form.ReplaceHTML(view);
						}
						else
							bootbox.alert(message);
						reject(message);
					}
				});
			}
			else
				goToNextStep(wizardId, stepId, resolve, reject);
		});
	}

