@model GenioMVC.ViewModels.Menu_ViewModel

@if(@Model.AvailableModules.Count > 0)
{
    if (GenioMVC.LayoutConfig.config.BookmarkEnable)
    {
        @Bookmarks()
    }
    
    if (@Model.AvailableModules.Count > 1) {
        <ul class="nav i-changeModule">
            <li class="dropdown i-changeModule">
                    <a href="#" class="brand" data-toggle="dropdown">
                        @DesignModuleBrand()
                    </a>
                    @AllModules()
            </li>
        </ul>
    }

}




@helper DesignModuleBrand()
{  
var moduleIcon = "glyphicons glyphicons-show-thumbnails";
var module = @Model.AvailableModules.FirstOrDefault(p => p.ID.Equals(@Model.CurrentModule));
var moduleClass = @Model.AvailableModules.Count > 1 ? "i-changeModule__placeholder dropdown-toggle" : "i-changeModule__placeholder";

    <div></div>
    if (module != null)
    {      
        <i class="@moduleIcon changeModuleIcon"></i>    
        if (@Model.AvailableModules.Count > 1) {
            <span class="@moduleClass">@Helpers.GetTextFromResources(module.Title)</span>
        }            
    }
}

@helper Bookmarks()
{
    if (!@GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
    {
        @*          Bookmarks          *@
        @Html.Action("Bookmarks", "Home")
        @* --------------------------- *@
    }
}

@helper AllModules() {
    var moduleClass = "";
<ul class="dropdown-menu">
    @if (@Model.AvailableModules.Count > 0)
    {
        foreach (GenioMVC.Helpers.Menus.MenuEntry item in @Model.AvailableModules)
        {
            if (item.ID.Equals(@Model.CurrentModule))
            {
                moduleClass = "current";
            }else{
                moduleClass = "";
            }

            <li class="i-changeModule__item @moduleClass">
                <a class="dropdown-item" href="@Url.Action("Index", "Home", new { module = item.ID })">
                    @if (!String.IsNullOrEmpty(item.Font))
                    {
                        <i class="@item.Font dropdown__icon"></i>@Helpers.GetTextFromResources(item.Title)
                    }                    
                    else
                    {
                        @Helpers.GetTextFromResources(item.Title)
                    }
                </a>
            </li>
        }
    }
</ul>
}
