			@Html.HiddenFor(model => model.ValCodtblk, new { @pers_cs_field="ValCodtblk", @pers_cs_area="Tblk", data_refresh = "true", @form_area="true", @data_value = Model.ValCodtblk, @data_identifier = "LED_TBLK____TBLK_CODTBLK_" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Tblk" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Tblk" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Tblk" })
