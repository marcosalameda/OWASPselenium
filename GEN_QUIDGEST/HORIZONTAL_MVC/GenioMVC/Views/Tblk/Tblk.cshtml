						<div class="i-dbedit draggable " id="CONTAINER_IFF_TBLK____GRPB_NAME____">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableGrpbName, new { label_id="IFF_TBLK____GRPB_NAME____", @class = " i-text__label", id="LABEL_IFF_TBLK____GRPB_NAME____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_TBLK____GRPB_NAME____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValFkey1, Model.TableGrpbName.List , "", new {help_id = "IFF_TBLK____GRPB_NAME____", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_TBLK____GRPB_NAME____", @pers_cs_area = "Grpb", @pers_cs_field = "ValCodgrpb", @db_field = "ValCodgrpb", @db_full_field_name = "tblk.fkey1", data_has_more = Model.TableGrpbName.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableGrpbName.Selected, data_dbedit_value = Model.TableGrpbName.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodtblk, @data_see_more = "Tblk_GrpbValName", title = @Resources.NAME31974, data_see_more_url = @Url.Action("Tblk_GrpbValName","Tblk"), data_is_dbedit = "true", data_fields = "grpb.codgrpb,grpb.name", data_main_field = "Grpb.ValName", data_elements = 0, data_filled_by_history = Model.TableGrpbName.FilledByHistory, @dependant_fields = "grpb.codgrpb,grpb.name" })
								@Html.ValidationMessageFor(model => model.TableGrpbName)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_IFF_TBLK____TRSB_NAME____">
								<div class="d-flex">
								@Html.LabelFor(model => model.TableTrsbName, new { label_id="IFF_TBLK____TRSB_NAME____", @class = " i-text__label", id="LABEL_IFF_TBLK____TRSB_NAME____"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('IFF_TBLK____TRSB_NAME____','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.DropDownListFor(model => model.ValFkey2, Model.TableTrsbName.List , "", new {help_id = "IFF_TBLK____TRSB_NAME____", @class = "i-select chosen-dropdown input-xxlarge", data_identifier = "IFF_TBLK____TRSB_NAME____", @pers_cs_area = "Trsb", @pers_cs_field = "ValCodtrsb", @db_field = "ValCodtrsb", @db_full_field_name = "tblk.fkey2", data_has_more = Model.TableTrsbName.HasMore(), data_has_more_text = @Resources.PROCURE_PARA_MAIS_RE41208, data_placeholder = @Resources.ESCOLHA___40245, data_value = Model.TableTrsbName.Selected, data_dbedit_value = Model.TableTrsbName.Value, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_form_key = @Model.ValCodtblk, @data_see_more = "Tblk_TrsbValName", title = @Resources.NAME31974, data_see_more_url = @Url.Action("Tblk_TrsbValName","Tblk"), data_is_dbedit = "true", data_fields = "trsb.codtrsb,trsb.name", data_main_field = "Trsb.ValName", data_elements = 0, data_filled_by_history = Model.TableTrsbName.FilledByHistory, @dependant_fields = "trsb.codtrsb,trsb.name" })
