@model GenioMVC.ViewModels.Tblk.Tblk_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Tblk";
	ViewBag.Title = @Resources.TABLE__FOREIGN_KEYS_21641;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Tblk", FormMethod.Post, new { @class = "form-horizontal", area="Tblk", data_form="Tblk" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Tblk" area="Tblk" data-form="Tblk">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Tblk_well" area="Tblk" data-form="Tblk">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

