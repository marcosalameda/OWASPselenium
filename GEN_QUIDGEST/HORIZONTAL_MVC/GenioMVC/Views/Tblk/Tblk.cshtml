								@Html.TextBoxFor(model => model.ValName, new {help_id = "LED_TBLK____TBLK_NAME____", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_TBLK____TBLK_NAME____", @pers_cs_area = "Tblk", @pers_cs_field = "ValName", @db_field = "ValName", title = @Resources.NAME31974, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValName)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
