			<ul class="nav c-tab c-tab__divider" role="tablist">
				<li class="nav-item c-tab__item" elem-identifier="TabbableIdentifier" id="tab_armaz01" data-tab="armaz01"><a class="nav-link" tabindex="0" data-target="#armaz01" data-toggle="tab">@Resources.IDENTIFICATION37731</a></li>
