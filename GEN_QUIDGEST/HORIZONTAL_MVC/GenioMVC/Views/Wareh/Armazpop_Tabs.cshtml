									</div>
								</div>
							</div>
						</div>

					</div>
				</div>
				<div class="c-tab__item-content" id="armaz02" data-identifier="IFF_ARMAZPOPPSEUDARMAZ02_">
					<div class="form-flow">
						<div class="row">
							<div class="col-12">
								<div class="row-large-control">
									<div class="row-line-group" id="CONTAINER_IFF_ARMAZ02_PSEUDARTIGAPO">
										<div id="ARTIGAPO" data-target="ValArtigos" elem-identifier="extended-support">
											<div class="alert alert-block alert-info">@Resources.ESCOLHA_UM_ELEMENTO_24060</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-12">
								<div class="row-large-control">
									<div class="row-line-group" id="CONTAINER_IFF_ARMAZ02_PSEUDARTIGOS_">
										<div id="Armaz02_ValArtigos" data-identifier="IFF_ARMAZ02_PSEUDARTIGOS_"  data-extra-options="" > 
											@{ Html.RenderAction("Armaz02_ValArtigos", "Wareh", new { id = Model.ValCodwareh, partialView = "Armaz02_ValArtigos"}); }
										</div>
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>
 			</div>
        </div>
	</div>
	<!-- end tab content -->
	<script type="application/javascript">
		$(document).ready(function () {
			// to select the first tab
			var a = $('[elem-identifier="TabbableIdentifier"] > a', "#Armazpop_tabs").first();
            a.addClass("active");

			var li = $('[elem-identifier="TabbableIdentifier"]', "#Armazpop_tabs").first();			
			var tabId = li.attr("data-tab");
			$("#" + tabId).addClass("active");			
		});
	</script>
