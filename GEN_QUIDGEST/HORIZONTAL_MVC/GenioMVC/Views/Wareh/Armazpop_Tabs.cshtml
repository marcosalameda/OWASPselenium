										<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
										<a href="javascript:OpenSuggestion('LED_ARMAZ01_WAREHWAREHCOD','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
										@Html.TextBoxFor(model => model.ValWarehcod, new {help_id = "LED_ARMAZ01_WAREHWAREHCOD", @class = "i-text__field i-text input-small", data_identifier = "LED_ARMAZ01_WAREHWAREHCOD", @pers_cs_area = "Wareh", @pers_cs_field = "ValWarehcod", @db_field = "ValWarehcod", title = @Resources.CODE_49120, maxlength = "10", rows = "10" })
										@Html.ValidationMessageFor(model => model.ValWarehcod)
										</div>
									</div>
									<div class="control-join-group">
									<div class="i-switch-container draggable " id="CONTAINER_LED_ARMAZ01_WAREHACTIVITY">
										<div class="d-flex">
										@Html.LabelFor(model => model.ValActivity, new { label_id="LED_ARMAZ01_WAREHACTIVITY", @class = " i-text__label", id="LABEL_LED_ARMAZ01_WAREHACTIVITY"}, true, false)
										<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
										<a href="javascript:OpenSuggestion('LED_ARMAZ01_WAREHACTIVITY','Activida')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
										@Html.ArrayLogicalFor(model => model.ValActivity, Model.List_ValActivity, CSGenio.business.ArrayActivida.GetElement, false, new {help_id = "LED_ARMAZ01_WAREHACTIVITY", @class = "input-mini", data_identifier = "LED_ARMAZ01_WAREHACTIVITY", @pers_cs_area = "Wareh", @pers_cs_field = "ValActivity", @db_field = "ValActivity", title = @Resources.ACTIVITY_63514 })
										@Html.ValidationMessageFor(model => model.ValActivity)
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-12">
								<div class="control-row-group">
									<div class="control-join-group">
									<div class="i-text draggable " id="CONTAINER_LED_ARMAZ01_WAREHWAREHDES">
										<div class="d-flex">
										@Html.LabelFor(model => model.ValWarehdes, new { label_id="LED_ARMAZ01_WAREHWAREHDES", @class = " i-text__label", id="LABEL_LED_ARMAZ01_WAREHWAREHDES"}, true, false)
