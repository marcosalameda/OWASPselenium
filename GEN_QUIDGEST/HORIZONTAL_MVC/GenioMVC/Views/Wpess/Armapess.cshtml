@model GenioMVC.ViewModels.Wpess.Armapess_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Armapess";
	ViewBag.Title = @Resources.PERSON10446;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Wpess", FormMethod.Post, new { @class = "form-horizontal", area="Wpess", data_form="Armapess" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Armapess" area="Wpess" data-form="Armapess">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Armapess_well" area="Wpess" data-form="Armapess">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

