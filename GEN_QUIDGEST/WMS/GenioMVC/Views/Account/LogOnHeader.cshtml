@model GenioMVC.Models.LogOnModel

@{
	ViewBag.Title = @Resources.AREA_DE_AUTENTICACAO12342;
}

@* USE /[MANUAL GQT CUSTOM_LOGON_VIEW]/ *@
        @using (Ajax.BeginForm("LogOn", "Account", new { ReturnUrl = Request.QueryString["ReturnUrl"] }, new AjaxOptions { OnSuccess = "loginSuccess" }))
        {                   
            <fieldset>                            
                <div class="f-login--header">
                    <div class="row">  
						@if ((Model.OpenIdConnAuthMethods != null && Model.OpenIdConnAuthMethods.Count != 0) || (Model.CASAuthMethods != null && Model.CASAuthMethods.Count != 0))
						{
                            foreach (string idMethod in Model.OpenIdConnAuthMethods)
                            {
                                <div class="col-auto">
                                    @Html.ActionLink(String.IsNullOrEmpty(idMethod) ? "OpenId Connect Auth" : idMethod, "OpenIdLoginRedirect", "Account", new { id = idMethod }, new { @class = "b-icon-text b-icon-text--primary b-openid-" + CSGenio.framework.StringUtils.RemoveDiacritics(idMethod) })
                                </div>
                            }
							foreach (string idMethod in Model.CASAuthMethods)
                            {
                                <div class="col-auto">
                                    @Html.ActionLink(String.IsNullOrEmpty(idMethod) ? "CAS Protocol" : idMethod, "CASLoginRedirect", "Account", new { id = idMethod }, new { @class = "b-icon-text b-icon-text--primary b-openid-" + CSGenio.framework.StringUtils.RemoveDiacritics(idMethod) })
                                </div>
                            }
                                
                        }
                        <div class="col-auto">
                            <div class="input-group f-login__input-group mb-3">
                                <div class="i-input-group--left">
                                    <span class="input-group-text i-input-group__tag">
                                        <i class="glyphicons glyphicons-user f-login__input-icon"></i>
                                    </span>
                                </div>					
                                @Html.TextBoxFor(m => m.UserName, new { placeholder = @Resources.UTILIZADOR52387, @class = "i-input-group__field" })
                            </div>
                        </div>

                        <div class="col-auto">
                            <div class="input-group f-login__input-group mb-3">
                                <div class="i-input-group--left">
                                    <span class="input-group-text i-input-group__tag">
                                        <i class="glyphicons glyphicons-lock f-login__input-icon"></i></span>
                                    </div>					
                                @Html.PasswordFor(m => m.Password, new { autocomplete = "off" , @class = "i-input-group__field" , placeholder = @Resources.PALAVRA_CHAVE39832 })
								@if (GenioMVC.LayoutConfig.config.showPasswordToggle)
								{
									 <div class="i-input-group--right">
										<span class="i-input-group__tag f-login__input-tag">
											<i class="glyphicons glyphicons-eye-open f-login__input-icon" id="passwordtoggle" onclick="togglePassword()"></i>
										</span>
									</div>
								}
                            </div>
                        </div>

                        <div class="col-auto">
                            <button type="submit" class="b-icon b-icon--primary">
                                <i class="glyphicons glyphicons-log-in" style="font-size:1.2rem;"></i>
                            </button>
                        </div>
                        
    

                        </div> 
                    <div class="row">
                        <div class="col">
                            <div class="validation-summary-valid" id="formLoginValidation"></div>
                        </div>
                    </div>          
                </div>
                @Html.AntiForgeryToken()
            </fieldset>                    
        }
        
<script>
	function loginSuccess(data) {
		if (data.Success)
			window.location = data.Redirect;
		else
        {
            var message = (data && data.Message) ? data.Message : '@Html.Raw(@Resources.PEDIMOS_DESCULPA__OC63848)';
            $("#formLoginValidation").html('<i class="glyphicons glyphicons-light-beacon e-icon"></i> ' + message);
            $("#formLoginValidation").addClass("i-text__error"); 
        }		
	}
	
	function togglePassword() {
        if ($('#Password').attr('type') == 'text') {
            $('#Password').attr('type', 'password');
            $('#passwordtoggle').removeClass('glyphicons glyphicons-eye-close')
            $('#passwordtoggle').addClass('glyphicons glyphicons-eye-open')
        }
        else {
            $('#Password').attr('type', 'password');        
            $('#Password').attr('type', 'text');
            $('#passwordtoggle').removeClass('glyphicons glyphicons-eye-open')
            $('#passwordtoggle').addClass('glyphicons glyphicons-eye-close')
        }            
    }
</script>
