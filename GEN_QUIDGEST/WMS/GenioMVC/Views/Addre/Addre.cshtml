			@Html.HiddenFor(model => model.ValCodaddre, new { @pers_cs_field="ValCodaddre", @pers_cs_area="Addre", data_refresh = "true", @form_area="true", @data_value = Model.ValCodaddre, @data_identifier = "LED_ADDRE___ADDRECODADDRE" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Addre" })
