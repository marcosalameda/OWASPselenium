@model GenioMVC.ViewModels.Addre.Addre_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Addre";
	ViewBag.Title = @Resources.ADDRESS04342;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Addre", FormMethod.Post, new { @class = "form-horizontal", area="Addre", data_form="Addre" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Addre" area="Addre" data-form="Addre">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Addre_well" area="Addre" data-form="Addre">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

