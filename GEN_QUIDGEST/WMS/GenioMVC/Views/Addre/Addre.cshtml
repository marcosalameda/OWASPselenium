								@Html.TextBoxFor(model => model.ValAddresscity, new {help_id = "LED_ADDRE___ADDREADDRCITY", data_toggle = "tooltip", title = @Resources._109937997, data_placement = "top", description = "", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_ADDRE___ADDREADDRCITY", @pers_cs_area = "Addre", @pers_cs_field = "ValAddresscity", @db_field = "ValAddresscity", maxlength = "50", rows = "50" })
