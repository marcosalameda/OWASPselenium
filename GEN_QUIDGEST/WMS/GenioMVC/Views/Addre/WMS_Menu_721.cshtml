@model GenioMVC.ViewModels.Addre.WMS_Menu_721_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Addre.WMS_Menu_721_ViewModel modelWMS_Menu_721 = new GenioMVC.ViewModels.Addre.WMS_Menu_721_ViewModel(Navigation);
	var columns = modelWMS_Menu_721.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrAddressu = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayAddressu.GetDictionary())
	{
		arrAddressu.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}
	Dictionary<string, string> arrAddresst = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayAddresst.GetDictionary())
	{
		arrAddresst.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "addre" && areaField.Field == "addruse")
		{
			fields.Add("ADDRE.ADDRUSE", new TableFilterField("ADDRE", "ADDRUSE", Resources.ADDRESS_USE16014, "enum", array : arrAddressu, defaultSearch : true));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrtype")
		{
			fields.Add("ADDRE.ADDRTYPE", new TableFilterField("ADDRE", "ADDRTYPE", Resources.ADDRESS_TYPE12455, "enum", array : arrAddresst));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrtext")
		{
			fields.Add("ADDRE.ADDRTEXT", new TableFilterField("ADDRE", "ADDRTEXT", Resources.ENTIRE_ADDRESS64248, "text"));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrcity")
		{
			fields.Add("ADDRE.ADDRCITY", new TableFilterField("ADDRE", "ADDRCITY", Resources.ADDRESS_CITY41109, "text"));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrdist")
		{
			fields.Add("ADDRE.ADDRDIST", new TableFilterField("ADDRE", "ADDRDIST", Resources.ADDRESS_DISTRICT48524, "text"));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrstat")
		{
			fields.Add("ADDRE.ADDRSTAT", new TableFilterField("ADDRE", "ADDRSTAT", Resources.ADDRESS_STATE16863, "text"));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrpcod")
		{
			fields.Add("ADDRE.ADDRPCOD", new TableFilterField("ADDRE", "ADDRPCOD", Resources.ADDRESS_POSTAL_CODE41631, "text"));
		}
		if (areaField.Area == "addre" && areaField.Field == "addrcoun")
		{
			fields.Add("ADDRE.ADDRCOUN", new TableFilterField("ADDRE", "ADDRCOUN", Resources.ADDRESS_COUNTRY56159, "text"));
		}
		if (areaField.Area == "addre" && areaField.Field == "peristar")
		{
			fields.Add("ADDRE.PERISTAR", new TableFilterField("ADDRE", "PERISTAR", Resources.PERIOD_START07901, "date"));
		}
		if (areaField.Area == "addre" && areaField.Field == "periend")
		{
			fields.Add("ADDRE.PERIEND", new TableFilterField("ADDRE", "PERIEND", Resources.PERIOD_END31576, "date"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("WMS_Menu_721", "Addre", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Addre", data_form="WMS_Menu_721" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="WMS_Menu_721_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qWMS_Menu_721", Navigation.GetStrValue("qWMS_Menu_721"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('WMS_Menu_721');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('WMS_Menu_721');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.ADDRESS_USE16014})
					<button id="qWMS_Menu_721-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("WMS_Menu_721", fields, "ADDRE")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('WMS_Menu_721', 'ADDRE', 'ADDRE.ADDRUSE');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="WMS_Menu_721_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#WMS_Menu_721_complex_filter', 'WMS_Menu_721_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("WMS_Menu_721")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="WMS_Menu_721" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "WMS_Menu_721", idlistController = "Addre", idlistArea = "Addre", codlista ="effd297d-4589-4a9c-b1c1-d836902892b1" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("WMS_Menu_721_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "WMS_Menu_721" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_721 = new QMenuForm($('[data-form="WMS_Menu_721"]'), "Form_WMS_Menu_721");
		window.Form_WMS_Menu_721.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_721.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_721");
		RegisterClearEvents("WMS_Menu_721")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_721", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="WMS_Menu_721"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="WMS_Menu_721"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
