                    $('#ValAttachme').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS EQUIPM_VALATTACHME]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
