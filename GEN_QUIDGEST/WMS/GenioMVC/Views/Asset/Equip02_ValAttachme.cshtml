@* USE /[MANUAL GQT TABLE_FOR EQUIP02_ATTACHME]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Attac;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Attac>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodattac, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP02_ATTACHME_ATTAC_ATTACHED]/
		column.Expression(p => p.ValAttached).Title(@Resources.ATTACHED26247).Field("ValAttached").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP02_ATTACHME_ATTAC_NOTE]/
		column.Expression(p => p.ValNote).Title(@Resources.NOTE54557).Field("ValNote").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP02_ATTACHME_ATTAC_DOCUMENT]/
		column.Expression(p => p.ValDocument).Title(@Resources.DOCUMENT00695).Field("ValDocument").Size(30).Document(p => Url.Action("GetFile", "Attac", new { ticket = p.GetTicketForDocField("ValDocument"), viewType = (int)CSGenio.framework.DocumentViewTypeMode.Print}));
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Attac")
        .Id("ValAttachme")
        .AjaxRequest("Equip02_ValAttachme")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Equip02_ValAttachme", new { id = Model.ValCodasset, partialView = "Equip02_ValAttachme"}))
        .Form("Attac", false, false)
        .SetFollowUp("Attac_Show", "Attac" , (Func<GenioMVC.Models.Attac, object>)(item => new { id = item.ValCodattac }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


