@model GenioMVC.ViewModels.Asset.Equip04_ValParamete_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_EQUIP04_PSEUDPARAMETE" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.PARAMETERS28294</h2 list-header> </label></div>
	</div>
	<div class="col-auto search">
	<div id="ValParamete_simple_filter">
		<div class="i-input-group input-xxlarge">
			@Html.TextBox("qValParamete", Model.Menu.Query, new { @class="i-input-group__field ", @onkeydown = "ListSearchEnter(event)", @style="height: inherit" } )
			<div class="i-input-group--right">
				<button type="button" class="b-icon--secondary i-input-group__button--secondary listSearchButton" elem-identifier="ListSearchButton" onclick="window.ValParamete.Search();"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
				<button id="ValParamete_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#ValParamete_complex_filter', 'ValParamete_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
			</div>
		</div>
	</div>
	</div>
	<div class="col-auto"  style="padding: 0; padding-right: 15px">
		<div class="b-btn-group">
			@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
			{
				<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="ValParamete" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "Equip04_ValParamete", idlistController = "Asset", idlistArea = "Asspa" , codlista =""  })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
			}
		</div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR EQUIP04_PARAMETE]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Asspa;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Asspa>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodasspa, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_PARAM_PARAMETE]/
		column.Expression(p => p.Param.ValParameter).Title(@Resources.PARAMETER41976).Field("Param.ValParameter").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_ASSPA_DATATYPE]/
		column.Expression(p => p.ArrayValdatatype).Title(@Resources.DATA_TYPE47159).Hidden().Field("ValDatatype", "ArrayDatatype").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_ASSPA_DECPLACE]/
		column.Expression(p => p.ValDecimalplaces).Title(@Resources.DECIMAL_PLACES62575).Hidden().Field("ValDecimalplaces").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_ASSPA_TEXT]/
		column.Expression(p => p.ValText).Title(@Resources.TEXT04938).Hidden().Field("ValText").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_ASSPA_QUANTITY]/
		column.Expression(p => p.ValQuantity).Title(@Resources.QUANTITY06415).Hidden().Field("ValQuantity").Size(12);
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_ASSPA_DATE]/
		column.Expression(p => p.ValDate).Title(@Resources.DATE18475).Hidden().Field("ValDate").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN EQUIP04_PARAMETE_ASSPA_TOSHOW]/
		column.Expression(p => p.ValToshow).Title(@Resources.VALUE10285).Field("ValToshow").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Asspa")
        .Id("ValParamete")
        .AjaxRequest("Equip04_ValParamete")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Equip04_ValParamete", new { id = Model.ValCodasset, partialView = "Equip04_ValParamete"}))
        .Filters(this.Model.Menu.Filters)
        .Form("Asspa", false, true)
        .SetFollowUp("Asspa_Show", "Asspa" , (Func<GenioMVC.Models.Asspa, object>)(item => new { id = item.ValCodasspa }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValParamete, #ValParamete_complex_filter th input, #ValParamete_filters input").change(function() {
                    $("#pValParamete").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValParamete_tableFilters').val(false);")
                    @Html.Raw("$('#ValParamete_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValParamete_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValParamete_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValParamete_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValParamete').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValParamete']"));
                    InitSpecialControls($('#ValParamete'));
                    $('#ValParamete').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS EQUIPM_VALPARAMETE]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>