@model GenioMVC.ViewModels.Asset.Equipm_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Equipm";
	ViewBag.Title = string.Format(@Resources._ASSET__ASSETNUM____37227, string.Format("{0:F0}", this.Model.ValAssetnum),this.Model.ValName);
	Model.Navigation.CurrentLevel.redefineLocName(ViewBag.Title);
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Asset", FormMethod.Post, new { @class = "form-horizontal", area="Asset", data_form="Equipm" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Equipm" area="Asset" data-form="Equipm">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Equipm_well" area="Asset" data-form="Equipm">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

