	<script type="application/javascript">
		$(document).ready(function () {
			// to select the first tab
			var a = $('[elem-identifier="TabbableIdentifier"] > a', "#Equipm_tabs").first();
            a.addClass("active");

			var li = $('[elem-identifier="TabbableIdentifier"]', "#Equipm_tabs").first();			
			var tabId = li.attr("data-tab");
			$("#" + tabId).addClass("active");			
		});
	</script>
