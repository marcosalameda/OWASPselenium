@model GenioMVC.ViewModels.Assma.Assma_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Assma";
	ViewBag.Title = @Resources.ASSET_MANUAL50119;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Assma", FormMethod.Post, new { enctype="multipart/form-data", @class = "form-horizontal", area="Assma", data_form="Assma" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Assma" area="Assma" data-form="Assma">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Assma_well" area="Assma" data-form="Assma">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

