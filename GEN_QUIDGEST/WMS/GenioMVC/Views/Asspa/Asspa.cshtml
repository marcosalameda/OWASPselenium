@model GenioMVC.ViewModels.Asspa.Asspa_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Asspa";
	ViewBag.Title = @Resources.ASSET_PARAMETER22072;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Asspa", FormMethod.Post, new { @class = "form-horizontal", area="Asspa", data_form="Asspa" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Asspa" area="Asspa" data-form="Asspa">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Asspa_well" area="Asspa" data-form="Asspa">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

