	window.Form_Asspa.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValToshow' field *@
		$(qForm).bind('VALDATATYPE_CHANGE VALTEXT_CHANGE VALQUANTITY_CHANGE VALDATE_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDatatype', $('[data-form="Asspa"]')))=="T", getFieldValue($(':not([elem-identifier="Multiform"]) > #ValText', $('[data-form="Asspa"]'))),qApi.iif( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDatatype', $('[data-form="Asspa"]')))=="N",qApi.NumericToString( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValQuantity', $('[data-form="Asspa"]'))),0),qApi.iif( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDatatype', $('[data-form="Asspa"]')))=="D",qApi.NumericToString(qApi.Year( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDate', $('[data-form="Asspa"]')))),0)+"-"+qApi.RIGHT("00"+qApi.NumericToString(qApi.Month( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDate', $('[data-form="Asspa"]')))),0),2)+"-"+qApi.RIGHT("00"+qApi.NumericToString(qApi.Day( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDate', $('[data-form="Asspa"]')))),0),2),""))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValToshow', $('[data-form="Asspa"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValToshow', $('[data-form="Asspa"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValToshow', $('[data-form="Asspa"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValToshow: ' + err.message, err.stack, window.location.href); }
		});
		





	</text>
}

