{
<div class="hidden" id="FormJavaScript_ATTAC" data-form-javascript="true">
@Html.Partial("Attac_JavaScript", Model, ViewData)
</div>
}

@section code_javascript
{
	@codeJavascript()
}

@if (Request.IsAjaxRequest())
{
    @codeJavascript()
    @includeStylesheets()
}

