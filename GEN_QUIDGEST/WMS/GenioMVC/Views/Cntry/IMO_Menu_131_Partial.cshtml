@model GenioMVC.ViewModels.Cntry.IMO_Menu_131_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Cntry;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Cntry>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: true)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodcntry, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_131_CNTRY_COUNTRY]/
		column.Expression(p => p.ValCountry).Title(@Resources.COUNTRY64133).Field("ValCountry").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_131_CNTRY_ACTIVE]/
		column.Expression(p => p.ValActive).Title(@Resources.ACTIVE03270).Field("ValActive").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_131_CNTRY_CODIGONR]/
		column.Expression(p => p.ValCodigonr).Title(@Resources.NUMERIC19292).Field("ValCodigonr").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_131_CNTRY_ALFA2]/
		column.Expression(p => p.ValAlfa2).Title(@Resources.ALPHABETIC_232435).Field("ValAlfa2").Size(2);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_131_CNTRY_ALFA3]/
		column.Expression(p => p.ValAlfa3).Title(@Resources.ALPHABETIC_316640).Field("ValAlfa3").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_131_CNTRY_FLAG]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValFlag, new {alt=@Resources.FLAG51937,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodcntry, modelname = "Cntry", fldname = "ValFlag" }))).Title(@Resources.FLAG51937).Field("ValFlag").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Cntry")
        .Id("IMO_Menu_131")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Proppais", false, true)
        .SetFollowUp("IMO_Menu_1311", "Propr" , (Func<GenioMVC.Models.Cntry, object>)(item => new { cntry = item.ValCodcntry }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qIMO_Menu_131, #IMO_Menu_131_complex_filter th input, #IMO_Menu_131_filters input").change(function() {
                    $("#pIMO_Menu_131").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#IMO_Menu_131_tableFilters').val(false);")
                    @Html.Raw("$('#IMO_Menu_131_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#IMO_Menu_131_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='IMO_Menu_131']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qIMO_Menu_131');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#IMO_Menu_131_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_IMO_Menu_131').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('IMO_Menu_131', 'PAIS', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS IMO_MENU_131]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS IMO_MENU_131]/
</script>