@model GenioMVC.ViewModels.Cntry.Pais_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Pais";
	ViewBag.Title = @Resources.COUNTRY64133;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Cntry", FormMethod.Post, new { @class = "form-horizontal", area="Cntry", data_form="Pais" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Pais" area="Cntry" data-form="Pais">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Pais_well" area="Cntry" data-form="Pais">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

