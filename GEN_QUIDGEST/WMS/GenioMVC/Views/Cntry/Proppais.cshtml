@model GenioMVC.ViewModels.Cntry.Proppais_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Proppais";
	ViewBag.Title = @Resources.COUNTRY64133;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Cntry", FormMethod.Post, new { @class = "form-horizontal", area="Cntry", data_form="Proppais" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Proppais" area="Cntry" data-form="Proppais">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Proppais_well" area="Cntry" data-form="Proppais">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

