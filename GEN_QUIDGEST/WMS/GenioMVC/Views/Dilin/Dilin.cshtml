	ViewBag.Title = @Resources.DISPATCH_LINE65326;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Dilin", FormMethod.Post, new { @class = "form-horizontal", area="Dilin", data_form="Dilin" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Dilin" area="Dilin" data-form="Dilin">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Dilin_well" area="Dilin" data-form="Dilin">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

