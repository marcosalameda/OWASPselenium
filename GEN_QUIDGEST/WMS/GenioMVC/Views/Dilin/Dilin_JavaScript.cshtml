{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValOutstand' field *@
		$(qForm).bind('VALORDERED_CHANGE VALDELIVERE_CHANGE', function(event, eTarget) {
				try {
						var newValue = ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValOrdered', $('[data-form="Dilin"]')))- getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDelivere', $('[data-form="Dilin"]'))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValOutstand', $('[data-form="Dilin"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValOutstand', $('[data-form="Dilin"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValOutstand', $('[data-form="Dilin"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValOutstand: ' + err.message, err.stack, window.location.href); }
		});
		





	</text>
}

