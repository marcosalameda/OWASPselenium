@model GenioMVC.ViewModels.Dispa.Dispa_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Dispa";
	ViewBag.Title = @Resources.DISPATCH46310;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Dispa", FormMethod.Post, new { @class = "form-horizontal", area="Dispa", data_form="Dispa" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Dispa" area="Dispa" data-form="Dispa">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Dispa_well" area="Dispa" data-form="Dispa">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

