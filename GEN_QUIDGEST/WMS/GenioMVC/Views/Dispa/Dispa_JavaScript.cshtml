@{
	<text>
		window.Form_Dispa.Data.RelationKeysSelector = {
				get entit() { return $(':not([elem-identifier="Multiform"]) > #ValCodentit[pers-cs-area="Entit"]', $('[data-form="Dispa"]')); /* DBEdit */ },
				get perso() { return $(':not([elem-identifier="Multiform"]) > #ValCodperso[pers-cs-area="Perso"]', $('[data-form="Dispa"]')); /* DBEdit */ },
		};

		window.Form_Dispa.getAllForeignKeySelectors = function () {
			@* Get all selectors of foreign keys present on the form *@
			return this.Data.RelationKeysSelector;
		};

		window.Form_Dispa.Data.RelationKeys = {
			get formContext() { return window.Form_Dispa; },
			get entit() { return (this.formContext.Data.RelationKeysSelector.entit.getQControl() || {}).Value; /* DBEdit */ },
			set entit(newValue) { (this.formContext.Data.RelationKeysSelector.entit.getQControl() || {}).Value = newValue; /* DBEdit */ },
			get perso() { return (this.formContext.Data.RelationKeysSelector.perso.getQControl() || {}).Value; /* DBEdit */ },
			set perso(newValue) { (this.formContext.Data.RelationKeysSelector.perso.getQControl() || {}).Value = newValue; /* DBEdit */ },
		};
	</text>
}

	window.Form_Dispa.QFormulas = function () {
		var qForm = $(this.element);
@if(Model.FormMode == FormMode.New || Model.FormMode == FormMode.Edit || Model.FormMode == FormMode.Duplicate)
{
		@*Edit mode Fields Formulas*@
	<text>

		@* Formula of the 'ValStatus' field *@
		$(qForm).bind('VALDISPADT_CHANGE VALPREPARED_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDispadt', $('[data-form="Dispa"]'))))==0,"D",qApi.iif(qApi.emptyD( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValPrepared', $('[data-form="Dispa"]'))))==0,"P","I")));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValStatus', $('[data-form="Dispa"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValStatus', $('[data-form="Dispa"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValStatus', $('[data-form="Dispa"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValStatus: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Default of the 'ValPrepared' field *@
		window.Form_Dispa.SetFormulaDefault('LED_DISPA___DISPAPREPARED', function() {
						return (qApi.iif(qApi.emptyL( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValIsprepar', $('[data-form="Dispa"]'))))==1,"__/__/____",qApi.Today()));
		}, 'VALISPREPAR_CHANGE');
		





	</text>
}

