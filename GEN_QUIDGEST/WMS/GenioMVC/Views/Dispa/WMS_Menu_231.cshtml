@model GenioMVC.ViewModels.Dispa.WMS_Menu_231_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Dispa.WMS_Menu_231_ViewModel modelWMS_Menu_231 = new GenioMVC.ViewModels.Dispa.WMS_Menu_231_ViewModel(Navigation);
	var columns = modelWMS_Menu_231.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "dispa" && areaField.Field == "dispadt")
		{
			fields.Add("DISPA.DISPADT", new TableFilterField("DISPA", "DISPADT", Resources.DISPATCH_DATE54413, "date"));
		}
		if (areaField.Area == "dispa" && areaField.Field == "dispanr")
		{
			fields.Add("DISPA.DISPANR", new TableFilterField("DISPA", "DISPANR", Resources.DISPATCH_NUMBER23616, "num", defaultSearch : true));
		}
		if (areaField.Area == "entit" && areaField.Field == "name")
		{
			fields.Add("ENTIT.NAME", new TableFilterField("ENTIT", "NAME", Resources.CUSTOMER51658, "text"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("WMS_Menu_231", "Dispa", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Dispa", data_form="WMS_Menu_231" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="WMS_Menu_231_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qWMS_Menu_231", Navigation.GetStrValue("qWMS_Menu_231"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('WMS_Menu_231');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('WMS_Menu_231');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.DISPATCH_NUMBER23616})
					<button id="qWMS_Menu_231-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("WMS_Menu_231", fields, "DISPA")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('WMS_Menu_231', 'DISPA', 'DISPA.DISPANR');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="WMS_Menu_231_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#WMS_Menu_231_complex_filter', 'WMS_Menu_231_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("WMS_Menu_231")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="WMS_Menu_231" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "WMS_Menu_231", idlistController = "Dispa", idlistArea = "Dispa", codlista ="9a0b0214-06bf-4759-baaf-3939c00d8f73" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("WMS_Menu_231_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "WMS_Menu_231" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_231 = new QMenuForm($('[data-form="WMS_Menu_231"]'), "Form_WMS_Menu_231");
		window.Form_WMS_Menu_231.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_231.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_231");
		RegisterClearEvents("WMS_Menu_231")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_231", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="WMS_Menu_231"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="WMS_Menu_231"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
