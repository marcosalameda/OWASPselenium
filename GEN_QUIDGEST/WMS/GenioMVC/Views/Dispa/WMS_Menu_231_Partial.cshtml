@model GenioMVC.ViewModels.Dispa.WMS_Menu_231_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Dispa;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Dispa>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCoddispa, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_231_DISPA_DISPADT]/
		column.Expression(p => p.ValDispadt).Title(@Resources.DISPATCH_DATE54413).Field("ValDispadt").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_231_DISPA_DISPANR]/
		column.Expression(p => p.ValDispanr).Title(@Resources.DISPATCH_NUMBER23616).Field("ValDispanr").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_231_ENTIT_NAME]/
		column.Expression(p => p.Entit.ValName).Title(@Resources.CUSTOMER51658).Field("Entit.ValName").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Dispa")
        .Id("WMS_Menu_231")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Dispa", false, false)
        .SetFollowUp("Dispa_Show", "Dispa" , (Func<GenioMVC.Models.Dispa, object>)(item => new { id = item.ValCoddispa }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qWMS_Menu_231, #WMS_Menu_231_complex_filter th input, #WMS_Menu_231_filters input").change(function() {
                    $("#pWMS_Menu_231").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#WMS_Menu_231_tableFilters').val(false);")
                    @Html.Raw("$('#WMS_Menu_231_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#WMS_Menu_231_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='WMS_Menu_231']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qWMS_Menu_231');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#WMS_Menu_231_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_WMS_Menu_231').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('WMS_Menu_231', 'DISPA', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS WMS_MENU_231]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS WMS_MENU_231]/
</script>