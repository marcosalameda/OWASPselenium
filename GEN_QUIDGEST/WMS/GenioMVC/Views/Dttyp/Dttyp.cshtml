@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Dttyp";
	ViewBag.Title = @Resources.DATA_TYPE47159;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Dttyp", FormMethod.Post, new { @class = "form-horizontal", area="Dttyp", data_form="Dttyp" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Dttyp" area="Dttyp" data-form="Dttyp">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Dttyp_well" area="Dttyp" data-form="Dttyp">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

