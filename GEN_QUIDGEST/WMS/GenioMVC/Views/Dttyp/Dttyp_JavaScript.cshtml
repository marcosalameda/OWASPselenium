		window.Form_Dttyp.OnPreValida = function (mode, target) {
			var deferred = $.Deferred();
			this.Controls.LED_DTTYP___DTTYPUPPERCAS.Value = (this.Controls.LED_DTTYP___DTTYPUPPERCAS.Value || '').toUpperCase();
			var onPreValidaCode = function () {
				var deferred = $.Deferred();
				var stopReturn = false;

// USE /[MANUAL GQT PREVALI DTTYP]/

				@*Return é obrigatorio to execução sincrona do código*@
				if (!stopReturn) deferred.resolve(true);
				return deferred.promise();
			};

			$.when(onPreValidaCode(), { deferred: deferred, mode: mode }).done(function (resManual, rData) {
				if (resManual) {
						rData.deferred.resolve(true);
				}
				else rData.deferred.resolve(false);
			});

			return deferred.promise();
		};

		window.Form_Dttyp.OnBeforeSave = function () {
			var stopReturn = false;
			var deferred = $.Deferred();
// USE /[MANUAL GQT BEFORE_SAVE_JS DTTYP]/
			@*Return é obrigatorio to execução sincrona do código*@
			if(!stopReturn) deferred.resolve(true);
			return deferred.promise();
		};

		window.Form_Dttyp.OnAfterSave = function (data) {
			var stopReturn = false;
			var deferred = $.Deferred();
// USE /[MANUAL GQT AFTER_SAVE_JS DTTYP]/
			@*Return é obrigatorio to execução sincrona do código*@
			if(!stopReturn) deferred.resolve(true);
			return deferred.promise();
		};
	</text>
