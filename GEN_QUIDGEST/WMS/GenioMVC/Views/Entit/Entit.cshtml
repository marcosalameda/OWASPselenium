@model GenioMVC.ViewModels.Entit.Entit_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Entit";
	ViewBag.Title = @Resources.ENTITY62049;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Entit", FormMethod.Post, new { @class = "form-horizontal", area="Entit", data_form="Entit" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Entit" area="Entit" data-form="Entit">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Entit_well" area="Entit" data-form="Entit">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

