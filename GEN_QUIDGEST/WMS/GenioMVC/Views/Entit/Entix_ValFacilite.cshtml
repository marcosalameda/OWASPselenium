@model GenioMVC.ViewModels.Entit.Entix_ValFacilite_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_ENTIX___PSEUDFACILITE" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.FACILITIES08876</h2 list-header> </label></div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR ENTIX_FACILITE]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Facil;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Facil>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodfacil, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACIL_INCORPOR]/
		column.Expression(p => p.ValIncorpor).Title(@Resources.INCORPORATION10135).Field("ValIncorpor").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACIL_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.FACILITY_NAME19514).Field("ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACTY_TYPE]/
		column.Expression(p => p.Facty.ValType).Title(@Resources.FACILITY_TYPE44577).Field("Facty.ValType").Size(25);
// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACIL_LATITUDE]/
		column.Expression(p => p.ValLatitude).Title(@Resources.LATITUDE11291).Field("ValLatitude").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACIL_LONGITUD]/
		column.Expression(p => p.ValLongitud).Title(@Resources.LONGITUDE01015).Field("ValLongitud").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACIL_GEOCOORD]/
		column.Expression(p => p.ValGeocoord).Title(@Resources.GEOGRAPHICAL_COORDIN45869).Field("ValGeocoord").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN ENTIX_FACILITE_FACIL_IMAGE]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValImage, new {alt=@Resources.IMAGE65174,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodfacil, modelname = "Facil", fldname = "ValImage" }))).Title(@Resources.IMAGE65174).Field("ValImage").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Facil")
        .Id("ValFacilite")
        .AjaxRequest("Entix_ValFacilite")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Entix_ValFacilite", new { id = Model.ValCodentit, partialView = "Entix_ValFacilite"}))
        .Form("Facilfex", false, false)
        .UpdateConditions((item)=>Facilfex_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Facilfex_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Facilfex_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Facilfex_ViewModel.InsertConditions(this.Model.Navigation))
        .SetFollowUp("Facilfex_Show", "Facil" , (Func<GenioMVC.Models.Facil, object>)(item => new { id = item.ValCodfacil }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


