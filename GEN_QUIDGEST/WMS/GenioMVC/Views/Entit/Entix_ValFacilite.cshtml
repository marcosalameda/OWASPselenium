                    @:      $('#ValFacilite_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValFacilite_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValFacilite').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
