<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_5511 = new QMenuForm($('[data-form="WMS_Menu_5511"]'), "Form_WMS_Menu_5511");
		window.Form_WMS_Menu_5511.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_5511.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_5511");
		RegisterClearEvents("WMS_Menu_5511")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_5511", JSON.parse(SearchFilters.value))
	});
</script>

