@model GenioMVC.ViewModels.Facil.Facil_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Facil";
	ViewBag.Title = @Resources.FACILITY55206;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Facil", FormMethod.Post, new { @class = "form-horizontal", area="Facil", data_form="Facil" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Facil" area="Facil" data-form="Facil">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Facil_well" area="Facil" data-form="Facil">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

