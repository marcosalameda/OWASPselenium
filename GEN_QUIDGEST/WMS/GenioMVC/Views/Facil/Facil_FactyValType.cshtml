@model GenioMVC.ViewModels.Facil.Facil_FactyValType_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.FACILITY_TYPES57319</h2>
        </div>
        <div class="col-auto normal-view" id="Facil_FactyValType_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qFacil_FactyValType", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Facil_FactyValType.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Facil_FactyValType_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Facil_FactyValType_complex_filter', 'Facil_FactyValType_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="normal-view">
@{
    var data = Html.newTableFor<GenioMVC.Models.Facty>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
