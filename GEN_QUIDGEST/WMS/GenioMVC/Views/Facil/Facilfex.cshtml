@model GenioMVC.ViewModels.Facil.Facilfex_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Facilfex";
	ViewBag.Title = @Resources.FACILITY55206;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Facil", FormMethod.Post, new { @class = "form-horizontal", area="Facil", data_form="Facilfex" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Facilfex" area="Facil" data-form="Facilfex">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Facilfex_well" area="Facil" data-form="Facilfex">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

