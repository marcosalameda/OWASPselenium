@model GenioMVC.ViewModels.Facil.WMS_Menu_4211_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Facil.WMS_Menu_4211_ViewModel modelWMS_Menu_4211 = new GenioMVC.ViewModels.Facil.WMS_Menu_4211_ViewModel(Navigation);
	var columns = modelWMS_Menu_4211.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrFaciltyp = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayFaciltyp.GetDictionary())
	{
		arrFaciltyp.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}
	Dictionary<string, string> arrGpsinput = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayGpsinput.GetDictionary())
	{
		arrGpsinput.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "entit" && areaField.Field == "name")
		{
			fields.Add("ENTIT.NAME", new TableFilterField("ENTIT", "NAME", Resources.LEGAL_NAME42902, "text"));
		}
		if (areaField.Area == "facil" && areaField.Field == "incorpor")
		{
			fields.Add("FACIL.INCORPOR", new TableFilterField("FACIL", "INCORPOR", Resources.INCORPORATION10135, "date"));
		}
		if (areaField.Area == "facil" && areaField.Field == "name")
		{
			fields.Add("FACIL.NAME", new TableFilterField("FACIL", "NAME", Resources.FACILITY_NAME19514, "text", defaultSearch : true));
		}
		if (areaField.Area == "facil" && areaField.Field == "faciltyp")
		{
			fields.Add("FACIL.FACILTYP", new TableFilterField("FACIL", "FACILTYP", Resources.FACILITY_TYPE44577, "enum", array : arrFaciltyp));
		}
		if (areaField.Area == "facty" && areaField.Field == "type")
		{
			fields.Add("FACTY.TYPE", new TableFilterField("FACTY", "TYPE", Resources.FACILITY_TYPE44577, "text"));
		}
		if (areaField.Area == "facil" && areaField.Field == "address")
		{
			fields.Add("FACIL.ADDRESS", new TableFilterField("FACIL", "ADDRESS", Resources.ADDRESS04342, "text"));
		}
		if (areaField.Area == "facil" && areaField.Field == "gpsinput")
		{
			fields.Add("FACIL.GPSINPUT", new TableFilterField("FACIL", "GPSINPUT", Resources.GPS_INPUT13625, "enum", array : arrGpsinput));
		}
		if (areaField.Area == "facil" && areaField.Field == "latitude")
		{
			fields.Add("FACIL.LATITUDE", new TableFilterField("FACIL", "LATITUDE", Resources.LATITUDE11291, "num"));
		}
		if (areaField.Area == "facil" && areaField.Field == "longitud")
		{
			fields.Add("FACIL.LONGITUD", new TableFilterField("FACIL", "LONGITUD", Resources.LONGITUDE01015, "num"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("WMS_Menu_4211", "Facil", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Facil", data_form="WMS_Menu_4211" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="WMS_Menu_4211_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qWMS_Menu_4211", Navigation.GetStrValue("qWMS_Menu_4211"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('WMS_Menu_4211');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('WMS_Menu_4211');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.FACILITY_NAME19514})
					<button id="qWMS_Menu_4211-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("WMS_Menu_4211", fields, "FACIL")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('WMS_Menu_4211', 'FACIL', 'FACIL.NAME');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="WMS_Menu_4211_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#WMS_Menu_4211_complex_filter', 'WMS_Menu_4211_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("WMS_Menu_4211")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="WMS_Menu_4211" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "WMS_Menu_4211", idlistController = "Facil", idlistArea = "Facil", codlista ="24c039d6-a804-4041-8cef-ca842275cf78" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("WMS_Menu_4211_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "WMS_Menu_4211" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_4211 = new QMenuForm($('[data-form="WMS_Menu_4211"]'), "Form_WMS_Menu_4211");
		window.Form_WMS_Menu_4211.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_4211.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_4211");
		RegisterClearEvents("WMS_Menu_4211")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_4211", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="WMS_Menu_4211"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="WMS_Menu_4211"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
