		column.Expression(p => p.ValAddress).Title(@Resources.ADDRESS04342).Field("ValAddress").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_IMAGE]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValImage, new {alt=@Resources.IMAGE65174,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodfacil, modelname = "Facil", fldname = "ValImage" }))).Title(@Resources.IMAGE65174).Field("ValImage").Size(3);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_GPSINPUT]/
		column.Expression(p => p.ArrayValgpsinput).Title(@Resources.GPS_INPUT13625).Hidden().Field("ValGpsinput", "ArrayGpsinput").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_LATITUDE]/
		column.Expression(p => p.ValLatitude).Title(@Resources.LATITUDE11291).Hidden().Field("ValLatitude").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_LONGITUD]/
		column.Expression(p => p.ValLongitud).Title(@Resources.LONGITUDE01015).Hidden().Field("ValLongitud").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_GEOCOORI]/
		column.Expression(p => p.ValGeocoori).Title(@Resources.GEOGRAPHICAL_COORDIN45869).Hidden().Field("ValGeocoori").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_GEOCOORD]/
		column.Expression(p => p.ValGeocoord).Title(@Resources.GEOGRAPHICAL_COORDIN45869).Field("ValGeocoord").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Facil")
        .Id("WMS_Menu_4211")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Facil", false, false)
        .UpdateConditions((item)=>Facil_ViewModel.UpdateConditions(item))
        .ViewConditions((item)=>Facil_ViewModel.ViewConditions(item))
        .DeleteConditions((item)=>Facil_ViewModel.DeleteConditions(item))
        .InsertConditions((item)=>Facil_ViewModel.InsertConditions(this.Model.Navigation))
        .SetFollowUp("Facil_Show", "Facil" , (Func<GenioMVC.Models.Facil, object>)(item => new { id = item.ValCodfacil }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qWMS_Menu_4211, #WMS_Menu_4211_complex_filter th input, #WMS_Menu_4211_filters input").change(function() {
                    $("#pWMS_Menu_4211").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#WMS_Menu_4211_tableFilters').val(false);")
