// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_INCORPOR]/
		column.Expression(p => p.ValIncorpor).Title(@Resources.INCORPORATION10135).Field("ValIncorpor").Size(8).Format("{0:d}");
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.FACILITY_NAME19514).Field("ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACIL_FACILTYP]/
		column.Expression(p => p.ArrayValfaciltyp).Title(@Resources.FACILITY_TYPE44577).Hidden().Field("ValFaciltyp", "ArrayFaciltyp").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4211_FACTY_TYPE]/
		column.Expression(p => p.Facty.ValType).Title(@Resources.FACILITY_TYPE44577).Field("Facty.ValType").Size(25);
