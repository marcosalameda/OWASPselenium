@model GenioMVC.ViewModels.Facty.Facty_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Facty";
	ViewBag.Title = @Resources.FACILITY_TYPE44577;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Facty", FormMethod.Post, new { @class = "form-horizontal", area="Facty", data_form="Facty" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Facty" area="Facty" data-form="Facty">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Facty_well" area="Facty" data-form="Facty">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

