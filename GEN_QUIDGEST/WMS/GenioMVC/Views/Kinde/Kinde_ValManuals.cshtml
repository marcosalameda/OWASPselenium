@model GenioMVC.ViewModels.Kinde.Kinde_ValManuals_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_KINDE___PSEUDMANUALS_" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.MANUALS14730</h2 list-header> </label></div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR KINDE_MANUALS]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Manua;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Manua>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodmanua, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN KINDE_MANUALS_MANUA_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.MANUAL_NAME60077).Field("ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN KINDE_MANUALS_MANUA_DIGDOCUM]/
		column.Expression(p => p.ValDigdocum).Title(@Resources.DIGITAL_DOCUMENT59580).Field("ValDigdocum").Size(30).Document(p => Url.Action("GetFile", "Manua", new { ticket = p.GetTicketForDocField("ValDigdocum"), viewType = (int)CSGenio.framework.DocumentViewTypeMode.Print}));
// USE /[MANUAL GQT CUSTOM_COLUMN KINDE_MANUALS_MANUA_NOTES]/
		column.Expression(p => p.ValNotes).Title(@Resources.NOTES05274).Field("ValNotes").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Manua")
        .Id("ValManuals")
        .AjaxRequest("Kinde_ValManuals")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Kinde_ValManuals", new { id = Model.ValCodkinde, partialView = "Kinde_ValManuals"}))
        .Form("Manua", false, false)
        .SetFollowUp("Manua_Show", "Manua" , (Func<GenioMVC.Models.Manua, object>)(item => new { id = item.ValCodmanua }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValManuals, #ValManuals_complex_filter th input, #ValManuals_filters input").change(function() {
                    $("#pValManuals").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValManuals_tableFilters').val(false);")
                    @Html.Raw("$('#ValManuals_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValManuals_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValManuals_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValManuals_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValManuals').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValManuals']"));
                    InitSpecialControls($('#ValManuals'));
                    $('#ValManuals').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS KINDE_VALMANUALS]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>