@* USE /[MANUAL GQT TABLE_FOR KINDE_PARAMETE]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Param;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Param>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodparam, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN KINDE_PARAMETE_PARAM_PARAMETE]/
		column.Expression(p => p.ValParameter).Title(@Resources.PARAMETER41976).Field("ValParameter").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN KINDE_PARAMETE_PARAM_DATATYPE]/
		column.Expression(p => p.ArrayValdatatype).Title(@Resources.DATA_TYPE47159).Field("ValDatatype", "ArrayDatatype").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN KINDE_PARAMETE_PARAM_DECPLACE]/
		column.Expression(p => p.ArrayValdecimalplaces).Title(@Resources.DECIMAL_PLACES62575).Field("ValDecimalplaces", "ArrayDecplace").Size(2);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Param")
        .Id("ValParamete")
        .AjaxRequest("Kinde_ValParamete")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Kinde_ValParamete", new { id = Model.ValCodkinde, partialView = "Kinde_ValParamete"}))
        .Form("Param", false, false)
        .SetFollowUp("Param_Show", "Param" , (Func<GenioMVC.Models.Param, object>)(item => new { id = item.ValCodparam }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


