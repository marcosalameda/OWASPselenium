@model GenioMVC.ViewModels.Lcext.Lcext_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Lcext";
	ViewBag.Title = @Resources.LOCATION_EXTENSION_C10932;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Lcext", FormMethod.Post, new { @class = "form-horizontal", area="Lcext", data_form="Lcext" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Lcext" area="Lcext" data-form="Lcext">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Lcext_well" area="Lcext" data-form="Lcext">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

