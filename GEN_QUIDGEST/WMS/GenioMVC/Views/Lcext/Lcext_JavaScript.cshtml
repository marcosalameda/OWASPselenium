    $($('[elem-identifier="FormActions"]'), $('[data-form="Lcext"]')).click(function(event){
        var form = $(this).closest('[data-form]').data('form');
        var curLocalStorage = QLocalStorage.getLocalStorage('lastActiveElement');
        delete curLocalStorage[form];
        QLocalStorage.setLocalStorage('lastActiveElement', curLocalStorage);
