@model GenioMVC.ViewModels.Locat.Locat_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Locat";
	ViewBag.Title = @Resources.LOCATION54790;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Locat", FormMethod.Post, new { @class = "form-horizontal", area="Locat", data_form="Locat" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Locat" area="Locat" data-form="Locat">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Locat_well" area="Locat" data-form="Locat">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

