@model GenioMVC.ViewModels.Locat.Locat_ValLocalext_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_LOCAT___PSEUDLOCALEXT" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.LOCATION_EXTENSION_C33560</h2 list-header> </label></div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR LOCAT_LOCALEXT]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Lcext;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Lcext>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodlcext, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN LOCAT_LOCALEXT_LCEXT_GLNEXT]/
		column.Expression(p => p.ValGlnext).Title(@Resources.GLN_EXTENSION_COMPON55869).Field("ValGlnext").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN LOCAT_LOCALEXT_LCEXT_SPACETYP]/
		column.Expression(p => p.ArrayValspacetyp).Title(@Resources.SPACE_TYPE42493).Field("ValSpacetyp", "ArraySpacetyp").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN LOCAT_LOCALEXT_LCEXT_SPACEOBS]/
		column.Expression(p => p.ValSpaceobs).Title(@Resources.SPACE62433).Field("ValSpaceobs").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Lcext")
        .Id("ValLocalext")
        .AjaxRequest("Locat_ValLocalext")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Locat_ValLocalext", new { id = Model.ValCodlocat, partialView = "Locat_ValLocalext"}))
        .Form("Lcext", false, false)
        .SetFollowUp("Lcext_Show", "Lcext" , (Func<GenioMVC.Models.Lcext, object>)(item => new { id = item.ValCodlcext }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValLocalext, #ValLocalext_complex_filter th input, #ValLocalext_filters input").change(function() {
                    $("#pValLocalext").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValLocalext_tableFilters').val(false);")
                    @Html.Raw("$('#ValLocalext_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValLocalext_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValLocalext_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValLocalext_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValLocalext').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValLocalext']"));
                    InitSpecialControls($('#ValLocalext'));
                    $('#ValLocalext').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS LOCAT_VALLOCALEXT]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>