@model GenioMVC.ViewModels.Locat.WMS_Menu_4251_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Locat;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Locat>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodlocat, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4251_ENTIT_NAME]/
		column.Expression(p => p.Entit.ValName).Title(@Resources.LEGAL_NAME42902).Field("Entit.ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4251_FACIL_NAME]/
		column.Expression(p => p.Facil.ValName).Title(@Resources.FACILITY_NAME19514).Field("Facil.ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_4251_LOCAT_GLN]/
		column.Expression(p => p.ValGln).Title(@Resources.GLOBAL_LOCATION_NUMB24637).Field("ValGln").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Locat")
        .Id("WMS_Menu_4251")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Locat", false, false)
        .SetFollowUp("Locat_Show", "Locat" , (Func<GenioMVC.Models.Locat, object>)(item => new { id = item.ValCodlocat }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qWMS_Menu_4251, #WMS_Menu_4251_complex_filter th input, #WMS_Menu_4251_filters input").change(function() {
                    $("#pWMS_Menu_4251").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#WMS_Menu_4251_tableFilters').val(false);")
                    @Html.Raw("$('#WMS_Menu_4251_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#WMS_Menu_4251_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='WMS_Menu_4251']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qWMS_Menu_4251');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#WMS_Menu_4251_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_WMS_Menu_4251').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('WMS_Menu_4251', 'LOCAT', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS WMS_MENU_4251]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS WMS_MENU_4251]/
</script>