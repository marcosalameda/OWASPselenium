@helper form_content_alert() {
	if(Model.FormMode == FormMode.Delete) {
		<div class="c-alert c-alert--warning">
			<i class="glyphicons glyphicons-alert c-alert__icon" aria-hidden="true"></i>
			<div class="c-alert__text">
				&ensp;@Resources.DESEJA_ELIMINAR_ESTA24564
			</div>
		<!--Ao confirmar esta ficha irá ser eliminada da base de dados. Cancele caso não tenha a certeza.-->
		</div>
	}
}

@helper form_content_buttons() {




    @* Extended support form *@
    if (Model.NestedForm)
    {
        if (Model.IsEditableMode)
        {
            <button type="button" data-end-pers="true" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick='javascript:submitNestedForm("@Url.Action(Helpers.FormModeActionName("Manua", Model.FormMode).ToString(), "Manua")", "Manua_well")' qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>
                    @Resources.GRAVAR45301
            </button>
            <button type="button" data-end-pers="true" class="b-icon-text b-icon-text--secondary" onclick='javascript:submitNestedForm("@Url.Action("Manua_Delete", "Manua", new {id = @Model.ValCodmanua} )", "Manua_well")' qbutton="delete">
                <i class="glyphicons glyphicons-bin e-icon"></i>
                @Resources.APAGAR04097
            </button>

            <script type="application/javascript">
                $(document).ready(function () { loaded($("#Manua_well")); });
            </script>
        }

        @* javascript code_javascript *@
        @*@codeJavascript()*@
    }
    @* Normal mode *@
    else
    {
        if (Model.IsEditableMode || Model.FormMode == FormMode.Delete)
        {
            if (Model.FormMode == FormMode.New && Convert.ToBoolean(Model.Navigation.CurrentLevel.GetEntry("repeatInsertion")))
            {
            <button type="button" data-end-pers="true" name="Manua_repete_insertion" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitManua(event, true)" qbutton="ok_new">@Resources.GRAVAR_E_CRIAR_NOVA17771</button>
            }
            if(Model.FormMode == FormMode.Delete)
            {
				<button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Manua", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitDeleteManua(event)" qbutton="delete">
                    <i class="glyphicons glyphicons-check e-icon" aria-hidden="true"></i>@Resources.CONFIRMAR09808
                </button>
            }
            else
            {
                <button type="submit" data-end-pers="true" name="@(Helpers.FormModeActionName("Manua", Model.FormMode))" elem-identifier="ButtonPrimary" class="b-icon-text b-icon-text--primary" onclick="javascript:submitManua(event)" title="@Resources.GRAVAR45301" data-selector="true" qbutton="ok">
                    <i class="SaveIcon e-icon" aria-hidden="true"></i>@Resources.GRAVAR45301
                </button>
            }

            <button type="button" class="b-icon-text b-icon-text--secondary" data-end-pers="true" data-href="@Url.Action("Manua_Cancel", "Manua", new { niv = Model.Navigation.CurrentLevel.Level })" onclick="javascript:window.Form_Manua.Cancel()" title="@Resources.CANCEL65428" data-selector="true" qbutton="cancel">
                <i class="glyphicons glyphicons-ban-circle e-icon" aria-hidden="true"></i>@Resources.CANCEL65428
            </button>
        }
        else if (!(ViewBag.isHomePage ?? false))
        {
            @Html.ActionLinkWithIcon(@Resources.RETROCEDER16633, "Manua_Cancel","Manua","glyphicons glyphicons-arrow-left e-icon", null, new { @class = "b-icon-text b-icon-text--secondary", @data_end_pers = "true", @title = @Resources.RETROCEDER16633, qbutton = "cancel" })
        }
    }
}

@helper LoadDefault() {
    if (Model.NestedForm)
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div class="c-card__header">
                    <div class="c-card__header-tag">
						<span class="form-header" style="padding:0;">
							<i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
						</span>
                    </div>
                </div>
                <div class="c-card__body">
                    @form_content_body()
                    <div elem-identifier="FormActions" class="form-actions" data-form-actions="Manua">
                        @form_content_buttons()
                    </div>
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <fieldset>
			<legend class="hidden-elem">@ViewBag.Title</legend>
            <div class="@ViewBag.ClassForFormLayout">
                <div id="c-stickyHeader">
                    <div class="c-action-bar d-flex">
                        <span class="form-header">
                            <i class="icon- ViewMode-@ViewBag.formmode"></i><h1>@ViewBag.Title</h1>
                        </span>
                        <div data-parent-form="Manua" data-q-ref="form-btns-main_container"></div>
                    </div>
                </div>

                @form_content_body()
                <div elem-identifier="FormActions" class="form-actions" data-form-actions="Manua">
                @form_content_buttons()
                </div>
            </div>
        </fieldset>
    }
}

