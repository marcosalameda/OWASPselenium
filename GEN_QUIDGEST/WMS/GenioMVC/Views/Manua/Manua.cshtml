@model GenioMVC.ViewModels.Manua.Manua_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Manua";
	ViewBag.Title = @Resources.MANUAL_TO_COLLECT13417;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Manua", FormMethod.Post, new { enctype="multipart/form-data", @class = "form-horizontal", area="Manua", data_form="Manua" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Manua" area="Manua" data-form="Manua">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Manua_well" area="Manua" data-form="Manua">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

