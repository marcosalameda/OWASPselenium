@model GenioMVC.ViewModels.Messa.Messa_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Messa";
	ViewBag.Title = @Resources.MESSAGE30602;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Messa", FormMethod.Post, new { @class = "form-horizontal", area="Messa", data_form="Messa" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Messa" area="Messa" data-form="Messa">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Messa_well" area="Messa" data-form="Messa">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

