@model GenioMVC.ViewModels.Messa.WMS_Menu_611_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Messa.WMS_Menu_611_ViewModel modelWMS_Menu_611 = new GenioMVC.ViewModels.Messa.WMS_Menu_611_ViewModel(Navigation);
	var columns = modelWMS_Menu_611.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "messa" && areaField.Field == "idnotif")
		{
			fields.Add("MESSA.IDNOTIF", new TableFilterField("MESSA", "IDNOTIF", Resources.NOTIFICATION_ID25507, "text", defaultSearch : true));
		}
		if (areaField.Area == "messa" && areaField.Field == "idmsg")
		{
			fields.Add("MESSA.IDMSG", new TableFilterField("MESSA", "IDMSG", Resources.MESSAGE_ID37133, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "designat")
		{
			fields.Add("MESSA.DESIGNAT", new TableFilterField("MESSA", "DESIGNAT", Resources.TO_WHOM_THE_MESSAGE_02337, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "email")
		{
			fields.Add("MESSA.EMAIL", new TableFilterField("MESSA", "EMAIL", Resources.E_MAIL_TO_WHOM_THE_M37668, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "message")
		{
			fields.Add("MESSA.MESSAGE", new TableFilterField("MESSA", "MESSAGE", Resources.MESSAGE30602, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "mailsent")
		{
			fields.Add("MESSA.MAILSENT", new TableFilterField("MESSA", "MAILSENT", Resources.E_MAIL_SENT_60490, "bool"));
		}
		if (areaField.Area == "messa" && areaField.Field == "mailerr")
		{
			fields.Add("MESSA.MAILERR", new TableFilterField("MESSA", "MAILERR", Resources.ERROR_SENDING_MAIL44674, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "creatope")
		{
			fields.Add("MESSA.CREATOPE", new TableFilterField("MESSA", "CREATOPE", Resources.CREATED_BY12292, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "creatdat")
		{
			fields.Add("MESSA.CREATDAT", new TableFilterField("MESSA", "CREATDAT", Resources.CREATED_ON00051, "date"));
		}
		if (areaField.Area == "entit" && areaField.Field == "name")
		{
			fields.Add("ENTIT.NAME", new TableFilterField("ENTIT", "NAME", Resources.LEGAL_NAME42902, "text"));
		}
		if (areaField.Area == "perso" && areaField.Field == "name")
		{
			fields.Add("PERSO.NAME", new TableFilterField("PERSO", "NAME", Resources.PERSON_NAME40980, "text"));
		}
		if (areaField.Area == "messa" && areaField.Field == "docum_nr")
		{
			fields.Add("MESSA.DOCUM_NR", new TableFilterField("MESSA", "DOCUM_NR", Resources.DOCUMENT_NUMBER28451, "num"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("WMS_Menu_611", "Messa", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Messa", data_form="WMS_Menu_611" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="WMS_Menu_611_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qWMS_Menu_611", Navigation.GetStrValue("qWMS_Menu_611"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('WMS_Menu_611');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('WMS_Menu_611');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.NOTIFICATION_ID25507})
					<button id="qWMS_Menu_611-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("WMS_Menu_611", fields, "MESSA")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('WMS_Menu_611', 'MESSA', 'MESSA.IDNOTIF');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="WMS_Menu_611_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#WMS_Menu_611_complex_filter', 'WMS_Menu_611_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("WMS_Menu_611")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="WMS_Menu_611" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "WMS_Menu_611", idlistController = "Messa", idlistArea = "Messa", codlista ="c907abb5-c7f3-4623-8cf5-4701f233e6cb" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("WMS_Menu_611_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "WMS_Menu_611" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_611 = new QMenuForm($('[data-form="WMS_Menu_611"]'), "Form_WMS_Menu_611");
		window.Form_WMS_Menu_611.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_611.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_611");
		RegisterClearEvents("WMS_Menu_611")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_611", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="WMS_Menu_611"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="WMS_Menu_611"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
