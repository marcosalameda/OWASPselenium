			</div>




			@Html.HiddenFor(model => model.ValCodparam, new { @pers_cs_field="ValCodparam", @pers_cs_area="Param", data_refresh = "true", @form_area="true", @data_value = Model.ValCodparam, @data_identifier = "LED_PARAM___PARAMCODPARAM" })

            @Html.Hidden("IgnoreWarnings", "false", new { id = "IgnoreWarnings" })

			@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "Param" })
            @Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId, new { data_interface_id = "Param" })
            @Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock(), new { data_interface_id = "Param" })
