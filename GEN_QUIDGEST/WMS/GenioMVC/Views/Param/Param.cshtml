								<div class="d-flex">
								@Html.LabelFor(model => model.ValDecimalplaces, new { label_id="LED_PARAM___PARAMDECPLACE", @class = " i-text__label", id="LABEL_LED_PARAM___PARAMDECPLACE"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_PARAM___PARAMDECPLACE','Decplace')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.ArrayDropDownListFor(model => model.ValDecimalplaces, Model.List_ValDecimalplaces, CSGenio.business.ArrayDecplace.GetElement, "", new {help_id = "LED_PARAM___PARAMDECPLACE", @class = "i-select chosen-dropdown input-small", data_identifier = "LED_PARAM___PARAMDECPLACE", @pers_cs_area = "Param", @pers_cs_field = "ValDecimalplaces", @db_field = "ValDecimalplaces", title = @Resources.DECIMAL_PLACES62575, data_array_type = "AN", data_placeholder = @Resources.ESCOLHA___40245, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_value = Model.List_ValDecimalplaces.SelectedValue, data_is_array = "true" })
