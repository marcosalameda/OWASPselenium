								@Html.ValidationMessageFor(model => model.TableKindeDesignat)
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="control-row-group">
						<div class="control-join-group">
						<div class="i-text draggable " id="CONTAINER_LED_PARAM___PARAMPARAMETE">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValParameter, new { label_id="LED_PARAM___PARAMPARAMETE", @class = " i-text__label", id="LABEL_LED_PARAM___PARAMPARAMETE"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_PARAM___PARAMPARAMETE','')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.TextBoxFor(model => model.ValParameter, new {help_id = "LED_PARAM___PARAMPARAMETE", @class = "i-text__field i-text input-xlarge", data_identifier = "LED_PARAM___PARAMPARAMETE", @pers_cs_area = "Param", @pers_cs_field = "ValParameter", @db_field = "ValParameter", title = @Resources.PARAMETER41976, maxlength = "50", rows = "50" })
								@Html.ValidationMessageFor(model => model.ValParameter)
							</div>
						</div>
						<div class="control-join-group">
						<div class="i-dbedit draggable " id="CONTAINER_LED_PARAM___PARAMDATATYPE">
								<div class="d-flex">
								@Html.LabelFor(model => model.ValDatatype, new { label_id="LED_PARAM___PARAMDATATYPE", @class = " i-text__label", id="LABEL_LED_PARAM___PARAMDATATYPE"}, true, false)
								<span class="glyphicons glyphicons-stats e-icon--reporting d-none report-mode"></span>
								<a href="javascript:OpenSuggestion('LED_PARAM___PARAMDATATYPE','Datatype')" class="suggest suggest--hidden"><span class="glyphicons glyphicons-edit"></span><span class="hidden-elem">@Resources.SUGESTOES44000</span></a></div>
								@Html.ArrayDropDownListFor(model => model.ValDatatype, Model.List_ValDatatype, CSGenio.business.ArrayDatatype.GetElement, "", new {help_id = "LED_PARAM___PARAMDATATYPE", @class = "i-select chosen-dropdown input-small", data_identifier = "LED_PARAM___PARAMDATATYPE", @pers_cs_area = "Param", @pers_cs_field = "ValDatatype", @db_field = "ValDatatype", title = @Resources.DATA_TYPE47159, data_array_type = "AC", data_placeholder = @Resources.ESCOLHA___40245, data_no_results_text = @Resources.NAO_HA_RESULTADOS_PA53055, data_value = Model.List_ValDatatype.SelectedValue, data_is_array = "true" })
