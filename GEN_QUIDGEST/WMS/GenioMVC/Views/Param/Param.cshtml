@model GenioMVC.ViewModels.Param.Param_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Param";
	ViewBag.Title = @Resources.PARAMETER41976;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Param", FormMethod.Post, new { @class = "form-horizontal", area="Param", data_form="Param" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Param" area="Param" data-form="Param">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Param_well" area="Param" data-form="Param">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

