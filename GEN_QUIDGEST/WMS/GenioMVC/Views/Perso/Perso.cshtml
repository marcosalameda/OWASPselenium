@model GenioMVC.ViewModels.Perso.Perso_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Perso";
	ViewBag.Title = @Resources.PERSON10446;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Perso", FormMethod.Post, new { @class = "form-horizontal", area="Perso", data_form="Perso" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Perso" area="Perso" data-form="Perso">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Perso_well" area="Perso" data-form="Perso">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

