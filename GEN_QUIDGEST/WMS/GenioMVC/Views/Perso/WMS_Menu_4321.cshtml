@{
    ViewBag.Title = @Resources.SELECIONE_UMA_OPCAO51988;
}

<h2 class="table-title c-table__title">@ViewBag.Title</h2>

<table class="c-table table-resizable">
    <thead class="c-table__head">
        <tr>  
            <th>@Resources.GENDER44172</th>
            <th></th>
        </tr>
    </thead>
    <tbody class="c-table__body">
    @foreach (var item in Model.List_ValGender) {
