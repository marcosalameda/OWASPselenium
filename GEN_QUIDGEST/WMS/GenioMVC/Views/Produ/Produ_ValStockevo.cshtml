@model GenioMVC.ViewModels.Produ.Produ_ValStockevo_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@using Newtonsoft.Json;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@*List properties DBEDIT BUTTONS*@
<div class="row">
	<div class="col">
		<div elem-identifier="List"  help-id="IFF_PRODU___PSEUDSTOCKEVO" style="padding-top: 0.5rem;"><label class = "i-text__label table-title c-table__title" > <h2 list-header>@Resources.STOCK_EVOLUTION61800</h2 list-header> </label></div>
	</div>
</div>

@* USE /[MANUAL GQT TABLE_FOR PRODU_STOCKEVO]/ *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Stock>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodstock, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN PRODU_STOCKEVO_STOCK_SEQUENCE]/
		column.Expression(p => p.ValSequence).Title(@Resources.SEQUENCE42310).Field("ValSequence").Size(6);
// USE /[MANUAL GQT CUSTOM_COLUMN PRODU_STOCKEVO_STOCK_DATE]/
		column.Expression(p => p.ValDate).Title(@Resources.DATE18475).Field("ValDate").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN PRODU_STOCKEVO_STOCK_TYPE]/
		column.Expression(p => p.ValType).Title(@Resources.TYPE00312).Field("ValType").Size(8);
// USE /[MANUAL GQT CUSTOM_COLUMN PRODU_STOCKEVO_STOCK_REFERENC]/
		column.Expression(p => p.ValReferenc).Title(@Resources.REFERENCE28402).Field("ValReferenc").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN PRODU_STOCKEVO_STOCK_QUANTITY]/
		column.Expression(p => p.ValQuantity).Title(@Resources.QUANTITY06415).Field("ValQuantity").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN PRODU_STOCKEVO_STOCK_BALANCE]/
		column.Expression(p => p.ValBalance).Title(@Resources.BALANCE13297).Field("ValBalance").Size(10);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Stock")
        .Id("ValStockevo")
        .AjaxRequest("Produ_ValStockevo")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: false)
        .RequestLink(@Url.Action("Produ_ValStockevo", new { id = Model.ValCodprodu, partialView = "Produ_ValStockevo"}))
        .BackgroundColourOnCondition(p => p.ValZzstate != 0 ? "" : (((p.ValType)=="Input")?("RGB(207,255,158)"):((((p.ValType)=="Output")?("RGB(255,190,158)"):("RGB(255,255,255)")))))
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()

<script>


$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qValStockevo, #ValStockevo_complex_filter th input, #ValStockevo_filters input").change(function() {
                    $("#pValStockevo").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#ValStockevo_tableFilters').val(false);")
                    @Html.Raw("$('#ValStockevo_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#ValStockevo_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $('#ValStockevo_complex_filter button#applyComplexFilter').click();
                    @:      event.preventDefault();
                    @:  }
                    @:});
                }
                @Html.Raw("$('#ValStockevo_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_ValStockevo').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });


                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='ValStockevo']"));
                    InitSpecialControls($('#ValStockevo'));
                    $('#ValStockevo').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS PRODU_VALSTOCKEVO]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
</script>