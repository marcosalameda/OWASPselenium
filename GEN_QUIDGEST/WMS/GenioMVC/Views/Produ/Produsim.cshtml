@model GenioMVC.ViewModels.Produ.Produsim_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Produsim";
	ViewBag.Title = @Resources.PRODUCT12880;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Produ", FormMethod.Post, new { @class = "form-horizontal", area="Produ", data_form="Produsim" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Produsim" area="Produ" data-form="Produsim">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Produsim_well" area="Produ" data-form="Produsim">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

