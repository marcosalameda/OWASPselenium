@model GenioMVC.ViewModels.Produ.WMS_Menu_311_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Produ.WMS_Menu_311_ViewModel modelWMS_Menu_311 = new GenioMVC.ViewModels.Produ.WMS_Menu_311_ViewModel(Navigation);
	var columns = modelWMS_Menu_311.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();

	Dictionary<string, string> arrYesno = new Dictionary<string, string>();
	foreach(var elem in CSGenio.business.ArrayYesno.GetDictionary())
	{
		arrYesno.Add(elem.Key.ToString(), GenioMVC.Resources.Resources.ResourceManager.GetString(elem.Value.ToString()));
	}

	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "produ" && areaField.Field == "product")
		{
			fields.Add("PRODU.PRODUCT", new TableFilterField("PRODU", "PRODUCT", Resources.PRODUCT12880, "text", defaultSearch : true));
		}
		if (areaField.Area == "produ" && areaField.Field == "sku")
		{
			fields.Add("PRODU.SKU", new TableFilterField("PRODU", "SKU", Resources.SKU42303, "text"));
		}
		if (areaField.Area == "produ" && areaField.Field == "descript")
		{
			fields.Add("PRODU.DESCRIPT", new TableFilterField("PRODU", "DESCRIPT", Resources.DESCRIPTION07383, "text"));
		}
		if (areaField.Area == "produ" && areaField.Field == "gtin")
		{
			fields.Add("PRODU.GTIN", new TableFilterField("PRODU", "GTIN", Resources.GTIN45487, "text"));
		}
		if (areaField.Area == "produ" && areaField.Field == "size")
		{
			fields.Add("PRODU.SIZE", new TableFilterField("PRODU", "SIZE", Resources.SIZE10299, "text"));
		}
		if (areaField.Area == "produ" && areaField.Field == "weight")
		{
			fields.Add("PRODU.WEIGHT", new TableFilterField("PRODU", "WEIGHT", Resources.WEIGHT36329, "num"));
		}
		if (areaField.Area == "locat" && areaField.Field == "gln")
		{
			fields.Add("LOCAT.GLN", new TableFilterField("LOCAT", "GLN", Resources.GLN35528, "text"));
		}
		if (areaField.Area == "lcext" && areaField.Field == "glnext")
		{
			fields.Add("LCEXT.GLNEXT", new TableFilterField("LCEXT", "GLNEXT", Resources.GLN_EXT31913, "text"));
		}
		if (areaField.Area == "produ" && areaField.Field == "inputs")
		{
			fields.Add("PRODU.INPUTS", new TableFilterField("PRODU", "INPUTS", Resources.INPUTS19315, "num"));
		}
		if (areaField.Area == "produ" && areaField.Field == "outputs")
		{
			fields.Add("PRODU.OUTPUTS", new TableFilterField("PRODU", "OUTPUTS", Resources.OUTPUTS47833, "num"));
		}
		if (areaField.Area == "produ" && areaField.Field == "stock")
		{
			fields.Add("PRODU.STOCK", new TableFilterField("PRODU", "STOCK", Resources.STOCK37618, "num"));
		}
		if (areaField.Area == "produ" && areaField.Field == "price")
		{
			fields.Add("PRODU.PRICE", new TableFilterField("PRODU", "PRICE", Resources.PRICE06900, "num"));
		}
		if (areaField.Area == "produ" && areaField.Field == "in_use")
		{
			fields.Add("PRODU.IN_USE", new TableFilterField("PRODU", "IN_USE", Resources.IN_USE42606, "enum", array : arrYesno));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("WMS_Menu_311", "Produ", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Produ", data_form="WMS_Menu_311" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="WMS_Menu_311_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qWMS_Menu_311", Navigation.GetStrValue("qWMS_Menu_311"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('WMS_Menu_311');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('WMS_Menu_311');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.PRODUCT12880})
					<button id="qWMS_Menu_311-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("WMS_Menu_311", fields, "PRODU")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('WMS_Menu_311', 'PRODU', 'PRODU.PRODUCT');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="WMS_Menu_311_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#WMS_Menu_311_complex_filter', 'WMS_Menu_311_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("WMS_Menu_311")
					</div>
				</div>
			</div>
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@Html.ExportListMenu("WMS_Menu_311")
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="WMS_Menu_311" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "WMS_Menu_311", idlistController = "Produ", idlistArea = "Produ", codlista ="92697297-35db-4e66-a7dc-b3b9b29febb5" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("WMS_Menu_311_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "WMS_Menu_311" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_311 = new QMenuForm($('[data-form="WMS_Menu_311"]'), "Form_WMS_Menu_311");
		window.Form_WMS_Menu_311.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_311.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_311");
		RegisterClearEvents("WMS_Menu_311")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_311", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="WMS_Menu_311"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="WMS_Menu_311"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
