@model GenioMVC.ViewModels.Produ.WMS_Menu_311_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Produ;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Produ>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodprodu, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_PRODUCT]/
		column.Expression(p => p.ValProduct).Title(@Resources.PRODUCT12880).Field("ValProduct").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_SKU]/
		column.Expression(p => p.ValSku).Title(@Resources.SKU42303).Field("ValSku").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_DESCRIPT]/
		column.Expression(p => p.ValDescript).Title(@Resources.DESCRIPTION07383).Hidden().Field("ValDescript").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_GTIN]/
		column.Expression(p => p.ValGtin).Title(@Resources.GTIN45487).Hidden().Field("ValGtin").Size(14);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_SIZE]/
		column.Expression(p => p.ValSize).Title(@Resources.SIZE10299).Hidden().Field("ValSize").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_WEIGHT]/
		column.Expression(p => p.ValWeight).Title(@Resources.WEIGHT36329).Hidden().Field("ValWeight").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_LOCAT_GLN]/
		column.Expression(p => p.Locat.ValGln).Title(@Resources.GLN35528).Field("Locat.ValGln").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_LCEXT_GLNEXT]/
		column.Expression(p => p.Lcext.ValGlnext).Title(@Resources.GLN_EXT31913).Field("Lcext.ValGlnext").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_INPUTS]/
		column.Expression(p => p.ValInputs).Title(@Resources.INPUTS19315).Field("ValInputs").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_OUTPUTS]/
		column.Expression(p => p.ValOutputs).Title(@Resources.OUTPUTS47833).Field("ValOutputs").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_STOCK]/
		column.Expression(p => p.ValStock).Title(@Resources.STOCK37618).Field("ValStock").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_PRICE]/
		column.Expression(p => p.ValPrice).Title(@Resources.PRICE06900).Field("ValPrice").Size(12);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_IN_USE]/
		column.Expression(p => p.ArrayValin_use).Title(@Resources.IN_USE42606).Field("ValIn_use", "ArrayYesno").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_311_PRODU_IMAGE]/
		column.Expression(p => Html.ImageMagnifierZoom(p.ValImage, new {alt=@Resources.IMAGE65174,}, Url.Action("ImageHandlerGet", "Home", new { id = p.ValCodprodu, modelname = "Produ", fldname = "ValImage" }))).Title(@Resources.IMAGE65174).Field("ValImage").Size(3);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Produ")
        .Id("WMS_Menu_311")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Produ", false, false)
        .SetFollowUp("Produ_Edit", "Produ" , (Func<GenioMVC.Models.Produ, object>)(item => new { id = item.ValCodprodu }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qWMS_Menu_311, #WMS_Menu_311_complex_filter th input, #WMS_Menu_311_filters input").change(function() {
                    $("#pWMS_Menu_311").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#WMS_Menu_311_tableFilters').val(false);")
                    @Html.Raw("$('#WMS_Menu_311_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#WMS_Menu_311_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='WMS_Menu_311']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qWMS_Menu_311');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#WMS_Menu_311_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_WMS_Menu_311').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('WMS_Menu_311', 'PRODU', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS WMS_MENU_311]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS WMS_MENU_311]/
</script>