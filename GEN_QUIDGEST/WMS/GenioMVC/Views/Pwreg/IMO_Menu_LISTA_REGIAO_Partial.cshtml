@model GenioMVC.ViewModels.Pwreg.IMO_Menu_LISTA_REGIAO_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@{
    var data = Html.newTableFor<GenioMVC.Models.Pwreg>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodpwreg, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_LISTA_REGIAO_PSW_NOME]/
		column.Expression(p => p.Psw.ValNome).Title(@Resources.LOGIN48703).Field("Psw.ValNome").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_LISTA_REGIAO_REGIO_REGIAO]/
		column.Expression(p => p.Regio.ValRegiao).Title(@Resources.REGION12723).Field("Regio.ValRegiao").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Pwreg")
        .Id("IMO_Menu_LISTA_REGIAO")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .MultipleSelection()
        .Filters(this.Model.Menu.Filters)
        .AddTableAction("DefineEphFormValues", "Pwreg", null, "glyphicons glyphicons-check tabel_action_icon", @Resources.SUBMETER21206 , isBootStrapIcon: true, isRoutine: true, multipleSelection: true, isAjaxAction: true, htmlAttributes: new { })
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()


<script>
 
 

$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qIMO_Menu_LISTA_REGIAO, #IMO_Menu_LISTA_REGIAO_complex_filter th input, #IMO_Menu_LISTA_REGIAO_filters input").change(function() {
                    $("#pIMO_Menu_LISTA_REGIAO").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#IMO_Menu_LISTA_REGIAO_tableFilters').val(false);")
                    @Html.Raw("$('#IMO_Menu_LISTA_REGIAO_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#IMO_Menu_LISTA_REGIAO_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='IMO_Menu_LISTA_REGIAO']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qIMO_Menu_LISTA_REGIAO');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#IMO_Menu_LISTA_REGIAO_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_IMO_Menu_LISTA_REGIAO').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('IMO_Menu_LISTA_REGIAO', 'PWREG', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS IMO_MENU_LISTA_REGIAO]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS IMO_MENU_LISTA_REGIAO]/
function DefineEphFormValues(jsonRouteValues) {
    var url = '@Url.Action("DefineEphFormValues", "Pwreg", new { nav = @Navigation.NavigationId })';
    $.ajax({
        url: url,
        cache: false,
        type: "POST",
        dataType: "json",
        data: $.param({ ids: jsonRouteValues.ids, formId : "LISTA_REGIAO"}, true)
    }).done(function (data) {
        if (data.success) {
            switch (data.success) {
                case 'E':
                    bootbox.alert(data.message, function () { QUtils.WindowReload() });
                    break;
                case 'W':
                case 'OK':
                    QUtils.NavigateTo = '@Url.Action("Index","Home")';
                    break;
            }
        }
        })
        .fail(function (jqXHR, textStatus, errorThrown) {
            if (errorThrown != "canceled")
                bootbox.alert(quidgestGlobals.Resources.ERRO_NA_EXECUCAO_DE_49457);
        });
}
</script>