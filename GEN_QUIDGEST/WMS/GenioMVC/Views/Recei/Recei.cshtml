@model GenioMVC.ViewModels.Recei.Recei_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Recei";
	ViewBag.Title = @Resources.RECEIPT_OF_GOOD16561;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Recei", FormMethod.Post, new { @class = "form-horizontal", area="Recei", data_form="Recei" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Recei" area="Recei" data-form="Recei">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Recei_well" area="Recei" data-form="Recei">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

