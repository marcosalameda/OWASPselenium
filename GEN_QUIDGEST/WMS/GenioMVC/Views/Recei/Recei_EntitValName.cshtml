@model GenioMVC.ViewModels.Recei.Recei_EntitValName_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.ENTITIES22578</h2>
        </div>
        <div class="col-auto normal-view" id="Recei_EntitValName_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qRecei_EntitValName", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Recei_EntitValName.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Recei_EntitValName_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Recei_EntitValName_complex_filter', 'Recei_EntitValName_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="normal-view">
@{
    var data = Html.newTableFor<GenioMVC.Models.Entit>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodentit, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_NAME]/
		column.Expression(p => p.ValName).Title(@Resources.LEGAL_NAME42902).Field("ValName").Size(85);
// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_INITIALS]/
		column.Expression(p => p.ValInitials).Title(@Resources.INITIALS22754).Field("ValInitials").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_TAXNUMBE]/
		column.Expression(p => p.ValTaxnumbe).Title(@Resources.VAT_NUMBER24236).Field("ValTaxnumbe").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_EMAIL]/
		column.Expression(p => p.ValEmail).Title(@Resources.EMAIL25170).Field("ValEmail").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_PHONENUM]/
		column.Expression(p => p.ValPhonenum).Title(@Resources.PHONE_NUMBER20774).Field("ValPhonenum").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_CONTACT]/
		column.Expression(p => p.ValContact).Title(@Resources.CONTACT59247).Field("ValContact").Size(20);
// USE /[MANUAL GQT CUSTOM_COLUMN RECEI_NAME_ENTIT_LANGUAGE]/
		column.Expression(p => p.ValLanguage).Title(@Resources.LANGUAGE16872).Field("ValLanguage").Size(2);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValName).Field("ValName").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Entit")
        .Id("Recei_EntitValName")
        .AjaxRequest("Recei_EntitValName")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Recei_EntitValName", new { id = Model.ValCodrecei, partialView = "Recei_EntitValName"}))
        .Filters(this.Model.Menu.Filters)
        .Permissions(canView: false, canInsert: false, canEdit: false, canDelete: false, canDuplicate: false)
		;
        
}

@tbl.ToHtml()
</div>
<script>
    try {
        if (jQuery) {
            try {
                $("#qRecei_EntitValName, #TableEntitName_complex_filter th input").change(function() {
                    var context = $("#TableEntitName").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Recei_EntitValName table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_RECEI___ENTITNAME____"]');

                    selectList.trigger("DBEditSetValue", key);

                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Recei_EntitValName_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Recei_EntitValName_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Recei_EntitValName_extra').prop("disabled", true);
</text>
}


// USE /[MANUAL GQT LISTING_JS RECEI_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>