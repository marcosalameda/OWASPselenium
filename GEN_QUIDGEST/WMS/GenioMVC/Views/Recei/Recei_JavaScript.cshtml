	<text>

		@* Formula of the 'ValTocheck' field *@
		$(qForm).bind('VALDTRECEIP_CHANGE VALDTCHECK_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(!( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDtreceip', $('[data-form="Recei"]'))) == "")&&( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDtcheck', $('[data-form="Recei"]'))) == ""),1,0));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValTocheck', $('[data-form="Recei"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValTocheck', $('[data-form="Recei"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValTocheck', $('[data-form="Recei"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValTocheck: ' + err.message, err.stack, window.location.href); }
		});
		
		@* Formula of the 'ValChecked' field *@
		$(qForm).bind('VALDTCHECK_CHANGE', function(event, eTarget) {
				try {
						var newValue = (qApi.iif(( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValDtcheck', $('[data-form="Recei"]'))) == ""),0,1));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValChecked', $('[data-form="Recei"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValChecked', $('[data-form="Recei"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValChecked', $('[data-form="Recei"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValChecked: ' + err.message, err.stack, window.location.href); }
		});
		





	</text>
