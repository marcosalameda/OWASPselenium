@model GenioMVC.ViewModels.Recei.WMS_Menu_111_ViewModel
@using GenioMVC.Resources
@using System.Web.Script.Serialization
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Title = Model.DBEditTitle;
	//Layout = "~/Views/Shared/Layouts/TopMenu_BT4/_Layout.cshtml";
}

@{
	GenioMVC.ViewModels.Recei.WMS_Menu_111_ViewModel modelWMS_Menu_111 = new GenioMVC.ViewModels.Recei.WMS_Menu_111_ViewModel(Navigation);
	var columns = modelWMS_Menu_111.GetSearchColumns();

	Dictionary<string, TableFilterField> fields = new Dictionary<string, TableFilterField>();


	foreach (var col in columns)
	{
		var areaField = col.AreaField;
		if (areaField.Area == "recei" && areaField.Field == "number")
		{
			fields.Add("RECEI.NUMBER", new TableFilterField("RECEI", "NUMBER", Resources.RECEIPT_NUMBER31380, "num", defaultSearch : true));
		}
		if (areaField.Area == "recei" && areaField.Field == "dtreceip")
		{
			fields.Add("RECEI.DTRECEIP", new TableFilterField("RECEI", "DTRECEIP", Resources.RECEIPT_DATE00996, "date"));
		}
		if (areaField.Area == "entit" && areaField.Field == "name")
		{
			fields.Add("ENTIT.NAME", new TableFilterField("ENTIT", "NAME", Resources.LEGAL_NAME42902, "text"));
		}
		if (areaField.Area == "recei" && areaField.Field == "dtcheck")
		{
			fields.Add("RECEI.DTCHECK", new TableFilterField("RECEI", "DTCHECK", Resources.RECEIPT_VERIFICATION62328, "date"));
		}
		if (areaField.Area == "recei" && areaField.Field == "checked")
		{
			fields.Add("RECEI.CHECKED", new TableFilterField("RECEI", "CHECKED", Resources.CHECKED31708, "bool"));
		}
		if (areaField.Area == "recei" && areaField.Field == "tocheck")
		{
			fields.Add("RECEI.TOCHECK", new TableFilterField("RECEI", "TOCHECK", Resources.TO_CHECK57511, "bool"));
		}
		if (areaField.Area == "recei" && areaField.Field == "dtstorag")
		{
			fields.Add("RECEI.DTSTORAG", new TableFilterField("RECEI", "DTSTORAG", Resources.STORAGE_DATE59954, "date"));
		}
	}

	JavaScriptSerializer serializer = new JavaScriptSerializer();
	string fieldsStr = serializer.Serialize(fields);
}

<script>
	//Fields with information for search filters
	var fields = @Html.Raw(fieldsStr);
	//Table List Search Filters
	var searchFilterGroups = [];
</script>


@using (Ajax.BeginForm("WMS_Menu_111", "Recei", new AjaxOptions
{
	HttpMethod= "POST",
	InsertionMode = InsertionMode.Replace,
	UpdateTargetId = "Menu",
	OnSuccess = "InitMenuSpecialControls"
}, new { @class = "form-horizontal", area="Recei", data_form="WMS_Menu_111" }))
{
		<input id="SearchFilters" type="hidden" value="" />

		<div class="page-header row" style="align-items:center">
		   <div class="col">
<div class="table-title c-table__title">
					<h1>@ViewBag.Title</h1>
				</div>

		   </div>
		   <div class="col-auto search">
				<div class="i-input-group input-xxlarge" id="WMS_Menu_111_simple_filter">
					<div data-search-filter-menu-elem="filter-box-list"></div>
					@Html.TextBox("qWMS_Menu_111", Navigation.GetStrValue("qWMS_Menu_111"), new { @class="i-input-group__field input-xxlarge dropdown-toggle", @title=@Resources.CAIXA_DE_PESQUISA53870, @onfocus="ToggleSearchFilterBox('WMS_Menu_111');" ,@onkeydown = "ListSearchEnter(event)", @autocomplete = "off" ,@data_toggle = "dropdown",@data_search_field_menu_elem = "show", @onblur = "HideSearchFieldMenuOnUnfocus('WMS_Menu_111');",@placeholder = Resources.PESQUISAR34506 + " " + Resources.RECEIPT_NUMBER31380})
					<button id="qWMS_Menu_111-clearBtn" class="clear-search d-none" type="button">
						<i class="glyphicons glyphicons-remove mr-1"></i>
					</button>
					@Html.SearchFieldMenu("WMS_Menu_111", fields, "RECEI")
					<div class="b-btn-group i-input-group--right">
						<button type="button" elem-identifier="ListSearchButton" class="btn b-icon b-icon--secondary i-input-group__button--secondary  listSearchButton" title="@Resources.PESQUISAR34506" onclick="AddSearchFieldFilter('WMS_Menu_111', 'RECEI', 'RECEI.NUMBER');"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>
						@{
						var advancedSearchIcon = @Model.Menu.Filters.ShowTableFilters ? "glyphicons-zoom-out" : "glyphicons-zoom-in";
						<button id="WMS_Menu_111_extra" class="btn b-icon b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#WMS_Menu_111_complex_filter', 'WMS_Menu_111_tableFilters');applyComplexFilterIDs();" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons @advancedSearchIcon i-input-group__tag-icon i-input-group__button-icon"></span></button>
						}
						@Html.SearchFilterMenu("WMS_Menu_111")
					</div>
				</div>
			</div>
            @if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest() && !Model.IsViewModeHidden("LIST"))
            {
			<div class="col-auto float-right" style="padding: 0; padding-right: 15px">
				<div class="b-btn-group float-right" style="height: 32.625px">
					@*List properties LISTS*@
					@if(!GenioMVC.Models.Navigation.UserContext.Current.User.IsGuest())
					{
						<button class="b-btn b-icon b-icon--secondary" type="button" data-modal-form="Lstusr" data-modal-id="lstusr-edit-modal" data-table="WMS_Menu_111" data-modal-url="@Url.Action("ChangeListProperties", "Lstusr", new { idlist = "WMS_Menu_111", idlistController = "Recei", idlistArea = "Recei", codlista ="6bb55b0e-5337-4429-b2f8-3175958c9c5b" })" title="@Resources.ALTERAR_A_APRESENTAC58401"><i class="glyphicons glyphicons-list e-icon"></i></button>
					}
				</div>
			</div>
            }
		</div>
 	<div id="Menu" element-identifier="List">
		@{ Html.RenderPartial("WMS_Menu_111_Partial"); }
	</div>
	@Html.Hidden("CurrentHistoryLevel", Model.Navigation.CurrentLevel.Level, new { data_interface_id = "WMS_Menu_111" })
	@Html.Hidden("CurrentNavigationId", Model.Navigation.NavigationId)
	@Html.Hidden("NavigationFormHistLock", Model.Navigation.FormHistLock())
	@Html.AntiForgeryToken()
}



<script>
	$(document).ready(function () {
		window.Form_WMS_Menu_111 = new QMenuForm($('[data-form="WMS_Menu_111"]'), "Form_WMS_Menu_111");
		window.Form_WMS_Menu_111.HelpStyle = '@GenioMVC.LayoutConfig.config.helpStyle';
		window.Form_WMS_Menu_111.Init();

		//Initialize search field menu for search bar
		InitSearchFieldMenu("qWMS_Menu_111");
		RegisterClearEvents("WMS_Menu_111")

		// TVC - added code to load advanced filters after returning from a form
		@{
			string advFil = "";
			if (!String.IsNullOrEmpty(Navigation.GetStrValue("AdvancedFilters")))
			{
				advFil = Navigation.GetStrValue("AdvancedFilters");
			}
		}

		SearchFilters.value = '@Html.Raw(advFil)';
		if (typeof SearchFilters.value === 'string' && SearchFilters.value.length > 0)
			UpdateSearchFilterStatus("WMS_Menu_111", JSON.parse(SearchFilters.value))
	});
</script>

@helper codeJavascript()
{
<script>
	QLocalStorage.remLocalStorage("savedInfo");
	$(document).ready(function (e) {
		InitSpecialControls($('[data-form="WMS_Menu_111"]'));


 	});

	function InitMenuSpecialControls() {
		InitSpecialControls($('[data-form="WMS_Menu_111"]'));
	}

</script>
}

@section code_javascript {
	@codeJavascript()
}
