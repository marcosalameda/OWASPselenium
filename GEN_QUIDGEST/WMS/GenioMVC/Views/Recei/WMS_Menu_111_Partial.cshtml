@model GenioMVC.ViewModels.Recei.WMS_Menu_111_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Recei;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Recei>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodrecei, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_RECEI_NUMBER]/
		column.Expression(p => p.ValNumber).Title(@Resources.RECEIPT_NUMBER31380).Field("ValNumber").Size(10);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_RECEI_DTRECEIP]/
		column.Expression(p => p.ValDtreceip).Title(@Resources.RECEIPT_DATE00996).Field("ValDtreceip").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_ENTIT_NAME]/
		column.Expression(p => p.Entit.ValName).Title(@Resources.LEGAL_NAME42902).Field("Entit.ValName").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_RECEI_DTCHECK]/
		column.Expression(p => p.ValDtcheck).Title(@Resources.RECEIPT_VERIFICATION62328).Field("ValDtcheck").Size(16);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_RECEI_CHECKED]/
		column.Expression(p => p.ValChecked).Title(@Resources.CHECKED31708).Field("ValChecked").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_RECEI_TOCHECK]/
		column.Expression(p => p.ValTocheck).Title(@Resources.TO_CHECK57511).Field("ValTocheck").Size(1);
// USE /[MANUAL GQT CUSTOM_COLUMN WMS_MENU_111_RECEI_DTSTORAG]/
		column.Expression(p => p.ValDtstorag).Title(@Resources.STORAGE_DATE59954).Field("ValDtstorag").Size(16);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Recei")
        .Id("WMS_Menu_111")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Recei", false, false)
        .SetFollowUp("Recei_Edit", "Recei" , (Func<GenioMVC.Models.Recei, object>)(item => new { id = item.ValCodrecei }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qWMS_Menu_111, #WMS_Menu_111_complex_filter th input, #WMS_Menu_111_filters input").change(function() {
                    $("#pWMS_Menu_111").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#WMS_Menu_111_tableFilters').val(false);")
                    @Html.Raw("$('#WMS_Menu_111_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#WMS_Menu_111_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='WMS_Menu_111']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qWMS_Menu_111');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#WMS_Menu_111_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_WMS_Menu_111').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('WMS_Menu_111', 'RECEI', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS WMS_MENU_111]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS WMS_MENU_111]/
</script>