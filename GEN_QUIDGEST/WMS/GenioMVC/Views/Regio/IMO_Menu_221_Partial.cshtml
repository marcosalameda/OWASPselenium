@model GenioMVC.ViewModels.Regio.IMO_Menu_221_ViewModel
@using Newtonsoft.Json;
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@
@{ Dictionary<int, MvcHtmlString> renderings = new Dictionary<int, MvcHtmlString>(); }
@using GenioMVC.ViewModels.Regio;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Regio>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodregia, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_221_CNTRY_COUNTRY]/
		column.Expression(p => p.Cntry.ValCountry).Title(@Resources.COUNTRY64133).Field("Cntry.ValCountry").Size(30);
// USE /[MANUAL GQT CUSTOM_COLUMN IMO_MENU_221_REGIO_REGIAO]/
		column.Expression(p => p.ValRegiao).Title(@Resources.REGION12723).Field("ValRegiao").Size(30);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Regio")
        .Id("IMO_Menu_221")
        .AjaxRequest("Menu")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .DBEdit()
        .Filters(this.Model.Menu.Filters)
        .Form("Regia", false, false)
        .SetFollowUp("Regia_Show", "Regio" , (Func<GenioMVC.Models.Regio, object>)(item => new { id = item.ValCodregia }), isRoutine: false, isSpecificPaths: false, isAjaxAction: false, htmlAttributes: new { }, openInPopup: false)
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()


<script>



$(document).ready(function() {

    try {
        if (jQuery) {
            try {
                $("#qIMO_Menu_221, #IMO_Menu_221_complex_filter th input, #IMO_Menu_221_filters input").change(function() {
                    $("#pIMO_Menu_221").val("1");
                });
                @{ var disable = (Model.IsEditableMode && Model.Menu.Elements.Count() == 0 && Model.Menu.Filters.FiltersValues.Count == 0); }


                @if(@disable && Model.Menu.Filters.ShowTableFilters) {
                    @Html.Raw("$('#IMO_Menu_221_tableFilters').val(false);")
                    @Html.Raw("$('#IMO_Menu_221_simple_filter').show();")
                }
                @if (!disable) {
                    @:$('#IMO_Menu_221_complex_filter input').keypress(function (event) {
                    @:  var keycode = (event.keyCode ? event.keyCode : event.which);
                    @:  if(keycode == '13' || keycode == '10'){
                    @:      $("[data-form='IMO_Menu_221']").submit();
                    @:      event.preventDefault();
                    @:      ClearSearchBox('qIMO_Menu_221');
                    @:  }
                    @:});
                }
                @Html.Raw("$('#IMO_Menu_221_extra').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                @Html.Raw("$('#exportBtn_IMO_Menu_221').prop(\"disabled\", " + @disable.ToString().ToLower() + ");")
                //Hide 2nd date fields
                $("[hiddable]").hide();
                $(".filter-date-cell *").focus(function () {
                    $("[hiddable]").show();
                });
                 @if (this.Model.Menu.Filters.FiltersValues.Count >= 1) {
                    var activeFields = Newtonsoft.Json.JsonConvert.SerializeObject(this.Model.Menu.Filters.FiltersValues);
                    @: SetActiveFilters('IMO_Menu_221', 'REGIA', @Html.Raw(activeFields))
                  }


                setupHistoryClicks()
                // TODO: FIX THIS!!!
                @* $(document).ready(function () { loaded(); });*@
                $(document).ready(function () {
                    loaded($("[id='Menu']"));
                    InitSpecialControls($('#Menu'));
                    $('#Menu').trigger('SET_QCONTROL_LOADED', [true]);
                    HideTableEmptyFooter();
                    StickAdvancedSearch();

                });





// USE /[MANUAL GQT LISTING_JS IMO_MENU_221]/
 
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
})
// USE /[MANUAL GQT LISTING_CODEJS IMO_MENU_221]/
</script>