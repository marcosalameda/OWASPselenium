@model GenioMVC.ViewModels.Regio.Regiapro_CntryValCountry_ViewModel
@using GenioMVC.Models.Navigation;@* MH - Allows use the UserContext. *@
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
    var searchStyle =  string.Empty;
}
<div class="search" @searchStyle>
    <div class="row">
        <div class="col">
            <h2 class="table-title c-table__title">@Resources.COUNTRIES64527</h2>
        </div>
        <div class="col-auto normal-view" id="Regiapro_CntryValCountry_simple_filter">
            <div class="i-input-group" style="width:21rem; height: inherit;">
                @Html.TextBox("qRegiapro_CntryValCountry", this.Model.Menu.Query, new { @class = "i-input-group__field", @onkeydown = "ListSearchEnter(event)" })
                <div class="i-input-group--right">
                    <button type="button" elem-identifier="ListSearchButton" class="b-icon--secondary i-input-group__button--secondary" onclick="window.Regiapro_CntryValCountry.Search()"><i class="glyphicons glyphicons-search i-input-group__tag-icon i-input-group__button-icon"></i></button>

                    <button id="Regiapro_CntryValCountry_extra" class="b-icon--secondary i-input-group__button--secondary" type="button" onclick="changeFilters('#Regiapro_CntryValCountry_complex_filter', 'Regiapro_CntryValCountry_tableFilters')" title="@Resources.PESQUISA_AVANCADA06198"><span class="glyphicons glyphicons-zoom-in i-input-group__tag-icon i-input-group__button-icon"></span></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="normal-view">
@using GenioMVC.ViewModels.Cntry;    
@{
    var data = Html.newTableFor<GenioMVC.Models.Cntry>(edit: Model.IsEditableMode, canPage: true, canSort: true, countRec: false)
        .Columns(column =>
        {
            column.Expression(p => p.ValCodcntry, true).Hidden();

// USE /[MANUAL GQT CUSTOM_COLUMN REGIAPRO_COUNTRY_CNTRY_COUNTRY]/
		column.Expression(p => p.ValCountry).Title(@Resources.COUNTRY64133).Field("ValCountry").Size(90);
            column.Expression(p => p.ValZzstate).Field("ValZzstate").Hidden();
			//Hidden field used in JavaScript for return selected row text value
			column.Expression(p => p.ValCountry).Field("ValCountry").AddInlineStyle("display", "none", true).UsedForFilter(false);
        })
        .SetLimits(this.Model.tableLimits)
        .SetUserColumns(this.Model.UserColumns, "Cntry")
        .Id("Regiapro_CntryValCountry")
        .AjaxRequest("Regiapro_CntryValCountry")
        .DataSource(this.Model.Menu.Elements)
        .Sort(this.Model.Menu.Sort)
        .Pager(this.Model.Menu.Pagination)
        .Focus(this.Model.Menu.FocusOnRecord);

    var tbl = data
        .TableList(hasFilters: true)
        .RequestLink(@Url.Action("Regiapro_CntryValCountry", new { id = Model.ValCodregia, partialView = "Regiapro_CntryValCountry"}))
        .Filters(this.Model.Menu.Filters)
        .Form("Pais", false, false, new { data_skip_prevalida = "true" })
        .Permissions(canView: true, canInsert: true, canEdit: true, canDelete: true, canDuplicate: true)
		;
        
}

@tbl.ToHtml()
</div>
<script>
    try {
        if (jQuery) {
            try {
                $("#qRegiapro_CntryValCountry, #TableCntryCountry_complex_filter th input").change(function() {
                    var context = $("#TableCntryCountry").parent();
                    $("#table-inputs input", context).val("");
                });

                var row = $("#Regiapro_CntryValCountry table tbody tr");
                row.mouseenter(function () {
                    $(this).addClass("highlighted");
                });
                row.mouseleave(function () {
                    $(this).removeClass("highlighted");
                });

                $('td:not([elem-identifier="RowActions"])', row).click(function () {
                    var row = $(this).parent();
                    var key = row.data("key");
                    var selectList = $('[data-identifier="IFF_REGIAPROCNTRYCOUNTRY_"]');

                    selectList.trigger("DBEditSetValue", key);

                    $('#modal-dbedit').modal('hide');
                });

                $("td a").click(function (event) {
                    event.stopPropagation()
                });
                $('#Regiapro_CntryValCountry_complex_filter input').keypress(function (event) {
                    var keycode = (event.keyCode ? event.keyCode : event.which);
                    if(keycode == '13' || keycode == '10'){
                        $('#Regiapro_CntryValCountry_complex_filter button#applyComplexFilter').click();
                        event.preventDefault();
                    }
                });
@if(Model.Menu.Elements.Count() == 0 && !Model.Menu.Filters.ShowTableFilters)
{
<text>
                $('#Regiapro_CntryValCountry_extra').prop("disabled", true);
</text>
}


// USE /[MANUAL GQT LISTING_JS REGIAPRO_MENU]/
            } catch (err) {
                //function still not defined, proceed
            }
        }
    } catch (err) {
        //ajax request loaded from cache, so jquery is not loaded yet
        window.location.pathname = location.pathname;
    }
</script>