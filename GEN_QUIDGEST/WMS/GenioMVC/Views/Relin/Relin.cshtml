@model GenioMVC.ViewModels.Relin.Relin_ViewModel
@using GenioMVC.Models.Navigation;
@{ var Navigation = Model.Navigation; } @* MH - Allows unificate the generated code. And re-use some methods of the GenioAPI. *@

@{
	ViewBag.Form = "Relin";
	ViewBag.Title = @Resources.RECEIPT_LINE60287;
    ViewBag.formmode = Model.GetFormMode;
	ViewBag.ClassForFormLayout = "form-flow";
}


@if (!Model.NestedForm) {
    if(Model.IsEditableMode || Model.FormMode == FormMode.Delete)
    {
        using (Html.BeginForm("Action", "Relin", FormMethod.Post, new { @class = "form-horizontal", area="Relin", data_form="Relin" }))
        {
            @form_content_alert()
            @Html.QValidationSummary()
	        @LoadDefault()
        }
    }
    else
    {
        <div class="form-horizontal" id="Relin" area="Relin" data-form="Relin">
	        @LoadDefault()
        </div>
    }
}
else {
    <div class="c-card nested-form" id="Relin_well" area="Relin" data-form="Relin">
        @Html.QValidationSummary()
		@LoadDefault()
    </div>
}

