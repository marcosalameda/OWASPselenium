	<text>

		@* Formula of the 'ValOutstand' field *@
		$(qForm).bind('VALORDERED_CHANGE VALRECEIVED_CHANGE', function(event, eTarget) {
				try {
						var newValue = ( getFieldValue($(':not([elem-identifier="Multiform"]) > #ValOrdered', $('[data-form="Relin"]')))- getFieldValue($(':not([elem-identifier="Multiform"]) > #ValReceived', $('[data-form="Relin"]'))));
						$.when(newValue).done(function (result) {
								setFieldValue($(':not([elem-identifier="Multiform"]) > #ValOutstand', $('[data-form="Relin"]')), result);
								if($(':not([elem-identifier="Multiform"]) > #ValOutstand', $('[data-form="Relin"]')).data('QObject') === undefined) $(':not([elem-identifier="Multiform"]) > #ValOutstand', $('[data-form="Relin"]')).change(); //TODO: Remove this later...
						});
				} catch (err) { QError.AppendError('Formula of field ValOutstand: ' + err.message, err.stack, window.location.href); }
		});
		





	</text>
}

