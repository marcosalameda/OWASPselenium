@{
	<text>
		window.Form_Relin.Data.RelationKeysSelector = {
				get entit() { return $(':not([elem-identifier="Multiform"]) > #ValCodentit', $('[data-form="Relin"]')); /* Hidden */ },
				get recei() { return $(':not([elem-identifier="Multiform"]) > #ValCodrecei[pers-cs-area="Recei"]', $('[data-form="Relin"]')); /* DBEdit */ },
				get produ() { return $(':not([elem-identifier="Multiform"]) > #ValCodprodu[pers-cs-area="Produ"]', $('[data-form="Relin"]')); /* DBEdit */ },
		};

		window.Form_Relin.getAllForeignKeySelectors = function () {
			@* Get all selectors of foreign keys present on the form *@
			return this.Data.RelationKeysSelector;
		};

		window.Form_Relin.Data.RelationKeys = {
			get formContext() { return window.Form_Relin; },
			get entit() { return (this.formContext.Data.RelationKeysSelector.entit.getQControl() || {}).Value; /* Hidden FK */ },
			set entit(newValue) { (this.formContext.Data.RelationKeysSelector.entit.getQControl() || {}).Value = newValue; /* Hidden FK */ },
			get recei() { return (this.formContext.Data.RelationKeysSelector.recei.getQControl() || {}).Value; /* DBEdit */ },
			set recei(newValue) { (this.formContext.Data.RelationKeysSelector.recei.getQControl() || {}).Value = newValue; /* DBEdit */ },
			get produ() { return (this.formContext.Data.RelationKeysSelector.produ.getQControl() || {}).Value; /* DBEdit */ },
			set produ(newValue) { (this.formContext.Data.RelationKeysSelector.produ.getQControl() || {}).Value = newValue; /* DBEdit */ },
		};
	</text>
