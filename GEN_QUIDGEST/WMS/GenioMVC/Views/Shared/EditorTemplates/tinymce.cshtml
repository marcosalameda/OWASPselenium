@{
    var formFieldId = ViewData.TemplateInfo.GetFullHtmlFieldId(string.Empty);
    object isReadOnly = false;
    ViewData.TryGetValue("data_readonly", out isReadOnly);
}
<script src="@Url.Content(UrlNames.TinyMCE5)"></script>
<script type="text/javascript">
    window.tinyMCEPreInit = {
        base: '@Url.Content("~/Scripts/tinymce")',
        suffix: '.min',
        query: ''
    };
    $(document).ready(function () {
        @* Devido a má implementação da inicialização do script do plugin
            passa ser necessario fazer o load só depois do documente ready.
            Caso contrario a segunda inicialização do script do plugin limpa variaveis internas *@
        loadTinyMCE_@(formFieldId)();
    });
</script>
@{
    object menu, plugins, buttonsGroup, customConfig = string.Empty;

    //Defaults
    if (!ViewData.ModelMetadata.AdditionalValues.TryGetValue("menu", out menu))
    {
        menu = string.Empty;
    }

    if (!ViewData.ModelMetadata.AdditionalValues.TryGetValue("plugins", out plugins))
    {
        plugins = "'powerpaste autoresize textpattern importcss imagetools fullpage lists advlist autolink link image imagetools charmap print preview hr anchor pagebreak searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media nonbreaking table directionality emoticons '";
         //unused plugins: autoresize autosave bbcode codesample help legacyoutput noneditable save contextmenu spellchecker tabfocus template toc
         //colorpicker textcolor
         
    }

    if (!ViewData.ModelMetadata.AdditionalValues.TryGetValue("buttonsGroup", out buttonsGroup))
    {
        buttonsGroup = "toolbar1: 'cut copy paste | undo redo | styleselect | fontselect fontsizeselect | removeformat | bullist numlist | outdent indent | visualblocks ltr rtl  | searchreplace | media image link unlink | ',";
        buttonsGroup += "toolbar2: 'bold italic underline strikethrough | subscript superscript | forecolor backcolor | alignleft aligncenter alignright alignjustify | table | anchor pagebreak hr | charmap emoticons | print preview fullscreen | fullpage | code'";
        //Premium: formatpainter https://www.tiny.cloud/docs-4x/plugins/formatpainter/#usingformatpainter
    }

    if (!ViewData.ModelMetadata.AdditionalValues.TryGetValue("customConfig", out customConfig))
    {
        customConfig = string.Empty;
    }
}

@*plugins: ["advlist anchor autolink autoresize autosave bbcode charmap code codesample colorpicker contextmenu directionality emoticons fullpage fullscreen help hr image imagetools importcss insertdatetime  legacyoutput link lists media nonbreaking noneditable pagebreak powerpaste preview print save searchreplace spellchecker tabfocus table template textcolor textpattern toc visualblocks visualchars wordcount"],
            //REMOVED PLUGINS: example example_dependency layer
            link_assume_external_targets: true,
            //powerpaste_word_import: "clean",
            //powerpaste_html_import: "clean",
			*@
<script type="text/javascript">
    function loadTinyMCE_@(formFieldId)() {
        tinymce.dom.Event.domLoaded = true;
        tinymce.init({
            mode: "exact",
            elements: '@formFieldId',
            readonly: @isReadOnly.ToString().ToLower(),
            language: '@Helpers.GetSupportedLanguageTinymce()',
            convert_urls: false,
            encoding : "raw",
            resize: "both",
            menubar: false,
            powerpaste_allow_local_images: true,
            powerpaste_word_import: "merge",
            powerpaste_html_import: "merge",
            style_formats_autohide: true,
            importcss_append: true,
            browser_spellcheck: true,
            contextmenu: true,
            branding:false,
            textpattern_patterns: [
                {start: '*', end: '*', format: 'italic'},
                {start: '**', end: '**', format: 'bold'},
                {start: '#', format: 'h1'},
                {start: '##', format: 'h2'},
                {start: '###', format: 'h3'},
                {start: '####', format: 'h4'},
                {start: '#####', format: 'h5'},
                {start: '######', format: 'h6'},
                {start: '1. ', cmd: 'InsertOrderedList'},
                {start: '* ', cmd: 'InsertUnorderedList'},
                {start: '- ', cmd: 'InsertUnorderedList'},
            ],
            plugins: [
            @Html.Raw(@plugins.ToString())
            ],
            image_advtab: true,
            @Html.Raw(buttonsGroup.ToString() + ",")
            @if (!string.IsNullOrEmpty(menu.ToString()))
            {
                @:menu: { @Html.Raw(menu.ToString()) },
            }
            @if (!string.IsNullOrEmpty(customConfig.ToString()))
            {
                @Html.Raw(customConfig.ToString())
            }
            });
            };
</script>

@Html.TextArea(string.Empty, /* Name suffix */
    ViewData.TemplateInfo.FormattedModelValue /* Initial value */
)
