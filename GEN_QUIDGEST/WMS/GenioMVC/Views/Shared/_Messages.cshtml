@model GenioMVC.ViewModels.Messages_ViewModel
@using GenioMVC.Models.Navigation;

@if (Model.Messages != null && Model.Messages.Count > 0)
{

    foreach (Message message in Model.Messages)
        {           
            <div id="@message.ID" class="alert c-alert c-alert-@message.Status" role="alert">
                @if(message.Status.Equals(CSGenio.framework.Status.E) || message.Status.Equals(CSGenio.framework.Status.W))
                {
                    <i class="glyphicons glyphicons-light-beacon c-alert__icon"></i>
                }else if(message.Status.Equals(CSGenio.framework.Status.OK))
                {
                    <i class="glyphicons glyphicons-ok-sign c-alert__icon"></i>
                }else
                {
                    <i class="glyphicons glyphicons-info-sign c-alert__icon"></i>
                }
                <a href="#" class="c-alert__dismissible" data-dismiss="alert" aria-label="close">
                    <i class="glyphicons glyphicons-remove c-alert__icon"></i>
                </a>                
                @if (!String.IsNullOrEmpty(message.Title))
                {
                    <H4 class="c-alert__title">@message.Title!</H4>
                }
                <div class="c-alert__text">
					&nbsp;@if (@message.ContainsHtml)
							{@Html.Raw(@message.Content)}
							else {@message.Content}
                </div> 
            </div>
        }  
}
