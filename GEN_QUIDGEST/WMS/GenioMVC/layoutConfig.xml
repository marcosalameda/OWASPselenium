<?xml version="1.0" encoding="utf-8"?>
<LayoutConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<DbEditActionPlacement>left</DbEditActionPlacement> <!-- left, right -->
	<FormAnchorsPosition>sidebar</FormAnchorsPosition> <!-- form-header, sidebar -->
	<DbEditPagerPlacement>left</DbEditPagerPlacement> <!-- left, right -->
	<DbEditMultipleActionPlacement>left</DbEditMultipleActionPlacement> <!-- left, right -->
	<LoginStyle>single_page</LoginStyle> <!-- single_page, embeded_page -->
	<LanguagePlacement>in_footer</LanguagePlacement> <!-- in_header, in_footer -->
	<UserRegisterStyle>button</UserRegisterStyle> <!-- button, hyperlink -->
	<FooterEnable>true</FooterEnable> <!-- true, false -->
	<BreadcrumbsContent>detailed</BreadcrumbsContent> <!-- simplified, detailed, hidden -->
	<RowActionDisplay>dropdown</RowActionDisplay> <!-- inline, dropdown -->
	<DefaultSidebarState>opened</DefaultSidebarState> <!-- opened, closed -->
	<ModulesStyle>dropdown</ModulesStyle> <!-- list, dropdown, collapsible -->
	<MenuSearchEnable>true</MenuSearchEnable> <!-- true, false -->
	<BookmarkEnable>true</BookmarkEnable> <!-- true, false -->
	<ShowPasswordToggle>true</ShowPasswordToggle> <!-- true, false -->
	<AuthenticationStyle>default</AuthenticationStyle> <!-- default, light, secondary -->
	<HelpListShort>Subtitle</HelpListShort> <!-- Tooltip, Popover, Subtitle, Info-banner -->
	<HelpListDetail>Popover</HelpListDetail> <!-- Popover, Subtitle, Info-banner -->
	<HelpInputShort>Tooltip</HelpInputShort> <!-- Tooltip, Subtext, Popover -->
	<HelpInputDetail>Popover</HelpInputDetail> <!-- Popover -->
	<HelpGroupShort>Tooltip</HelpGroupShort> <!-- Tooltip, Popover, Subtitle -->
	<HelpGroupDetail>Popover</HelpGroupDetail> <!-- Popover, Subtitle -->
	<MenuStyle>simple_navbar</MenuStyle> <!-- simple_navbar, ribbon, double_navbar -->
	<LogonPlacement>in_header</LogonPlacement> <!-- in_header, in_navmenu -->
	<HeaderEnable>true</HeaderEnable> <!-- true, false -->
	<LogoEnable>true</LogoEnable> <!-- true, false -->
	<BrandIconEnable>false</BrandIconEnable> <!-- true, false -->
	<LoginBrandEnable>true</LoginBrandEnable> <!-- true, false -->
	<ContainerWidth>whole_page</ContainerWidth> <!-- whole_page, reduced -->
	<MenuAlign>left</MenuAlign> <!-- left, right -->
</LayoutConfig>