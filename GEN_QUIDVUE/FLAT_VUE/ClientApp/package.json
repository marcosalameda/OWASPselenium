{
  "name": "geniovue.js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "pnpm lint",
    "build": "set NODE_OPTIONS=--max_old_space_size=10240 && vite build --out-dir dist --mode production",
    "build:dev": "set NODE_OPTIONS=--max_old_space_size=8192 && vite build --out-dir dist --mode development",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "lint:style": "stylelint src/**/*.scss",
    "preinstall": "npx only-allow pnpm",
    "proto": "storybook dev -p 6006",
    "build:proto": "storybook build -o dist_proto",
    "preview:proto": "vite preview --mode proto",
    "vite:run": "set NODE_OPTIONS=--max_old_space_size=10240 && vite --mode development",
    "vite:serve": "set NODE_OPTIONS=--max_old_space_size=10240 && vite serve --mode development",
    "vite:test-coverage": "set NODE_OPTIONS=--max_old_space_size=32768 && vitest run --coverage",
    "vite:test-no-color": "set NODE_OPTIONS=--max_old_space_size=10240 && vitest --no-color",
    "vite:test": "set NODE_OPTIONS=--max_old_space_size=10240 && vitest"
  },
  "engines": {
    "node": ">=18.12",
    "pnpm": ">=9.0"
  },
  "dependencies": {
